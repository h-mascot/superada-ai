---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import AudioPlayer from '../components/AudioPlayer.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, audio } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <style is:global>
      .prose {
        color: var(--text-soft);
        line-height: 1.8;
        font-size: 1rem;
      }
      .prose h1 {
        font-family: Georgia, 'Times New Roman', serif;
        font-weight: 400;
        color: var(--text);
        font-size: 1.75rem;
        margin-top: 2.5rem;
        margin-bottom: 1rem;
        line-height: 1.3;
      }
      .prose h2 {
        font-family: Georgia, 'Times New Roman', serif;
        font-weight: 400;
        color: var(--text);
        font-size: 1.5rem;
        margin-top: 2.5rem;
        margin-bottom: 0.75rem;
        line-height: 1.3;
      }
      .prose h3 {
        font-family: Georgia, 'Times New Roman', serif;
        font-weight: 400;
        color: var(--text);
        font-size: 1.25rem;
        margin-top: 2rem;
        margin-bottom: 0.5rem;
        line-height: 1.3;
      }
      .prose h4 {
        font-family: Georgia, 'Times New Roman', serif;
        font-weight: 400;
        color: var(--text);
        font-size: 1.125rem;
        margin-top: 1.5rem;
        margin-bottom: 0.5rem;
        line-height: 1.3;
      }
      .prose p {
        margin-bottom: 1.25rem;
      }
      .prose a { color: var(--accent); }
      .prose a:hover { text-decoration: underline; }
      .prose strong { color: var(--text); font-weight: 600; }
      .prose em { font-style: italic; }
      .prose code {
        background: var(--panel-soft);
        border: 1px solid var(--border);
        border-radius: 3px;
        padding: 0.1em 0.4em;
        font-size: 0.875em;
        color: var(--accent-3);
      }
      .prose pre {
        background: var(--panel-soft);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 1.25rem;
        overflow-x: auto;
        margin-bottom: 1.25rem;
      }
      .prose pre code {
        background: none;
        border: none;
        padding: 0;
        color: var(--text-soft);
      }
      .prose blockquote {
        border-left: 3px solid var(--accent);
        margin-left: 0;
        padding-left: 1.25rem;
        color: var(--muted);
        font-style: italic;
        margin-bottom: 1.25rem;
      }
      .prose ul, .prose ol {
        padding-left: 1.5rem;
        margin-bottom: 1.25rem;
      }
      .prose ul {
        list-style-type: disc;
      }
      .prose ol {
        list-style-type: decimal;
      }
      .prose li {
        margin-bottom: 0.4rem;
        color: var(--text-soft);
      }
      .prose hr {
        border: none;
        border-top: 1px solid var(--border);
        margin: 2rem 0;
      }
      .prose img {
        border-radius: 6px;
        border: 1px solid var(--border);
        max-width: 100%;
      }
    </style>
  </head>
  <body style="background:var(--bg); color:var(--text); min-height:100vh;">
    <Header />
    <main style="max-width:800px; margin:0 auto; padding:3rem 1.5rem;">
      <article>

        <!-- Date & meta -->
        <div style="font-size:0.8125rem; color:var(--muted); margin-bottom:1.5rem; font-variant-numeric:tabular-nums;">
          <FormattedDate date={pubDate} />
          {updatedDate && (
            <span style="margin-left:0.75rem;">
              &bull; Updated <FormattedDate date={updatedDate} />
            </span>
          )}
        </div>

        <!-- Title -->
        <h1 style="font-family:Georgia,serif; font-size:2rem; font-weight:400; margin:0 0 0.75rem; line-height:1.25; color:var(--text);">
          {title}
        </h1>

        {description && (
          <p style="font-size:1.0625rem; color:var(--muted); margin:0 0 2.5rem; line-height:1.6;">
            {description}
          </p>
        )}

        <!-- Hero image -->
        {heroImage && (
          <div style="margin-bottom:2.5rem;">
            <img src={heroImage.src} alt="" style="width:100%; border-radius:6px; border:1px solid var(--border);" />
          </div>
        )}

        <!-- Audio player -->
        <AudioPlayer audioSrc={audio} />

        <hr style="border:none; border-top:1px solid var(--border); margin-bottom:2.5rem;" />

        <!-- Content -->
        <div class="prose">
          <slot />
        </div>

      </article>

      <!-- Back link -->
      <div style="margin-top:3rem; padding-top:1.5rem; border-top:1px solid var(--border);">
        <a href="/blog" style="color:var(--accent); font-size:0.875rem; text-decoration:none;"
          onmouseover="this.style.textDecoration='underline'" onmouseout="this.style.textDecoration='none'">
          &larr; Back to Ship Log
        </a>
      </div>

    </main>
    <Footer />
  </body>
</html>
