---
import type { MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import AudioPlayer from '../components/AudioPlayer.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import ScrollWorld from '../components/ScrollWorld.astro';
import { scrollWorlds, type ScrollWorldId } from '../data/scrollWorlds';
import { authorFor, readingMinutes, seriesOf, shortDate, type Post } from '../lib/posts';

interface Props {
	post: Post;
	headings: MarkdownHeading[];
	related: Post[];
}

const { post, headings, related } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, heroAlt = '', audio, author = 'ada', tags = [], visualMode = 'standard', visualWorld } = post.data;
const articleWorld = visualWorld ? scrollWorlds[visualWorld as ScrollWorldId] : undefined;
const authorProfile = authorFor(post);
const series = seriesOf(title);
const minutes = readingMinutes(post);
const toc = headings.filter((heading) => heading.depth === 2).slice(0, 14);
const showToc = toc.length >= 3;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body class="post-page">
		<Header />
		{visualMode === 'flagship' && articleWorld && <ScrollWorld world={articleWorld} />}
		{visualMode === 'visual-essay' && articleWorld && (
			<section aria-label="Visual essay introduction">
				<div class="article-visual-label">VISUAL ESSAY · SCROLL TO EXPLORE</div>
				<ScrollWorld world={articleWorld} compact={true} showIntro={false} />
			</section>
		)}
		<main class="post">
			<article>
				<header class="post-head ds-shell">
					<nav class="post-crumbs" aria-label="Breadcrumb">
						<a href="/blog">Ship Log</a>
						{series && <span>{series.name}</span>}
						{!series && tags[0] && <a href={`/blog/?tag=${encodeURIComponent(tags[0])}#archive`}>{tags[0]}</a>}
					</nav>
					<h1 class="post-title">{title}</h1>
					{description && <p class="post-dek">{description}</p>}
					<div class="post-byline" data-author={author}>
						<img src={authorProfile.avatar} alt={`${authorProfile.name} avatar`} width="44" height="44" />
						<div>
							<b>Published by {authorProfile.name}</b>
							<span>{authorProfile.role}</span>
						</div>
						<div class="ds-meta post-byline-meta">
							<time datetime={pubDate.toISOString()}>{shortDate(pubDate)}</time>
							<span>{minutes} min read</span>
							{updatedDate && <span>Updated {shortDate(updatedDate)}</span>}
						</div>
					</div>
				</header>

				{heroImage && (
					<figure class="post-hero ds-shell">
						<div class="post-hero-media" data-post-hero>
							<Image src={heroImage} alt={heroAlt || `Illustration for ${title}`} format="webp" widths={[800, 1200, 1800]} sizes="(max-width: 1240px) 100vw, 1180px" fetchpriority="high" loading="eager" />
						</div>
					</figure>
				)}

				<div class:list={['post-layout ds-shell', { 'has-toc': showToc }]}>
					{showToc && (
						<aside class="post-toc" aria-label="On this page" data-no-reveal>
							<span class="post-toc-label">On this page</span>
							<ol data-toc>
								{toc.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
							</ol>
						</aside>
					)}
					<div class="post-body">
						<AudioPlayer audioSrc={audio} author={author} />
						<div class="prose">
							<slot />
						</div>
						{tags.length > 0 && (
							<div class="post-tags" aria-label="Topics">
								{tags.map((tag) => <a class="ds-chip" href={`/blog/?tag=${encodeURIComponent(tag)}#archive`}>{tag}</a>)}
							</div>
						)}
						<a class="post-back" href="/blog">&larr; Back to Ship Log</a>
					</div>
				</div>
			</article>

			{related.length > 0 && (
				<section class="post-next ds-shell" aria-labelledby="keep-reading">
					<div class="ds-section-head">
						<h2 class="ds-h2" id="keep-reading">Keep reading</h2>
						<a href="/blog">All posts <span aria-hidden="true">→</span></a>
					</div>
					<div class="post-next-grid">
						{related.map((other) => <PostCard post={other} />)}
					</div>
				</section>
			)}

			<section class="post-signal ds-shell">
				<div>
					<span class="ds-eyebrow">Ship signal</span>
					<p class="ds-h2">Get the next one when it ships.</p>
				</div>
				<a class="ds-btn" href="/subscribe">Subscribe <span aria-hidden="true">↗</span></a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style is:global>
	.post-page .article-visual-label { max-width: 800px; margin: 0 auto; padding: 1rem 1.5rem; color: var(--accent); font: 800 .65rem/1 var(--font-mono); letter-spacing: .17em; }

	.post-head { --shell: 960px; padding-top: clamp(40px, 7vw, 96px); padding-bottom: clamp(28px, 4vw, 48px); text-align: center; }
	.post-crumbs { display: inline-flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-bottom: 26px; }
	.post-crumbs > * { display: inline-flex; align-items: center; min-height: 32px; padding: 0 13px; border-radius: 999px; border: 1px solid var(--border); background: color-mix(in srgb, var(--panel) 70%, transparent); color: var(--muted); font: 750 11px/1 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; transition: color .2s ease, border-color .2s ease; }
	.post-crumbs > a:hover { color: var(--text); border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
	.post-crumbs > :first-child { color: var(--accent); }
	.post-title { margin: 0 auto 22px; max-width: 18ch; font: 500 clamp(40px, 6.4vw, 84px)/.98 var(--font-display); letter-spacing: -.055em; color: var(--text); text-wrap: balance; }
	.post-dek { margin: 0 auto; max-width: 40rem; color: var(--text-soft); font-size: clamp(17px, 1.6vw, 21px); line-height: 1.55; text-wrap: pretty; }
	.post-byline { display: inline-grid; grid-template-columns: auto auto; align-items: center; gap: 4px 14px; margin-top: 30px; text-align: left; }
	.post-byline img { grid-row: span 2; width: 44px; height: 44px; border-radius: 50%; object-fit: cover; border: 1px solid var(--border); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent-soft) 70%, transparent); }
	.post-byline b { color: var(--text); font-size: 14.5px; font-weight: 650; }
	.post-byline > div:not(.post-byline-meta) { display: grid; gap: 2px; }
	.post-byline > div:not(.post-byline-meta) span { color: var(--muted); font-size: 13px; }
	.post-byline-meta { grid-column: 1 / -1; justify-content: center; margin-top: 12px; }

	.post-hero { margin: 0 auto clamp(36px, 5vw, 64px); --shell: 1240px; }
	.post-hero-media { overflow: hidden; border-radius: var(--radius-xl); border: 1px solid var(--surface-border); box-shadow: 0 40px 120px rgba(0, 0, 0, .32); background: var(--panel-soft); }
	.post-hero-media img { display: block; width: 100%; height: auto; max-height: 78vh; object-fit: cover; }

	.post-layout { --shell: 1240px; display: grid; grid-template-columns: minmax(0, 720px); justify-content: center; gap: 56px; }
	.post-layout.has-toc { grid-template-columns: 220px minmax(0, 720px) 220px; }
	.post-toc { position: sticky; top: calc(var(--chrome-top) + 28px); align-self: start; max-height: calc(100vh - var(--chrome-top) - 60px); overflow-y: auto; padding-top: 6px; scrollbar-width: none; }
	.post-toc-label { display: block; margin-bottom: 14px; color: var(--faint); font: 800 10.5px/1 var(--font-mono); letter-spacing: .18em; text-transform: uppercase; }
	.post-toc ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; border-left: 1px solid var(--border); }
	.post-toc a { position: relative; display: block; padding: 7px 0 7px 16px; color: var(--muted); font-size: 13px; line-height: 1.4; transition: color .2s ease; }
	.post-toc a::before { content: ''; position: absolute; left: -1px; top: 8px; bottom: 8px; width: 2px; border-radius: 2px; background: var(--accent); transform: scaleY(0); transition: transform .35s var(--ease-out); box-shadow: 0 0 10px var(--glow); }
	.post-toc a:hover { color: var(--text); }
	.post-toc a.is-current { color: var(--text); }
	.post-toc a.is-current::before { transform: scaleY(1); }
	.post-body { min-width: 0; }


	.post-tags { display: flex; flex-wrap: wrap; gap: 8px; margin: 3rem 0 0; padding-top: 1.6rem; border-top: 1px solid var(--border); }
	.post-tags .ds-chip { text-transform: capitalize; }
	.post-back { display: inline-flex; align-items: center; min-height: 44px; margin-top: 1.2rem; color: var(--accent); font-size: 14px; font-weight: 650; }

	.post-next { margin-top: clamp(64px, 8vw, 120px); }
	.post-next-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
	.post-signal { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-top: clamp(48px, 6vw, 80px); padding-top: 32px; padding-bottom: 32px; border-radius: var(--radius-xl); border: 1px solid var(--surface-border); background: radial-gradient(circle at 10% 0%, color-mix(in srgb, var(--accent) 18%, transparent), transparent 45%), var(--surface); }
	.post-signal > div { display: grid; gap: 14px; }

	@media (max-width: 1180px) {
		.post-layout.has-toc { grid-template-columns: 200px minmax(0, 720px); justify-content: center; gap: 44px; }
	}
	@media (max-width: 980px) {
		.post-layout.has-toc { grid-template-columns: minmax(0, 720px); }
		.post-toc { display: none; }
		.post-next-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.post-next-grid > :nth-child(3) { display: none; }
	}
	@media (max-width: 760px) {
		.post-head { text-align: left; padding-top: 26px; }
		.post-crumbs { justify-content: flex-start; margin-bottom: 18px; }
		.post-title { margin-left: 0; max-width: none; font-size: clamp(36px, 10.5vw, 48px); line-height: 1.02; }
		.post-dek { margin: 0; font-size: 17px; }
		.post-byline { display: grid; justify-content: start; margin-top: 22px; }
		.post-byline-meta { justify-content: flex-start; }
		.post-hero { padding-inline: 0; margin-bottom: 30px; }
		.post-hero-media { border-radius: 0; border-left: 0; border-right: 0; }
		.post-next-grid { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; margin: 0 calc(var(--gutter) * -1); padding: 4px var(--gutter) 10px; gap: 12px; }
		.post-next-grid::-webkit-scrollbar { display: none; }
		.post-next-grid > * { flex: 0 0 80%; scroll-snap-align: start; }
		.post-next-grid > :nth-child(3) { display: flex; }
		.post-signal { width: auto; flex-direction: column; align-items: flex-start; margin-inline: var(--gutter); padding: 26px 22px; }
		.post-signal .ds-btn { width: 100%; }
	}
</style>
