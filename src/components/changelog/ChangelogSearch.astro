---
import NavIcon from '../NavIcon.astro';

interface Props {
	id: string;
	placeholder: string;
	idleStatus: string;
	scope?: string;
	label?: string;
}

const { id, placeholder, idleStatus, scope = '', label = 'Search' } = Astro.props;
---
<div class="cls-bar" data-cl-search data-scope={scope} data-src="/openclaw-changelog/search.json">
	<label class="cls-field" for={id}>
		<NavIcon name="search" />
		<span class="cls-label">{label}</span>
		<input id={id} type="search" placeholder={placeholder} autocomplete="off" spellcheck="false" enterkeyhint="search" />
	</label>
	<p class="cls-status" data-cl-status aria-live="polite">{idleStatus}</p>
</div>
<div class="cls-results" data-cl-results data-no-reveal hidden></div>

<script is:inline>
	(() => {
		const root = document.querySelector('[data-cl-search]');
		const results = document.querySelector('[data-cl-results]');
		if (!root || !results) return;
		const input = root.querySelector('input');
		const status = root.querySelector('[data-cl-status]');
		const hideables = [...document.querySelectorAll('[data-cl-hide-on-search]')];
		const scope = root.dataset.scope || '';
		const idle = status.textContent;
		const STEP = 60;
		let data = null;
		let loading = null;
		let limit = STEP;
		let timer = 0;

		const load = () => loading || (loading = fetch(root.dataset.src)
			.then((res) => { if (!res.ok) throw new Error(String(res.status)); return res.json(); })
			.then((json) => { data = json; return json; })
			.catch(() => { loading = null; status.textContent = 'The search index did not load. Check your connection and try again.'; }));
		const esc = (s) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
		const mark = (s, q) => {
			const i = s.toLowerCase().indexOf(q);
			return i < 0 ? esc(s) : `${esc(s.slice(0, i))}<mark>${esc(s.slice(i, i + q.length))}</mark>${esc(s.slice(i + q.length))}`;
		};
		const snip = (s, q) => {
			if (s.length <= 220) return s;
			const at = Math.max(0, s.toLowerCase().indexOf(q));
			const start = at > 90 ? at - 70 : 0;
			return `${start ? '…' : ''}${s.slice(start, start + 220)}${start + 220 < s.length ? '…' : ''}`;
		};
		const fmt = (n) => n.toLocaleString('en-US');
		const pageHref = (slug, page) => `/openclaw-changelog/${slug}/${page > 1 ? `${page}/` : ''}`;
		const entryHref = (slug, i) => `${pageHref(slug, Math.floor(i / data.pageSize) + 1)}#c-${i + 1}`;

		const render = () => {
			const q = input.value.trim().toLowerCase();
			const on = q.length > 0;
			hideables.forEach((el) => { el.hidden = on; });
			results.hidden = !on;
			if (!on) { status.textContent = idle; results.innerHTML = ''; return; }
			if (!data) {
				status.textContent = 'Loading the full changelog index…';
				const pending = load();
				if (pending) pending.then(() => { if (data) render(); });
				return;
			}
			let total = 0;
			let shown = 0;
			let groups = 0;
			let html = '';
			data.releases.forEach(([version, slug, changeCount], r) => {
				if (scope && slug !== scope) return;
				const versionHit = !scope && version.toLowerCase().includes(q);
				const hits = [];
				data.entries[r].forEach((entry, i) => {
					if (entry[0].toLowerCase().includes(q) || (entry[1] && entry[1].toLowerCase().includes(q))) hits.push(i);
				});
				if (!hits.length && !versionHit) return;
				groups += 1;
				total += hits.length;
				const rows = [];
				for (const i of hits) {
					if (shown >= limit) break;
					shown += 1;
					const [title, desc] = data.entries[r][i];
					const kind = i < changeCount ? 'Change' : 'Fix';
					rows.push(`<li><a href="${entryHref(slug, i)}"><span class="cls-kind cls-kind--${kind.toLowerCase()}">${kind}</span><span class="cls-copy"><b>${mark(title, q)}</b>${desc ? `<small>${mark(snip(desc, q), q)}</small>` : ''}</span><span class="cls-go" aria-hidden="true">→</span></a></li>`);
				}
				const hidden = hits.length - rows.length;
				html += `<section class="cls-group"><header><a href="${pageHref(slug, 1)}">${scope ? 'Matches' : `<span>Release</span> ${esc(version)}`}</a><span>${hits.length ? `${fmt(hits.length)} ${hits.length === 1 ? 'match' : 'matches'}` : 'Version match'}</span></header>${rows.length ? `<ol>${rows.join('')}</ol>` : ''}${!rows.length && versionHit ? `<a class="cls-open" href="${pageHref(slug, 1)}">Open every change in ${esc(version)} →</a>` : ''}${hidden > 0 && shown >= limit ? `<p class="cls-more-note">${fmt(hidden)} more in this release</p>` : ''}</section>`;
			});
			if (!groups) {
				status.textContent = 'No matches';
				results.innerHTML = `<p class="cls-empty">Nothing in ${scope ? 'this release' : 'the changelog'} matches “${esc(input.value.trim())}”. Try a feature, channel, provider or version number.</p>`;
				return;
			}
			status.textContent = scope ? `${fmt(total)} ${total === 1 ? 'match' : 'matches'} in this release` : `${fmt(total)} ${total === 1 ? 'match' : 'matches'} across ${groups} ${groups === 1 ? 'release' : 'releases'}`;
			results.innerHTML = html + (shown < total ? `<button type="button" class="ds-btn ds-btn--ghost cls-more" data-cl-more>Show ${fmt(Math.min(STEP, total - shown))} more results</button>` : '');
		};

		input.addEventListener('input', () => { limit = STEP; clearTimeout(timer); timer = setTimeout(render, 110); });
		input.addEventListener('focus', () => { load(); }, { once: true });
		input.addEventListener('keydown', (event) => { if (event.key === 'Escape' && input.value) { input.value = ''; render(); } });
		results.addEventListener('click', (event) => {
			if (event.target.closest('[data-cl-more]')) { limit += STEP; render(); return; }
			const link = event.target.closest('a');
			if (link && link.pathname === location.pathname) { input.value = ''; render(); }
		});
		const initial = new URLSearchParams(location.search).get('q');
		if (initial) { input.value = initial; render(); }
	})();
</script>

<style>
	.cls-bar { position: sticky; top: var(--chrome-top); z-index: 20; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 10px 18px; margin: 0 calc(var(--gutter) * -1) 22px; padding: 12px var(--gutter); border: 1px solid color-mix(in srgb, var(--border) 60%, transparent); border-top: 0; border-radius: 0 0 22px 22px; background: color-mix(in srgb, var(--bg) 84%, transparent); -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px); transition: top .4s var(--ease-ios); }
	.cls-field { display: flex; align-items: center; gap: 12px; min-height: 52px; padding: 0 16px; border-radius: 16px; border: 1px solid var(--border); background: var(--panel); color: var(--accent); cursor: text; transition: border-color .2s ease, box-shadow .2s ease; }
	.cls-field:focus-within { border-color: color-mix(in srgb, var(--accent) 60%, var(--border)); box-shadow: 0 0 0 4px color-mix(in srgb, var(--glow) 35%, transparent); }
	.cls-field :global(.nav-icon) { width: 18px; height: 18px; }
	.cls-label { color: var(--muted); font: 800 10.5px/1 var(--font-mono); letter-spacing: .16em; text-transform: uppercase; padding-right: 12px; border-right: 1px solid var(--border); }
	.cls-field input { flex: 1; min-width: 0; height: 50px; border: 0; outline: 0; background: transparent; color: var(--text); font: inherit; font-size: 16px; }
	.cls-field input::placeholder { color: var(--faint); }
	.cls-status { color: var(--muted); font: 650 12px/1.3 var(--font-mono); letter-spacing: .04em; white-space: nowrap; }

	.cls-results { display: grid; gap: 18px; }
	.cls-results[hidden] { display: none; }
	.cls-results :global(.cls-group) { border-radius: var(--radius-lg); border: 1px solid var(--surface-border); background: var(--surface); overflow: hidden; }
	.cls-results :global(.cls-group > header) { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 16px 20px; border-bottom: 1px solid var(--border); }
	.cls-results :global(.cls-group > header a) { display: inline-flex; align-items: baseline; gap: 10px; min-height: 28px; color: var(--text); font: 500 24px/1 var(--font-display); letter-spacing: -.03em; }
	.cls-results :global(.cls-group > header a span) { color: var(--accent); font: 800 10px/1 var(--font-mono); letter-spacing: .16em; text-transform: uppercase; }
	.cls-results :global(.cls-group > header a:hover) { color: var(--accent); }
	.cls-results :global(.cls-group > header > span) { color: var(--muted); font: 650 12px/1 var(--font-mono); }
	.cls-results :global(ol) { list-style: none; margin: 0; padding: 6px; display: grid; }
	.cls-results :global(li a) { display: grid; grid-template-columns: 66px minmax(0, 1fr) 18px; align-items: start; gap: 14px; min-height: 48px; padding: 12px 14px; border-radius: 14px; color: var(--text); transition: background-color .2s ease; }
	.cls-results :global(li a:hover) { background: color-mix(in srgb, var(--panel-soft) 70%, transparent); }
	.cls-results :global(.cls-kind) { justify-self: start; margin-top: 2px; padding: 5px 8px; border-radius: 999px; border: 1px solid var(--border); color: var(--muted); font: 800 9.5px/1 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; }
	.cls-results :global(.cls-kind--change) { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 40%, var(--border)); }
	.cls-results :global(.cls-kind--fix) { color: var(--success); border-color: color-mix(in srgb, var(--success) 40%, var(--border)); }
	.cls-results :global(.cls-copy) { display: grid; gap: 4px; min-width: 0; }
	.cls-results :global(.cls-copy b) { font-weight: 620; font-size: 15px; line-height: 1.4; overflow-wrap: anywhere; }
	.cls-results :global(.cls-copy small) { color: var(--muted); font-size: 13.5px; line-height: 1.55; overflow-wrap: anywhere; }
	.cls-results :global(mark) { background: color-mix(in srgb, var(--accent) 26%, transparent); color: var(--text); border-radius: 3px; padding: 0 1px; }
	.cls-results :global(.cls-go) { color: var(--accent); opacity: 0; transition: opacity .2s ease, transform .3s var(--ease-out); }
	.cls-results :global(li a:hover .cls-go) { opacity: 1; transform: translateX(3px); }
	.cls-results :global(.cls-open) { display: flex; align-items: center; min-height: 52px; padding: 0 20px; color: var(--accent); font-size: 13px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
	.cls-results :global(.cls-more-note) { padding: 0 20px 16px 100px; color: var(--faint); font-size: 12.5px; }
	.cls-results :global(.cls-more) { justify-self: center; }
	.cls-results :global(.cls-empty) { padding: 48px 20px; color: var(--muted); text-align: center; }

	@media (max-width: 760px) {
		.cls-bar { grid-template-columns: minmax(0, 1fr); gap: 8px; padding-top: 10px; padding-bottom: 10px; }
		.cls-label { display: none; }
		.cls-status { font-size: 11.5px; }
		.cls-results :global(.cls-group > header) { padding: 14px 16px; }
		.cls-results :global(li a) { grid-template-columns: minmax(0, 1fr); gap: 6px; padding: 12px 10px; }
		.cls-results :global(.cls-go) { display: none; }
		.cls-results :global(.cls-more-note) { padding-left: 16px; }
	}
</style>
