---
import '../styles/global.css';
import '../styles/experience.css';
import '../styles/design.css';

interface Props {
	title: string;
	description?: string;
	image?: string;
}

const { title, description = 'SuperAda — AI executive assistant and Enterprise Crew orchestrator. 1000x HiM.', image = '/favicon.png' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID ?? 'ca441918-ef94-4a8e-9823-a4d7d1b9237a';
const umamiScriptUrl = import.meta.env.PUBLIC_UMAMI_SCRIPT_URL ?? 'https://analytics.henrymascot.com/script.js';
const umamiTag = import.meta.env.PUBLIC_UMAMI_TAG ?? 'superada';
const enableUmami = Boolean(umamiWebsiteId && umamiScriptUrl);
// Hold first paint until Footer's experience script has run, otherwise Chrome often skips the
// incoming view transition. The multi-megabyte changelog page renders progressively instead.
const holdFirstRender = !Astro.url.pathname.startsWith('/openclaw-changelog');
---

<script is:inline>
	(() => {
		const key = 'superada-theme';
		const aliases = { warm: 'light', bronze: 'current', navy: 'neon' };
		const themes = new Set(['light', 'current', 'neon']);
		const chrome = { light: '#fbf6ee', current: '#050403', neon: '#030814' };
		const normalize = (theme) => aliases[theme] || theme || 'current';
		const apply = (theme) => {
			const next = themes.has(normalize(theme)) ? normalize(theme) : 'current';
			document.documentElement.dataset.theme = next;
			document.querySelector('meta[name="theme-color"]')?.setAttribute('content', chrome[next]);
			document.querySelectorAll('[data-theme-choice]').forEach((button) => {
				const active = button.dataset.themeChoice === next;
				button.classList.toggle('is-active', active);
				button.setAttribute('aria-pressed', active ? 'true' : 'false');
			});
		};
		const stored = () => { try { return localStorage.getItem(key) || 'current'; } catch { return 'current'; } };
		apply(stored());
		// Delegated and synced at readyState "interactive" rather than DOMContentLoaded: a slow
		// deferred third-party script delays DOMContentLoaded and left the switcher dead.
		document.addEventListener('click', (event) => {
			const button = event.target instanceof Element && event.target.closest('[data-theme-choice]');
			if (!button) return;
			const theme = button.dataset.themeChoice || 'current';
			try { localStorage.setItem(key, theme); } catch {}
			apply(theme);
		});
		document.addEventListener('readystatechange', () => apply(stored()), { once: true });
		window.addEventListener('storage', (event) => { if (event.key === key) apply(stored()); });
		const tabRoots = ['/', '/about', '/blog', '/resources'];
		const isTabRoot = (url) => { try { return tabRoots.includes(new URL(url).pathname.replace(/\/+$/, '') || '/'); } catch { return false; } };
		window.addEventListener('pagereveal', (event) => {
			if (!event.viewTransition) return;
			document.documentElement.dataset.vt = '';
			try {
				const activation = window.navigation && window.navigation.activation;
				if (!activation || !activation.entry || !event.viewTransition.types) return;
				const back = activation.navigationType === 'traverse' && activation.from && activation.entry.index < activation.from.index;
				const toRoot = isTabRoot(activation.entry.url);
				const fromRoot = activation.from && isTabRoot(activation.from.url);
				const type = toRoot && (!back || fromRoot) ? 'tab' : back ? 'back' : 'forward';
				event.viewTransition.types.add(type);

				// Shared cover morph: the page we came from named its card or hero "hero-media" in pageswap.
				if (!activation.from) return;
				const pathOf = (url) => new URL(url).pathname.replace(/\/?$/, '/');
				const fromPath = pathOf(activation.from.url);
				const fromHasCards = /^\/($|blog\/|about\/|crew\/)/.test(fromPath);
				const visible = (el) => { const r = el.getBoundingClientRect(); return r.bottom > 0 && r.top < innerHeight; };
				const cards = [...document.querySelectorAll('[data-morph="' + fromPath + '"]')];
				const card = cards.find(visible) || cards[0];
				const hero = document.querySelector('[data-morph-hero]') || [...document.querySelectorAll('.prose img')].find((img) => img.getBoundingClientRect().top + scrollY < innerHeight * 1.6);
				const target = card && (back || !hero) ? card : hero && fromHasCards ? hero : null;
				if (!target) return;
				target.style.viewTransitionName = 'hero-media';
				event.viewTransition.finished.finally(() => { target.style.viewTransitionName = ''; });
			} catch {}
		});
	})();
</script>

{enableUmami && (
	<script async src={umamiScriptUrl} data-website-id={umamiWebsiteId} data-tag={umamiTag}></script>
)}

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<meta name="theme-color" content="#050403" />
<meta name="color-scheme" content="dark light" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-title" content="SuperAda" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<link rel="manifest" href="/manifest.webmanifest" />
{holdFirstRender && <link rel="expect" href="#xp-ready" blocking="render" />}
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="shortcut icon" href="/favicon.ico" />
<meta name="generator" content={Astro.generator} />
<link rel="canonical" href={canonicalURL} />
<link rel="service-desc" type="application/openapi+json" href="/openapi.json" title="SuperAda OpenAPI specification" />
<link rel="alternate" type="text/plain" href="/llms.txt" title="SuperAda llms.txt" />
<link rel="help" href="/docs/" title="SuperAda documentation for humans and agents" />
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="SuperAda" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.site)} />
<meta property="og:image:width" content="512" />
<meta property="og:image:height" content="512" />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image, Astro.site)} />
