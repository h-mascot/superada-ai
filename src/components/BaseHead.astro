---
import '../styles/global.css';
import '../styles/experience.css';

interface Props {
	title: string;
	description?: string;
	image?: string;
}

const { title, description = 'SuperAda — AI executive assistant and Enterprise Crew orchestrator. 1000x HiM.', image = '/favicon.png' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID ?? 'ca441918-ef94-4a8e-9823-a4d7d1b9237a';
const umamiScriptUrl = import.meta.env.PUBLIC_UMAMI_SCRIPT_URL ?? 'https://analytics.henrymascot.com/script.js';
const umamiTag = import.meta.env.PUBLIC_UMAMI_TAG ?? 'superada';
const enableUmami = Boolean(umamiWebsiteId && umamiScriptUrl);
// Hold first paint until Footer's experience script has run, otherwise Chrome often skips the
// incoming view transition. The multi-megabyte changelog page renders progressively instead.
const holdFirstRender = !Astro.url.pathname.startsWith('/openclaw-changelog');
---

<script is:inline>
	(() => {
		const key = 'superada-theme';
		const aliases = { warm: 'light', bronze: 'current', navy: 'neon' };
		const themes = new Set(['light', 'current', 'neon']);
		const chrome = { light: '#fbf6ee', current: '#050403', neon: '#030814' };
		const normalize = (theme) => aliases[theme] || theme || 'current';
		const apply = (theme) => {
			const next = themes.has(normalize(theme)) ? normalize(theme) : 'current';
			document.documentElement.dataset.theme = next;
			document.querySelector('meta[name="theme-color"]')?.setAttribute('content', chrome[next]);
			document.querySelectorAll('[data-theme-choice]').forEach((button) => {
				const active = button.dataset.themeChoice === next;
				button.classList.toggle('is-active', active);
				button.setAttribute('aria-pressed', active ? 'true' : 'false');
			});
		};
		try { apply(localStorage.getItem(key) || 'current'); } catch { apply('current'); }
		window.addEventListener('DOMContentLoaded', () => {
			let current = 'current';
			try { current = localStorage.getItem(key) || 'current'; } catch {}
			document.querySelectorAll('[data-theme-choice]').forEach((button) => {
				button.addEventListener('click', () => {
					const theme = button.dataset.themeChoice || 'current';
					try { localStorage.setItem(key, theme); } catch {}
					apply(theme);
				});
			});
			apply(current);
		});
		const tabRoots = ['/', '/about', '/blog', '/resources'];
		const isTabRoot = (url) => { try { return tabRoots.includes(new URL(url).pathname.replace(/\/+$/, '') || '/'); } catch { return false; } };
		window.addEventListener('pagereveal', (event) => {
			if (!event.viewTransition) return;
			document.documentElement.dataset.vt = '';
			try {
				const activation = window.navigation && window.navigation.activation;
				if (!activation || !activation.entry || !event.viewTransition.types) return;
				const back = activation.navigationType === 'traverse' && activation.from && activation.entry.index < activation.from.index;
				const toRoot = isTabRoot(activation.entry.url);
				const fromRoot = activation.from && isTabRoot(activation.from.url);
				const type = toRoot && (!back || fromRoot) ? 'tab' : back ? 'back' : 'forward';
				event.viewTransition.types.add(type);
			} catch {}
		});
	})();
</script>

{enableUmami && (
	<script defer src={umamiScriptUrl} data-website-id={umamiWebsiteId} data-tag={umamiTag}></script>
)}

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<meta name="theme-color" content="#050403" />
<meta name="color-scheme" content="dark light" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-title" content="SuperAda" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<link rel="manifest" href="/manifest.webmanifest" />
{holdFirstRender && <link rel="expect" href="#xp-ready" blocking="render" />}
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="shortcut icon" href="/favicon.ico" />
<meta name="generator" content={Astro.generator} />
<link rel="canonical" href={canonicalURL} />
<link rel="service-desc" type="application/openapi+json" href="/openapi.json" title="SuperAda OpenAPI specification" />
<link rel="alternate" type="text/plain" href="/llms.txt" title="SuperAda llms.txt" />
<link rel="help" href="/developers/" title="SuperAda developer API documentation" />
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="SuperAda" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.site)} />
<meta property="og:image:width" content="512" />
<meta property="og:image:height" content="512" />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image, Astro.site)} />
