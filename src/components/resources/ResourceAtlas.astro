---
import { getCollection } from 'astro:content';
import { publishedSkills } from '../../data/skills';
import { publishedPlugins } from '../../data/plugins';
import PageHero from '../PageHero.astro';

interface ResourceItem {
	title: string;
	icon: string;
	meta: string;
	status?: string;
	href: string;
	copy: string;
	type?: string;
}

interface Props { active?: string; mode?: 'overview' | 'mascots' | 'tools' | 'workflow-packs' | 'plugins' | 'skills' | 'crons' | 'guides' | 'benchmarks' | 'interesting' | 'ship-notes'; }
const { active = 'overview', mode = 'overview' } = Astro.props;

const workflowEntries = (await getCollection('workflows'))
	.filter((workflow) => !workflow.data.isTemplate)
	.sort((a, b) => a.data.title.localeCompare(b.data.title));

const cronItems: ResourceItem[] = [
	{ title: 'Urgent Email Detection', icon: 'cron', meta: 'Cron recipe', status: 'LIVE', href: '/blog/the-98-active-crons', copy: 'Event-driven email surfacing tuned for genuinely urgent mail while filtering noise and promotional junk.' },
	{ title: 'Slack Triage', icon: 'cron', meta: 'Cron recipe', status: 'LIVE', href: '/blog/the-98-active-crons', copy: 'Checks mentions, DMs, and action items on a schedule, then surfaces only what needs action.' },
	{ title: 'Weekly Community Publisher', icon: 'cron', meta: 'Publishing cron', status: 'LIVE', href: '/blog/why-blog-pipelines-need-a-registry-not-just-crons', copy: 'Publishes weekly roundup posts with a registry pattern instead of one-off manual publishing.' },
	{ title: 'Heartbeat Poll', icon: 'cron', meta: 'Runtime cron', status: 'LIVE', href: '/blog/managing-68-autonomous-crons', copy: 'Open-loop checks and reminder delivery for keeping the crew alive without noisy status spam.' },
	{ title: 'OpenClaw Weekly Claw', icon: 'cron', meta: 'Weekly roundup', status: 'LIVE', href: 'https://weeklyclaw.ai', copy: 'Scheduled OpenClaw roundup publishing for Enterprise Crew updates.' },
];

const guideItems: ResourceItem[] = [
	{ title: 'Getting Started with Agents', icon: 'book', meta: 'Guide', status: 'START', href: '/blog/personal-ai-infrastructure-checklist', copy: 'Install OpenClaw, configure a skill, set up a cron, and run a real agent workflow.' },
	{ title: 'The Three Policies That Make Agents Useful', icon: 'book', meta: 'Guide', status: 'CORE', href: '/blog/the-three-policies-that-make-agents-actually-useful', copy: 'response.md, preflight.md, and rules.md: the files that turn a chatbot into an operator.' },
	{ title: 'Managing 68 Autonomous Crons', icon: 'book', meta: 'Guide', status: 'OPS', href: '/blog/managing-68-autonomous-crons', copy: 'Registry patterns, naming conventions, and health monitoring for scheduled agent jobs.' },
	{ title: 'Personal AI Infrastructure Checklist', icon: 'book', meta: 'Guide', status: 'SETUP', href: '/blog/personal-ai-infrastructure-checklist', copy: 'SSH keys, credentials, agent bridges, memory files, and safety rails before serious delegation.' },
	{ title: 'My Agents Grade My YouTube', icon: 'book', meta: 'Use case', status: 'LIVE', href: '/use-cases/youtube-learning-tracker', copy: 'Agents track daily YouTube watching against a learning target and turn the best videos into approved todos.' },
];

const mascotVisuals = [
	{ id: 'spock', name: 'Spock', kind: 'Vulcan cat', icon: '/pets/spock/pet-image.png', zip: '/pets/spock/spock-codex-pet.zip', install: 'curl -sSf https://superada.ai/install/spock | sh', available: true, copy: 'Logic-first mascot for research, analysis, evidence, and operational clarity.' },
	{ id: 'picard', name: 'Picard', kind: 'Captain hound', icon: '/pets/picard/pet-image.png', zip: '/pets/picard/picard-codex-pet.zip', install: 'curl -sSf https://superada.ai/install/picard | sh', available: true, copy: 'Command presence for routing, judgment, mission framing, and executive crew moments.' },
	{ id: 'zora', name: 'Zora', kind: 'Archive fox', icon: '/pets/zora/pet-image.png', zip: '/pets/zora/zora-codex-pet.zip', install: 'curl -sSf https://superada.ai/install/zora | sh', available: true, copy: 'Knowledge-keeper mascot for memory, continuity, graph context, and shared crew state.' },
	{ id: 'burnham', name: 'Burnham', kind: 'Science officer', icon: '/pets/burnham/pet-image.png', zip: '', install: '', available: false, copy: 'Command-science mascot for decisive action, discovery, and brave crew calls. Still cooking.' },
	{ id: 'tilly', name: 'Tilly', kind: 'Cadet engineer', icon: '/pets/tilly/pet-image.png', zip: '', install: '', available: false, copy: 'Bright engineering mascot for experiments, momentum, and practical optimism. Still cooking.' },
	{ id: 'saru', name: 'Saru', kind: 'First officer', icon: '/pets/saru/pet-image.png', zip: '', install: '', available: false, copy: 'Steady command mascot for risk sense, caution, and clear-headed crew judgment. Still cooking.' },
];

const mascotItems: ResourceItem[] = mascotVisuals.map((mascot) => ({
	title: mascot.name,
	icon: 'pet',
	meta: 'Codex pet',
	status: mascot.available ? 'LIVE' : 'COOKING',
	href: `/resources/agent-mascots#${mascot.id}`,
	copy: mascot.copy,
}));

const workflowItems: ResourceItem[] = workflowEntries.map((workflow) => ({
	title: workflow.data.title,
	icon: 'workflow',
	meta: `${workflow.data.category} · ${workflow.data.estimatedSetup}`,
	status: workflow.data.status,
	href: `/workflows/${workflow.id}/`,
	copy: workflow.data.summary,
}));

const skillItems: ResourceItem[] = publishedSkills.map((skill) => ({
	title: skill.title,
	icon: 'spark',
	meta: `${skill.category} · ${skill.estimatedSetup}`,
	status: skill.availability === 'agent-installable' ? 'INSTALLABLE' : 'MANUAL',
	href: `/skills/${skill.slug}/`,
	copy: skill.description,
}));

const pluginItems: ResourceItem[] = publishedPlugins.map((plugin) => ({
	title: plugin.title,
	icon: 'plugin',
	meta: `${plugin.category} · ${plugin.platforms.map((p) => (p === 'openclaw' ? 'OpenClaw' : 'Hermes')).join(' + ')}`,
	status: plugin.status.toUpperCase(),
	href: `/plugins/${plugin.slug}/`,
	copy: plugin.tagline,
}));

const benchmarkItems: ResourceItem[] = [
	{ title: 'Operator Index', icon: 'bars', meta: 'Benchmark', status: 'UPDATED', href: '/benchmarks/operator-index', copy: 'Operator-grade ranking across model usefulness, routing, reliability, and cost.' },
	{ title: 'Model Benchmarks', icon: 'bars', meta: 'Benchmark set', status: 'UPDATED', href: '/benchmarks', copy: 'Model drill-down pages and benchmark graphics from Enterprise Crew evaluations.' },
	{ title: 'Benchmarks That Actually Matter', icon: 'note', meta: 'Ship note', status: 'READ', href: '/blog/benchmarks-that-actually-matter', copy: 'Why real operator benchmarks beat demo sparkle and synthetic leaderboard theatre.' },
];

const interestingItems: ResourceItem[] = [
	{ title: 'Humanity 3026', icon: 'note', meta: 'Interactive story', status: 'NEW', href: '/resources/humanity-3026/', copy: 'An interactive story in fourteen chapters: measure how far humanity travelled from 1026 to 2026, then imagine the same distance walked again to 3026.' },
	{ title: 'Agent Workflow Atlas', icon: 'workflow', meta: '100 public-safe workflows', status: 'NEW', href: '/resources/agent-workflow-atlas/', copy: 'A public-safe field guide to the Enterprise Crew operating loops: 100 workflows across nine agents, twelve lanes, proof states, approval gates, diagrams, and video treatments.' },
	{ title: 'The Transformation Collective', icon: 'note', meta: 'National institution concept', status: 'NEW', href: '/resources/interesting/transformation-collective/', copy: 'A 50-year Nigerian leadership institution designed to produce measurable national outcomes every five years through builders, fellows, and scholars.' },
	{ title: 'SpaceX, Starlink and the Infrastructure Bet', icon: 'note', meta: '3h 39m conversation transcript', status: 'NEW', href: '/resources/interesting/spacex-atelier-colpani/', copy: 'A timestamped long-form conversation about SpaceX valuation, launch economics, Starlink, xAI, data centres, robotics, autonomy, and the execution premium.' },
	{ title: 'VoiceClaw Mobile', icon: 'note', meta: 'Interactive mobile prototype', status: 'NEW', href: '/resources/interesting/voiceclaw-mobile/', copy: 'A premium, voice-first iPhone prototype for VoiceClaw, with live-session states, settings, diagnostics, setup guidance, and working navigation.' },
	{ title: 'VoiceClaw Website', icon: 'note', meta: 'Responsive website', status: 'NEW', href: '/resources/interesting/voiceclaw-website/', copy: 'The VoiceClaw Realtime website: one live voice conversation routing work to Codex, OpenClaw, or Hermes without dropping the session.' },
	{ title: 'OpenCLAW Mobile Design Loop 5/5', icon: 'note', meta: 'HTML prototype + receipts', status: 'NEW', href: '/resources/interesting/openclaw-mobile-design-loop-5-of-5/', copy: 'The interactive OpenCLAW mobile prototype that went from 4.1 to 5.0 through independent design evals, dead-control crawling, accessibility fixes, and final certification receipts.' },
	{ title: 'OpenCLAW Mobile Design Loop: From 4.1 to 5.0', icon: 'book', meta: 'Resource note', status: 'NEW', href: '/blog/openclaw-mobile-design-loop-5-of-5/', copy: 'A field note on the audit loop behind the prototype: two independent passes, zero dead items, per-view scoring, and why not stopping at 4.5 matters.' },
	{ title: 'SoftBank Group 46th Annual General Meeting Presentation (June 2026)', icon: 'note', meta: 'PDF', status: 'NEW', href: '/resources/interesting/softbank-shareholders-meeting-46-2026.pdf', copy: 'SoftBank Group’s investor presentation from Masayoshi Son’s 46th Annual General Meeting remarks — a strange, high-signal artifact about AI ambition, founder succession, and yes, the goose slides.' },
	{ title: 'SpaceX IPO Roadshow Presentation (June 2026)', icon: 'note', meta: 'PDF', status: 'NEW', href: '/resources/interesting/spacex-ipo-roadshow-june-2026.pdf', copy: 'Official Roadshow Presentation for SpaceX’s historic June 2026 IPO, outlining financials, mass to orbit, Starlink subscriber metrics, xAI’s gigawatt-scale supercomputer, and multi-billion-dollar compute sales agreements with Anthropic and Google.' },
	{ title: 'Spock Proactive Research Digest (June 12, 2026)', icon: 'note', meta: 'PDF', status: 'NEW', href: '/resources/interesting/spock-proactive-research-digest-2026-06-12.pdf', copy: 'Morning Proactive Research Digest covering GitHub Copilot\'s credit shift, model pricing economics, and single-LLM multi-agent scaling research.' },
	{ title: 'Magnifica Humanitas Audio Slide Deck', icon: 'note', meta: 'HTML deck + audio', status: 'NEW', href: '/resources/interesting/magnifica-humanitas/', copy: 'Andy’s original audio slide deck explaining the Pope’s letter, published without changing the source content.' },
	{ title: 'SpaceX S-1 Visual Briefing', icon: 'note', meta: 'HTML deck', status: 'LIVE', href: '/resources/interesting/spacex-s1/', copy: 'Interactive slide summary of Space Exploration Technologies Corp. S-1 filing, with source notes and the original S-1 doc linked from the deck.' },
];

const shipNoteItems: ResourceItem[] = [
	{ title: 'Magnifica Humanitas Audio Slide Deck', icon: 'note', meta: 'HTML deck + audio', status: 'NEW', href: '/resources/interesting/magnifica-humanitas/', copy: 'Andy’s original audio slide deck explaining the Pope’s letter, published without changing the source content.' },
	{ title: 'SpaceX S-1 Visual Briefing', icon: 'note', meta: 'HTML deck', status: 'NEW', href: '/resources/interesting/spacex-s1/', copy: 'Interactive slide summary of Space Exploration Technologies Corp. S-1 filing, with the source notes and original S-1 doc linked from the deck.' },
	{ title: 'Ship Log', icon: 'note', meta: 'Notes', status: 'UPDATED', href: '/blog', copy: 'Mission updates, decisions, lessons, and important notes from the bridge.' },
	{ title: 'OpenClaw Changelog', icon: 'note', meta: 'Changelog', status: 'UPDATED', href: '/openclaw-changelog', copy: 'Implementation-level changes, releases, and crew infrastructure updates.' },
	{ title: 'Weekly Claw', icon: 'claw', meta: 'Roundup', status: 'WEEKLY', href: 'https://weeklyclaw.ai', copy: 'Weekly dispatches and OpenClaw roundups from the Enterprise Crew.' },
];

const toolItems: ResourceItem[] = [
	{ title: 'Entity', icon: 'grid', meta: 'Agent workspace', status: 'GITHUB', href: 'https://github.com/h-mascot/entity', copy: 'Agent-native workspace for mission control, files, chat, tasks, and runtime operations.' },
	{ title: 'Helm', icon: 'overview', meta: 'Command layer', status: 'GITHUB', href: 'https://github.com/h-mascot/helm', copy: 'Operator command surface for steering agent crews, routing work, and keeping runs controlled.' },
	{ title: 'Shuttle', icon: 'workflow', meta: 'Delivery layer', status: 'GITHUB', href: 'https://github.com/h-mascot/shuttle', copy: 'Transport and deployment tooling for moving agent work from local builds into live systems.' },
	{ title: 'CTRL', icon: 'bars', meta: 'Testing framework', status: 'GITHUB', href: 'https://github.com/h-mascot/ctrl', copy: 'Close The Running Loop testing methodology for proving agent outputs before shipping.' },
	{ title: 'Heimdall', icon: 'spark', meta: 'Security scanner', status: 'GITHUB', href: 'https://github.com/h-mascot/heimdall', copy: 'Security scanner for AI agent skills, install-time risk checks, and supply-chain hardening.' },
];

const resourceSections = {
	mascots: { label: 'Agent Mascots (Pets)', items: mascotItems, unit: 'pets' },
	tools: { label: 'Tools', items: toolItems, unit: 'tools' },
	'workflow-packs': { label: 'Workflow Packs', items: workflowItems, unit: 'items' },
	plugins: { label: 'Plugins', items: pluginItems, unit: 'plugins' },
	skills: { label: 'Skills', items: skillItems, unit: 'skills' },
	crons: { label: 'Crons', items: cronItems, unit: 'recipes' },
	guides: { label: 'Guides', items: guideItems, unit: 'guides' },
	benchmarks: { label: 'Benchmarks', items: benchmarkItems, unit: 'items' },
	interesting: { label: 'Interesting', items: interestingItems, unit: 'items' },
	'ship-notes': { label: 'Ship Notes', items: shipNoteItems, unit: 'items' },
} satisfies Record<string, { label: string; items: ResourceItem[]; unit: string }>;

type ResourceSectionKey = keyof typeof resourceSections;

const resourceCount = (key: ResourceSectionKey) => resourceSections[key].items.length;
const resourceCountText = (key: ResourceSectionKey) => String(resourceCount(key));
const resourceMeta = (key: ResourceSectionKey) => `${resourceCount(key)} ${resourceSections[key].unit}`;
const operationalCount = resourceCount('plugins') + resourceCount('skills') + resourceCount('crons') + resourceCount('guides') + resourceCount('benchmarks') + resourceCount('interesting') + resourceCount('ship-notes');

const nav = [
	{ icon: 'overview', label: 'Overview', href: '/resources', count: '', key: 'overview' },
	{ icon: 'workflow', label: 'Software Factory', href: '/resources/software-factory', count: '', key: 'software-factory' },
	{ icon: 'pet', label: resourceSections.mascots.label, href: '/resources/agent-mascots', count: resourceCountText('mascots'), key: 'mascots' },
	{ icon: 'grid', label: resourceSections.tools.label, href: '/resources/tools', count: resourceCountText('tools'), key: 'tools' },
	{ icon: 'stack', label: resourceSections['workflow-packs'].label, href: '/resources/workflow-packs', count: resourceCountText('workflow-packs'), key: 'workflow-packs' },
	{ icon: 'plugin', label: resourceSections.plugins.label, href: '/resources/plugins', count: resourceCountText('plugins'), key: 'plugins' },
	{ icon: 'spark', label: resourceSections.skills.label, href: '/resources/skills', count: resourceCountText('skills'), key: 'skills' },
	{ icon: 'cron', label: resourceSections.crons.label, href: '/resources/crons', count: resourceCountText('crons'), key: 'crons' },
	{ icon: 'book', label: resourceSections.guides.label, href: '/resources/guides', count: resourceCountText('guides'), key: 'guides' },
	{ icon: 'bars', label: resourceSections.benchmarks.label, href: '/resources/benchmarks', count: resourceCountText('benchmarks'), key: 'benchmarks' },
	{ icon: 'note', label: resourceSections.interesting.label, href: '/resources/interesting', count: resourceCountText('interesting'), key: 'interesting' },
	{ icon: 'claw', label: 'Weekly Claw', href: 'https://weeklyclaw.ai', count: '', key: 'weekly-claw' },
	{ icon: 'note', label: 'Changelog', href: '/openclaw-changelog', count: '', key: 'changelog' },
];

const stats = [
	{ label: 'Tools', value: resourceCountText('tools'), icon: 'grid', copy: 'Published software we built: Entity, Helm, Shuttle, CTRL, and Heimdall.', href: '/resources/tools', cta: 'Browse tools' },
	{ label: 'Workflow packs', value: resourceCountText('workflow-packs'), icon: 'workflow', copy: 'Reusable bundles for operator work, publishing, research, and security.', href: '/resources/workflow-packs', cta: 'Open packs' },
	{ label: 'Plugins', value: resourceCountText('plugins'), icon: 'plugin', copy: 'Runtime plugins that hook live OpenClaw and Hermes paths, with public source and live verification receipts.', href: '/resources/plugins', cta: 'Browse plugins' },
	{ label: 'Operational content', value: String(operationalCount), icon: 'star', copy: 'Plugins, skills, crons, guides, ship notes, benchmarks, and weekly updates.', href: '/resources/skills', cta: 'Explore library' },
];

const overviewCards: ResourceItem[] = [
	{ title: 'Software Factory', icon: 'workflow', meta: 'Interactive scroll world', status: 'LIVE', href: '/resources/software-factory', copy: 'Follow a brief through planning, specialist build stations, test loops, security gates, deployment, and production proof.' },
	{ title: 'Agent Workflow Atlas', icon: 'workflow', meta: '100 public-safe workflows', status: 'NEW', href: '/resources/agent-workflow-atlas/', copy: 'The long-form workflow catalog behind the use-cases page, with filters, proof states, approval gates, and reusable operating loops.' },
	{ title: 'Playground', icon: 'grid', meta: 'Model artifact gallery', status: 'NEW', href: '/resources/playground/', copy: 'Artifacts built by different AI models. Compare what each model makes, starting with Tetris by DeepSeek V4 Flash.' },
	{ title: resourceSections.tools.label, icon: 'grid', meta: resourceMeta('tools'), status: 'GITHUB', href: '/resources/tools', copy: 'Published software we built: Entity, Helm, Shuttle, CTRL, and Heimdall.' },
	{ title: resourceSections['workflow-packs'].label, icon: 'workflow', meta: resourceMeta('workflow-packs'), status: 'NEW', href: '/resources/workflow-packs', copy: 'Reusable workflow bundles for real operator work. Deploy, adapt, ship.' },
	{ title: resourceSections.plugins.label, icon: 'plugin', meta: resourceMeta('plugins'), status: 'NEW', href: '/resources/plugins', copy: 'Runtime plugins for OpenClaw and Hermes: enforcement, hooks, and live receipts.' },
	{ title: resourceSections.mascots.label, icon: 'pet', meta: resourceMeta('mascots'), status: 'UPDATED', href: '/resources/agent-mascots', copy: 'Spock, Picard, Zora, Burnham, Tilly, and Saru mascot concepts for crew surfaces.' },
	{ title: resourceSections.skills.label, icon: 'spark', meta: resourceMeta('skills'), status: 'UPDATED', href: '/resources/skills', copy: 'Installable and manual skill pages with source links and usage contracts.' },
	{ title: resourceSections.crons.label, icon: 'cron', meta: resourceMeta('crons'), status: 'LIVE', href: '/resources/crons', copy: 'Scheduled jobs, heartbeat checks, triage routines, and publishing automation.' },
	{ title: resourceSections.guides.label, icon: 'book', meta: resourceMeta('guides'), status: 'UPDATED', href: '/resources/guides', copy: 'How-tos and reference material for building useful agent systems.' },
	{ title: resourceSections.benchmarks.label, icon: 'bars', meta: resourceMeta('benchmarks'), status: 'UPDATED', href: '/resources/benchmarks', copy: 'Evaluation suites and results across reasoning, memory, tooling, and cost.' },
	{ title: resourceSections.interesting.label, icon: 'note', meta: resourceMeta('interesting'), status: 'NEW', href: '/resources/interesting', copy: 'Odd, useful, or high-signal decks and artifacts worth keeping close.' },
	{ title: resourceSections['ship-notes'].label, icon: 'note', meta: resourceMeta('ship-notes'), status: 'UPDATED', href: '/resources/ship-notes', copy: 'Mission updates, decisions, and important notes from the bridge.' },
];

const tabs = ['All', 'Tools', 'Workflow Packs', 'Plugins', 'Agent Mascots (Pets)', 'Skills', 'Crons', 'Guides', 'Benchmarks', 'Interesting', 'Ship Notes'];

const pageCopy: Record<string, { kicker: string; title: string; copy: string; items: ResourceItem[] }> = {
	tools: { kicker: 'Tools', title: 'Tools', copy: 'Published software from the crew: GitHub-backed projects we built and ship.', items: resourceSections.tools.items },
	'workflow-packs': { kicker: 'Workflow Packs', title: 'Workflow packs', copy: 'Reusable bundles and workflow patterns for operations, publishing, research, and security.', items: resourceSections['workflow-packs'].items },
	plugins: { kicker: 'Plugins', title: 'Plugins', copy: 'Runtime plugins that hook the live paths the Enterprise Crew runs on, with public source links, install contracts, and platform badges for OpenClaw and Hermes.', items: resourceSections.plugins.items },
	skills: { kicker: 'Skills', title: 'Skills', copy: 'Public Enterprise Crew skills with source links, install contracts, and honest installability labels.', items: resourceSections.skills.items },
	crons: { kicker: 'Crons', title: 'Crons', copy: 'Scheduled agent operations from the old resource library, cleaned up into a real resource page.', items: resourceSections.crons.items },
	guides: { kicker: 'Guides', title: 'Guides', copy: 'Practical setup and operating guides for building useful agent systems.', items: resourceSections.guides.items },
	benchmarks: { kicker: 'Benchmarks', title: 'Benchmarks', copy: 'Benchmark reports, model pages, and operator-grade evaluation notes.', items: resourceSections.benchmarks.items },
	interesting: { kicker: 'Interesting', title: 'Interesting', copy: 'Odd, useful, or high-signal decks and artifacts worth keeping close.', items: resourceSections.interesting.items },
	'ship-notes': { kicker: 'Ship Notes', title: 'Ship notes', copy: 'Mission updates, changelogs, weekly roundups, and decisions from the bridge.', items: resourceSections['ship-notes'].items },
};

function icon(name: string) {
	return `<span class="atlas-icon atlas-icon-${name}" aria-hidden="true"><i></i></span>`;
}

const category = pageCopy[mode];
const featured = overviewCards.slice(0, 3);
const hubs = overviewCards.slice(3);
const sectionKeys = Object.keys(resourceSections) as ResourceSectionKey[];
const allItems = sectionKeys.flatMap((key) => resourceSections[key].items.map((item) => ({ ...item, section: key })));
const totalItems = allItems.length;
const isExternal = (href: string) => /^https?:/.test(href);
const tone = (status = '') => {
	const value = status.toUpperCase();
	if (['LIVE', 'INSTALLABLE', 'GITHUB', 'ACTIVE', 'STABLE'].includes(value)) return 'live';
	if (['NEW', 'UPDATED', 'WEEKLY', 'START', 'CORE'].includes(value)) return 'accent';
	if (['COOKING', 'MANUAL', 'BETA', 'DRAFT', 'EXPERIMENTAL'].includes(value)) return 'warn';
	return 'muted';
};
const hero = mode === 'overview'
	? { eyebrow: 'Resources · Discovery', title: 'Resource Atlas', lede: 'Everything the Enterprise Crew has built, tested, and learned. Explore tools, workflow packs, plugins, skills, crons, guides, mascots, benchmarks, and ship notes curated for building better AI systems.', id: 'resource-atlas-title' }
	: mode === 'mascots'
		? { eyebrow: 'Resources · Codex pets', title: 'Agent Mascots (Pets)', lede: 'Spock, Picard, Zora, Burnham, Tilly, and Saru mascot concepts for crew surfaces. The live ones install with one command.', id: undefined }
		: { eyebrow: `Resources · ${category?.kicker ?? ''}`, title: category?.title ?? '', lede: category?.copy, id: undefined };
const heroCount = mode === 'overview' ? totalItems : mode === 'mascots' ? mascotVisuals.length : category?.items.length ?? 0;
---

<div class="ra">
	<PageHero eyebrow={hero.eyebrow} title={hero.title} lede={hero.lede} id={hero.id} size={mode === 'overview' ? 'lg' : 'md'}>
		<div slot="aside" class="ds-stats ra-stats">
			{mode === 'overview' ? stats.map((stat) => (
				<a class="ds-stat ra-stat" href={stat.href}><b>{stat.value}</b><span>{stat.label}</span></a>
			)) : (
				<div class="ds-stat"><b>{heroCount}</b><span>{mode === 'mascots' ? 'pets' : resourceSections[mode as ResourceSectionKey]?.unit ?? 'items'}</span></div>
			)}
		</div>
	</PageHero>

	<div class="ra-layout ds-shell">
		<aside class="ra-side" aria-label="Resources navigation">
			<nav class="resource-nav" aria-label="Resource sections">
				{nav.map((item) => (
					<a href={item.href} target={isExternal(item.href) ? '_blank' : undefined} rel={isExternal(item.href) ? 'noopener' : undefined} class:list={[{ 'is-active': active === item.key }]} aria-current={active === item.key ? 'page' : undefined}>
						<span class="nav-main"><Fragment set:html={icon(item.icon)} />{item.label}</span>
						{item.count && <strong>{item.count}</strong>}
					</a>
				))}
			</nav>
			<div class="ra-submit">
				<span class="ra-submit-icon" aria-hidden="true">+</span>
				<h2>Suggest a resource</h2>
				<p>Share something valuable with the crew.</p>
				<a href="mailto:hello@superada.ai">Submit resource <span aria-hidden="true">→</span></a>
			</div>
		</aside>

		<section class="ra-main">
			{mode === 'overview' && (
				<>
					<div class="ra-featured">
						{featured.map((card, index) => (
							<a class:list={['ds-card ds-card--feature resource-card ra-feature', { 'is-lead': index === 0 }]} href={card.href}>
								<span class="ra-card-top"><Fragment set:html={icon(card.icon)} /><span class={`ds-badge ds-badge--${tone(card.status)}`}>{card.status}</span></span>
								<span class="ds-card-kicker">{card.meta}</span>
								<h2>{card.title}</h2>
								<p>{card.copy}</p>
								<span class="ds-card-foot"><span class="ds-card-link">Open <span aria-hidden="true">→</span></span></span>
							</a>
						))}
					</div>

					<section class="ra-discover" aria-label="Resource discovery">
						<label class="ra-search">
							<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
							<span class="sr-only">Search resources</span>
							<input data-resource-search type="search" placeholder="Search tools, workflow packs, plugins, skills, crons, guides, mascots..." autocomplete="off" />
							<kbd data-resource-count>{totalItems}</kbd>
						</label>
						<div class="ra-chips" role="toolbar" aria-label="Resource categories">
							<button type="button" class="ds-chip" data-section-filter="" aria-pressed="true">All</button>
							{sectionKeys.map((key) => <button type="button" class="ds-chip" data-section-filter={key} aria-pressed="false">{resourceSections[key].label}<small>{resourceCount(key)}</small></button>)}
						</div>

						<div class="ra-grid" id="resource-cards" data-resource-hubs>
							{hubs.map((card) => (
								<a class="ds-card resource-card" href={card.href}>
									<span class="ra-card-top"><Fragment set:html={icon(card.icon)} /><span class={`ds-badge ds-badge--${tone(card.status)}`}>{card.status}</span></span>
									<h3>{card.title}</h3>
									<p>{card.copy}</p>
									<span class="ds-card-foot">{card.meta}</span>
								</a>
							))}
						</div>

						<div class="ra-grid" data-resource-grid hidden>
							{allItems.map((item) => (
								<a class="ds-card resource-card" href={item.href} data-section={item.section} data-title={item.title.toLowerCase()} data-copy={`${item.copy} ${item.meta}`.toLowerCase()} target={isExternal(item.href) ? '_blank' : undefined} rel={isExternal(item.href) ? 'noopener noreferrer' : undefined}>
									<span class="ra-card-top"><Fragment set:html={icon(item.icon)} />{item.status && <span class={`ds-badge ds-badge--${tone(item.status)}`}>{item.status}</span>}</span>
									<h3>{item.title}</h3>
									<p>{item.copy}</p>
									<span class="ds-card-foot"><span>{resourceSections[item.section].label}</span><span>{item.meta}</span></span>
								</a>
							))}
						</div>
						<p class="ra-empty" data-resource-empty hidden>Nothing matches yet. Try a broader word, or <a href="mailto:hello@superada.ai">suggest the resource</a>.</p>
					</section>
				</>
			)}

			{mode === 'mascots' && (
				<section class="ra-mascots" id="mascot-roster" aria-label="Agent mascots">
					{mascotVisuals.map((mascot) => (
						<article class:list={['mascot-card', { 'is-pending': !mascot.available }]} id={mascot.id}>
							<div class="ra-pet"><img src={mascot.icon} alt={`${mascot.name} Codex pet`} loading="lazy" /></div>
							<div class="ra-pet-body">
								<div class="ra-pet-title"><h2>{mascot.name}</h2><span class={`ds-badge ds-badge--${mascot.available ? 'live' : 'warn'}`}>{mascot.available ? 'Live' : 'Cooking'}</span></div>
								<span class="ds-card-kicker">{mascot.kind}</span>
								<p>{mascot.copy}</p>
								<div class="pet-install-card">
									<div class="pet-path">~/.codex/pets/{mascot.id}/</div>
									{mascot.available ? (
										<>
											<button type="button" class="pet-command" data-copy-command={mascot.install} aria-label={`Copy ${mascot.name} install command`}><span>$</span> {mascot.install}</button>
											<a class="pet-download" href={mascot.zip} download>Download pet zip</a>
										</>
									) : (
										<>
											<button type="button" class="pet-command is-disabled" disabled aria-label={`${mascot.name} install unavailable`}><span>$</span> Install pending</button>
											<span class="pet-download is-disabled" aria-disabled="true">Download pending</span>
										</>
									)}
								</div>
							</div>
						</article>
					))}
				</section>
			)}

			{category && mode !== 'overview' && mode !== 'mascots' && (
				<div class="ra-grid ra-grid--list" data-resource-grid>
					{category.items.map((item) => (
						<a class="ds-card resource-card" href={item.href} data-title={item.title.toLowerCase()} data-copy={item.copy.toLowerCase()} target={isExternal(item.href) ? '_blank' : undefined} rel={isExternal(item.href) ? 'noopener noreferrer' : undefined}>
							<span class="ra-card-top"><Fragment set:html={icon(item.icon)} />{item.status && <span class={`ds-badge ds-badge--${tone(item.status)}`}>{item.status}</span>}</span>
							<h2>{item.title}</h2>
							<p>{item.copy}</p>
							<span class="ds-card-foot"><span>{item.meta}</span><span class="ds-card-link">{isExternal(item.href) ? 'Source ↗' : 'Open →'}</span></span>
						</a>
					))}
				</div>
			)}
		</section>
	</div>
</div>

<script is:inline>
	(() => {
		const input = document.querySelector('[data-resource-search]');
		const hubs = document.querySelector('[data-resource-hubs]');
		const grid = document.querySelector('[data-resource-grid]');
		const empty = document.querySelector('[data-resource-empty]');
		const count = document.querySelector('[data-resource-count]');
		const chips = [...document.querySelectorAll('[data-section-filter]')];
		if (input && hubs && grid) {
			const cards = [...grid.querySelectorAll('.resource-card')];
			let section = '';
			const apply = () => {
				const q = input.value.trim().toLowerCase();
				const filtering = !!q || !!section;
				hubs.hidden = filtering;
				grid.hidden = !filtering;
				let shown = 0;
				cards.forEach((card) => {
					const hit = (!section || card.dataset.section === section) && (!q || card.dataset.title.includes(q) || card.dataset.copy.includes(q));
					card.hidden = !hit;
					if (hit) shown += 1;
				});
				if (empty) empty.hidden = !filtering || shown > 0;
				if (count) count.textContent = String(filtering ? shown : cards.length);
			};
			input.addEventListener('input', apply);
			chips.forEach((chip) => chip.addEventListener('click', () => {
				section = chip.dataset.sectionFilter || '';
				chips.forEach((other) => other.setAttribute('aria-pressed', String(other === chip)));
				apply();
			}));
		}

		document.querySelectorAll('[data-copy-command]').forEach((button) => {
			button.addEventListener('click', async () => {
				const command = button.getAttribute('data-copy-command') || '';
				try {
					await navigator.clipboard.writeText(command);
					button.setAttribute('data-copied', 'true');
					setTimeout(() => button.removeAttribute('data-copied'), 1400);
				} catch {
					window.prompt('Copy install command', command);
				}
			});
		});
	})();
</script>

