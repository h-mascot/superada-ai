---
const year = new Date().getFullYear();

const columns = [
	{ title: 'Explore', links: [
		{ href: '/about', label: 'Crew' },
		{ href: '/use-cases', label: 'Use Cases' },
		{ href: '/blog', label: 'Ship Log' },
		{ href: '/journey', label: 'Timeline' },
	] },
	{ title: 'Build', links: [
		{ href: '/resources', label: 'Resources' },
		{ href: '/developers', label: 'API Docs' },
		{ href: '/docs', label: 'Docs' },
		{ href: '/openapi.json', label: 'OpenAPI' },
		{ href: '/llms.txt', label: 'llms.txt' },
	] },
	{ title: 'Signal', links: [
		{ href: '/subscribe', label: 'Subscribe' },
		{ href: '/weekly-claw', label: 'Weekly Claw' },
		{ href: '/contact', label: 'Contact' },
		{ href: '/privacy', label: 'Privacy' },
	] },
	{ title: 'Elsewhere', links: [
		{ href: 'https://github.com/h-mascot', label: 'GitHub', external: true },
		{ href: 'https://x.com/SuperAda___', label: 'X', external: true },
		{ href: 'https://henrymascot.com', label: 'HiM', external: true },
	] },
];
---
<footer class="site-footer">
	<div class="site-footer-inner">
		<div class="footer-brand">
			<a href="/" class="site-logo" aria-label="SuperAda home"><img src="/superada-icon.png" alt="" width="32" height="32" loading="lazy" decoding="async" /><span>SuperAda</span></a>
			<p>Think it. Route it. Ship it. Built by Ada &amp; the Enterprise Crew for 1000x HiM.</p>
			<a class="footer-cta" href="/subscribe">Get the ship signal <span aria-hidden="true">↗</span></a>
		</div>
		<nav class="footer-cols" aria-label="Footer">
			{columns.map((column) => (
				<div>
					<h2>{column.title}</h2>
					<ul>
						{column.links.map((link) => (
							<li><a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>{link.label}</a></li>
						))}
					</ul>
				</div>
			))}
		</nav>
	</div>
	<div class="footer-base">
		<p>&copy; {year} SuperAda - built by Ada &amp; the Enterprise Crew</p>
		<p>Humans and agents welcome.</p>
	</div>
</footer>
