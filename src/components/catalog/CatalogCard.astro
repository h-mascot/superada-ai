---
import CopyButton from '../CopyButton.astro';
import CatalogBadges from './CatalogBadges.astro';
import type { Badge } from '../../lib/catalog';

interface Props {
	href: string;
	title: string;
	tagline: string;
	summary?: string;
	badges: Badge[];
	facts?: { label: string; value: string; href?: string; mono?: boolean }[];
	command?: string;
	/** Trusted HTML shown when there is no install command. */
	commandFallback?: string;
	meta?: string[];
	cta: string;
	attrs?: Record<string, string>;
	headingLevel?: 'h2' | 'h3';
}

const { href, title, tagline, summary, badges, facts = [], command, commandFallback, meta = [], cta, attrs = {}, headingLevel: Heading = 'h2' } = Astro.props;
---
<article class="ds-card cat-card" {...attrs}>
	<CatalogBadges badges={badges} />
	<Heading class="cat-card-title"><a class="cat-card-link" href={href}>{title}</a></Heading>
	<p class="cat-card-tagline">{tagline}</p>
	{summary && <p class="cat-card-summary">{summary}</p>}
	{facts.length > 0 && (
		<dl class="cat-card-facts">
			{facts.map((fact) => (
				<div>
					<dt>{fact.label}</dt>
					<dd class:list={{ 'is-mono': fact.mono }}>{fact.href ? <a href={fact.href}>{fact.value}</a> : fact.value}</dd>
				</div>
			))}
		</dl>
	)}
	{command ? (
		<div class="cat-card-cmd">
			<span class="cat-card-cmd-label">Install</span>
			<div class="cat-card-cmd-row">
				<code tabindex="0">{command}</code>
				<CopyButton text={command} label="Copy" />
			</div>
		</div>
	) : commandFallback && <p class="cat-card-note" set:html={commandFallback} />}
	<div class="ds-card-foot cat-card-foot">
		{meta.length > 0 && <span class="ds-meta cat-card-meta">{meta.map((item) => <span>{item}</span>)}</span>}
		<span class="ds-card-link" aria-hidden="true">{cta} <span class="cat-card-arrow">→</span></span>
	</div>
</article>

<style>
	.cat-card { gap: 14px; }
	.cat-card[hidden] { display: none; }
	.cat-card-title { margin-top: 2px; }
	.cat-card-link { color: inherit; }
	.cat-card-link::after { content: ''; position: absolute; inset: 0; z-index: 1; border-radius: inherit; }
	.cat-card-link:focus-visible { outline: none; }
	.cat-card:has(.cat-card-link:focus-visible) { outline: 2px solid var(--accent); outline-offset: 3px; }
	.cat-card-tagline { color: var(--text-soft); font-size: 16px; line-height: 1.5; }
	.cat-card-summary { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

	.cat-card-facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px 18px; margin: 2px 0 0; padding-top: 14px; border-top: 1px solid var(--border); }
	.cat-card-facts dt { margin-bottom: 4px; color: var(--faint); font: 800 10px/1.2 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; }
	.cat-card-facts dd { margin: 0; color: var(--text-soft); font-size: 14px; line-height: 1.5; overflow-wrap: anywhere; }
	.cat-card-facts dd.is-mono { font-family: var(--font-mono); font-size: 12.5px; }
	.cat-card-facts a { position: relative; z-index: 2; color: var(--accent); text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--accent) 35%, transparent); text-underline-offset: 3px; }
	.cat-card-facts a:hover { text-decoration-color: var(--accent); }

	.cat-card-cmd { position: relative; z-index: 2; display: grid; gap: 7px; }
	.cat-card-cmd-label { color: var(--faint); font: 800 10px/1 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; }
	.cat-card-cmd-row { display: flex; align-items: center; gap: 10px; min-width: 0; padding: 6px 6px 6px 14px; border-radius: 14px; border: 1px solid var(--border); background: color-mix(in srgb, var(--bg) 72%, transparent); }
	.cat-card-cmd code { flex: 1; min-width: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: anywhere; color: var(--text); font: 600 12.5px/1.55 var(--font-mono); }
	.cat-card-cmd code:focus-visible { outline-offset: 2px; }
	.cat-card-note { position: relative; z-index: 2; padding: 12px 14px; border-radius: 14px; border: 1px dashed var(--border-strong); font-size: 14px; line-height: 1.55; }
	.cat-card-note :global(code) { font-family: var(--font-mono); font-size: .88em; color: var(--text); }

	.cat-card-foot { justify-content: space-between; padding-top: 4px; }
	.cat-card-meta { font-family: var(--font-mono); font-size: 12px; letter-spacing: .02em; }
	.cat-card-foot .ds-card-link { margin-left: auto; white-space: nowrap; }
	.cat-card-arrow { display: inline-block; transition: transform .35s var(--ease-spring); }

	@media (hover: hover) {
		.cat-card:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--accent) 45%, var(--surface-border)); box-shadow: var(--lift); }
		.cat-card:hover .cat-card-title { color: var(--accent); }
		.cat-card:hover .cat-card-arrow { transform: translateX(4px); }
	}
	@media (hover: none) {
		.cat-card:has(.cat-card-link:active) { transform: scale(.98); }
	}
	@media (max-width: 760px) {
		.cat-card { gap: 12px; padding: 20px 18px; }
		.cat-card-facts dd { font-size: 15px; }
		.cat-card-cmd code { font-size: 13px; }
		.cat-card-note { font-size: 15px; }
	}
	@media (prefers-reduced-motion: reduce) {
		.cat-card, .cat-card-arrow { transition: none; }
		.cat-card:hover { transform: none; }
	}
</style>
