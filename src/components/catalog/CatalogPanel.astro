---
interface Props {
	title: string;
	id: string;
	eyebrow?: string;
	tone?: 'accent';
}

const { title, id, eyebrow, tone } = Astro.props;
const hasAction = Astro.slots.has('action');
---
<section class:list={['ds-panel cat-panel', tone && `cat-panel--${tone}`]} id={id} aria-labelledby={`${id}-title`}>
	<header class="cat-panel-head">
		<div class="cat-panel-heading">
			{eyebrow && <span class="cat-panel-eyebrow">{eyebrow}</span>}
			<h2 id={`${id}-title`}>{title}</h2>
		</div>
		{hasAction && <div class="cat-panel-action"><slot name="action" /></div>}
	</header>
	<div class="cat-panel-body"><slot /></div>
</section>

<style>
	.cat-panel { min-width: 0; scroll-margin-top: calc(var(--chrome-top) + 24px); }
	.cat-panel--accent { border-color: color-mix(in srgb, var(--accent) 45%, var(--surface-border)); background: radial-gradient(circle at 0% 0%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 50%), var(--surface); }
	.cat-panel-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 20px; }
	.cat-panel-heading { display: grid; gap: 10px; min-width: 0; }
	.cat-panel-eyebrow { color: var(--accent); font: 800 10.5px/1 var(--font-mono); letter-spacing: .18em; text-transform: uppercase; }
	.cat-panel h2 { font: 500 clamp(24px, 2.3vw, 32px)/1.08 var(--font-display); letter-spacing: -.035em; color: var(--text); text-wrap: balance; }
	.cat-panel-action { flex: 0 0 auto; }

	.cat-panel-body { display: grid; gap: 18px; min-width: 0; color: var(--text-soft); font-size: 16px; line-height: 1.7; }
	.cat-panel-body > :global(*) { min-width: 0; }
	.cat-panel-body :global(p) { text-wrap: pretty; }
	.cat-panel-body :global(.cat-muted) { color: var(--muted); font-size: 15px; }
	.cat-panel-body :global(a:not(.ds-btn):not(.ds-card)) { color: var(--accent); text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--accent) 35%, transparent); text-underline-offset: 3px; overflow-wrap: anywhere; transition: text-decoration-color .2s ease; }
	.cat-panel-body :global(a:not(.ds-btn):not(.ds-card):hover) { text-decoration-color: var(--accent); }
	.cat-panel-body :global(p code) { padding: .1em .4em; border-radius: 6px; border: 1px solid var(--border); background: var(--panel-soft); color: var(--text); font: 600 .84em var(--font-mono); overflow-wrap: anywhere; }
	.cat-panel-body :global(h3) { margin-top: 6px; color: var(--faint); font: 800 10.5px/1.2 var(--font-mono); letter-spacing: .16em; text-transform: uppercase; }

	@media (max-width: 760px) {
		.cat-panel { padding: 22px 18px; border-radius: var(--radius-lg); }
		.cat-panel-head { margin-bottom: 16px; }
		.cat-panel-body { font-size: 16px; gap: 16px; }
	}
</style>
