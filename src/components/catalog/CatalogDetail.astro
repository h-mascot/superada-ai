---
interface Props {
	sideLabel: string;
}

const { sideLabel } = Astro.props;
---
<div class="ds-shell cat-detail">
	<div class="cat-detail-main"><slot /></div>
	<aside class="cat-detail-side" aria-label={sideLabel}><slot name="side" /></aside>
</div>

<style>
	.cat-detail { display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, 360px); gap: clamp(24px, 3vw, 40px); align-items: start; }
	.cat-detail-main { display: grid; gap: 20px; min-width: 0; }
	.cat-detail-side { position: sticky; top: calc(var(--chrome-top) + 24px); display: grid; gap: 16px; min-width: 0; max-height: calc(100vh - var(--chrome-top) - 48px); overflow-y: auto; overscroll-behavior: contain; scrollbar-width: none; border-radius: var(--radius-lg); }
	.cat-detail-side::-webkit-scrollbar { display: none; }

	@media (max-width: 980px) {
		.cat-detail { grid-template-columns: minmax(0, 1fr); gap: 16px; }
		.cat-detail-main { display: contents; }
		.cat-detail-side { display: contents; }
		.cat-detail-side > :global(:first-child) { order: -1; }
		.cat-detail-side > :global(:not(:first-child)) { order: 1; }
	}
</style>
