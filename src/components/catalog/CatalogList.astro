---
interface Props {
	items: string[];
	marker?: 'check' | 'dot' | 'warn';
	mono?: boolean;
}

const { items, marker = 'dot', mono = false } = Astro.props;
---
<ul class:list={['cat-list', `cat-list--${marker}`, { 'is-mono': mono }]}>
	{items.map((item) => <li>{mono ? <code>{item}</code> : item}</li>)}
</ul>

<style>
	.cat-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
	.cat-list li { position: relative; padding-left: 28px; color: var(--text-soft); font-size: 15.5px; line-height: 1.6; }
	.cat-list li::before { content: ''; position: absolute; left: 6px; top: .62em; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 10px var(--glow); }
	.cat-list--check li::before { content: '✓'; left: 0; top: .1em; width: 18px; height: 18px; display: grid; place-items: center; border-radius: 6px; background: var(--accent-soft); box-shadow: none; color: var(--accent); font: 800 11px/1 var(--font-mono); }
	.cat-list--warn li::before { background: #e8b04a; box-shadow: none; border-radius: 2px; transform: rotate(45deg); }
	.cat-list.is-mono { gap: 6px; }
	.cat-list.is-mono li::before { width: 5px; height: 5px; top: .7em; background: var(--faint); box-shadow: none; }
	.cat-list code { color: var(--text-soft); font: 600 13px/1.6 var(--font-mono); white-space: pre-wrap; overflow-wrap: anywhere; }
</style>
