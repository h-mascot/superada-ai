---
import type { BadgeTone } from '../../lib/catalog';

interface Props {
	items: { value: number | string; label: string; tone?: BadgeTone }[];
	caption?: string;
	label?: string;
}

const { items, caption, label = 'Catalog at a glance' } = Astro.props;
---
<div class="cat-stats" role="group" aria-label={label}>
	<div class="ds-stats cat-stats-grid">
		{items.map((item) => (
			<div class="ds-stat">
				<b>{item.value}</b>
				<span class:list={['cat-stat-label', item.tone && `is-${item.tone}`]}>{item.label}</span>
			</div>
		))}
	</div>
	{caption && <p class="cat-stats-caption">{caption}</p>}
</div>

<style>
	.cat-stats { display: grid; gap: 18px; padding: clamp(20px, 2.4vw, 30px); border-radius: var(--radius-lg); border: 1px solid var(--surface-border); background: radial-gradient(circle at 100% 0%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 55%), var(--surface); }
	.cat-stats-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0; }
	.cat-stats-grid .ds-stat { padding: 16px 0 16px 18px; border-left: 1px solid var(--border); }
	.cat-stats-grid .ds-stat:nth-child(odd) { padding-left: 0; border-left: 0; }
	.cat-stats-grid .ds-stat:nth-child(n + 3) { border-top: 1px solid var(--border); }
	.cat-stats-grid .ds-stat:nth-child(-n + 2) { padding-top: 0; }
	.cat-stats-grid .ds-stat b { font-size: clamp(40px, 4vw, 56px); }
	.cat-stat-label { display: inline-flex; align-items: center; gap: 7px; }
	.cat-stat-label[class*='is-']::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; flex: 0 0 auto; }
	.cat-stat-label.is-live { color: var(--success); }
	.cat-stat-label.is-accent { color: var(--accent); }
	.cat-stat-label.is-info { color: var(--accent-2); }
	.cat-stat-label.is-warn { color: #e8b04a; }
	.cat-stats-caption { color: var(--muted); font-size: 13.5px; line-height: 1.55; }
	@media (max-width: 760px) {
		.cat-stats { padding: 18px 20px; }
		.cat-stats-grid .ds-stat { padding: 12px 0 12px 16px; }
		.cat-stats-grid .ds-stat b { font-size: 38px; }
		.cat-stats-caption { font-size: 15px; }
	}
</style>
