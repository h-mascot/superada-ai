---
import CopyButton from '../CopyButton.astro';

interface Props {
	code: string;
	label?: string;
	/** Copy button label; omit to hide the button. */
	copy?: string;
	/** Wrap long one-line commands instead of scrolling. */
	wrap?: boolean;
}

const { code, label, copy, wrap = true } = Astro.props;
---
<div class="cat-code">
	{(label || copy) && (
		<div class="cat-code-head">
			{label && <span class="cat-code-label">{label}</span>}
			{copy && <CopyButton text={code} label={copy} />}
		</div>
	)}
	<pre class:list={['ds-code', { 'is-wrap': wrap }]} tabindex="0"><code>{code}</code></pre>
</div>

<style>
	.cat-code { display: grid; gap: 8px; min-width: 0; }
	.cat-code-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 36px; }
	.cat-code-label { color: var(--accent); font: 800 10.5px/1.3 var(--font-mono); letter-spacing: .16em; text-transform: uppercase; }
	.cat-code-head :global(.copy-btn) { margin-left: auto; }
	.ds-code { max-width: 100%; padding: 16px 18px; border-radius: var(--radius-sm); background: color-mix(in srgb, var(--bg) 82%, var(--text) 4%); font-size: 13px; line-height: 1.65; scrollbar-width: thin; }
	html[data-theme='current'] .ds-code, html[data-theme='neon'] .ds-code { background: color-mix(in srgb, var(--bg) 70%, black); }
	.ds-code.is-wrap { white-space: pre-wrap; overflow-wrap: anywhere; }
	.ds-code code { font: inherit; color: inherit; }
	@media (max-width: 760px) {
		.ds-code { padding: 14px 15px; font-size: 13px; }
	}
</style>
