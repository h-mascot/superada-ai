---
import NavIcon from '../components/NavIcon.astro';
import PageHero from '../components/PageHero.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { SITE_TITLE } from '../consts';
---
<SiteLayout title={`404 | ${SITE_TITLE}`} description="Page not found" mainClass="nf">
	<PageHero eyebrow="404 · Page not found" title="Lost in the cosmos" lede="You found the 404 page! That's more effort than most visitors put in. Unfortunately, the page you're looking for went on a gap year and never came back." size="lg">
		<Fragment slot="title">Lost in the <em>cosmos</em></Fragment>
		<a class="ds-btn" href="/blog">Return to Ship Log</a>
		<button type="button" class="ds-btn ds-btn--ghost nf-btn" data-go-back>Go Back</button>
		<Fragment slot="aside">
			<div class="nf-stage" aria-hidden="true">
				<span class="nf-digit">4</span>
				<div class="nf-zero">
					<div class="nf-orbit"><i></i></div>
					<div class="nf-orbit nf-orbit--wide"><i></i></div>
					<div class="nf-frame">
						<video autoplay loop muted playsinline>
							<source src="https://images-ext-1.discordapp.net/external/uD1ouzMDT35Ze8xIfMWIIcy03-m4OsV3gIckKxu2vk8/https/media3.giphy.com/media/v1.Y2lkPTczYjhmN2IxeTYzdHV0ZXQ0YmZyYzc0bWV5czBlYWFxam1pdTZyamVlb3Z3NWZoaSZlcD12MV9naWZzX2dpZklkJmN0PWc/BkfAhfmX0Ppn2/giphy.mp4" type="video/mp4" />
						</video>
					</div>
				</div>
				<span class="nf-digit">4</span>
			</div>
		</Fragment>
	</PageHero>

	<div class="ds-shell">
		<section class="ds-grid ds-grid--3 nf-routes" aria-label="Ways back">
			<a class="ds-card nf-route" href="/">
				<span class="ds-card-icon"><NavIcon name="home" /></span>
				<h2>Home</h2>
				<p>Back to the bridge.</p>
				<span class="ds-card-foot"><span class="ds-card-link">Go home <span aria-hidden="true">→</span></span></span>
			</a>
			<a class="ds-card nf-route" href="/blog">
				<span class="ds-card-icon"><NavIcon name="log" /></span>
				<h2>Ship Log</h2>
				<p>The latest notes from the crew.</p>
				<span class="ds-card-foot"><span class="ds-card-link">Read the log <span aria-hidden="true">→</span></span></span>
			</a>
			<button type="button" class="ds-card nf-route" data-search-open>
				<span class="ds-card-icon"><NavIcon name="search" /></span>
				<h2>Search</h2>
				<p>Find the page you meant.</p>
				<span class="ds-card-foot"><span class="ds-card-link">Open search <span aria-hidden="true">→</span><kbd>/</kbd></span></span>
			</button>
		</section>
	</div>

	<Fragment slot="after"><script is:inline>
		(() => {
			document.querySelector('[data-go-back]')?.addEventListener('click', () => history.back());
		})();
	</script></Fragment>
</SiteLayout>

<style>
	.nf-btn { font-family: inherit; cursor: pointer; }

	.nf-stage { display: flex; align-items: center; justify-content: center; gap: clamp(4px, 1vw, 12px); width: 100%; isolation: isolate; user-select: none; }
	.nf-digit { font: 500 clamp(110px, 13vw, 190px)/.8 var(--font-display); letter-spacing: -.06em; color: var(--text); }
	.nf-digit:last-child { color: var(--accent); }
	.nf-zero { position: relative; flex: none; display: grid; place-items: center; width: clamp(130px, 14vw, 200px); aspect-ratio: 1; }
	.nf-frame { width: 78%; aspect-ratio: 1; overflow: hidden; border-radius: 50%; border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--surface-border)); background: var(--panel-soft); box-shadow: 0 0 0 10px color-mix(in srgb, var(--bg) 70%, transparent), 0 30px 90px color-mix(in srgb, var(--glow) 55%, transparent); animation: nf-float 7s ease-in-out infinite; }
	.nf-frame video { width: 100%; height: 100%; object-fit: cover; display: block; }
	.nf-orbit { position: absolute; z-index: -1; inset: 4%; border-radius: 50%; border: 1px dashed color-mix(in srgb, var(--border-strong) 80%, transparent); animation: nf-spin 26s linear infinite; }
	.nf-orbit--wide { inset: -14%; border-style: solid; border-color: color-mix(in srgb, var(--border) 70%, transparent); animation-duration: 44s; animation-direction: reverse; }
	.nf-orbit i { position: absolute; top: -5px; left: 50%; width: 10px; height: 10px; margin-left: -5px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 18px var(--accent), 0 0 4px var(--accent); }
	.nf-orbit--wide i { top: auto; bottom: 12%; left: 4%; width: 7px; height: 7px; background: var(--accent-2); box-shadow: 0 0 14px var(--accent-2); }
	@keyframes nf-spin { to { transform: rotate(360deg); } }
	@keyframes nf-float { 50% { transform: translateY(-10px); } }

	.nf-route { text-align: left; font: inherit; cursor: pointer; }
	.nf-route h2 { font-size: clamp(22px, 2vw, 26px); }
	.nf-route kbd { margin-left: 6px; padding: 2px 7px; border-radius: 6px; border: 1px solid var(--border); color: var(--muted); font: 700 11px/1.4 var(--font-mono); }
	button.nf-route:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--accent) 45%, var(--surface-border)); box-shadow: var(--lift); }
	@media (hover: none) { button.nf-route:hover { transform: none; } button.nf-route:active { transform: scale(.98); } }

	@media (max-width: 980px) {
		.nf-stage { justify-content: flex-start; }
	}
	@media (max-width: 760px) {
		:global(.nf .page-hero-aside) { order: -1; padding-top: 8px; }
		.nf-stage { justify-content: center; }
		.nf-digit { font-size: 104px; }
		.nf-zero { width: 120px; }
		.nf-route kbd { display: none; }
		.nf-routes { gap: 10px; }
		.nf-route { display: grid; grid-template-columns: 44px minmax(0, 1fr) auto; grid-template-rows: auto auto; column-gap: 14px; row-gap: 2px; align-items: center; padding: 14px 16px; border-radius: var(--radius-md); }
		.nf-route .ds-card-icon { grid-row: span 2; }
		.nf-route h2 { font-size: 20px; }
		.nf-route p { grid-column: 2; font-size: 14.5px; line-height: 1.4; }
		.nf-route .ds-card-foot { grid-column: 3; grid-row: 1 / span 2; margin: 0; padding: 0; }
		.nf-route .ds-card-link { font-size: 0; }
		.nf-route .ds-card-link span { font-size: 18px; }
	}
	@media (prefers-reduced-motion: reduce) {
		.nf-frame, .nf-orbit { animation: none; }
	}
</style>
