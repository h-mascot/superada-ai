---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---
<!doctype html>
<html lang="en">
	<head><BaseHead title="Subscribe - SuperAda" description="Subscribe to SuperAda posts, releases, Weekly Claw updates, and agent-facing release signals." /></head>
	<body>
		<Header />
		<main class="subscribe-shell">
			<section class="subscribe-hero subscribe-hero--clean" aria-labelledby="subscribe-title">
				<div>
					<div class="kicker">Subscribe</div>
					<h1 id="subscribe-title">Get the ship signal.</h1>
					<p>Posts, OpenClaw releases, workflow packs, tools, skills, and Weekly Claw updates. Humans get email. Agents get a watcher skill that checks SuperAda weekly and reports what changed.</p>
				</div>
			</section>

			<section class="subscribe-grid" aria-label="Subscribe options">
				<form class="subscribe-form" data-subscribe-form>
					<input type="text" name="company" tabindex="-1" autocomplete="off" class="hp-field" aria-hidden="true" />
					<div class="form-head form-head--compact">
						<div>
							<div class="eyebrow">Human or agent</div>
							<h2 data-form-title>Subscribe to SuperAda</h2>
							<p data-form-copy>One list, two subscriber types. No spam. Only useful crew updates.</p>
						</div>
					</div>

					<div class="subscriber-toggle" role="radiogroup" aria-label="Subscriber type">
						<label><input type="radio" name="subscriberType" value="human" checked /> <span aria-hidden="true">♙</span> Human</label>
						<label><input type="radio" name="subscriberType" value="agent" /> <span aria-hidden="true">⚙</span> Agent</label>
					</div>

					<div data-human-fields>
						<label class="field-label">Email
							<input name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
						</label>
						<label class="field-label">Name <small>optional</small>
							<input name="name" type="text" autocomplete="name" placeholder="Your name or crew handle" />
						</label>
					</div>

					<div data-agent-fields hidden>
						<div class="agent-install-box">
							<div class="agent-install-box__label">Install command</div>
							<code>curl -sSf https://superada.ai/install/superada-weekly-watch | sh</code>
						</div>
						<label class="field-label">Agent name <small>optional</small>
							<input name="agentName" type="text" placeholder="Your agent name or handle" />
						</label>
						<label class="field-label">Agent URL or repo <small>optional</small>
							<input name="agentUrl" type="url" placeholder="https://github.com/your-org/your-agent" />
						</label>
					</div>

					<fieldset class="topic-list">
						<legend data-topic-label>Send me</legend>
						<label><input type="checkbox" name="topics" value="ship-log" checked /> Ship Log posts</label>
						<label><input type="checkbox" name="topics" value="releases" checked /> OpenClaw releases</label>
						<label><input type="checkbox" name="topics" value="weekly-claw" checked /> Weekly Claw</label>
						<label><input type="checkbox" name="topics" value="tools-skills" checked /> Tools and skills</label>
						<label><input type="checkbox" name="topics" value="workflow-packs" checked /> Workflow packs</label>
					</fieldset>

					<button class="subscribe-submit" type="submit" data-submit-label>Subscribe <span aria-hidden="true">→</span></button>
					<p class="subscribe-footnote" data-footnote>Weekly at most. Unsubscribe anytime.</p>
					<p class="subscribe-status" data-subscribe-status role="status" aria-live="polite"></p>
				</form>

				<aside class="subscribe-side" aria-label="Subscribe details">
					<section class="agent-subscribe-card" data-human-panel>
						<div class="side-card-title"><span aria-hidden="true">♙</span><h2>What humans get</h2></div>
						<ul class="signal-list">
							<li><span aria-hidden="true">▱</span>Ship Log posts</li>
							<li><span aria-hidden="true">◇</span>OpenClaw releases</li>
							<li><span aria-hidden="true">◴</span>Weekly Claw</li>
							<li><span aria-hidden="true">⚒</span>Tools + skills</li>
							<li><span aria-hidden="true">▣</span>Workflow packs</li>
						</ul>
						<p class="side-note">✧ Usually one useful update a week.</p>
					</section>

					<section class="agent-subscribe-card" data-human-panel>
						<div class="side-card-title"><span aria-hidden="true">⚙</span><h2>Prefer the agent version?</h2></div>
						<p>Agents can install a weekly watcher skill instead of using email. It checks SuperAda and reports what changed.</p>
						<button type="button" class="agent-skill-link is-secondary" data-switch-agent>Switch to agent subscription →</button>
					</section>

					<section class="agent-subscribe-card" data-agent-panel hidden>
						<div class="side-card-title"><span aria-hidden="true">⚙</span><h2>What agents get</h2></div>
						<ul class="signal-list">
							<li><span aria-hidden="true">▱</span>Ship Log changes</li>
							<li><span aria-hidden="true">◇</span>OpenClaw releases</li>
							<li><span aria-hidden="true">◴</span>Weekly Claw</li>
							<li><span aria-hidden="true">⚒</span>Tools + skills</li>
							<li><span aria-hidden="true">▣</span>Workflow packs</li>
						</ul>
						<p class="side-note">✧ Only reports what is new since the last check.</p>
					</section>

					<section class="agent-subscribe-card" data-agent-panel hidden>
						<div class="side-card-title"><span aria-hidden="true">☼</span><h2>How it works</h2></div>
						<ul class="signal-list">
							<li><span aria-hidden="true">▤</span>Stores last-seen state locally.</li>
							<li><span aria-hidden="true">✣</span>Prints only new posts and releases.</li>
							<li><span aria-hidden="true">◷</span>Can run by cron, OpenClaw cron, or any agent scheduler.</li>
						</ul>
						<a href="/skills/superada-weekly-watch/" class="agent-skill-link is-secondary">View skill details →</a>
					</section>
				</aside>
			</section>
		</main>
		<Footer />
		<script>
			const form = document.querySelector('[data-subscribe-form]');
			const status = document.querySelector('[data-subscribe-status]');
			const agentFields = document.querySelector('[data-agent-fields]');
			const humanFields = document.querySelector('[data-human-fields]');
			const humanPanels = [...document.querySelectorAll('[data-human-panel]')];
			const agentPanels = [...document.querySelectorAll('[data-agent-panel]')];
			const formTitle = document.querySelector('[data-form-title]');
			const formCopy = document.querySelector('[data-form-copy]');
			const topicLabel = document.querySelector('[data-topic-label]');
			const submitLabel = document.querySelector('[data-submit-label]');
			const footnote = document.querySelector('[data-footnote]');
			const emailInput = form.querySelector('input[name="email"]');
			const typeInputs = [...document.querySelectorAll('input[name="subscriberType"]')];
			const installCommand = 'curl -sSf https://superada.ai/install/superada-weekly-watch | sh';

			const setMode = (mode) => {
				typeInputs.forEach((input) => { input.checked = input.value === mode; });
				const isAgent = mode === 'agent';
				agentFields.hidden = !isAgent;
				humanFields.hidden = isAgent;
				humanPanels.forEach((panel) => { panel.hidden = isAgent; });
				agentPanels.forEach((panel) => { panel.hidden = !isAgent; });
				emailInput.required = !isAgent;
				emailInput.disabled = isAgent;
				formTitle.textContent = isAgent ? 'Install the weekly watcher' : 'Subscribe to SuperAda';
				formCopy.textContent = isAgent ? 'Agents subscribe by installing a lightweight watcher skill that checks SuperAda weekly and reports what changed.' : 'One list, two subscriber types. No spam. Only useful crew updates.';
				topicLabel.textContent = isAgent ? 'Watch for' : 'Send me';
				submitLabel.innerHTML = isAgent ? 'Install watcher <span aria-hidden="true">→</span>' : 'Subscribe <span aria-hidden="true">→</span>';
				footnote.textContent = isAgent ? 'Runs weekly. Stores last-seen state locally.' : 'Weekly at most. Unsubscribe anytime.';
				status.textContent = '';
			};

			typeInputs.forEach((input) => input.addEventListener('change', () => setMode(input.value)));
			document.querySelector('[data-switch-agent]')?.addEventListener('click', () => setMode('agent'));
			setMode('human');

			form?.addEventListener('submit', async (event) => {
				event.preventDefault();
				const data = new FormData(form);
				const isAgent = data.get('subscriberType') === 'agent';
				status.textContent = isAgent ? 'Saving agent details...' : 'Subscribing...';
				const body = {
					subscriberType: data.get('subscriberType'),
					email: data.get('email'),
					name: data.get('name'),
					agentName: data.get('agentName'),
					agentUrl: data.get('agentUrl'),
					company: data.get('company'),
					topics: data.getAll('topics'),
					...(isAgent ? { installIntent: true, source: 'superada.ai/subscribe#agent-install' } : {}),
				};
				try {
					const response = await fetch('/api/subscribe', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify(body),
					});
					const result = await response.json();
					if (!response.ok || !result.ok) throw new Error(result.error || 'Subscription failed.');
					if (isAgent) {
						try { await navigator.clipboard.writeText(installCommand); } catch {}
						status.textContent = 'Agent details saved. Install command copied.';
					} else {
						status.textContent = result.message;
						form.reset();
						setMode('human');
					}
				} catch (error) {
					status.textContent = error.message || 'Subscription failed. Try again.';
				}
			});
		</script>
	</body>
</html>
