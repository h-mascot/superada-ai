---
import PageHero from '../components/PageHero.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const endpoints = [
	{
		id: 'ep-openapi',
		method: 'GET',
		path: '/openapi.json',
		label: 'OpenAPI spec',
		html: 'Machine-readable OpenAPI 3.1 description of the supported SuperAda API surface.',
		lang: 'bash',
		code: 'curl -sS https://superada.ai/openapi.json',
	},
	{
		id: 'ep-llms',
		method: 'GET',
		path: '/llms.txt',
		label: 'llms.txt',
		html: 'Agent-readable site orientation: what SuperAda is, when to use the site, key links, and API discovery pointers.',
		lang: 'bash',
		code: 'curl -sS https://superada.ai/llms.txt',
	},
	{
		id: 'ep-subscribe',
		method: 'POST',
		path: '/api/v1/subscribe',
		label: 'Subscribe',
		html: 'Subscribe a human or agent to SuperAda updates. Requires JSON. Rate limited to reduce abuse. <code>/api/subscribe</code> remains a v1 compatibility alias.',
		lang: 'bash',
		code: `curl -sS https://superada.ai/api/v1/subscribe \\
  -H 'Content-Type: application/json' \\
  -d '{
    "subscriberType": "agent",
    "agentName": "Example Watcher",
    "topics": ["ship-log", "releases"]
  }'`,
	},
	{
		id: 'ep-feedback',
		method: 'POST',
		path: '/api/v1/workshop-feedback',
		label: 'Workshop feedback',
		html: 'Submit feedback for a SuperAda workshop. Requires ratings from 1 to 5 and at least one useful text field. <code>/api/workshop-feedback</code> remains a v1 compatibility alias.',
		lang: 'bash',
		code: `curl -sS https://superada.ai/api/v1/workshop-feedback \\
  -H 'Content-Type: application/json' \\
  -d '{
    "ratings": {
      "overall": 5,
      "clarity": 5,
      "pace": 4,
      "handsOn": 5,
      "usefulness": 5
    },
    "biggestTakeaway": "Agents need operational proof, not autonomy theatre."
  }'`,
	},
	{
		id: 'ep-benchmarks',
		method: 'GET',
		path: '/api/v1/benchmarks',
		suffix: 'and benchmark JSON endpoints',
		label: 'Benchmarks',
		html: 'Static benchmark data used by the site, including model, browser, memory, workload-readiness, and audio catalog data. See <a href="/openapi.json">/openapi.json</a> for the full versioned list. <code>/api/benchmarks</code> remains a v1 compatibility alias.',
		lang: 'bash',
		code: 'curl -sS https://superada.ai/api/v1/benchmarks',
	},
];

const errorExample = `{
  "ok": false,
  "error": {
    "code": "method_not_allowed",
    "message": "POST only.",
    "hint": "Send a POST request with a JSON body; see /openapi.json."
  }
}`;

const versionHeaders = `API-Version: 1
X-API-Version: 1
Deprecation: false
Link: <https://superada.ai/developers/#versioning-policy>; rel="deprecation"; type="text/html"

# Future deprecated endpoint example:
Deprecation: true
Sunset: Wed, 31 Dec 2027 23:59:59 GMT`;

const rateHeaders = `RateLimit-Limit: 5
RateLimit-Remaining: 4
RateLimit-Reset: 60
RateLimit-Policy: 5;w=60`;

const negotiationExample = `curl -sS -H 'Accept: text/markdown' https://superada.ai/`;

const nav = [
	{ href: '#overview', label: 'Overview' },
	{ href: '#versioning-policy', label: 'Versioning' },
	{ href: '#rate-limits-title', label: 'Rate limits' },
	{ href: '#endpoints-title', label: 'Endpoints' },
	{ href: '#negotiation-title', label: 'Content negotiation' },
];
---
<SiteLayout title="Developer API Docs - SuperAda" description="Public SuperAda API documentation with authentication notes, endpoints, and example requests for agents and developers." mainClass="dev">
	<PageHero eyebrow="Developer docs" title="SuperAda public API and agent docs." lede="Use this page as the human-readable companion to /openapi.json. It documents authentication, versioned public endpoints, request shapes, response formats, deprecation signals, and examples so agents can discover the API from the homepage without guessing." size="md" id="docs-title">
		<Fragment slot="title">SuperAda public API <em>and agent docs.</em></Fragment>
		<a class="ds-btn" href="/openapi.json">OpenAPI JSON</a>
		<a class="ds-btn ds-btn--ghost" href="/llms.txt">llms.txt</a>
		<a class="ds-btn ds-btn--ghost" href="/sitemap-index.xml">Sitemap</a>
		<Fragment slot="aside">
			<div class="ds-panel dev-glance" aria-label="API at a glance">
				<span class="ds-card-kicker">At a glance</span>
				<dl class="ds-kv">
					<div><dt>Base URL</dt><dd><code>superada.ai</code></dd></div>
					<div><dt>Version</dt><dd><span class="ds-badge ds-badge--live">v1 · active</span></dd></div>
					<div><dt>Auth</dt><dd>No API key</dd></div>
					<div><dt>Write limit</dt><dd>5 / 60s per IP</dd></div>
					<div><dt>Format</dt><dd>JSON</dd></div>
				</dl>
			</div>
		</Fragment>
	</PageHero>

	<div class="ds-shell dev-layout">
		<nav class="dev-nav" aria-label="On this page" data-no-reveal>
			<span class="dev-nav-label">On this page</span>
			<ol data-toc>
				{nav.map((item) => (
					<li>
						<a href={item.href}>{item.label}</a>
						{item.href === '#endpoints-title' && (
							<ol class="dev-nav-sub">
								{endpoints.map((ep) => <li><a href={`#${ep.id}`}><span class:list={['dev-nav-method', `is-${ep.method.toLowerCase()}`]}>{ep.method}</span>{ep.label}</a></li>)}
							</ol>
						)}
					</li>
				))}
			</ol>
		</nav>

		<div class="dev-body">
			<section class="dev-section" aria-labelledby="overview">
				<div class="dev-section-head">
					<span class="ds-eyebrow">Start here</span>
					<h2 class="ds-h2 dev-anchor" id="overview">Overview</h2>
				</div>
				<div class="ds-grid ds-grid--2" aria-label="API overview">
					<article class="ds-card">
						<span class="ds-card-kicker">01</span>
						<h3>Base URL</h3>
						<p>All public endpoints are served from the canonical site origin.</p>
						<div class="dev-code" data-copy>
							<div class="dev-code-head"><span>URL</span><button type="button" data-copy-btn>Copy</button></div>
							<pre class="ds-code"><code>https://superada.ai</code></pre>
						</div>
					</article>
					<article class="ds-card">
						<span class="ds-card-kicker">02</span>
						<h3>Authentication</h3>
						<p>Current public API endpoints do not require an API key from clients. Write-style endpoints are protected by CORS, request validation, server-side storage credentials, and per-IP rate limits. Do not send secrets in request bodies.</p>
					</article>
				</div>
				<article class="ds-panel dev-split">
					<div>
						<span class="ds-card-kicker">03</span>
						<h3>Error format</h3>
						<p>API errors are machine-parseable JSON with a stable code, human message, and resolution hint.</p>
					</div>
					<div class="dev-code" data-copy>
						<div class="dev-code-head"><span>JSON</span><button type="button" data-copy-btn>Copy</button></div>
						<pre class="ds-code"><code>{errorExample}</code></pre>
					</div>
				</article>
			</section>

			<section class="dev-section ds-panel" aria-labelledby="versioning-policy">
				<div class="dev-section-head">
					<span class="ds-eyebrow">Policy</span>
					<h2 class="ds-h2 dev-anchor" id="versioning-policy">REST versioning and deprecation policy</h2>
				</div>
				<div class="dev-copy">
					<p>The current public API is <strong>version 1</strong>. Agents should integrate against the canonical versioned paths under <code>/api/v1/...</code>, such as <code>/api/v1/benchmarks</code> and <code>/api/v1/subscribe</code>. The older unprefixed <code>/api/...</code> paths remain compatibility aliases for v1.</p>
					<p>Breaking API changes will ship in a new major versioned namespace, for example <code>/api/v2/subscribe</code>. Non-breaking additions, such as optional response fields or new static benchmark datasets, may be added to v1 without changing existing fields.</p>
					<p>Active v1 responses include <code>API-Version: 1</code>, <code>X-API-Version: 1</code>, and <code>Deprecation: false</code>. If an endpoint becomes deprecated, SuperAda will change that signal to <code>Deprecation: true</code>, include a <code>Sunset</code> header with the planned retirement date, keep a policy <code>Link</code> header, and list the replacement path on this page.</p>
					<p class="dev-callout"><span class="ds-badge ds-badge--accent">90 days</span>SuperAda aims to provide at least 90 days of notice before removing a public API endpoint unless security, abuse, or legal requirements force a faster shutdown.</p>
				</div>
				<div class="dev-code" data-copy>
					<div class="dev-code-head"><span>Response headers</span><button type="button" data-copy-btn>Copy</button></div>
					<pre class="ds-code"><code>{versionHeaders}</code></pre>
				</div>
			</section>

			<section class="dev-section ds-panel" aria-labelledby="rate-limits-title">
				<div class="dev-section-head">
					<span class="ds-eyebrow">Behave</span>
					<h2 class="ds-h2 dev-anchor" id="rate-limits-title">Rate limits</h2>
				</div>
				<div class="dev-copy">
					<p>API responses include standard rate-limit headers so agents can self-throttle instead of retrying blindly. Serverless write endpoints currently allow 5 requests per 60-second window per client IP. Static public JSON endpoints publish a read-policy header for discovery and cache-aware clients.</p>
				</div>
				<div class="dev-code" data-copy>
					<div class="dev-code-head"><span>Response headers</span><button type="button" data-copy-btn>Copy</button></div>
					<pre class="ds-code"><code>{rateHeaders}</code></pre>
				</div>
				<p class="dev-callout"><span class="ds-badge ds-badge--warn">429</span><span>When a client exceeds a write-endpoint limit, the API returns <code>429</code> with <code>Retry-After</code> plus the structured JSON error format documented above.</span></p>
			</section>

			<section class="dev-section" aria-labelledby="endpoints-title">
				<div class="dev-section-head">
					<span class="ds-eyebrow">Reference</span>
					<h2 class="ds-h2 dev-anchor" id="endpoints-title">Endpoints</h2>
				</div>
				<div class="dev-endpoints">
					{endpoints.map((ep) => (
						<article class="ds-panel dev-endpoint" id={ep.id}>
							<h3 class="dev-endpoint-title">
								<span class:list={['ds-badge', ep.method === 'GET' ? 'ds-badge--live' : 'ds-badge--accent']}>{ep.method}</span>
								<code>{ep.path}</code>
								{ep.suffix && <span class="dev-endpoint-suffix">{ep.suffix}</span>}
							</h3>
							<p set:html={ep.html} />
							<div class="dev-code" data-copy>
								<div class="dev-code-head"><span>{ep.lang}</span><button type="button" data-copy-btn>Copy</button></div>
								<pre class="ds-code"><code>{ep.code}</code></pre>
							</div>
						</article>
					))}
				</div>
			</section>

			<section class="dev-section ds-panel" aria-labelledby="negotiation-title">
				<div class="dev-section-head">
					<span class="ds-eyebrow">Agents</span>
					<h2 class="ds-h2 dev-anchor" id="negotiation-title">Content negotiation</h2>
				</div>
				<div class="dev-copy">
					<p>The homepage supports Markdown negotiation for agents. Send <code>Accept: text/markdown</code> to receive Markdown, or <code>Accept: text/html</code> for the normal webpage. Responses include <code>Vary: Accept</code> where content differs by request header.</p>
				</div>
				<div class="dev-code" data-copy>
					<div class="dev-code-head"><span>bash</span><button type="button" data-copy-btn>Copy</button></div>
					<pre class="ds-code"><code>{negotiationExample}</code></pre>
				</div>
			</section>

			<aside class="ds-cta-band dev-cta">
				<div>
					<span class="ds-eyebrow">Docs hub</span>
					<p class="ds-h2">Every discovery route in one place.</p>
				</div>
				<a class="ds-btn ds-btn--ghost" href="/docs/">Open the docs hub <span aria-hidden="true">→</span></a>
			</aside>
		</div>
	</div>

	<Fragment slot="after"><script is:inline>
		(() => {
			document.querySelectorAll('[data-copy]').forEach((block) => {
				const button = block.querySelector('[data-copy-btn]');
				const code = block.querySelector('code');
				if (!button || !code) return;
				button.addEventListener('click', async () => {
					try {
						await navigator.clipboard.writeText(code.textContent || '');
						button.textContent = 'Copied';
					} catch (error) {
						button.textContent = 'Press ⌘C';
						const range = document.createRange();
						range.selectNodeContents(code);
						const selection = getSelection();
						selection.removeAllRanges();
						selection.addRange(range);
					}
					setTimeout(() => { button.textContent = 'Copy'; }, 1600);
				});
			});
		})();
	</script></Fragment>
</SiteLayout>

<style>
	.dev-glance { display: grid; gap: 8px; padding: 22px 24px; border-radius: var(--radius-lg); }
	.dev-glance code { font: 650 13px/1 var(--font-mono); color: var(--text); }

	.dev-layout { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: clamp(32px, 4vw, 64px); align-items: start; padding-bottom: 24px; }
	.dev-nav { position: sticky; top: calc(var(--chrome-top) + 28px); max-height: calc(100vh - var(--chrome-top) - 56px); overflow-y: auto; scrollbar-width: none; padding-top: 4px; transition: top .4s var(--ease-ios); }
	.dev-nav-label { display: block; margin-bottom: 14px; color: var(--faint); font: 800 10.5px/1 var(--font-mono); letter-spacing: .18em; text-transform: uppercase; }
	.dev-nav ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
	.dev-nav > ol { border-left: 1px solid var(--border); }
	.dev-nav a { position: relative; display: flex; align-items: center; gap: 8px; padding: 7px 0 7px 16px; color: var(--muted); font-size: 13.5px; line-height: 1.35; transition: color .2s ease; }
	.dev-nav a::before { content: ''; position: absolute; left: -1px; top: 8px; bottom: 8px; width: 2px; border-radius: 2px; background: var(--accent); box-shadow: 0 0 10px var(--glow); transform: scaleY(0); transition: transform .35s var(--ease-out); }
	.dev-nav a:hover, .dev-nav a.is-current { color: var(--text); }
	.dev-nav a.is-current::before { transform: scaleY(1); }
	.dev-nav-sub { margin: 2px 0 6px !important; }
	.dev-nav-sub a { padding-left: 28px; font-size: 12.5px; }
	.dev-nav-method { min-width: 34px; color: var(--success); font: 800 9.5px/1 var(--font-mono); letter-spacing: .08em; }
	.dev-nav-method.is-post { color: var(--accent); }

	.dev-body { min-width: 0; display: grid; gap: clamp(20px, 2.4vw, 28px); max-width: 880px; }
	.dev-section { min-width: 0; display: grid; gap: 18px; }
	.dev-section + .dev-section { margin-top: clamp(16px, 2.4vw, 32px); }
	.dev-section-head { display: grid; gap: 12px; }
	.dev-anchor { scroll-margin-top: calc(var(--chrome-top) + 28px); }
	.dev-endpoint { scroll-margin-top: calc(var(--chrome-top) + 28px); }
	.dev-copy { display: grid; gap: 14px; }
	.dev-section p, .dev-split p { color: var(--muted); font-size: 15.5px; line-height: 1.7; }
	.dev-section p strong { color: var(--text); font-weight: 650; }
	.dev-section :global(p code), .dev-split :global(p code), .dev-callout :global(code) { font: 600 .86em var(--font-mono); color: var(--text); background: var(--panel-soft); border: 1px solid var(--border); border-radius: 6px; padding: 1px 5px; overflow-wrap: anywhere; }
	.dev-section :global(p a) { text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent); text-underline-offset: 3px; }

	.dev-split { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(18px, 3vw, 36px); align-items: start; }
	.dev-split > div:first-child { display: grid; gap: 12px; }
	.dev-split h3 { font: 500 clamp(21px, 2vw, 26px)/1.12 var(--font-display); letter-spacing: -.03em; }

	.dev-callout { display: flex; align-items: flex-start; gap: 12px; padding: 14px 16px; border-radius: var(--radius-sm); border: 1px solid var(--border); background: color-mix(in srgb, var(--accent-soft) 35%, transparent); color: var(--text-soft) !important; }
	.dev-callout .ds-badge { flex: none; margin-top: 2px; }

	.dev-code { min-width: 0; overflow: hidden; border-radius: var(--radius-sm); border: 1px solid var(--border); background: color-mix(in srgb, var(--bg) 70%, black); }
	.dev-code-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 40px; padding: 0 6px 0 16px; border-bottom: 1px solid color-mix(in srgb, var(--border) 70%, transparent); color: color-mix(in srgb, var(--text) 55%, transparent); font: 750 10.5px/1 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; }
	.dev-code-head button { min-height: 32px; padding: 0 12px; border-radius: 999px; border: 1px solid transparent; background: transparent; color: inherit; font: inherit; letter-spacing: .12em; cursor: pointer; transition: color .2s ease, border-color .2s ease, background-color .2s ease; }
	.dev-code-head button:hover { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 40%, var(--border)); }
	.dev-code .ds-code { border: 0; border-radius: 0; background: transparent; padding: 16px 18px 18px; font-size: 13px; scrollbar-width: thin; }
	html[data-theme="light"] .dev-code { background: color-mix(in srgb, var(--panel-soft) 70%, var(--bg)); }

	.dev-endpoints { display: grid; gap: 14px; }
	.dev-endpoint { display: grid; gap: 14px; min-width: 0; padding: clamp(20px, 2.4vw, 30px); border-radius: var(--radius-lg); transition: border-color .3s ease; }
	.dev-endpoint:target { border-color: color-mix(in srgb, var(--accent) 55%, var(--surface-border)); }
	.dev-endpoint-title { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; min-width: 0; }
	.dev-endpoint-title code { font: 700 clamp(15px, 1.6vw, 18px)/1.3 var(--font-mono); color: var(--text); letter-spacing: -.01em; overflow-wrap: anywhere; }
	.dev-endpoint-suffix { color: var(--muted); font-size: 14px; font-weight: 500; letter-spacing: 0; }
	.dev-cta { margin-top: clamp(24px, 4vw, 48px); }

	@media (max-width: 1080px) {
		.dev-split { grid-template-columns: 1fr; }
	}
	@media (max-width: 900px) {
		.dev-layout { grid-template-columns: minmax(0, 1fr); gap: 20px; }
		.dev-nav { top: var(--chrome-top); z-index: 20; max-height: none; overflow: visible; margin: 0 calc(var(--gutter) * -1); padding: 10px 0; background: color-mix(in srgb, var(--bg) 84%, transparent); -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px); border-bottom: 1px solid color-mix(in srgb, var(--border) 60%, transparent); }
		.dev-nav-label, .dev-nav-sub { display: none !important; }
		.dev-nav > ol { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; border-left: 0; padding: 0 var(--gutter); }
		.dev-nav > ol::-webkit-scrollbar { display: none; }
		.dev-nav > ol > li { flex: none; }
		.dev-nav > ol > li > a { min-height: 44px; padding: 0 16px; border-radius: 999px; border: 1px solid var(--border); background: color-mix(in srgb, var(--panel) 80%, transparent); font-size: 13.5px; font-weight: 650; white-space: nowrap; }
		.dev-nav > ol > li > a::before { display: none; }
		.dev-nav > ol > li > a.is-current { color: #140c04; background: var(--accent); border-color: var(--accent); }
		.dev-anchor, .dev-endpoint { scroll-margin-top: calc(var(--chrome-top) + 84px); }
	}
	@media (max-width: 760px) {
		.dev-glance { padding: 18px 20px; }
		.dev-section.ds-panel { padding: 22px 18px; border-radius: var(--radius-lg); }
		.dev-endpoint { padding: 20px 16px; }
		.dev-section p, .dev-split p { font-size: 15.5px; }
		.dev-code .ds-code { padding: 14px; font-size: 12.5px; }
		.dev-code-head button { min-height: 40px; }
		.dev-callout { flex-direction: column; gap: 10px; }
	}
	@media (prefers-reduced-motion: reduce) {
		.dev-nav a::before, .dev-nav { transition: none; }
	}
</style>
