---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { SITE_TITLE } from '../../consts';
import { coreSlugs, crew, hermesSlugs, type CrewMember } from '../../data/crew';

export function getStaticPaths() {
	return crew.map((agent) => ({ params: { slug: agent.slug }, props: { agent } }));
}

interface Props { agent: CrewMember }
const { agent } = Astro.props;
const fleetName = hermesSlugs.includes(agent.slug) ? 'Core crew · Hermes & OpenClaw' : 'Core crew · Grok Bot';
const peers = coreSlugs.map((slug) => crew.find((member) => member.slug === slug)!).filter(Boolean);
const index = peers.findIndex((member) => member.slug === agent.slug);
const prev = peers[(index - 1 + peers.length) % peers.length];
const next = peers[(index + 1) % peers.length];
const [lead, ...rest] = agent.bio;
---
<SiteLayout title={`${agent.name} — ${agent.role} | ${SITE_TITLE}`} description={`${agent.name}: ${agent.bio[0]}`} bodyClass="crew-profile-page">
	<article class="crew-profile" style={`--agent-accent:${agent.accent}; --agent-glow:${agent.accentGlow};`}>
		<header class="cp-hero">
			<div class="cp-banner" data-morph-hero>
				<img src={agent.banner} alt={`${agent.name} hero banner`} loading="eager" fetchpriority="high" />
			</div>
			<div class="cp-hero-copy ds-shell">
				<img class="cp-avatar" src={agent.avatar} alt={agent.name} width="112" height="112" />
				<div class="cp-hero-text">
					<a class="cp-fleet" href="/about">{fleetName}</a>
					<h1 class="cp-name">{agent.name} <span aria-hidden="true">{agent.emoji}</span></h1>
					<p class="cp-role">{agent.role}</p>
					<div class="ds-meta cp-meta"><span>Born {agent.born}</span><span>Runs on {agent.hardware}</span><span>{agent.signatureEmoji}</span></div>
				</div>
			</div>
		</header>

		<div class="cp-layout ds-shell">
			<div class="cp-main">
				<p class="cp-lead">{lead}</p>
				{rest.map((para) => <p class="cp-para">{para}</p>)}
				<blockquote class="cp-quote"><p>{agent.quote}</p><cite>— {agent.name}</cite></blockquote>

				<section class="cp-trek ds-panel" aria-labelledby="trek-title">
					<span class="cp-trek-mark" aria-hidden="true">✦</span>
					<div>
						<span class="ds-card-kicker">Star Trek connection</span>
						<h2 id="trek-title">{agent.trekCharacter}</h2>
						<p class="cp-trek-show">{agent.trekShow}</p>
						<p>{agent.trekDetail}</p>
					</div>
				</section>
			</div>

			<aside class="cp-side" data-no-reveal>
				<section class="ds-panel cp-facts" aria-label="Facts">
					<dl class="ds-kv">
						<div><dt>Born</dt><dd>{agent.born}</dd></div>
						<div><dt>Runs on</dt><dd>{agent.hardware}</dd></div>
						<div><dt>Fleet</dt><dd>{hermesSlugs.includes(agent.slug) ? 'Hermes & OpenClaw' : 'Grok Bot'}</dd></div>
						<div><dt>Signature</dt><dd>{agent.signatureEmoji}</dd></div>
					</dl>
				</section>
				<section class="ds-panel" aria-labelledby="cap-title">
					<h2 class="cp-side-title" id="cap-title">Capabilities</h2>
					<ul class="cp-chips">{agent.capabilities.map((cap) => <li>{cap}</li>)}</ul>
				</section>
				<section class="ds-panel" aria-labelledby="models-title">
					<h2 class="cp-side-title" id="models-title">Models</h2>
					<ul class="cp-models">{agent.models.map((model) => <li>{model}</li>)}</ul>
				</section>
				<section class="ds-panel cp-fun" aria-labelledby="fun-title">
					<h2 class="cp-side-title" id="fun-title">Fun fact</h2>
					<p>{agent.funFact}</p>
				</section>
			</aside>
		</div>

		<nav class="cp-fleet-nav ds-shell" aria-label="More of the crew">
			<div class="ds-section-head">
				<h2 class="ds-h2">More of the crew</h2>
				<a class="detail-back-link" href="/about">← Back to the Crew</a>
			</div>
			<div class="cp-peers">
				{peers.filter((peer) => peer.slug !== agent.slug).map((peer) => (
					<a class="cp-peer" href={`/crew/${peer.slug}`} style={`--peer-accent:${peer.accent}`}>
						<img src={peer.avatar} alt="" width="56" height="56" loading="lazy" />
						<span><b>{peer.name}</b><small>{peer.role}</small></span>
					</a>
				))}
			</div>
			<div class="cp-step">
				<a href={`/crew/${prev.slug}`} rel="prev"><span>Previous</span><b>← {prev.name}</b></a>
				<a href={`/crew/${next.slug}`} rel="next"><span>Next</span><b>{next.name} →</b></a>
			</div>
		</nav>
	</article>
</SiteLayout>

<style>
	.crew-profile { --accent-local: var(--agent-accent, var(--accent)); }
	.cp-hero { position: relative; margin-bottom: clamp(36px, 5vw, 64px); }
	.cp-banner { position: relative; height: clamp(320px, 58vh, 620px); overflow: hidden; background: var(--panel-soft); }
	.cp-banner img { width: 100%; height: 100%; object-fit: cover; display: block; animation: cp-drift 18s ease-in-out infinite alternate; }
	.cp-banner::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, color-mix(in srgb, var(--bg) 10%, transparent) 0%, transparent 35%, color-mix(in srgb, var(--bg) 70%, transparent) 72%, var(--bg) 100%), radial-gradient(circle at 20% 100%, color-mix(in srgb, var(--accent-local) 26%, transparent), transparent 50%); }
	@keyframes cp-drift { to { transform: scale(1.06) translateY(-1.5%); } }
	.cp-hero-copy { position: relative; z-index: 2; display: flex; align-items: flex-end; gap: clamp(18px, 3vw, 32px); margin-top: clamp(-150px, -14vw, -96px); }
	.cp-avatar { flex: 0 0 auto; width: clamp(88px, 10vw, 128px); height: auto; aspect-ratio: 1; border-radius: 32%; object-fit: cover; border: 3px solid var(--accent-local); box-shadow: 0 0 0 6px var(--bg), 0 20px 60px var(--agent-glow, var(--glow)); background: var(--panel); }
	.cp-hero-text { display: grid; gap: 8px; padding-bottom: 6px; min-width: 0; }
	.cp-fleet { justify-self: start; display: inline-flex; align-items: center; min-height: 30px; padding: 0 12px; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--accent-local) 45%, var(--border)); background: color-mix(in srgb, var(--bg) 60%, transparent); color: var(--accent-local); font: 800 10.5px/1 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
	.cp-name { font: 500 clamp(56px, 9vw, 124px)/.88 var(--font-display); letter-spacing: -.065em; color: var(--text); }
	.cp-name span { font-size: .42em; vertical-align: middle; letter-spacing: 0; }
	.cp-role { color: var(--accent-local); font: 800 13px/1.3 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; }
	.cp-meta { font-size: 13.5px; }

	.cp-layout { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: clamp(32px, 5vw, 72px); align-items: start; }
	.cp-main { display: grid; gap: 20px; max-width: 720px; }
	.cp-lead { color: var(--text); font: 400 clamp(22px, 2.2vw, 28px)/1.45 var(--font-display); letter-spacing: -.02em; text-wrap: pretty; }
	.cp-para { color: var(--text-soft); font-size: 18px; line-height: 1.75; text-wrap: pretty; }
	.cp-quote { margin: 16px 0; padding: 28px 0 28px 30px; border-left: 3px solid var(--accent-local); }
	.cp-quote p { color: var(--text); font: 500 clamp(26px, 3vw, 38px)/1.2 var(--font-display); letter-spacing: -.03em; text-wrap: balance; }
	.cp-quote cite { display: block; margin-top: 14px; color: var(--accent-local); font: 750 12px/1 var(--font-mono); font-style: normal; letter-spacing: .12em; text-transform: uppercase; }
	.cp-trek { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 20px; margin-top: 12px; }
	.cp-trek-mark { width: 52px; height: 52px; display: grid; place-items: center; border-radius: 16px; background: color-mix(in srgb, var(--accent-local) 18%, transparent); color: var(--accent-local); font-size: 22px; }
	.cp-trek .ds-card-kicker { color: var(--accent-local); }
	.cp-trek h2 { margin-top: 10px; font: 500 26px/1.15 var(--font-display); letter-spacing: -.03em; }
	.cp-trek-show { margin: 4px 0 12px; color: var(--muted); font-style: italic; }
	.cp-trek p:last-child { color: var(--text-soft); line-height: 1.7; }

	.cp-side { position: sticky; top: calc(var(--chrome-top) + 24px); display: grid; gap: 14px; }
	.cp-side .ds-panel { padding: 22px; border-radius: var(--radius-lg); }
	.cp-side-title { margin-bottom: 14px; color: var(--faint); font: 800 10.5px/1 var(--font-mono); letter-spacing: .18em; text-transform: uppercase; }
	.cp-chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
	.cp-chips li { padding: 7px 12px; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--accent-local) 35%, var(--border)); background: color-mix(in srgb, var(--accent-local) 10%, transparent); color: var(--text); font-size: 13px; font-weight: 600; }
	.cp-models { list-style: none; margin: 0; padding: 0; display: grid; }
	.cp-models li { padding: 9px 0; border-bottom: 1px solid var(--border); color: var(--text-soft); font-size: 14px; }
	.cp-models li:first-child { color: var(--text); font-weight: 650; }
	.cp-models li:last-child { border-bottom: 0; }
	.cp-fun p { color: var(--text-soft); font-size: 14.5px; line-height: 1.65; }

	.cp-fleet-nav { margin-top: clamp(64px, 8vw, 112px); }
	.detail-back-link { display: inline-flex; align-items: center; min-height: 44px; }
	.cp-peers { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; }
	.cp-peer { display: flex; align-items: center; gap: 14px; min-height: 76px; padding: 10px 16px 10px 10px; border-radius: var(--radius-lg); border: 1px solid var(--surface-border); background: var(--surface); color: var(--text); transition: transform .4s var(--ease-out), border-color .25s ease, box-shadow .4s ease; }
	.cp-peer img { width: 56px; height: 56px; border-radius: 30%; object-fit: cover; border: 2px solid var(--peer-accent); }
	.cp-peer span { display: grid; gap: 3px; min-width: 0; }
	.cp-peer b { font-size: 16px; }
	.cp-peer small { color: var(--muted); font-size: 12.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.cp-peer:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--peer-accent) 55%, var(--surface-border)); box-shadow: 0 18px 50px color-mix(in srgb, var(--peer-accent) 22%, transparent); }
	.cp-step { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 16px; }
	.cp-step a { display: grid; gap: 6px; padding: 18px 20px; border-radius: var(--radius-lg); border: 1px solid var(--border); color: var(--text); transition: border-color .25s ease, background-color .25s ease; }
	.cp-step a:last-child { text-align: right; }
	.cp-step span { color: var(--faint); font: 750 10.5px/1 var(--font-mono); letter-spacing: .16em; text-transform: uppercase; }
	.cp-step b { font: 500 22px/1.1 var(--font-display); letter-spacing: -.02em; }
	.cp-step a:hover { border-color: color-mix(in srgb, var(--accent-local) 50%, var(--border)); background: color-mix(in srgb, var(--panel-soft) 60%, transparent); }

	@media (max-width: 980px) {
		.cp-layout { grid-template-columns: 1fr; }
		.cp-side { position: static; grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}
	@media (max-width: 760px) {
		.cp-banner { height: 46vh; min-height: 280px; }
		.cp-hero-copy { flex-direction: column; align-items: flex-start; margin-top: -84px; gap: 14px; }
		.cp-name { font-size: clamp(52px, 16vw, 72px); }
		.cp-lead { font-size: 21px; }
		.cp-para { font-size: 17px; }
		.cp-quote { padding: 18px 0 18px 20px; }
		.cp-side { grid-template-columns: 1fr; }
		.cp-trek { grid-template-columns: 1fr; }
		.cp-peers { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; margin-inline: calc(var(--gutter) * -1); padding: 4px var(--gutter) 8px; }
		.cp-peers::-webkit-scrollbar { display: none; }
		.cp-peer { flex: 0 0 72%; scroll-snap-align: start; }
		.cp-step b { font-size: 19px; }
	}
	@media (prefers-reduced-motion: reduce) { .cp-banner img { animation: none; } }
</style>
