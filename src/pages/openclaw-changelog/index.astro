---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { CHANGELOG_SOURCE_URL, CHANGELOG_VERSIONS } from '../../data/changelog';

const versionCards = CHANGELOG_VERSIONS.filter((version) => version.features.length > 0).map((version) => {
  const fullChangelogHref = version.href || `${CHANGELOG_SOURCE_URL}#${version.version.replace(/\./g, '')}`;
  const items = version.features.map((feature) => ({
    title: feature.title,
    description: feature.description,
    href: feature.href || fullChangelogHref,
    type: 'Change',
  }));

  return {
    ...version,
    fullChangelogHref,
    items,
  };
});

const totalItems = versionCards.reduce((sum, version) => sum + version.items.length, 0);
const totalFixes = versionCards.reduce((sum, version) => sum + version.fixes.length, 0);

const latestWeeklyDeck = {
  date: '2026-06-14',
  href: '/openclaw-changelog/2026-06-14.html',
  headline: 'Three releases, one quiet win: the channel that used to die silently now stays alive',
  lead: 'This was a plumbing week. Not a feature parade. OpenClaw shipped 2026.6.5, 2026.6.6, and the 2026.6.8 pre-release with the through-line of recovery: safer approvals, reproducible installs, and the session lock leak fixed at the root.',
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="OpenClaw Changelog & Feature Tracker"
      description="A clean release reference for OpenClaw versions, shipped items, and upstream changelog links."
    />
  </head>
  <body style="background:var(--bg); color:var(--text); min-height:100vh;">
    <Header />
    <main class="changelog-shell">
      <section class="hero-card">
        <a href="javascript:history.back()" class="back-link">← Back to Resources</a>
        <div class="hero-kicker">OpenClaw releases</div>
        <h1>OpenClaw Changelog &amp; Feature Tracker</h1>
        <p class="hero-copy">
          A working reference for the Enterprise Crew. Scan what shipped by version, open the upstream release notes,
          and follow each listed item back to its source when a PR or issue is available.
        </p>
        <div class="hero-meta">
          <div class="meta-pill"><strong>{versionCards.length}</strong><span>release sections</span></div>
          <div class="meta-pill"><strong>{totalItems}</strong><span>listed changes</span></div>
          <div class="meta-pill"><strong>{totalFixes}</strong><span>fix entries</span></div>
        </div>
      </section>

      <section class="weekly-deck-card">
        <div>
          <div class="hero-kicker">Latest weekly DX deck</div>
          <h2><a href={latestWeeklyDeck.href}>{latestWeeklyDeck.headline}</a></h2>
          <p>{latestWeeklyDeck.lead}</p>
          <a class="deck-link" href={latestWeeklyDeck.href}>Open {latestWeeklyDeck.date} deck ↗</a>
        </div>
      </section>

      <section class="control-bar">
        <label class="search-wrap">
          <span>Search</span>
          <input id="feature-search" type="search" placeholder="Memory, Codex, Matrix, 2026.4.10..." />
        </label>
      </section>

      <div class="page-grid">
        <aside class="sidebar-card">
          <div class="sidebar-inner">
            <div class="sidebar-title">Versions</div>
            <div class="sidebar-subtitle">Newest first. Version numbers open the upstream OpenClaw changelog.</div>
            <nav class="version-nav">
              {versionCards.map((version) => (
                <a href={version.fullChangelogHref} class="version-nav-link" target="_blank" rel="noopener noreferrer">
                  <span>{version.version}</span>
                  <small>{version.items.length} changes ↗</small>
                </a>
              ))}
            </nav>
          </div>
        </aside>

        <section class="versions-column" id="versions-column">
          {versionCards.map((version, versionIndex) => (
            <details
              class="version-card"
              id={`v-${version.version}`}
              data-version-card
              data-version={version.version}
              data-default-open={versionIndex === 0 ? 'true' : 'false'}
              open={versionIndex === 0}
            >
              <summary class="version-summary">
                <div class="summary-main">
                  <div class="version-kicker">Release</div>
                  <h2>
                    <a href={version.fullChangelogHref} target="_blank" rel="noopener noreferrer">{version.version}</a>
                  </h2>
                  <p>{version.date}</p>
                </div>
                <span class="summary-actions">
                  <span class="change-count">{version.items.length} changes</span>
                  <a class="summary-link" href={version.fullChangelogHref} target="_blank" rel="noopener noreferrer">Open upstream ↗</a>
                  <span class="collapse-indicator" aria-hidden="true"></span>
                </span>
              </summary>

              <div class="version-body">
                <div class="changelog-list">
                  {version.items.map((item, index) => (
                    <a
                      class="changelog-list-item"
                      href={item.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      data-feature-search={`${version.version} ${item.type} ${item.title} ${item.description}`.toLowerCase()}
                    >
                      <span class="item-thumb">{String(index + 1).padStart(2, '0')}</span>
                      <span class="item-copy">
                        <strong>{item.title}</strong>
                        <small>{item.description}</small>
                      </span>
                      <span class="item-arrow">↗</span>
                    </a>
                  ))}
                </div>
              </div>
            </details>
          ))}
        </section>
      </div>
    </main>
    <Footer />

    <script is:inline>
      const searchInput = document.getElementById('feature-search');
      const versionCards = Array.from(document.querySelectorAll('[data-version-card]'));
      let wasSearching = false;
      let savedOpenState = new Map();

      versionCards.forEach((card) => {
        card.querySelectorAll('.summary-link, .version-summary h2 a').forEach((link) => {
          link.addEventListener('click', (event) => event.stopPropagation());
        });
      });

      const restoreOpenState = () => {
        versionCards.forEach((card) => {
          const shouldOpen = savedOpenState.has(card)
            ? savedOpenState.get(card)
            : card.dataset.defaultOpen === 'true';
          card.open = Boolean(shouldOpen);
        });
        savedOpenState = new Map();
      };

      const applyFilters = () => {
        const searchValue = (searchInput?.value || '').trim().toLowerCase();
        const isSearching = searchValue.length > 0;

        if (isSearching && !wasSearching) {
          savedOpenState = new Map(versionCards.map((card) => [card, card.open]));
        }

        versionCards.forEach((card) => {
          const items = Array.from(card.querySelectorAll('.changelog-list-item'));
          let visibleCount = 0;

          items.forEach((item) => {
            const haystack = item.getAttribute('data-feature-search') || '';
            const show = !searchValue || haystack.includes(searchValue);
            item.toggleAttribute('hidden', !show);
            if (show) visibleCount += 1;
          });

          card.toggleAttribute('hidden', visibleCount === 0);
          if (isSearching) {
            card.open = visibleCount > 0;
          }
        });

        if (!isSearching && wasSearching) {
          restoreOpenState();
        }

        wasSearching = isSearching;
      };

      searchInput?.addEventListener('input', applyFilters);
    </script>
  </body>
</html>

<style>
  :global(html) {
    scroll-behavior: auto;
  }

  .changelog-shell {
    max-width: 1220px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
  }

  .hero-card,
  .control-bar,
  .sidebar-card,
  .version-card {
    border: 1px solid var(--border);
    background: var(--panel);
    border-radius: 16px;
  }

  .hero-card {
    padding: 2rem;
    background: linear-gradient(135deg, var(--panel) 0%, #17110c 55%, #1f150d 100%);
    margin-bottom: 1rem;
  }

  .weekly-deck-card {
    border: 1px solid rgba(0, 229, 204, 0.24);
    background: linear-gradient(135deg, rgba(0, 229, 204, 0.08), rgba(255, 77, 77, 0.05));
    border-radius: 16px;
    padding: 1.35rem 1.5rem;
    margin-bottom: 1rem;
  }

  .weekly-deck-card h2 {
    margin: 0.35rem 0 0.6rem;
    font-family: Georgia, serif;
    font-size: clamp(1.55rem, 2.8vw, 2.25rem);
    line-height: 1.08;
  }

  .weekly-deck-card h2 a,
  .deck-link {
    color: var(--text);
    text-decoration: none;
  }

  .weekly-deck-card p {
    max-width: 850px;
    margin: 0 0 0.9rem;
    color: var(--muted);
    line-height: 1.6;
  }

  .deck-link {
    color: var(--accent);
    font-weight: 700;
  }

  .back-link {
    display: inline-flex;
    margin-bottom: 1.1rem;
    color: var(--accent);
    font-size: 0.9rem;
  }

  .hero-kicker,
  .version-kicker,
  .sidebar-title,
  .control-bar label span {
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .hero-card h1,
  .version-summary h2 {
    margin: 0;
    font-family: Georgia, serif;
    font-weight: 400;
  }

  .hero-card h1 {
    font-size: clamp(2.2rem, 4vw, 3.5rem);
    line-height: 1.02;
    margin-bottom: 0.85rem;
  }

  .hero-copy {
    max-width: 820px;
    margin: 0 0 1.4rem;
    color: var(--text-soft);
    line-height: 1.8;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .meta-pill {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    border: 1px solid #342c25;
    border-radius: 999px;
    padding: 0.65rem 0.9rem;
    background: rgba(255, 255, 255, 0.02);
  }

  .meta-pill strong {
    font-size: 1rem;
    color: var(--text);
  }

  .meta-pill span,
  .version-summary p,
  .sidebar-subtitle {
    color: var(--muted);
  }

  .control-bar {
    padding: 1rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 1.2rem;
  }

  .control-bar label {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .control-bar input {
    width: 100%;
    border-radius: 12px;
    border: 1px solid #3A3027;
    background: var(--bg);
    color: var(--text);
    padding: 0.9rem 1rem;
    font: inherit;
  }

  .page-grid {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: 1.2rem;
    align-items: start;
  }

  .sidebar-card {
    position: sticky;
    top: 5.25rem;
    max-height: calc(100vh - 6.5rem);
    overflow: hidden;
  }

  .sidebar-inner {
    padding: 1rem;
    max-height: inherit;
    display: flex;
    min-height: 0;
    flex-direction: column;
  }

  .version-nav {
    display: flex;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    flex-direction: column;
    gap: 0.55rem;
    margin-top: 1rem;
    padding-right: 0.25rem;
  }

  .version-nav-link {
    display: flex;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 0.8rem 0.9rem;
    border-radius: 12px;
    border: 1px solid var(--border);
    color: var(--text);
    background: #100d0a;
    text-decoration: none;
  }

  .version-nav-link:hover,
  .changelog-list-item:hover {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--border));
    background: color-mix(in srgb, var(--accent-soft) 26%, #100d0a);
  }

  .version-nav-link small {
    color: var(--muted);
  }

  .versions-column {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .version-card {
    overflow: clip;
    scroll-margin-top: 5.5rem;
  }

  .version-summary {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 1rem;
    padding: 1.35rem;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    list-style: none;
  }

  .version-summary::-webkit-details-marker {
    display: none;
  }

  .version-card:not([open]) .version-summary {
    border-bottom: 0;
  }

  .version-summary h2 {
    font-size: 2rem;
    margin-top: 0.2rem;
  }

  .version-summary h2 a {
    color: var(--text);
    text-decoration: none;
  }

  .version-summary h2 a:hover,
  .summary-link:hover {
    color: var(--accent);
  }

  .version-summary p {
    margin: 0.35rem 0 0;
  }

  .summary-actions {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .change-count {
    color: var(--muted);
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .summary-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #342c25;
    border-radius: 999px;
    padding: 0.65rem 0.9rem;
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
    background: rgba(255, 255, 255, 0.02);
  }

  .collapse-indicator {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid #342c25;
    border-radius: 999px;
    color: var(--accent);
    background: rgba(255, 255, 255, 0.02);
  }

  .collapse-indicator::before {
    content: '+';
    font: 700 1.05rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .version-card[open] .collapse-indicator::before {
    content: '−';
  }

  .version-body {
    padding: 1rem 1.35rem 1.35rem;
  }

  .changelog-list {
    display: grid;
    gap: 0.75rem;
  }

  .changelog-list-item {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto;
    gap: 0.9rem;
    align-items: start;
    min-height: 84px;
    padding: 0.9rem;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: #0F0C09;
    color: var(--text);
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s;
  }

  .changelog-list-item[hidden],
  .version-card[hidden] {
    display: none;
  }

  .item-thumb {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 14px;
    border: 1px solid #342c25;
    background: color-mix(in srgb, var(--accent-soft) 42%, transparent);
    color: var(--accent);
    font: 800 0.78rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .item-copy {
    display: grid;
    gap: 0.35rem;
  }

  .item-copy strong {
    font-family: Georgia, serif;
    font-size: 1.08rem;
    font-weight: 400;
  }

  .item-copy small {
    color: var(--text-soft);
    line-height: 1.65;
    font-size: 0.92rem;
  }

  .item-arrow {
    color: var(--accent);
    padding-top: 0.12rem;
  }

  @media (max-width: 960px) {
    .page-grid {
      grid-template-columns: 1fr;
    }

    .sidebar-card {
      position: static;
      max-height: none;
      overflow: visible;
    }

    .version-nav {
      max-height: 18rem;
    }
  }

  @media (max-width: 720px) {
    .changelog-shell {
      padding: 1.5rem 1rem 3rem;
    }

    .hero-card {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .version-summary {
      flex-direction: column;
      padding: 1rem;
    }

    .summary-actions {
      width: 100%;
      justify-content: space-between;
    }

    .version-summary h2 {
      font-size: 1.65rem;
    }

    .changelog-list-item {
      grid-template-columns: 2.5rem minmax(0, 1fr);
    }

    .item-arrow {
      display: none;
    }
  }
</style>
