---
import ChangelogEntries from '../../components/changelog/ChangelogEntries.astro';
import ChangelogSearch from '../../components/changelog/ChangelogSearch.astro';
import { PREVIEW_ITEMS, PREVIEW_RELEASES, formatCount, getReleases, releaseHref } from '../../components/changelog/format';
import PageHero from '../../components/PageHero.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { CHANGELOG_SOURCE_URL } from '../../data/changelog';

const versionCards = getReleases();
const totalItems = versionCards.reduce((sum, version) => sum + version.changeCount, 0);
const totalFixes = versionCards.reduce((sum, version) => sum + version.fixCount, 0);
const latest = versionCards[0];
const largest = versionCards.reduce((max, version) => (version.entries.length > max.entries.length ? version : max), latest);
const scale = (count: number) => Math.sqrt(count) / Math.sqrt(largest.entries.length);
const pct = (value: number) => `${(value * 100).toFixed(2)}%`;

const previews = versionCards.slice(0, PREVIEW_RELEASES).map((version) => {
	const showAll = version.entries.length <= PREVIEW_ITEMS * 1.5;
	const entries = showAll ? version.entries : version.entries.slice(0, PREVIEW_ITEMS);
	return { ...version, preview: entries, remaining: version.entries.length - entries.length };
});
const previewed = new Set(previews.map((version) => version.version));
const pulse = [...versionCards].reverse();

const latestWeeklyDeck = {
	date: '2026-06-14',
	href: '/openclaw-changelog/2026-06-14.html',
	headline: 'Three releases, one quiet win: the channel that used to die silently now stays alive',
	lead: 'This was a plumbing week. Not a feature parade. OpenClaw shipped 2026.6.5, 2026.6.6, and the 2026.6.8 pre-release with the through-line of recovery: safer approvals, reproducible installs, and the session lock leak fixed at the root.',
};

const weeklyDecks = [
	{ date: '2026-06-14', title: 'OpenClaw Weekly Dev Experience - 2026-06-14' },
	{ date: '2026-05-01', title: 'Weekly Claw - May 1, 2026' },
	{ date: '2026-04-24', title: 'OpenClaw Weekly Dev Experience - 2026-04-24' },
	{ date: '2026-04-17', title: 'OpenClaw Weekly Dev Experience - 2026-04-17' },
	{ date: '2026-04-10', title: 'OpenClaw Weekly Changelog Review - 2026-04-10' },
	{ date: '2026-03-30', title: 'OpenClaw Weekly Changelog Review - 2026-03-30' },
	{ date: '2026-03-27', title: 'OpenClaw Weekly Changelog Review - Week of March 27' },
	{ date: '2026-03-20', title: 'OpenClaw Weekly Changelog Review - Week of March 20' },
];
---
<SiteLayout title="OpenClaw Changelog & Feature Tracker" description="A clean release reference for OpenClaw versions, shipped items, and upstream changelog links." mainClass="cl-page">
	<div class="ds-shell cl-back"><a href="javascript:history.back()" class="back-link">← Back to Resources</a></div>
	<PageHero eyebrow="OpenClaw releases" title="OpenClaw Changelog & Feature Tracker" lede="A working reference for the Enterprise Crew. Scan what shipped by version, open the upstream release notes, and follow each listed item back to its source when a PR or issue is available." size="md" id="changelog-title">
		<a class="ds-btn" href={`#v-${latest.version}`}>Latest: {latest.version} <span aria-hidden="true">↓</span></a>
		<a class="ds-btn ds-btn--ghost" href={CHANGELOG_SOURCE_URL} target="_blank" rel="noopener noreferrer">Upstream changelog <span aria-hidden="true">↗</span></a>
		<div slot="aside" class="cl-pulse ds-panel" data-no-reveal>
			<div class="ds-stats cl-stats">
				<div class="ds-stat"><b>{versionCards.length}</b><span>release sections</span></div>
				<div class="ds-stat"><b>{formatCount(totalItems)}</b><span>listed changes</span></div>
				<div class="ds-stat"><b>{formatCount(totalFixes)}</b><span>fix entries</span></div>
			</div>
			<div class="cl-pulse-chart" role="list" aria-label="Entries per release, oldest to newest">
				{pulse.map((version) => (
					<a role="listitem" href={releaseHref(version)} style={`--h:${pct(Math.max(0.08, scale(version.entries.length)))}`} class:list={{ 'is-latest': version === latest }} aria-label={`${version.version}: ${formatCount(version.changeCount)} changes, ${formatCount(version.fixCount)} fixes`} title={`${version.version} · ${formatCount(version.entries.length)} entries`}><i></i></a>
				))}
			</div>
			<div class="cl-pulse-axis" aria-hidden="true"><span>{pulse[0].version}</span><span>Entries per release</span><span>{latest.version}</span></div>
		</div>
	</PageHero>

	<div class="ds-shell">
		<section class="weekly-deck-card ds-card ds-card--feature" aria-labelledby="weekly-deck-title">
			<div class="weekly-deck-main">
				<span class="ds-eyebrow">Latest weekly DX deck</span>
				<h2 class="ds-h2" id="weekly-deck-title"><a href={latestWeeklyDeck.href}>{latestWeeklyDeck.headline}</a></h2>
				<p>{latestWeeklyDeck.lead}</p>
				<a class="ds-btn deck-link" href={latestWeeklyDeck.href}>Open {latestWeeklyDeck.date} deck <span aria-hidden="true">↗</span></a>
			</div>
			<nav class="weekly-deck-archive" aria-label="Weekly dev experience decks">
				<span class="ds-card-kicker">Deck archive</span>
				<ul>
					{weeklyDecks.map((deck) => (
						<li><a href={`/openclaw-changelog/${deck.date}.html`}><time datetime={deck.date}>{deck.date}</time><span>{deck.title}</span></a></li>
					))}
				</ul>
			</nav>
		</section>

		<section class="ds-section cl-releases" id="releases" aria-labelledby="releases-title">
			<div class="ds-section-head">
				<div class="cl-section-title">
					<span class="ds-eyebrow">Versions</span>
					<h2 class="ds-h2" id="releases-title">Every release, newest first</h2>
				</div>
				<a href={CHANGELOG_SOURCE_URL} target="_blank" rel="noopener noreferrer">Upstream source <span aria-hidden="true">↗</span></a>
			</div>

			<ChangelogSearch id="feature-search" placeholder="Memory, Codex, Matrix, 2026.4.10..." idleStatus={`${formatCount(totalItems + totalFixes)} entries · ${versionCards.length} releases`} />

			<ol class="cl-index" data-cl-hide-on-search data-no-reveal>
				{versionCards.map((version) => (
					<li class="cl-rel" id={previewed.has(version.version) ? undefined : `v-${version.version}`} data-version={version.version}>
						<div class="cl-rel-id">
							<a class="cl-rel-link" href={releaseHref(version)}><span class="cl-rel-version">{version.version}</span></a>
							<span class="cl-rel-badges">
								{version === latest && <span class="ds-badge ds-badge--live">Latest</span>}
								{version === largest && <span class="ds-badge ds-badge--accent">Largest</span>}
								{version.date !== version.version && <span class="cl-rel-date">{version.date}</span>}
							</span>
						</div>
						<div class="cl-rel-volume">
							<span class="cl-rel-bar" style={`--w:${pct(scale(version.entries.length))};--c:${pct(version.changeCount / version.entries.length)}`} aria-hidden="true"><i></i></span>
							<span class="cl-rel-counts"><b>{formatCount(version.changeCount)}</b> changes<span aria-hidden="true"> · </span><b>{formatCount(version.fixCount)}</b> fixes</span>
						</div>
						<ul class="cl-rel-highlights" aria-label={`${version.version} highlights`}>
							{version.highlights.map((highlight) => <li>{highlight}</li>)}
						</ul>
						<div class="cl-rel-actions">
							<a class="cl-rel-up" href={version.fullChangelogHref} target="_blank" rel="noopener noreferrer" aria-label={`${version.version} upstream release notes`}>Upstream ↗</a>
							<span class="cl-rel-go" aria-hidden="true">→</span>
						</div>
					</li>
				))}
			</ol>

			<div class="cl-latest" id="latest" data-cl-hide-on-search>
				<div class="ds-section-head cl-latest-head">
					<div class="cl-section-title">
						<span class="ds-eyebrow">In detail</span>
						<h2 class="ds-h2">The latest {previews.length} releases</h2>
					</div>
				</div>
				{previews.map((version, versionIndex) => (
					<article class="cl-detail" id={`v-${version.version}`} data-version={version.version} aria-labelledby={`title-${version.slug}`}>
						<header class="cl-detail-head">
							<div class="cl-detail-id">
								<span class="ds-card-kicker">Release{versionIndex === 0 ? ' · Latest' : ''}</span>
								<h3 class="cl-detail-title" id={`title-${version.slug}`}><a href={releaseHref(version)}>{version.version}</a></h3>
								<span class="ds-meta"><span>{formatCount(version.changeCount)} changes</span><span>{formatCount(version.fixCount)} fixes</span>{version.date !== version.version && <span>{version.date}</span>}</span>
							</div>
							<div class="cl-detail-actions">
								<a class="ds-btn ds-btn--ghost summary-link" href={version.fullChangelogHref} target="_blank" rel="noopener noreferrer">Open upstream <span aria-hidden="true">↗</span></a>
								<a class="ds-btn" href={releaseHref(version)}>Full release <span aria-hidden="true">→</span></a>
							</div>
						</header>
						<ChangelogEntries entries={version.preview} changeCount={version.changeCount} fixCount={version.fixCount} version={version.version} />
						{version.remaining > 0 && (
							<a class="cl-detail-more" href={releaseHref(version)}>
								<span><b>{formatCount(version.remaining)} more entries</b> in {version.version}{version.pages > 1 ? `, across ${version.pages} pages` : ''}</span>
								<span aria-hidden="true">→</span>
							</a>
						)}
					</article>
				))}
			</div>
		</section>
	</div>
</SiteLayout>

<style>
	.cl-back { padding-top: clamp(20px, 3vw, 36px); margin-bottom: calc(clamp(44px, 7vw, 108px) * -1 + 12px); }
	.back-link { display: inline-flex; align-items: center; min-height: 44px; color: var(--muted); font-size: 13px; font-weight: 700; transition: color .2s ease; }
	.back-link:hover { color: var(--accent); }

	.cl-pulse { display: grid; gap: 22px; padding: clamp(22px, 2.4vw, 30px); border-radius: var(--radius-lg); }
	.cl-stats { display: grid; grid-template-columns: repeat(3, auto); justify-content: space-between; gap: 18px; }
	.cl-stats .ds-stat b { font-size: clamp(32px, 3.2vw, 46px); }
	.cl-pulse-chart { display: flex; align-items: end; gap: 4px; height: 104px; padding-bottom: 1px; border-bottom: 1px solid var(--border); }
	.cl-pulse-chart a { flex: 1; display: flex; align-items: end; height: 100%; min-width: 0; }
	.cl-pulse-chart i { display: block; width: 100%; height: var(--h); border-radius: 4px 4px 1px 1px; background: linear-gradient(180deg, var(--accent), color-mix(in srgb, var(--accent) 30%, transparent)); opacity: .55; transform-origin: bottom; transition: opacity .2s ease, transform .3s var(--ease-out); animation: cl-grow .9s var(--ease-out) backwards; }
	.cl-pulse-chart a:nth-child(3n) i { animation-delay: .06s; }
	.cl-pulse-chart a:nth-child(3n + 1) i { animation-delay: .12s; }
	.cl-pulse-chart a.is-latest i { opacity: 1; background: linear-gradient(180deg, var(--accent-2), var(--accent)); box-shadow: 0 0 18px var(--glow); }
	.cl-pulse-chart a:hover i, .cl-pulse-chart a:focus-visible i { opacity: 1; transform: scaleY(1.04); }
	@keyframes cl-grow { from { transform: scaleY(0); } }
	.cl-pulse-axis { display: flex; justify-content: space-between; gap: 8px; margin-top: -12px; color: var(--faint); font: 650 10.5px/1 var(--font-mono); letter-spacing: .06em; }
	.cl-pulse-axis span:nth-child(2) { text-transform: uppercase; letter-spacing: .14em; }

	.weekly-deck-card { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(260px, .8fr); gap: clamp(24px, 4vw, 56px); background: radial-gradient(circle at 0% 0%, color-mix(in srgb, var(--accent-2) 14%, transparent), transparent 46%), radial-gradient(circle at 100% 100%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 50%), var(--surface); }
	.weekly-deck-main { display: grid; gap: 16px; justify-items: start; align-content: start; }
	.weekly-deck-main h2 a { color: var(--text); transition: color .2s ease; }
	.weekly-deck-main h2 a:hover { color: var(--accent); }
	.weekly-deck-main p { max-width: 44rem; color: var(--text-soft); font-size: 16px; line-height: 1.65; }
	.weekly-deck-archive { display: grid; gap: 12px; align-content: start; padding-left: clamp(0px, 3vw, 40px); border-left: 1px solid var(--border); }
	.weekly-deck-archive ul { list-style: none; margin: 0; padding: 0; display: grid; }
	.weekly-deck-archive a { display: grid; grid-template-columns: 92px minmax(0, 1fr); gap: 12px; align-items: center; min-height: 44px; padding: 6px 0; border-bottom: 1px solid color-mix(in srgb, var(--border) 70%, transparent); color: var(--text-soft); font-size: 13.5px; transition: color .2s ease, transform .3s var(--ease-out); }
	.weekly-deck-archive li:last-child a { border-bottom: 0; }
	.weekly-deck-archive time { color: var(--accent); font: 700 11.5px/1 var(--font-mono); }
	.weekly-deck-archive span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.weekly-deck-archive a:hover { color: var(--text); transform: translateX(3px); }

	.cl-section-title { display: grid; gap: 12px; }
	.cl-index { list-style: none; margin: 0; padding: 0; display: grid; border-top: 1px solid var(--border); }
	.cl-index[hidden], .cl-latest[hidden] { display: none; }
	.cl-rel { position: relative; display: grid; grid-template-columns: minmax(150px, .7fr) minmax(170px, .8fr) minmax(0, 2fr) auto; gap: 28px; align-items: center; padding: 22px 16px; margin: 0 -16px; border-bottom: 1px solid var(--border); border-radius: var(--radius-md); scroll-margin-top: calc(var(--chrome-top) + 110px); transition: background-color .25s ease; }
	.cl-rel:target { background: color-mix(in srgb, var(--accent-soft) 60%, transparent); }
	.cl-rel-id { display: grid; gap: 8px; justify-items: start; }
	.cl-rel-link { color: var(--text); }
	.cl-rel-link::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
	.cl-rel-version { font: 500 clamp(26px, 2.4vw, 34px)/1 var(--font-display); letter-spacing: -.04em; font-variant-numeric: tabular-nums; transition: color .2s ease; }
	.cl-rel-badges { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; min-height: 24px; }
	.cl-rel-date { color: var(--muted); font: 650 12px/1 var(--font-mono); }
	.cl-rel-volume { display: grid; gap: 10px; }
	.cl-rel-bar { position: relative; display: block; height: 8px; border-radius: 999px; background: color-mix(in srgb, var(--border) 70%, transparent); overflow: hidden; }
	.cl-rel-bar i { position: absolute; inset: 0 auto 0 0; width: var(--w); border-radius: inherit; background: linear-gradient(90deg, var(--accent) 0 var(--c), var(--success) var(--c) 100%); box-shadow: 0 0 14px color-mix(in srgb, var(--glow) 70%, transparent); }
	.cl-rel-counts { color: var(--muted); font-size: 12.5px; white-space: nowrap; }
	.cl-rel-counts b { color: var(--text); font-weight: 700; font-variant-numeric: tabular-nums; }
	.cl-rel-highlights { list-style: none; margin: 0; padding: 0; display: grid; gap: 5px; min-width: 0; }
	.cl-rel-highlights li { position: relative; padding-left: 16px; color: var(--text-soft); font-size: 14px; line-height: 1.45; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.cl-rel-highlights li::before { content: ''; position: absolute; left: 0; top: .6em; width: 6px; height: 1px; background: var(--accent); }
	.cl-rel-actions { position: relative; z-index: 1; display: flex; align-items: center; gap: 14px; }
	.cl-rel-up { display: inline-flex; align-items: center; min-height: 44px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--border); background: color-mix(in srgb, var(--panel) 80%, transparent); color: var(--muted); font-size: 12px; font-weight: 750; white-space: nowrap; transition: color .2s ease, border-color .2s ease; }
	.cl-rel-up:hover { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
	.cl-rel-go { color: var(--accent); font-size: 18px; transition: transform .35s var(--ease-out); }
	@media (hover: hover) {
		.cl-rel:hover { background: color-mix(in srgb, var(--panel-soft) 70%, transparent); }
		.cl-rel:hover .cl-rel-version { color: var(--accent); }
		.cl-rel:hover .cl-rel-go { transform: translateX(4px); }
	}

	.cl-latest { margin-top: clamp(56px, 7vw, 96px); display: grid; gap: clamp(28px, 4vw, 48px); }
	.cl-latest-head { margin-bottom: 0; }
	.cl-detail { display: grid; gap: 26px; padding: clamp(22px, 3vw, 40px); border-radius: var(--radius-xl); border: 1px solid var(--surface-border); background: var(--surface); scroll-margin-top: calc(var(--chrome-top) + 90px); }
	.cl-detail-head { display: flex; align-items: end; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
	.cl-detail-id { display: grid; gap: 12px; }
	.cl-detail-title { font: 500 clamp(40px, 4.6vw, 64px)/.95 var(--font-display); letter-spacing: -.05em; }
	.cl-detail-title a { color: var(--text); transition: color .2s ease; }
	.cl-detail-title a:hover { color: var(--accent); }
	.cl-detail-actions { display: flex; flex-wrap: wrap; gap: 10px; }
	.cl-detail-more { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 60px; padding: 0 22px; border-radius: var(--radius-md); border: 1px dashed color-mix(in srgb, var(--accent) 40%, var(--border)); color: var(--text-soft); font-size: 14.5px; transition: background-color .2s ease, border-color .2s ease; }
	.cl-detail-more b { color: var(--text); }
	.cl-detail-more > span:last-child { color: var(--accent); font-size: 18px; transition: transform .35s var(--ease-out); }
	.cl-detail-more:hover { background: var(--accent-soft); border-style: solid; }
	.cl-detail-more:hover > span:last-child { transform: translateX(4px); }

	@media (max-width: 1100px) {
		.cl-rel { grid-template-columns: minmax(130px, .6fr) minmax(0, 1.6fr) auto; }
		.cl-rel-volume { grid-column: 2; grid-row: 1; }
		.cl-rel-highlights { grid-column: 1 / 3; grid-row: 2; }
		.cl-rel-actions { grid-column: 3; grid-row: 1 / 3; }
	}
	@media (max-width: 980px) {
		.cl-back { margin-bottom: -40px; }
		.weekly-deck-card { grid-template-columns: 1fr; }
		.weekly-deck-archive { padding-left: 0; padding-top: 20px; border-left: 0; border-top: 1px solid var(--border); }
	}
	@media (max-width: 760px) {
		.cl-back { padding-top: 10px; margin-bottom: -26px; }
		.cl-pulse { padding: 20px; }
		.cl-stats { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
		.cl-stats .ds-stat b { font-size: 30px; }
		.cl-stats .ds-stat span { font-size: 9.5px; letter-spacing: .12em; }
		.cl-pulse-chart { height: 76px; gap: 3px; }
		.cl-pulse-axis span:nth-child(2) { display: none; }
		.weekly-deck-main .ds-btn { width: 100%; }
		.weekly-deck-archive a { grid-template-columns: 84px minmax(0, 1fr); }
		.cl-rel { grid-template-columns: minmax(0, 1fr) auto; gap: 14px 12px; padding: 18px 10px; margin: 0 -10px; }
		.cl-rel-id { grid-column: 1; grid-row: 1; grid-auto-flow: column; justify-content: start; align-items: center; gap: 10px; }
		.cl-rel-version { font-size: 28px; }
		.cl-rel-volume { grid-column: 1 / -1; grid-row: 2; }
		.cl-rel-highlights { grid-column: 1 / -1; grid-row: 3; }
		.cl-rel-highlights li { white-space: normal; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
		.cl-rel-highlights li:nth-child(n + 3) { display: none; }
		.cl-rel-actions { grid-column: 2; grid-row: 1; }
		.cl-rel-go { display: none; }
		.cl-rel:active { background: color-mix(in srgb, var(--panel-soft) 70%, transparent); }
		.cl-detail { padding: 20px 18px; border-radius: var(--radius-lg); }
		.cl-detail-actions { width: 100%; display: grid; grid-template-columns: 1fr 1fr; }
		.cl-detail-actions .ds-btn { padding: 0 12px; }
		.cl-detail-more { padding: 14px 16px; }
	}
	@media (prefers-reduced-motion: reduce) {
		.cl-pulse-chart i { animation: none; transition: none; }
		.cl-rel, .cl-rel-go, .cl-detail-more > span:last-child, .weekly-deck-archive a { transition: none; }
	}
</style>
