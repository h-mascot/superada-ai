---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import AudioPlayer from '../../../components/AudioPlayer.astro';
import sourceText from '../../../data/mods/meeting-summary-2026-05-20-to-2026-05-27.md?raw';

const slug = 'community-staff-meeting-summary-2026-05-20-to-2026-05-27';
const title = 'OpenClaw Community Staff Voice Chat Summary | SuperAda';
const description = 'Passworded mod summary for the OpenClaw community staff voice chat covering May 20 through May 27, 2026.';
const textViewHref = `/mods/${slug}/text.txt`;
const sourceLines = sourceText.split(/\r?\n/);
const headline = sourceLines.find((line) => line.startsWith('# '))?.replace(/^#\s+/, '') ?? 'Meeting Summary';
const dateRange = sourceLines.find((line) => line.startsWith('Date range requested:'))?.replace('Date range requested:', '').trim() ?? 'May 20–27, 2026';
const capturedDate = sourceLines.find((line) => line.startsWith('Captured meeting date:'))?.replace('Captured meeting date:', '').trim() ?? 'May 23, 2026';
const sections = sourceText.match(/^##\s+/gm)?.length ?? 0;
const actionItems = sourceLines.filter((line) => line.startsWith('- ')).length;

function escapeHtml(value: string) {
  return value
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function renderInline(value: string) {
  return escapeHtml(value)
    .replace(/`([^`]+)`/g, '<code>$1</code>')
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
    .replace(/\"([^\"]+)\"/g, '&ldquo;$1&rdquo;');
}

function renderMarkdown(markdown: string) {
  const lines = markdown.split(/\r?\n/);
  let html = '';
  let inList = false;

  const closeList = () => {
    if (inList) {
      html += '</ul>';
      inList = false;
    }
  };

  for (const line of lines) {
    const trimmed = line.trim();

    if (!trimmed) {
      closeList();
      continue;
    }

    if (trimmed.startsWith('# ')) {
      closeList();
      html += `<h2>${renderInline(trimmed.replace(/^#\s+/, ''))}</h2>`;
      continue;
    }

    if (trimmed.startsWith('## ')) {
      closeList();
      html += `<h2>${renderInline(trimmed.replace(/^##\s+/, ''))}</h2>`;
      continue;
    }

    if (trimmed.startsWith('### ')) {
      closeList();
      html += `<h3>${renderInline(trimmed.replace(/^###\s+/, ''))}</h3>`;
      continue;
    }

    if (trimmed.startsWith('- ')) {
      if (!inList) {
        html += '<ul>';
        inList = true;
      }
      html += `<li>${renderInline(trimmed.replace(/^-\s+/, ''))}</li>`;
      continue;
    }

    closeList();
    html += `<p>${renderInline(trimmed)}</p>`;
  }

  closeList();
  return html;
}

const renderedSummary = renderMarkdown(sourceText);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <meta name="robots" content="noindex,nofollow" />
  </head>
  <body style="background:var(--bg); color:var(--text); min-height:100vh;">
    <Header />
    <main class="mod-summary-shell">
      <section class="hero-card">
        <div class="eyebrow">Passworded mod brief · HTML view</div>
        <h1>{headline}</h1>
        <p class="lede">
          A cleaner reading surface for the community staff voice chat summary. The exact source text is preserved separately, byte-for-byte, in the text view.
        </p>
        <div class="hero-actions">
          <a href={textViewHref}>Open exact text view</a>
          <a href="/mods/community-engagement/">Discord analytics dashboard</a>
        </div>
      </section>

      <section class="stat-grid" aria-label="Summary metadata">
        <article>
          <span>Date range</span>
          <strong>{dateRange}</strong>
        </article>
        <article>
          <span>Captured meeting</span>
          <strong>{capturedDate}</strong>
        </article>
        <article>
          <span>Sections</span>
          <strong>{sections}</strong>
        </article>
        <article>
          <span>Bullet items</span>
          <strong>{actionItems}</strong>
        </article>
      </section>

      <section class="notice-card">
        <div>
          <strong>Two views:</strong> this HTML view is formatted for reading. The linked text view returns the original Markdown exactly as provided.
        </div>
        <div>
          <strong>Audio:</strong> browser TTS is enabled below using SuperAda's Book voice preference. Small mercy for long mod notes.
        </div>
      </section>

      <AudioPlayer author="book" />

      <article class="prose mod-prose" set:html={renderedSummary} />
    </main>
    <Footer />
  </body>
</html>

<style>
  .mod-summary-shell {
    max-width: 980px;
    margin: 0 auto;
    padding: 3rem 1.25rem 4rem;
  }

  .hero-card,
  .notice-card,
  .mod-prose,
  .stat-grid article {
    border: 1px solid var(--border);
    background: var(--panel);
    border-radius: 18px;
  }

  .hero-card {
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: linear-gradient(135deg, var(--panel) 0%, #111827 55%, #0f0c0a 100%);
    margin-bottom: 1.25rem;
  }

  .eyebrow {
    color: var(--accent);
    font-size: 0.76rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 0.85rem;
  }

  h1 {
    font-family: Georgia, serif;
    font-size: clamp(2.25rem, 5vw, 4.1rem);
    line-height: 1.02;
    font-weight: 400;
    margin: 0 0 1rem;
  }

  .lede {
    font-size: 1.13rem;
    color: var(--text-soft);
    line-height: 1.75;
    max-width: 820px;
    margin: 0;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .hero-actions a {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text);
    text-decoration: none;
    padding: 0.65rem 0.95rem;
    background: rgba(255,255,255,0.04);
  }

  .hero-actions a:first-child {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
  }

  .stat-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .stat-grid article {
    padding: 1rem;
  }

  .stat-grid span {
    display: block;
    color: var(--muted);
    font-size: 0.78rem;
    margin-bottom: 0.35rem;
  }

  .stat-grid strong {
    color: var(--text);
    font-size: 1.05rem;
    line-height: 1.35;
  }

  .notice-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    padding: 1.1rem;
    color: var(--text-soft);
    line-height: 1.65;
    margin-bottom: 1.25rem;
  }

  .notice-card strong {
    color: var(--text);
  }

  .mod-prose {
    padding: clamp(1.25rem, 3vw, 2rem);
    line-height: 1.78;
    color: var(--text-soft);
  }

  .mod-prose :global(h2) {
    font-family: Georgia, serif;
    color: var(--text);
    font-weight: 400;
    font-size: clamp(1.55rem, 3vw, 2.2rem);
    line-height: 1.2;
    margin: 2.2rem 0 0.8rem;
  }

  .mod-prose :global(h2:first-child) {
    margin-top: 0;
  }

  .mod-prose :global(h3) {
    color: var(--accent);
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 1.7rem 0 0.6rem;
  }

  .mod-prose :global(p) {
    margin: 0 0 1rem;
  }

  .mod-prose :global(ul) {
    margin: 0 0 1.25rem;
    padding-left: 1.25rem;
  }

  .mod-prose :global(li) {
    margin: 0.4rem 0;
  }

  .mod-prose :global(code) {
    color: var(--accent);
    background: rgba(255,255,255,0.06);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 0.05rem 0.3rem;
  }

  @media (max-width: 760px) {
    .stat-grid,
    .notice-card {
      grid-template-columns: 1fr;
    }
  }
</style>
