---
import { getCollection } from 'astro:content';
import PageHero from '../../components/PageHero.astro';
import CatalogCard from '../../components/catalog/CatalogCard.astro';
import CatalogCrossBand from '../../components/catalog/CatalogCrossBand.astro';
import CatalogFilterBar from '../../components/catalog/CatalogFilterBar.astro';
import CatalogHeroMeta from '../../components/catalog/CatalogHeroMeta.astro';
import CatalogStats from '../../components/catalog/CatalogStats.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { catalogs, countBy, statusTone } from '../../lib/catalog';

const workflows = (await getCollection('workflows'))
  .filter((workflow) => !workflow.data.isTemplate)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const categories = ['All', ...new Set(workflows.map((workflow) => workflow.data.category))];
const classificationLabels = {
  local: 'Local bundle',
  external: 'External bundle',
  conceptual: 'Conceptual workflow',
} as const;
const reviewModeLabels = {
  manual: 'Manual verification',
  'source-review': 'Source review',
  conceptual: 'Concept review',
} as const;
const installabilityLabels = {
  'openclaw-skill': 'OpenClaw install',
  script: 'Script install',
  prompt: 'Prompt run',
  manual: 'Manual install',
  concept: 'Concept only',
} as const;

const byStatus = countBy(workflows, (workflow) => workflow.data.status);
const byCategory = countBy(workflows, (workflow) => workflow.data.category);
const installableNow = workflows.filter((workflow) => workflow.data.bundle.installable.supported).length;
const chips = categories.map((category) => ({ value: category, label: category, count: category === 'All' ? workflows.length : byCategory.get(category) ?? 0 }));
const otherCatalogs = catalogs.filter((catalog) => catalog.href !== '/workflows/');
---

<SiteLayout
  title="Workflow Marketplace — SuperAda"
  description="Browse workflow bundles and workflow patterns for operations, publishing, research, and security, with availability labels that reflect reality."
>
  <PageHero
    eyebrow="Workflow Marketplace"
    title="Workflows and bundles"
    lede="Browse real installable bundles plus prompt-driven and conceptual workflow patterns for operator work. Each listing now says whether it is local, external, or still just a blueprint."
    id="workflows-title"
  >
    <Fragment slot="title">Workflows <em>and</em> bundles</Fragment>
    <CatalogHeroMeta>
      <a class="ds-btn" href="#catalog">Browse {workflows.length} workflows <span aria-hidden="true">↓</span></a>
      {otherCatalogs.map((catalog) => <a class="ds-btn ds-btn--ghost" href={catalog.href}>{catalog.title}</a>)}
    </CatalogHeroMeta>
    <CatalogStats
      slot="aside"
      label="Workflows by status"
      items={[
        { value: workflows.length, label: 'Workflows' },
        { value: byStatus.get('Live') ?? 0, label: 'Live', tone: 'live' },
        { value: byStatus.get('Internal') ?? 0, label: 'Internal', tone: 'info' },
        { value: byStatus.get('Draft') ?? 0, label: 'Draft', tone: 'warn' },
      ]}
      caption={`${installableNow} of ${workflows.length} are installable now. The rest are reviewed as prompts or designs until real artifacts exist.`}
    />
  </PageHero>

  <section class="ds-shell cat-catalog" id="catalog" aria-labelledby="catalog-title">
    <div class="ds-section-head cat-catalog-head">
      <div>
        <h2 class="ds-h2" id="catalog-title">All workflows</h2>
        <p>That means no more pretending every listing ships as local artifacts in this repo. Review the source, install path, and verification mode before rollout.</p>
      </div>
    </div>

    <CatalogFilterBar label="Filter workflows by category" chips={chips} target="#workflow-grid" noun={['workflow', 'workflows']} chipClass="filter-chip">
      <div class="ds-grid ds-grid--2 cat-grid" id="workflow-grid">
        {workflows.map((workflow) => (
          <CatalogCard
            href={`/workflows/${workflow.id}/`}
            title={workflow.data.title}
            tagline={workflow.data.tagline}
            summary={workflow.data.summary}
            badges={[
              { label: workflow.data.status, tone: statusTone(workflow.data.status) },
              { label: workflow.data.category, tone: 'plain' },
              { label: workflow.data.difficulty, tone: 'plain' },
              { label: classificationLabels[workflow.data.bundle.classification], tone: 'plain' },
              { label: `v${workflow.data.bundle.version}`, tone: 'plain' },
            ]}
            facts={[
              { label: 'Availability', value: workflow.data.bundle.availabilityNote },
              { label: 'Artifacts', value: `${workflow.data.bundle.artifactCount} described items` },
              { label: 'Install and review', value: `${workflow.data.bundle.installable.supported ? 'Installable now' : 'Not installable yet'} · ${installabilityLabels[workflow.data.bundle.installable.method]} · ${reviewModeLabels[workflow.data.verification.mode]}` },
            ]}
            command={workflow.data.installCommand}
            meta={[workflow.data.estimatedSetup]}
            cta="View details"
            attrs={{
              'data-category': workflow.data.category,
              'data-title': workflow.data.title.toLowerCase(),
              'data-summary': workflow.data.summary.toLowerCase(),
            }}
          />
        ))}
      </div>
    </CatalogFilterBar>
  </section>

  <CatalogCrossBand current="/workflows/" title="Looking for a single capability?" copy="Skills are the individual building blocks behind these workflows. Plugins enforce behavior inside the live runtime." />

  <script is:inline slot="after">
    (() => {
      window.filterWorkflows = (category) => document.querySelector('[data-cat-filter]')?.catFilter?.(category);
    })();
  </script>
</SiteLayout>

<style>
  .cat-catalog { scroll-margin-top: var(--chrome-top); }
  .cat-catalog-head p { max-width: 44rem; margin-top: 10px; color: var(--muted); font-size: 15px; line-height: 1.6; }
  .cat-grid { gap: 18px; }
  .cat-grid :global(.cat-card-facts) { grid-template-columns: minmax(0, .7fr) minmax(0, 1fr); }
  .cat-grid :global(.cat-card-facts > div:first-child) { grid-column: 1 / -1; }
  @media (max-width: 760px) {
    .cat-grid { gap: 12px; }
  }
</style>
