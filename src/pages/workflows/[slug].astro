---
import { getCollection, getEntry } from 'astro:content';
import CopyButton from '../../components/CopyButton.astro';
import PageHero from '../../components/PageHero.astro';
import CatalogCode from '../../components/catalog/CatalogCode.astro';
import CatalogDetail from '../../components/catalog/CatalogDetail.astro';
import CatalogFacts from '../../components/catalog/CatalogFacts.astro';
import CatalogFields from '../../components/catalog/CatalogFields.astro';
import CatalogHeroMeta from '../../components/catalog/CatalogHeroMeta.astro';
import CatalogList from '../../components/catalog/CatalogList.astro';
import CatalogMiniList from '../../components/catalog/CatalogMiniList.astro';
import CatalogPanel from '../../components/catalog/CatalogPanel.astro';
import CatalogRelated from '../../components/catalog/CatalogRelated.astro';
import CatalogRows from '../../components/catalog/CatalogRows.astro';
import CatalogSteps from '../../components/catalog/CatalogSteps.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { neighbours, statusTone } from '../../lib/catalog';

export async function getStaticPaths() {
  const workflows = (await getCollection('workflows')).filter((workflow) => !workflow.data.isTemplate);
  return workflows.map((workflow) => ({ params: { slug: workflow.id } }));
}

const { slug } = Astro.params;
if (!slug) throw new Error('Missing workflow slug');

const workflow = await getEntry('workflows', slug);
if (!workflow) throw new Error(`Workflow not found: ${slug}`);

const allWorkflows = (await getCollection('workflows')).filter((entry) => !entry.data.isTemplate);
const relatedWorkflows = allWorkflows
  .filter((entry) => entry.id !== workflow.id && entry.data.category === workflow.data.category)
  .slice(0, 2);

const classificationLabels = {
  local: 'Local bundle',
  external: 'External bundle',
  conceptual: 'Conceptual workflow',
} as const;
const installModeLabels = {
  manual: 'Manual install',
  'agent-installable': 'Agent-installable',
  'prompt-only': 'Prompt-driven',
} as const;
const reviewStatusLabels = {
  'manual-review': 'Manual review',
  'source-review': 'Source review',
  'concept-review': 'Concept review',
} as const;
const verificationModeLabels = {
  manual: 'Manual verification',
  'source-review': 'Source review',
  conceptual: 'Concept review',
} as const;
const installabilityLabels = {
  'openclaw-skill': 'Installable via OpenClaw skill source',
  script: 'Installable via script',
  prompt: 'Prompt-run workflow',
  manual: 'Manual operator install',
  concept: 'Concept only',
} as const;

const { data } = workflow;
const { bundle, verification } = data;
const installable = bundle.installable;

const toLink = (entry: typeof workflow) => ({
  href: `/workflows/${entry.id}/`,
  title: entry.data.title,
  tagline: entry.data.tagline,
  badges: [
    { label: entry.data.status, tone: statusTone(entry.data.status) },
    { label: entry.data.category, tone: 'plain' as const },
  ],
});
const sorted = [...allWorkflows].sort((a, b) => a.data.title.localeCompare(b.data.title)).map(toLink);
const moreWorkflows = neighbours(sorted, sorted.findIndex((entry) => entry.href === `/workflows/${workflow.id}/`), new Set(relatedWorkflows.map((entry) => `/workflows/${entry.id}/`)));
---

<SiteLayout title={`${data.title} — Workflow Marketplace`} description={data.summary}>
  <PageHero eyebrow={`Workflow · ${data.category}`} title={data.title} lede={data.tagline} size="md">
    <CatalogHeroMeta
      badges={[
        { label: data.status, tone: statusTone(data.status) },
        { label: data.category, tone: 'plain' },
        { label: data.difficulty, tone: 'plain' },
        { label: classificationLabels[bundle.classification], tone: 'plain' },
        { label: `v${bundle.version}`, tone: 'plain' },
      ]}
    >
      {installable.supported
        ? <CopyButton text={data.installCommand} label="Copy install command" variant="button" />
        : <a class="ds-btn" href={data.sourceUrl}>View source <span aria-hidden="true">↗</span></a>}
      {installable.supported
        ? <a class="ds-btn ds-btn--ghost" href={data.sourceUrl}>View source</a>
        : <a class="ds-btn ds-btn--ghost" href="#install-contract">Install contract</a>}
    </CatalogHeroMeta>
  </PageHero>

  <CatalogDetail sideLabel="Workflow facts and related workflows">
    <CatalogPanel id="overview" eyebrow="Overview" title="What this workflow does">
      <p>{data.summary}</p>
    </CatalogPanel>

    <CatalogPanel id="availability" eyebrow="Availability" title="How it ships today">
      <CatalogFields
        items={[
          { label: 'Classification', value: classificationLabels[bundle.classification] },
          { label: 'Install mode', value: installModeLabels[bundle.installMode] },
          { label: 'Review status', value: reviewStatusLabels[bundle.reviewStatus] },
          { label: 'Verification mode', value: verificationModeLabels[verification.mode] },
        ]}
      />
      <p class="cat-muted">{bundle.availabilityNote}</p>
      {bundle.installSource && (
        <div class="cat-subblock">
          <h3>Install source</h3>
          <p>{bundle.installSource.label}</p>
          {bundle.installSource.url && <p><a href={bundle.installSource.url}>{bundle.installSource.url}</a></p>}
          {bundle.installSource.script && <CatalogCode code={bundle.installSource.script} copy="Copy" />}
        </div>
      )}
    </CatalogPanel>

    <CatalogPanel id="workflow-record" eyebrow="Workflow record" title="Bundle anatomy">
      <CatalogFields
        items={[
          { label: 'Bundle id', value: bundle.id, mono: true },
          { label: 'Entrypoint', value: bundle.entrypoint, mono: true },
          { label: 'Bundle root', value: bundle.bundleRoot, mono: true },
          { label: 'Artifact count', value: `${bundle.artifactCount} described items` },
        ]}
      />
      <p class="cat-muted">{bundle.summary}</p>
    </CatalogPanel>

    <CatalogPanel id="install-contract" eyebrow="Install contract" title="Can an agent install it now?">
      <CatalogFields
        items={[
          { label: 'Installability', value: installable.supported ? 'Truly installable now' : 'Not installable yet' },
          { label: 'Method', value: installabilityLabels[installable.method] },
          ...(installable.sourceSpec ? [{ label: 'Install source spec', value: installable.sourceSpec, mono: true }] : []),
        ]}
      />
      <CatalogCode label="Install command" code={data.installCommand} copy="Copy" />
      {installable.sourceUrl && (
        <p class="cat-muted">Canonical source: <a href={installable.sourceUrl}>{installable.sourceUrl}</a></p>
      )}
      <div class="cat-subblock">
        <h3>Agent steps</h3>
        <CatalogSteps steps={installable.instructions.map((detail) => ({ detail }))} label="Agent steps" prefix="Agent step" />
      </div>
      {installable.prompt && <CatalogCode label="Prompt" code={installable.prompt} copy="Copy" />}
      {installable.postInstallVerification && <CatalogCode label="Verification command" code={installable.postInstallVerification} copy="Copy" />}
      {installable.limitations && installable.limitations.length > 0 && (
        <div class="cat-subblock">
          <h3>Current limits</h3>
          <CatalogList items={installable.limitations} marker="warn" />
        </div>
      )}
    </CatalogPanel>

    <CatalogPanel id="install-steps" eyebrow="Setup" title="Install steps">
      <CatalogSteps steps={data.installSteps} label="Install steps" prefix="Step" />
      <p class="cat-note">If you hand an agent this workflow URL, this install contract is the source of truth for whether it can really install the bundle now, what source to use, and what still needs a human.</p>
    </CatalogPanel>

    <div class="cat-pair">
      <CatalogPanel id="outcomes" title="What you get">
        <CatalogList items={data.outcomes} marker="check" />
      </CatalogPanel>
      <CatalogPanel id="includes" title="Workflow includes">
        <CatalogList items={data.includes} />
      </CatalogPanel>
    </div>

    <CatalogPanel id="artifacts" eyebrow="Files" title="Described artifacts">
      <CatalogRows rows={data.artifacts.map((artifact) => ({ title: artifact.name, tag: `${artifact.type}${artifact.optional ? ' · optional' : ''}`, mono: artifact.path, detail: artifact.description }))} />
    </CatalogPanel>

    <CatalogPanel id="requirements" eyebrow="Before you start" title="Requirements">
      <CatalogRows rows={data.requirements.map((requirement) => ({ title: requirement.label, tag: requirement.type, detail: requirement.detail }))} />
    </CatalogPanel>

    <CatalogPanel id="structure" eyebrow="Layout" title="Declared structure">
      <div class="cat-tree"><CatalogList items={data.structure} mono /></div>
    </CatalogPanel>

    <CatalogPanel id="verification" eyebrow="Proof" title="Verification">
      <p class="cat-muted">Verification language now matches reality. Installable bundles can be tested after install, external bundles should be source-reviewed first, and conceptual entries are reviewed as designs until real artifacts exist.</p>
      <CatalogSteps steps={verification.checks.map((check) => ({ title: check.label, detail: check.detail, command: check.command, expected: check.expected }))} label="Verification checks" />
      <CatalogList items={verification.reviewNotes} />
    </CatalogPanel>

    <CatalogPanel id="use-cases" title="Best used for">
      <CatalogList items={data.useCases} marker="check" />
    </CatalogPanel>

    {data.notes && data.notes.length > 0 && (
      <CatalogPanel id="notes" eyebrow="From the operators" title="Operator notes">
        <CatalogList items={data.notes} />
      </CatalogPanel>
    )}

    <Fragment slot="side">
      <CatalogFacts
        title="Workflow facts"
        items={[
          { label: 'Status', value: data.status },
          { label: 'Category', value: data.category },
          { label: 'Difficulty', value: data.difficulty },
          { label: 'Version', value: `v${bundle.version}` },
          { label: 'Setup time', value: data.estimatedSetup },
          { label: 'Artifacts', value: String(bundle.artifactCount) },
          { label: 'Operators', value: data.operators.join(', '), wide: true },
          { label: 'Stack', value: data.stack.join(' · '), wide: true },
          { label: 'Source', value: data.sourceLabel, href: data.sourceUrl, wide: true },
          ...(data.repoPath ? [{ label: 'Repo path', value: data.repoPath, mono: true, wide: true }] : []),
        ]}
      >
        {installable.supported && <span class="cat-side-cta"><CopyButton text={data.installCommand} label="Copy install command" variant="button" /></span>}
      </CatalogFacts>
      <CatalogMiniList title="Related workflows" items={relatedWorkflows.map((entry) => ({ href: `/workflows/${entry.id}/`, title: entry.data.title, tagline: entry.data.tagline }))} />
    </Fragment>
  </CatalogDetail>

  <CatalogRelated title="More workflows" items={moreWorkflows} indexHref="/workflows/" indexLabel="All workflows" backLabel="Back to workflows" />
</SiteLayout>

<style>
  .cat-pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; min-width: 0; }
  .cat-subblock { display: grid; gap: 12px; min-width: 0; }
  .cat-note { padding-top: 16px; border-top: 1px solid var(--border); color: var(--muted); font-size: 14.5px; }
  .cat-tree { padding: 16px 18px; border-radius: var(--radius-sm); border: 1px solid var(--border); background: color-mix(in srgb, var(--bg) 40%, transparent); }
  .cat-side-cta { display: contents; }
  @media (max-width: 1180px) { .cat-pair { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 980px) { .cat-side-cta { display: none; } }
  @media (max-width: 760px) { .cat-pair { gap: 16px; } .cat-note { font-size: 15px; } }
</style>
