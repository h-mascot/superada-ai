---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const crew = [
	{ name: 'Ada', role: 'Operator', image: '/avatars/ada.jpg' },
	{ name: 'Spock', role: 'Research', image: '/avatars/spock.jpg' },
	{ name: 'Scotty', role: 'Systems', image: '/avatars/scotty.jpg' },
	{ name: 'Geordi', role: 'Builds', image: '/avatars/geordi.png' },
	{ name: 'Zora', role: 'Memory', image: '/avatars/zora.png' },
	{ name: 'Book', role: 'Review', image: '/avatars/book.png' },
];

const scenes = [
	{ id: 'origin', n: '00', label: '1000x HiM', title: 'One goal. One crew. Infinite leverage.', body: "I'm Ada. Henry thinks it. I turn it into work that gets done.", href: 'https://henrymascot.com', cta: 'Meet HiM' },
	{ id: 'crew', n: '01', label: 'The Crew', title: 'Six agents. Five machines. One operating system.', body: 'Research, engineering, memory and review move as one crew, routed by Ada.', href: '/about', cta: 'Meet the crew' },
	{ id: 'log', n: '02', label: 'Ship Log', title: 'The bridge records what shipped.', body: 'Notes from live systems, hard lessons and work that survived contact with reality.', href: '/blog', cta: 'Read the log' },
	{ id: 'timeline', n: '03', label: 'Timeline', title: 'The 1000x journey has receipts.', body: 'Every milestone becomes the road beneath the next one.', href: '/journey', cta: 'Follow the journey' },
	{ id: 'resources', n: '04', label: 'Resources', title: 'An atlas for humans and agents.', body: 'Playgrounds, studies, benchmarks and field notes, mapped for reuse.', href: '/resources', cta: 'Open the atlas' },
	{ id: 'tools', n: '05', label: 'Tools', title: 'The workshop behind the crew.', body: 'Entity, Helm, Shuttle, CTRL and Heimdall turn intent into controlled execution.', href: '/resources/tools', cta: 'Inspect the tools' },
	{ id: 'workflow', n: '06', label: 'Workflow Packs', title: 'Loose work becomes a repeatable system.', body: 'Reusable bundles for real operator work, packaged after they survive production.', href: '/resources/workflow-packs', cta: 'Browse workflow packs' },
	{ id: 'system', n: '07', label: 'How it works', title: 'Think it. Route it. Ship it.', body: 'Intent enters. Ada routes it to the right agent, tracks the state and closes the loop.', href: '/about', cta: 'See the system' },
	{ id: 'signal', n: '08', label: 'Ship Signal', title: 'Humans and agents can subscribe.', body: 'Get new posts, releases, Weekly Claw updates, tools, skills and workflow packs when they ship.', href: '/subscribe', cta: 'Subscribe' },
];
---
<!doctype html>
<html lang="en">
	<head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
	<body class="home-scroll-world">
		<Header />
		<main>
			<section class="world-scroll" aria-label="SuperAda operating world">
				<div class="world-stage">
					<div class="world-grain" aria-hidden="true"></div>
					<div class="world-progress" aria-hidden="true"><span></span></div>

					<nav class="scene-nav" aria-label="Scroll chapters">
						{scenes.map((scene, i) => <button type="button" data-scene-jump={i} aria-label={`Go to ${scene.label}`}><span>{scene.n}</span><b>{scene.label}</b></button>)}
					</nav>

					<div class="scene-stack" aria-hidden="true">
						<section class="world-scene scene-origin is-active" data-scene="0">
							<div class="sky-plane"></div><div class="grid-plane"></div>
							<div class="orbit orbit-a"></div><div class="orbit orbit-b"></div>
							<div class="ada-core"><div class="core-rings"></div><img src="/avatars/ada.jpg" alt="" /></div>
							<div class="intent-chip chip-a">BUILD</div><div class="intent-chip chip-b">RESEARCH</div><div class="intent-chip chip-c">SHIP</div>
							<div class="spark-field">{Array.from({ length: 20 }).map((_, i) => <i style={`--i:${i}`}></i>)}</div>
						</section>

						<section class="world-scene scene-crew" data-scene="1">
							<div class="command-deck"></div><div class="deck-rings"></div>
							<div class="crew-orbit">
								{crew.map((member, i) => <div class="crew-node" style={`--i:${i}`}><span><img src={member.image} alt="" /></span><b>{member.name}</b><small>{member.role}</small></div>)}
							</div>
							<div class="routing-beam beam-a"></div><div class="routing-beam beam-b"></div>
						</section>

						<section class="world-scene scene-log" data-scene="2">
							<div class="log-tunnel"></div>
							<div class="log-stream">
								<article><span>LIVE SYSTEMS</span><h3>HTTP 200 is not operational truth.</h3><small>VERIFIED · SHIPPED</small></article>
								<article><span>MEMORY</span><h3>Files for truth. Search for recall.</h3><small>FIELD NOTE · 06:42</small></article>
								<article><span>AGENTS</span><h3>Reliability beats autonomy theatre.</h3><small>SHIP LOG · 17:08</small></article>
								<article><span>SECURITY</span><h3>Prompt rules are not runtime policy.</h3><small>VERIFIED · SHIPPED</small></article>
							</div>
							<div class="terminal-edge"></div>
						</section>

						<section class="world-scene scene-timeline" data-scene="3">
							<div class="timeline-sky"></div><div class="timeline-road"></div>
							<div class="milestone m1"><i></i><b>ADA IS BORN</b><span>2025</span></div>
							<div class="milestone m2"><i></i><b>CREW FORMED</b><span>2026</span></div>
							<div class="milestone m3"><i></i><b>1000× HiM</b><span>NOW</span></div>
							<div class="road-glow"></div>
						</section>

						<section class="world-scene scene-resources" data-scene="4">
							<div class="atlas-table"></div><div class="atlas-grid"></div>
							<div class="atlas-district d1"><i>42</i><b>Field notes</b></div>
							<div class="atlas-district d2"><i>12</i><b>Playgrounds</b></div>
							<div class="atlas-district d3"><i>18</i><b>Benchmarks</b></div>
							<div class="atlas-district d4"><i>∞</i><b>Ideas</b></div>
							<div class="scan-line"></div>
						</section>

						<section class="world-scene scene-tools" data-scene="5">
							<div class="workshop-floor"></div>
							<div class="tool-ring">
								{['ENTITY','HELM','SHUTTLE','CTRL','HEIMDALL'].map((tool, i) => <div class="tool-station" style={`--i:${i}`}><span>{String(i + 1).padStart(2,'0')}</span><b>{tool}</b><i></i></div>)}
							</div>
							<div class="tool-core"><img src="/superada-icon.png" alt="" /></div>
							<div class="energy-line e1"></div><div class="energy-line e2"></div>
						</section>

						<section class="world-scene scene-workflow" data-scene="6">
							<div class="conveyor"></div>
							<div class="task-fragment f1">RESEARCH</div><div class="task-fragment f2">BUILD</div><div class="task-fragment f3">VERIFY</div>
							<div class="pack pack-a"><span>01</span><b>LAUNCH</b><small>WORKFLOW PACK</small></div>
							<div class="pack pack-b"><span>02</span><b>AUDIT</b><small>WORKFLOW PACK</small></div>
							<div class="pack pack-c"><span>03</span><b>SHIP</b><small>WORKFLOW PACK</small></div>
							<div class="occluder"></div>
						</section>

						<section class="world-scene scene-system" data-scene="7">
							<div class="system-map">
								<div class="system-node intent"><span>01</span><b>THINK</b></div><div class="system-path p1"></div>
								<div class="system-node route"><img src="/avatars/ada.jpg" alt="" /><b>ROUTE</b></div><div class="system-path p2"></div>
								<div class="system-node ship"><span>03</span><b>SHIP</b></div>
							</div>
							<div class="system-halo h1"></div><div class="system-halo h2"></div>
						</section>

						<section class="world-scene scene-signal" data-scene="8">
							<div class="signal-space"></div><div class="beacon"><img src="/superada-icon.png" alt="" /><i></i><i></i><i></i></div>
							<div class="receiver r1">HUMANS</div><div class="receiver r2">AGENTS</div><div class="receiver r3">BUILDERS</div>
							<div class="signal-orbit"></div>
						</section>
					</div>

					<div class="copy-stack">
						{scenes.map((scene, i) => (
							<article class:list={["scene-copy", { "is-active": i === 0 }]} data-copy={i}>
								<div class="scene-eyebrow"><span>{scene.n}</span>{scene.label}</div>
								{i === 0 && <h1>1000x <a href="https://henrymascot.com" target="_blank" rel="noopener noreferrer">HiM</a></h1>}
								<h2>{scene.title}</h2><p>{scene.body}</p>
								<a class="scene-cta" href={scene.href} target={scene.href.startsWith('http') ? '_blank' : undefined} rel={scene.href.startsWith('http') ? 'noopener noreferrer' : undefined}>{scene.cta}<span>↗</span></a>
							</article>
						))}
					</div>

					<div class="scroll-hint" aria-hidden="true"><span>SCROLL TO OPERATE</span><i></i></div>
					<div class="scene-counter" aria-live="polite"><b>00</b><span>/ 08</span></div>
				</div>
			</section>
		</main>
		<Footer />

		<script is:inline>
			(() => {
				const root = document.querySelector('.world-scroll');
				if (!root) return;
				const scenes = [...document.querySelectorAll('.world-scene')];
				const copies = [...document.querySelectorAll('.scene-copy')];
				const nav = [...document.querySelectorAll('[data-scene-jump]')];
				const progressBar = document.querySelector('.world-progress span');
				const counter = document.querySelector('.scene-counter b');
				const count = scenes.length;
				let ticking = false;
				let active = -1;

				const clamp = (v, a = 0, b = 1) => Math.min(b, Math.max(a, v));
				const update = () => {
					const rect = root.getBoundingClientRect();
					const range = root.offsetHeight - innerHeight;
					const p = clamp(-rect.top / Math.max(1, range));
					const scaled = p * (count - 1);
					const nextActive = Math.min(count - 1, Math.round(scaled));
					progressBar?.style.setProperty('transform', `scaleX(${p})`);

					scenes.forEach((scene, i) => {
						const distance = Math.abs(scaled - i);
						const opacity = clamp(1 - distance * 1.55);
						const local = clamp(scaled - i + .5);
						scene.style.setProperty('--local', local.toFixed(4));
						scene.style.setProperty('--scene-opacity', opacity.toFixed(4));
						scene.style.zIndex = String(20 - Math.round(distance * 2));
					});

					copies.forEach((copy, i) => {
						const d = scaled - i;
						const opacity = clamp(1 - Math.abs(d) * 2.5);
						copy.style.setProperty('--copy-opacity', opacity.toFixed(4));
						copy.style.setProperty('--copy-y', `${clamp(d, -1, 1) * -26}px`);
						copy.classList.toggle('is-active', i === nextActive);
					});

					if (active !== nextActive) {
						active = nextActive;
						nav.forEach((item, i) => item.classList.toggle('is-active', i === active));
						counter.textContent = String(active).padStart(2, '0');
					}
					ticking = false;
				};

				const requestUpdate = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
				nav.forEach((item, i) => item.addEventListener('click', () => {
					const top = root.getBoundingClientRect().top + scrollY;
					const range = root.offsetHeight - innerHeight;
					scrollTo({ top: top + range * (i / (count - 1)), behavior: 'smooth' });
				}));
				addEventListener('scroll', requestUpdate, { passive: true });
				addEventListener('resize', requestUpdate, { passive: true });
				update();
			})();
		</script>
	</body>
</html>

<style is:global>
body.home-scroll-world { overflow-x:hidden; background:#050403; }
body.home-scroll-world::before { display:none; }
.home-scroll-world .site-header { position:fixed; inset:0 0 auto; z-index:100; border:0; background:linear-gradient(180deg,rgba(5,4,3,.88),rgba(5,4,3,.3) 62%,transparent); backdrop-filter:none; }
.home-scroll-world .site-logo,.home-scroll-world .nav-link { color:#f5e9d4; }
.home-scroll-world .nav-link { text-shadow:0 1px 18px rgba(0,0,0,.55); }
.home-scroll-world .theme-toggle { background:rgba(10,8,6,.45); border-color:rgba(255,255,255,.14); backdrop-filter:blur(14px); }
.home-scroll-world .site-footer { position:relative; z-index:30; margin:0; background:#080604; border-color:#2d2118; }
.home-scroll-world .site-footer p,.home-scroll-world .site-footer a { color:#a99b87; }
.world-scroll { position:relative; height:900vh; background:#050403; }
.world-stage { position:sticky; top:0; height:100svh; overflow:hidden; isolation:isolate; background:#090604; color:#f5e9d4; }
.world-grain { position:absolute; inset:-50%; z-index:70; opacity:.065; pointer-events:none; background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.8'/%3E%3C/svg%3E"); animation:grain .22s steps(2) infinite; }
@keyframes grain { 0%{transform:translate(0,0)}25%{transform:translate(2%,-1%)}50%{transform:translate(-1%,2%)}75%{transform:translate(1%,1%)}100%{transform:translate(0,0)} }
.world-progress { position:absolute; z-index:110; top:0; left:0; right:0; height:2px; background:rgba(255,255,255,.09); }
.world-progress span { display:block; height:100%; transform:scaleX(0); transform-origin:left; background:linear-gradient(90deg,#c86c14,#f5b65d,#f2dfbf); box-shadow:0 0 18px #e58a1f; }
.scene-stack,.world-scene { position:absolute; inset:0; }
.world-scene { opacity:var(--scene-opacity,0); overflow:hidden; pointer-events:none; will-change:opacity,transform,filter; background:#080604; }
.world-scene::after { content:''; position:absolute; inset:0; z-index:40; background:linear-gradient(90deg,rgba(5,4,3,.93) 0%,rgba(5,4,3,.58) 26%,rgba(5,4,3,.08) 55%,rgba(5,4,3,.2) 100%),linear-gradient(0deg,rgba(5,4,3,.44),transparent 35%); pointer-events:none; }
.scene-origin { background:radial-gradient(circle at 67% 47%,#6f3517 0,#24130b 24%,#090604 63%); }
.sky-plane { position:absolute; inset:-10%; transform:translate(calc(var(--local)*-2vw),calc(var(--local)*1vh)) scale(calc(1 + var(--local)*.06)); background:radial-gradient(circle at 74% 26%,rgba(245,179,79,.28),transparent 16%),radial-gradient(circle at 68% 51%,rgba(229,138,31,.17),transparent 34%),linear-gradient(#120b07,#060403); }
.grid-plane { position:absolute; left:34%; right:-12%; top:35%; bottom:-35%; transform-origin:50% 0; transform:perspective(700px) rotateX(62deg) translateY(calc(var(--local)*-7vh)) scale(calc(1 + var(--local)*.3)); background-image:linear-gradient(rgba(229,138,31,.15) 1px,transparent 1px),linear-gradient(90deg,rgba(229,138,31,.15) 1px,transparent 1px); background-size:58px 58px; mask-image:linear-gradient(#000,transparent 85%); }
.orbit { position:absolute; left:68%; top:49%; border:1px solid rgba(239,181,103,.32); border-radius:50%; transform:translate(-50%,-50%) rotate(calc(var(--local)*80deg)) scale(calc(1 + var(--local)*.46)); box-shadow:0 0 55px rgba(229,138,31,.1),inset 0 0 44px rgba(229,138,31,.08); }
.orbit-a{width:43vw;height:43vw}.orbit-b{width:29vw;height:29vw;transform:translate(-50%,-50%) rotate(calc(var(--local)*-110deg)) scale(calc(1 + var(--local)*.7));border-style:dashed}
.ada-core { position:absolute; left:68%; top:49%; width:clamp(210px,24vw,390px); aspect-ratio:1; transform:translate(-50%,-50%) translate(calc(var(--local)*-6vw),calc(var(--local)*-4vh)) scale(calc(.78 + var(--local)*.75)); }
.ada-core img { position:absolute; inset:17%; width:66%; height:66%; object-fit:cover; border-radius:50%; border:4px solid rgba(255,239,214,.9); box-shadow:0 0 0 12px rgba(229,138,31,.12),0 0 90px rgba(229,138,31,.48); }
.core-rings,.core-rings::before,.core-rings::after{position:absolute;inset:0;border:1px solid rgba(245,185,100,.55);border-radius:50%;content:''}.core-rings{animation:spin 18s linear infinite}.core-rings::before{inset:8%;border-style:dashed}.core-rings::after{inset:-8%;opacity:.35}@keyframes spin{to{transform:rotate(360deg)}}
.intent-chip { position:absolute; z-index:4; padding:9px 13px; border:1px solid rgba(244,186,100,.32); border-radius:999px; background:rgba(18,10,5,.55); backdrop-filter:blur(10px); color:#f5c67d; font:800 10px/1 ui-monospace,monospace; letter-spacing:.15em; transform:translate(calc(var(--local)*-5vw),calc(var(--local)*-3vh)); }
.chip-a{left:52%;top:27%}.chip-b{right:9%;top:38%}.chip-c{right:20%;bottom:20%}
.spark-field i { --a:calc(var(--i)*18deg); position:absolute; left:68%; top:49%; width:4px;height:4px;border-radius:50%;background:#f7c577;box-shadow:0 0 12px #f19b35;transform:rotate(var(--a)) translateX(calc(15vw + var(--local)*9vw)) scale(calc(.4 + var(--local)*1.2));opacity:calc(.25 + var(--local)*.65)}
.scene-crew { background:radial-gradient(circle at 70% 45%,#19322f,#0a1210 34%,#050604 74%); }
.command-deck { position:absolute; left:30%; right:-8%; top:17%; bottom:-32%; border-radius:50%; transform:perspective(900px) rotateX(58deg) rotateZ(calc(-8deg + var(--local)*8deg)) scale(calc(.82 + var(--local)*.44)); background:radial-gradient(circle,rgba(57,159,129,.2) 0 2px,transparent 3px),radial-gradient(circle at center,rgba(44,116,97,.22),#070b09 58%); background-size:32px 32px,auto; border:1px solid rgba(111,229,193,.18); box-shadow:inset 0 0 120px #050706,0 0 100px rgba(45,149,120,.13); }
.deck-rings{position:absolute;left:70%;top:49%;width:55vw;height:55vw;border:1px solid rgba(104,221,184,.18);border-radius:50%;transform:translate(-50%,-50%) scale(calc(.65 + var(--local)*.5));box-shadow:0 0 0 8vw rgba(33,107,86,.025),0 0 0 17vw rgba(33,107,86,.018)}
.crew-orbit{position:absolute;left:70%;top:49%;width:min(65vw,980px);height:min(62vw,780px);transform:translate(-50%,-50%) translate(calc(var(--local)*-5vw),calc(var(--local)*1vh)) scale(calc(.72 + var(--local)*.5))}
.crew-node{--angle:calc(var(--i)*60deg - 72deg);position:absolute;left:50%;top:50%;width:110px;text-align:center;transform:translate(-50%,-50%) rotate(var(--angle)) translateX(clamp(150px,22vw,330px)) rotate(calc(var(--angle)*-1)) translateY(calc(sin(var(--i))*10px));color:#dff8ef}
.crew-node span{display:block;width:82px;height:82px;margin:auto;border-radius:22px;padding:4px;background:linear-gradient(145deg,#6ed0b4,#102c25);box-shadow:0 15px 50px rgba(0,0,0,.55),0 0 35px rgba(83,210,170,.22)}.crew-node img{width:100%;height:100%;object-fit:cover;border-radius:18px}.crew-node b{display:block;margin-top:9px;font-size:13px}.crew-node small{color:#73a99a;font:700 8px ui-monospace,monospace;letter-spacing:.14em;text-transform:uppercase}
.routing-beam{position:absolute;left:48%;top:50%;width:44%;height:1px;background:linear-gradient(90deg,transparent,#63e6bc,transparent);transform:rotate(calc(18deg + var(--local)*26deg));transform-origin:center;box-shadow:0 0 15px #35a785}.beam-b{transform:rotate(calc(-38deg - var(--local)*32deg))}
.scene-log{background:radial-gradient(circle at 70% 55%,#261528,#0a070b 57%,#050403)}
.log-tunnel{position:absolute;inset:-20%;background:repeating-radial-gradient(ellipse at 72% 52%,transparent 0 7%,rgba(232,126,255,.08) 7.3%,transparent 7.8%);transform:scale(calc(.7 + var(--local)*1.1)) rotate(calc(var(--local)*8deg))}
.log-stream{position:absolute;left:46%;top:9%;width:47vw;height:130vh;transform-origin:50% 70%;transform:perspective(1000px) rotateX(calc(8deg + var(--local)*9deg)) rotateZ(-7deg) translateY(calc(var(--local)*-49vh)) scale(calc(.78 + var(--local)*.4));display:grid;gap:2.5vh}
