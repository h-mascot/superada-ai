@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.world-scroll{height:auto}.world-stage{position:relative;height:auto;overflow:visible}.scene-stack,.copy-stack,.world-progress,.scene-nav,.scroll-hint,.scene-counter,.world-grain{display:none}.copy-stack{position:relative}.world-stage::after{content:'';display:block}.copy-stack{display:grid!important;width:auto;min-height:0;padding:130px 22px 50px;gap:18px}.scene-copy{position:relative;opacity:1!important;transform:none!important;filter:none!important;padding:30px 0;border-bottom:1px solid #2d2118}.scene-copy:last-child{border-bottom:0}.scene-copy .scene-h1{font-size:58px}.home-scroll-world .site-header{position:sticky}}
/* ---------- Front page after the scroll world ---------- */
.home-scroll-world .site-footer { position:relative; z-index:30; margin-top:0; }
.home-front { position:relative; }
.front-hero { position:relative; isolation:isolate; overflow:clip; min-height:calc(100svh - var(--chrome-top)); display:grid; align-items:center; padding:clamp(40px,6vh,80px) 0 clamp(56px,8vh,96px); }
.front-hero-bg { position:absolute; inset:0; z-index:-1; pointer-events:none; }
.hh-grid { position:absolute; inset:-10% -10% 0; background-image:linear-gradient(color-mix(in srgb,var(--accent) 9%,transparent) 1px,transparent 1px),linear-gradient(90deg,color-mix(in srgb,var(--accent) 9%,transparent) 1px,transparent 1px); background-size:64px 64px; mask-image:radial-gradient(ellipse 70% 60% at 70% 45%,#000 20%,transparent 75%); transform:perspective(900px) rotateX(18deg); transform-origin:50% 0; }
.hh-glow { position:absolute; border-radius:50%; filter:blur(80px); opacity:.55; animation:hh-float 14s ease-in-out infinite alternate; }
.hh-glow-a { width:44vw; height:44vw; right:-6vw; top:-8vw; background:radial-gradient(circle,color-mix(in srgb,var(--accent) 45%,transparent),transparent 70%); }
.hh-glow-b { width:30vw; height:30vw; left:-8vw; bottom:-12vw; background:radial-gradient(circle,color-mix(in srgb,var(--accent-2) 30%,transparent),transparent 70%); animation-delay:-6s; }
@keyframes hh-float { to { transform:translate(-3vw,3vh) scale(1.08); } }
.front-hero-inner { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); align-items:center; gap:clamp(24px,4vw,64px); }
.front-hero-copy { display:grid; gap:20px; justify-items:start; }
.front-hero-copy > * { animation:hh-in .9s var(--ease-out) backwards; }
.front-hero-copy > :nth-child(2) { animation-delay:.08s; } .front-hero-copy > :nth-child(3) { animation-delay:.16s; } .front-hero-copy > :nth-child(4) { animation-delay:.24s; } .front-hero-copy > :nth-child(5) { animation-delay:.32s; } .front-hero-copy > :nth-child(6) { animation-delay:.4s; }
@keyframes hh-in { from { opacity:0; transform:translateY(22px); filter:blur(6px); } }
.front-hero-title { font:500 clamp(80px,10.5vw,168px)/.84 var(--font-display); letter-spacing:-.075em; color:var(--text); }
.front-hero-title a { color:var(--accent); }
.front-hero-sub { font:500 clamp(26px,2.6vw,38px)/1.05 var(--font-display); letter-spacing:-.035em; color:var(--text); max-width:16ch; }
.front-hero-copy .ds-lede { max-width:34rem; }
.front-hero-actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:4px; }
.front-hero-stats { display:grid; grid-template-columns:repeat(4,auto); gap:clamp(18px,3vw,40px); margin:14px 0 0; padding-top:22px; border-top:1px solid var(--border); }
.front-hero-stats div { display:grid; gap:6px; }
.front-hero-stats dt { order:2; color:var(--muted); font:700 10px/1.3 var(--font-mono); letter-spacing:.14em; text-transform:uppercase; }
.front-hero-stats dd { margin:0; font:500 clamp(30px,3vw,44px)/1 var(--font-display); letter-spacing:-.05em; color:var(--text); }

.home-orbit { --r1:clamp(130px,13vw,200px); --r2:clamp(200px,20vw,300px); --node:clamp(52px,4.6vw,70px); position:relative; justify-self:center; width:calc(var(--r2) * 2 + var(--node)); aspect-ratio:1; max-width:100%; animation:hh-in 1.2s var(--ease-out) .2s backwards; }
.orbit-line { position:absolute; left:50%; top:50%; border-radius:50%; border:1px solid color-mix(in srgb,var(--accent) 28%,transparent); transform:translate(-50%,-50%); pointer-events:none; }
.orbit-line-a { width:calc(var(--r1) * 2); height:calc(var(--r1) * 2); }
.orbit-line-b { width:calc(var(--r2) * 2); height:calc(var(--r2) * 2); border-style:dashed; opacity:.7; animation:home-spin 120s linear infinite; }
.orbit-line-c { width:calc(var(--r1) * 1.1); height:calc(var(--r1) * 1.1); border-color:color-mix(in srgb,var(--accent) 50%,transparent); box-shadow:0 0 80px color-mix(in srgb,var(--accent) 30%,transparent),inset 0 0 50px color-mix(in srgb,var(--accent) 18%,transparent); }
.orbit-core { position:absolute; left:50%; top:50%; z-index:3; display:grid; justify-items:center; gap:10px; transform:translate(-50%,-50%); color:var(--text); }
.orbit-core img { width:calc(var(--r1) * .92); height:calc(var(--r1) * .92); border-radius:50%; object-fit:cover; border:3px solid color-mix(in srgb,var(--accent) 75%,white); box-shadow:0 0 0 10px var(--accent-soft),0 30px 90px var(--glow); transition:transform .6s var(--ease-spring); }
.orbit-core span { position:absolute; bottom:-30px; color:var(--accent); font:800 10.5px/1 var(--font-mono); letter-spacing:.2em; text-transform:uppercase; }
.orbit-core:hover img { transform:scale(1.04); }
.orbit-ring { position:absolute; inset:0; animation:home-spin 70s linear infinite; }
.orbit-ring-2 { animation-duration:110s; animation-direction:reverse; }
.orbit-node { position:absolute; left:50%; top:50%; width:var(--node); height:var(--node); margin:calc(var(--node) / -2) 0 0 calc(var(--node) / -2); transform:rotate(var(--a)) translateX(var(--r1)) rotate(calc(var(--a) * -1)); }
.orbit-ring-2 .orbit-node { transform:rotate(var(--a)) translateX(var(--r2)) rotate(calc(var(--a) * -1)); }
.orbit-node img { width:100%; height:100%; border-radius:50%; object-fit:cover; border:2px solid var(--agent-accent); background:var(--panel); box-shadow:0 12px 34px color-mix(in srgb,var(--agent-accent) 30%,transparent),0 0 0 4px var(--bg); animation:home-spin 70s linear infinite reverse; transition:scale .4s var(--ease-spring); }
.orbit-ring-2 .orbit-node img { animation-duration:110s; animation-direction:normal; }
.orbit-node:hover img, .orbit-node:focus-visible img { scale:1.18; }
.home-orbit:hover .orbit-ring, .home-orbit:hover .orbit-node img, .home-orbit:focus-within .orbit-ring, .home-orbit:focus-within .orbit-node img { animation-play-state:paused; }
.home-tour-head { margin-bottom:28px; }
.home-front > .world-scroll { margin-top:0; }
.home-block + .home-block { margin-top:clamp(64px,8vw,120px); }
.home-head { display:grid; gap:12px; }
.home-more { display:inline-flex; align-items:center; gap:6px; min-height:44px; color:var(--accent); font-size:12px; font-weight:850; letter-spacing:.1em; text-transform:uppercase; white-space:nowrap; }
.home-stories { display:grid; grid-template-columns:repeat(12,minmax(0,1fr)); gap:10px; }
.home-story { display:grid; justify-items:center; gap:6px; text-align:center; color:var(--text); min-width:0; }
.home-story-ring { width:100%; max-width:84px; aspect-ratio:1; padding:3px; border-radius:50%; background:conic-gradient(from 200deg,var(--agent-accent),color-mix(in srgb,var(--agent-accent) 25%,transparent),var(--agent-accent)); transition:transform .45s var(--ease-spring); }
.home-story-ring img { width:100%; height:100%; border-radius:50%; object-fit:cover; border:3px solid var(--bg); background:var(--panel); }
.home-story b { margin-top:4px; font-size:13.5px; }
.home-story small { color:var(--muted); font-size:11px; line-height:1.3; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
.home-story:hover .home-story-ring { transform:translateY(-4px) scale(1.05); }
.home-story:active .home-story-ring { transform:scale(.92); }
.home-posts { margin-top:16px; }
.home-explore { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14px; }
.home-tile h3 { font-size:24px; }
.home-split { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:16px; align-items:stretch; }
.home-journey { display:grid; gap:18px; align-content:start; justify-items:start; }
.home-journey ol { list-style:none; margin:0; padding:0; display:grid; width:100%; }
.home-journey li { display:grid; grid-template-columns:44px minmax(0,1fr); gap:14px; align-items:center; padding:14px 0; border-top:1px solid var(--border); }
.home-ms-emoji { width:44px; height:44px; display:grid; place-items:center; border-radius:14px; background:var(--panel-soft); font-size:20px; }
.home-journey time { display:block; margin-bottom:4px; color:var(--accent); font:750 10.5px/1 var(--font-mono); letter-spacing:.12em; text-transform:uppercase; }
.home-journey b { font:500 19px/1.25 var(--font-display); letter-spacing:-.02em; }
.home-claw { position:relative; display:block; min-height:420px; overflow:hidden; border-radius:var(--radius-xl); border:1px solid var(--surface-border); background:#0b0805; color:#fbf2e3; }
.home-claw img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform 1.4s var(--ease-out); }
.home-claw::after { content:''; position:absolute; inset:0; background:linear-gradient(180deg,transparent 30%,rgba(5,4,3,.92)); }
.home-claw-copy { position:absolute; z-index:2; left:28px; right:28px; bottom:26px; display:grid; gap:10px; }
.home-claw-copy b { font:500 clamp(34px,3.6vw,52px)/.95 var(--font-display); letter-spacing:-.05em; }
.home-claw-copy > span:last-child { color:rgba(251,242,227,.78); font-size:15px; }
.home-claw:hover img { transform:scale(1.05); }
@media (max-width:1100px) { .home-stories { grid-template-columns:repeat(6,minmax(0,1fr)); row-gap:22px; } }
@media (max-width:980px) { .home-explore { grid-template-columns:repeat(2,minmax(0,1fr)); } .home-split { grid-template-columns:1fr; } }
@media (max-width:760px) {
  body.home-scroll-world { background:var(--bg); }
  .world-scroll { display:none; }
  .home-scroll-world .site-header { position:sticky; }
  .front-hero { min-height:0; padding:18px 0 8px; }
  .front-hero-inner { grid-template-columns:1fr; gap:6px; }
  .home-orbit { --r1:96px; --r2:146px; --node:42px; order:-1; width:min(100%,334px); }
  .orbit-core span { display:none; }
  .front-hero-title { font-size:clamp(64px,20vw,88px); }
  .front-hero-sub { font-size:25px; }
  .front-hero-actions { display:grid; grid-template-columns:1fr 1fr; width:100%; }
  .front-hero-actions .ds-btn { justify-content:center; }
  .front-hero-stats { grid-template-columns:repeat(4,minmax(0,1fr)); gap:10px; width:100%; }
  .front-hero-stats dd { font-size:28px; }
  .front-hero-stats dt { font-size:9.5px; letter-spacing:.08em; }
  .home-tour-head { display:none; }
  .hh-glow { filter:blur(50px); }
  .home-block + .home-block, .home-intro { margin-top:48px; }
  .home-front .ds-section-head { display:grid; gap:2px; justify-items:start; margin-bottom:16px; }
  .home-front .ds-section-head .ds-h2 { font-size:clamp(30px,8.6vw,36px); }
  .home-more { min-height:40px; }
  .home-stories { display:flex; gap:14px; overflow-x:auto; scrollbar-width:none; margin-inline:calc(var(--gutter) * -1); padding:4px var(--gutter) 6px; }
  .home-stories::-webkit-scrollbar { display:none; }
  .home-story { flex:0 0 72px; }
  .home-story-ring { width:72px; }
  .home-story small { display:none; }
  .home-explore { grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
  .home-tile { padding:16px; gap:10px; border-radius:var(--radius-md); }
  .home-tile h3 { font-size:19px; }
  .home-tile p { font-size:13px; line-height:1.45; display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; }
  .home-tile .ds-card-icon { width:38px; height:38px; border-radius:12px; }
  .home-claw { min-height:300px; border-radius:var(--radius-lg); }
