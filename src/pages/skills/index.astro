---
import PageHero from '../../components/PageHero.astro';
import CatalogCard from '../../components/catalog/CatalogCard.astro';
import CatalogFilterBar from '../../components/catalog/CatalogFilterBar.astro';
import CatalogHeroMeta from '../../components/catalog/CatalogHeroMeta.astro';
import CatalogStats from '../../components/catalog/CatalogStats.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { publishedSkills } from '../../data/skills';
import { catalogs, clawhubLinkFor, countBy } from '../../lib/catalog';

const skills = [...publishedSkills].sort((a, b) => a.title.localeCompare(b.title));
const availabilityLabel = {
  'agent-installable': 'Agent-installable',
  manual: 'Manual setup',
} as const;
const availabilityTone = {
  'agent-installable': 'live',
  manual: 'accent',
} as const;

const byAvailability = countBy(skills, (skill) => skill.availability);
const byCategory = [...countBy(skills, (skill) => skill.category)].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const chips = [{ value: 'All', label: 'All', count: skills.length }, ...byCategory.map(([category, count]) => ({ value: category, label: category, count }))];
const onClawhub = skills.filter((skill) => clawhubLinkFor(skill)).length;
const otherCatalogs = catalogs.filter((catalog) => catalog.href !== '/skills/');
---

<SiteLayout
  title="Skills — SuperAda"
  description="Public Enterprise Crew skills with source links, install contracts, and honest installability labels."
>
  <PageHero
    eyebrow="Skills"
    title="Public skill pages"
    lede="These pages point at the real public skill sources. If a skill is agent-installable, the page shows the exact source spec and install command. If it is not, the page says so plainly instead of bluffing."
    id="skills-title"
  >
    <Fragment slot="title">Public <em>skill</em> pages</Fragment>
    <CatalogHeroMeta>
      <a class="ds-btn" href="#catalog">Browse {skills.length} skills <span aria-hidden="true">↓</span></a>
      {otherCatalogs.map((catalog) => <a class="ds-btn ds-btn--ghost" href={catalog.href}>{catalog.title}</a>)}
    </CatalogHeroMeta>
    <CatalogStats
      slot="aside"
      label="Skills at a glance"
      items={[
        { value: skills.length, label: 'Skills' },
        { value: byAvailability.get('agent-installable') ?? 0, label: 'Agent-installable', tone: 'live' },
        { value: byAvailability.get('manual') ?? 0, label: 'Manual setup', tone: 'accent' },
        { value: onClawhub, label: 'On ClawHub' },
      ]}
      caption={`${byCategory.length} categories, from ${byCategory.slice(0, 3).map(([category]) => category.toLowerCase()).join(', ')} and more.`}
    />
  </PageHero>

  <section class="ds-shell cat-catalog" id="catalog" aria-labelledby="catalog-title">
    <div class="ds-section-head cat-catalog-head">
      <div>
        <h2 class="ds-h2" id="catalog-title">All skills</h2>
        <p>Send the detail page URL to an agent if you want it to read the install contract first.</p>
      </div>
    </div>

    <CatalogFilterBar label="Filter skills by category" chips={chips} target="#skill-grid" noun={['skill', 'skills']} />

    <div class="ds-grid cat-grid" id="skill-grid">
      {skills.map((skill) => (
        <CatalogCard
          href={`/skills/${skill.slug}/`}
          title={skill.title}
          tagline={skill.tagline}
          summary={skill.description}
          badges={[
            { label: availabilityLabel[skill.availability], tone: availabilityTone[skill.availability] },
            { label: skill.category, tone: 'plain' },
          ]}
          facts={[
            { label: 'Source', value: skill.sourceLabel, href: skill.sourceUrl },
            { label: 'Installability', value: skill.availability === 'agent-installable' ? 'Installable by agent from source spec' : 'Manual repo/script setup only right now' },
          ]}
          command={skill.installCommand}
          commandFallback="No first-class <code>openclaw skills install</code> contract is published for this one yet."
          meta={[skill.estimatedSetup]}
          cta="View skill"
          attrs={{ 'data-category': skill.category, 'data-title': skill.title.toLowerCase() }}
        />
      ))}
    </div>
  </section>

  <section class="ds-shell">
    <div class="ds-cta-band">
      <div>
        <span class="ds-eyebrow">Keep exploring</span>
        <p class="ds-h2">Need more than one skill?</p>
        <p>Workflows bundle skills into repeatable operator routines. Plugins hook the live runtime itself.</p>
      </div>
      <div class="cat-band-actions">
        {otherCatalogs.map((catalog, index) => <a class:list={['ds-btn', { 'ds-btn--ghost': index > 0 }]} href={catalog.href}>{catalog.title} <span aria-hidden="true">→</span></a>)}
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .cat-catalog { scroll-margin-top: var(--chrome-top); }
  .cat-catalog-head p { margin-top: 10px; color: var(--muted); font-size: 15px; }
  .cat-grid { --min: 340px; gap: 18px; }
  .cat-band-actions { display: flex; flex-wrap: wrap; gap: 10px; flex: 0 0 auto; }
  @media (max-width: 760px) {
    .cat-grid { gap: 12px; }
    .cat-band-actions { display: grid; }
  }
</style>
