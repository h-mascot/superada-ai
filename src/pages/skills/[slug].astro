---
import CopyButton from '../../components/CopyButton.astro';
import PageHero from '../../components/PageHero.astro';
import CatalogCode from '../../components/catalog/CatalogCode.astro';
import CatalogDetail from '../../components/catalog/CatalogDetail.astro';
import CatalogFacts from '../../components/catalog/CatalogFacts.astro';
import CatalogFields from '../../components/catalog/CatalogFields.astro';
import CatalogHeroMeta from '../../components/catalog/CatalogHeroMeta.astro';
import CatalogList from '../../components/catalog/CatalogList.astro';
import CatalogMiniList from '../../components/catalog/CatalogMiniList.astro';
import CatalogPanel from '../../components/catalog/CatalogPanel.astro';
import CatalogRelated from '../../components/catalog/CatalogRelated.astro';
import CatalogRows from '../../components/catalog/CatalogRows.astro';
import CatalogSteps from '../../components/catalog/CatalogSteps.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { publishedSkills, skillMap } from '../../data/skills';
import { clawhubLinkFor, neighbours } from '../../lib/catalog';

export async function getStaticPaths() {
  return publishedSkills.map((skill) => ({ params: { slug: skill.slug } }));
}

const { slug } = Astro.params;
if (!slug) throw new Error('Missing skill slug');

const skill = skillMap[slug];
if (!skill) throw new Error(`Skill not found: ${slug}`);

const availabilityLabel = {
  'agent-installable': 'Agent-installable',
  manual: 'Manual setup',
} as const;
const availabilityTone = {
  'agent-installable': 'live',
  manual: 'accent',
} as const;
const reviewLabel = {
  'source-review': 'Source review',
  'manual-review': 'Manual review',
} as const;
const relatedSkills = publishedSkills.filter((entry) => entry.slug !== skill.slug && entry.category === skill.category).slice(0, 3);
const agentPrompt = skill.installCommand
  ? `Install the skill described on this page from ${skill.sourceSpec}. Review the source first, then run: ${skill.installCommand}`
  : `Review the skill page, then follow the manual setup instructions from ${skill.sourceUrl}. This one is not currently a first-class openclaw skills install bundle.`;

const clawhubLink = clawhubLinkFor(skill);

const toLink = (entry: typeof skill) => ({
  href: `/skills/${entry.slug}/`,
  title: entry.title,
  tagline: entry.tagline,
  badges: [
    { label: availabilityLabel[entry.availability], tone: availabilityTone[entry.availability] },
    { label: entry.category, tone: 'plain' as const },
  ],
});
const sorted = [...publishedSkills].sort((a, b) => a.title.localeCompare(b.title)).map(toLink);
const moreSkills = neighbours(sorted, sorted.findIndex((entry) => entry.href === `/skills/${skill.slug}/`), new Set(relatedSkills.map((entry) => `/skills/${entry.slug}/`)));
---

<SiteLayout title={`${skill.title} — Skill`} description={skill.description}>
  <PageHero eyebrow={`Skill · ${skill.category}`} title={skill.title} lede={skill.tagline} size="md">
    <CatalogHeroMeta
      badges={[
        { label: availabilityLabel[skill.availability], tone: availabilityTone[skill.availability] },
        { label: skill.category, tone: 'plain' },
        { label: reviewLabel[skill.reviewMode], tone: 'plain' },
        { label: skill.estimatedSetup, tone: 'plain' },
      ]}
    >
      {skill.installCommand
        ? <CopyButton text={skill.installCommand} label="Copy install command" variant="button" />
        : <a class="ds-btn" href={skill.sourceUrl}>Open source <span aria-hidden="true">↗</span></a>}
      {skill.installCommand && <a class="ds-btn ds-btn--ghost" href={skill.sourceUrl}>View source</a>}
      {clawhubLink && <a class="ds-btn ds-btn--ghost" href={clawhubLink}>Open on ClawHub</a>}
    </CatalogHeroMeta>
  </PageHero>

  <CatalogDetail sideLabel="Skill facts and related skills">
    <CatalogPanel id="overview" eyebrow="Overview" title="What this skill does">
      <p>{skill.description}</p>
    </CatalogPanel>

    {clawhubLink && (
      <CatalogPanel id="clawhub" eyebrow="ClawHub download" title="Install from ClawHub" tone="accent">
        <a slot="action" class="ds-btn cat-panel-btn" href={clawhubLink}>Open on ClawHub <span aria-hidden="true">→</span></a>
        <p>This skill is mirrored to <a href={clawhubLink}>ClawHub</a> for install-from-the-page convenience.</p>
        <p class="cat-muted">The ClawHub package is regenerated by <code>scripts/sync-superada-to-clawhub.mjs</code> on every push to <code>main</code>.</p>
      </CatalogPanel>
    )}

    <CatalogPanel id="install-contract" eyebrow="Install contract" title="Where it lives and how to install it">
      <CatalogFields
        items={[
          { label: 'Source', value: skill.sourceLabel },
          { label: 'Entrypoint', value: skill.entrypoint, mono: true },
          { label: 'Installability', value: skill.availability === 'agent-installable' ? 'Ready for agent install' : 'Viewable, but manual setup only' },
          ...(skill.sourceSpec ? [{ label: 'Source spec', value: skill.sourceSpec, mono: true }] : []),
        ]}
      />
      <p class="cat-muted">This page is designed to be the thing you send to another agent. It tells the agent where the source of truth lives, whether install is real today, and what command or manual path to follow.</p>
      <CatalogFields items={[{ label: 'Canonical source', value: skill.sourceUrl, href: skill.sourceUrl, mono: true }]} />
      {skill.installCommand ? (
        <CatalogCode label="Install command" code={skill.installCommand} copy="Copy" />
      ) : (
        <p class="cat-callout">This one does not currently publish a clean <code>openclaw skills install</code> contract. Read the repo and follow the manual setup path instead.</p>
      )}
      <CatalogCode label="Prompt to hand another agent" code={agentPrompt} copy="Copy" />
    </CatalogPanel>

    <CatalogPanel id="install-steps" eyebrow="Setup" title="Install steps">
      <CatalogSteps steps={skill.instructions.map((detail) => ({ detail }))} label="Install steps" />
    </CatalogPanel>

    <div class="cat-pair">
      <CatalogPanel id="covers" title="What it covers">
        <CatalogList items={skill.includes} marker="check" />
      </CatalogPanel>
      <CatalogPanel id="use-cases" title="Good use cases">
        <CatalogList items={skill.useCases} />
      </CatalogPanel>
    </div>

    <CatalogPanel id="artifacts" eyebrow="Files" title="Published artifacts">
      <CatalogRows rows={skill.artifacts.map((artifact) => ({ title: artifact.label, mono: artifact.path, detail: artifact.description }))} />
    </CatalogPanel>

    {skill.configExamples && skill.configExamples.length > 0 && (
      <CatalogPanel id="config" eyebrow="Configuration" title="Current published config examples">
        {skill.configExamples.map((example) => <CatalogCode label={example.label} code={example.code} copy="Copy" wrap={false} />)}
      </CatalogPanel>
    )}

    {skill.limitations && skill.limitations.length > 0 && (
      <CatalogPanel id="limits" eyebrow="Boundaries" title="Current limits">
        <CatalogList items={skill.limitations} marker="warn" />
      </CatalogPanel>
    )}

    <Fragment slot="side">
      <CatalogFacts
        title="Quick facts"
        items={[
          { label: 'Installability', value: availabilityLabel[skill.availability] },
          { label: 'Review before use', value: reviewLabel[skill.reviewMode] },
          { label: 'Category', value: skill.category },
          { label: 'Setup time', value: skill.estimatedSetup },
          { label: 'Source', value: 'Open GitHub', href: skill.sourceUrl },
          ...(clawhubLink ? [{ label: 'ClawHub', value: 'View on ClawHub', href: clawhubLink }] : []),
        ]}
      >
        {skill.installCommand && <span class="cat-side-cta"><CopyButton text={skill.installCommand} label="Copy install command" variant="button" /></span>}
      </CatalogFacts>
      <CatalogMiniList title="Related skills" items={relatedSkills.map((entry) => ({ href: `/skills/${entry.slug}/`, title: entry.title, tagline: entry.description }))} />
    </Fragment>
  </CatalogDetail>

  <CatalogRelated title="More skills" items={moreSkills} indexHref="/skills/" indexLabel="All skills" backLabel="Back to skills" />
</SiteLayout>

<style>
  .cat-pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; min-width: 0; }
  .cat-panel-btn { min-height: 44px; padding: 0 18px; }
  .cat-callout { padding: 16px 18px; border-radius: var(--radius-sm); border: 1px dashed color-mix(in srgb, var(--accent) 45%, var(--border)); background: color-mix(in srgb, var(--accent-soft) 35%, transparent); color: var(--text-soft); }
  .cat-side-cta { display: contents; }
  @media (max-width: 1180px) { .cat-pair { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 980px) { .cat-side-cta { display: none; } }
  @media (max-width: 760px) { .cat-pair { gap: 16px; } .cat-panel-btn { display: none; } }
</style>
