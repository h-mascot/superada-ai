---
import { publishedPlugins, pluginMap, pluginPlatforms } from '../../data/plugins';
import CopyButton from '../../components/CopyButton.astro';
import PageHero from '../../components/PageHero.astro';
import CatalogCode from '../../components/catalog/CatalogCode.astro';
import CatalogDetail from '../../components/catalog/CatalogDetail.astro';
import CatalogFacts from '../../components/catalog/CatalogFacts.astro';
import CatalogHeroMeta from '../../components/catalog/CatalogHeroMeta.astro';
import CatalogList from '../../components/catalog/CatalogList.astro';
import CatalogMiniList from '../../components/catalog/CatalogMiniList.astro';
import CatalogPanel from '../../components/catalog/CatalogPanel.astro';
import CatalogRelated from '../../components/catalog/CatalogRelated.astro';
import CatalogRows from '../../components/catalog/CatalogRows.astro';
import CatalogSteps from '../../components/catalog/CatalogSteps.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { clawhubLinkFor, neighbours, statusTone } from '../../lib/catalog';

export async function getStaticPaths() {
  return publishedPlugins.map((plugin) => ({ params: { slug: plugin.slug } }));
}

const { slug } = Astro.params;
if (!slug) throw new Error('Missing plugin slug');

const plugin = pluginMap[slug];
if (!plugin) throw new Error(`Plugin not found: ${slug}`);

const relatedPlugins = publishedPlugins.filter((entry) => entry.slug !== plugin.slug).slice(0, 2);

const clawhubLink = clawhubLinkFor(plugin);

const platformLabel = (id: keyof typeof pluginPlatforms) => pluginPlatforms[id].label;
const platformHint = (id: keyof typeof pluginPlatforms) => pluginPlatforms[id].installHint;
const requirementTypeLabel: Record<string, string> = {
  runtime: 'Runtime',
  secret: 'Secret',
  access: 'Access',
  review: 'Review',
  dependency: 'Dependency',
};

const toLink = (entry: typeof plugin) => ({
  href: `/plugins/${entry.slug}/`,
  title: entry.title,
  tagline: entry.tagline,
  badges: [
    { label: entry.status, tone: statusTone(entry.status) },
    ...entry.platforms.map((platform) => ({ label: platformLabel(platform), tone: 'accent' as const })),
  ],
});
const sorted = [...publishedPlugins].sort((a, b) => a.title.localeCompare(b.title)).map(toLink);
const morePlugins = neighbours(sorted, sorted.findIndex((entry) => entry.href === `/plugins/${plugin.slug}/`), new Set(relatedPlugins.map((entry) => `/plugins/${entry.slug}/`)));
---

<SiteLayout title={`${plugin.title} — Plugin Marketplace`} description={plugin.summary}>
  <PageHero eyebrow={`Plugin · ${plugin.category}`} title={plugin.title} lede={plugin.tagline} size="md">
    <CatalogHeroMeta
      badges={[
        { label: plugin.status, tone: statusTone(plugin.status) },
        { label: plugin.category, tone: 'plain' },
        { label: plugin.difficulty, tone: 'plain' },
        ...plugin.platforms.map((platform) => ({ label: platformLabel(platform), tone: 'accent' as const })),
      ]}
    >
      <CopyButton text={plugin.installCommand} label="Copy install command" variant="button" />
      <a class="ds-btn ds-btn--ghost" href={plugin.sourceUrl}>View source</a>
      {clawhubLink && <a class="ds-btn ds-btn--ghost" href={clawhubLink}>Open on ClawHub</a>}
    </CatalogHeroMeta>
  </PageHero>

  <CatalogDetail sideLabel="Plugin facts and other plugins">
    <CatalogPanel id="overview" eyebrow="Overview" title="What this plugin does">
      <p>{plugin.summary}</p>
    </CatalogPanel>

    {clawhubLink && (
      <CatalogPanel id="clawhub" eyebrow="ClawHub download" title="Install from ClawHub" tone="accent">
        <a slot="action" class="ds-btn cat-panel-btn" href={clawhubLink}>Open on ClawHub <span aria-hidden="true">→</span></a>
        <p>This plugin is mirrored to the <a href={clawhubLink}>h-mascot ClawHub account</a> for install-from-the-page convenience.</p>
        <p class="cat-muted">The ClawHub package is regenerated by <code>scripts/sync-superada-to-clawhub.mjs</code> on every push to <code>main</code>.</p>
      </CatalogPanel>
    )}

    <CatalogPanel id="source" eyebrow="Source" title={plugin.sourceLabel}>
      <p class="cat-muted">Canonical source: <a href={plugin.sourceUrl}>{plugin.sourceUrl}</a></p>
    </CatalogPanel>

    <CatalogPanel id="platforms" eyebrow="Runtimes" title="Supported platforms">
      <CatalogRows rows={plugin.platforms.map((platform) => ({ title: platformLabel(platform), detail: platformHint(platform) }))} />
    </CatalogPanel>

    <CatalogPanel id="prerequisites" eyebrow="Before you start" title="Prerequisites">
      <CatalogRows rows={plugin.prerequisites.map((req) => ({ title: req.label, tag: requirementTypeLabel[req.type], detail: req.detail }))} />
    </CatalogPanel>

    <CatalogPanel id="install" eyebrow="Setup" title="Install">
      <CopyButton slot="action" text={plugin.installCommand} label="Copy install" />
      <p class="cat-muted">One-shot install into a host plugins/ directory, then the auto installer registers the plugin with the running runtime.</p>
      <CatalogCode code={plugin.installCommand} />
      <CatalogSteps steps={plugin.installSteps} label="Install steps" />
    </CatalogPanel>

    <CatalogPanel id="verification" eyebrow="Proof" title="Verification">
      <CopyButton slot="action" text={plugin.verifyCommand} label="Copy verify" />
      <p class="cat-muted">Configuration is what you wanted. Enforcement is what happened. The verify script is the receipt.</p>
      <CatalogCode code={plugin.verifyCommand} />
      <CatalogSteps steps={plugin.verification.map((check) => ({ title: check.label, detail: check.detail, command: check.command, expected: check.expected }))} label="Verification checks" />
    </CatalogPanel>

    <CatalogPanel id="rollback" eyebrow="Rollback" title="Uninstall / rollback">
      <p class="cat-muted">Disable the plugin with the running runtime first, then remove the staged plugin directory. The audit store stays so you can prove the rollout happened.</p>
      <CatalogCode code={plugin.uninstallCommand} copy="Copy" />
    </CatalogPanel>

    {plugin.sections.map((section, index) => (
      <CatalogPanel id={`section-${index + 1}`} title={section.heading}>
        <p>{section.body}</p>
        {section.command && <CatalogCode code={section.command} copy="Copy" />}
        {section.bullets && section.bullets.length > 0 && <CatalogList items={section.bullets} />}
      </CatalogPanel>
    ))}

    <Fragment slot="side">
      <CatalogFacts
        title="Plugin facts"
        items={[
          { label: 'Status', value: plugin.status },
          { label: 'Category', value: plugin.category },
          { label: 'Difficulty', value: plugin.difficulty },
          { label: 'Platforms', value: plugin.platforms.map((p) => platformLabel(p)).join(', '), mono: true },
          { label: 'Slug', value: plugin.slug, mono: true, wide: true },
          { label: 'Source', value: plugin.sourceLabel, href: plugin.sourceUrl, mono: true, wide: true },
          ...(clawhubLink ? [{ label: 'ClawHub', value: plugin.clawhubSlug || 'View on ClawHub', href: clawhubLink, mono: true, wide: true }] : []),
        ]}
      >
        <span class="cat-side-cta"><CopyButton text={plugin.installCommand} label="Copy install command" variant="button" /></span>
      </CatalogFacts>
      <CatalogMiniList title="Other plugins" items={relatedPlugins.map((entry) => ({ href: `/plugins/${entry.slug}/`, title: entry.title, tagline: entry.tagline }))} />
    </Fragment>
  </CatalogDetail>

  <CatalogRelated title="More plugins" items={morePlugins} indexHref="/plugins/" indexLabel="All plugins" backLabel="Back to plugins" />
</SiteLayout>

<style>
  .cat-panel-btn { min-height: 44px; padding: 0 18px; }
  .cat-side-cta { display: contents; }
  @media (max-width: 980px) { .cat-side-cta { display: none; } }
  @media (max-width: 760px) { .cat-panel-btn { display: none; } }
</style>
