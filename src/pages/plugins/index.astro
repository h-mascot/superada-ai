---
import { publishedPlugins, pluginPlatforms } from '../../data/plugins';
import PageHero from '../../components/PageHero.astro';
import CatalogCard from '../../components/catalog/CatalogCard.astro';
import CatalogCrossBand from '../../components/catalog/CatalogCrossBand.astro';
import CatalogHeroMeta from '../../components/catalog/CatalogHeroMeta.astro';
import CatalogStats from '../../components/catalog/CatalogStats.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { catalogs, countBy, statusTone } from '../../lib/catalog';

const plugins = [...publishedPlugins].sort((a, b) => a.title.localeCompare(b.title));
const platformLabel = (id: keyof typeof pluginPlatforms) => pluginPlatforms[id].label;

const byStatus = countBy(plugins, (plugin) => plugin.status);
const platformsInUse = new Set(plugins.flatMap((plugin) => plugin.platforms));
const otherCatalogs = catalogs.filter((catalog) => catalog.href !== '/plugins/');
---

<SiteLayout
  title="Plugin Marketplace — SuperAda"
  description="Runtime plugins from the Enterprise Crew, with public source links, install contracts, supported platform badges, and the verification receipts that prove the plugin is really enforcing on a live system."
>
  <PageHero
    eyebrow="Plugin Marketplace"
    title="Runtime plugins"
    lede="Installable plugins that hook the live runtimes the Enterprise Crew runs on. Each listing links the canonical source, names the supported platforms, and ships a self-install contract with verification receipts."
    id="plugins-title"
  >
    <Fragment slot="title">Runtime <em>plugins</em></Fragment>
    <CatalogHeroMeta>
      <a class="ds-btn" href="#catalog">Browse {plugins.length} plugins <span aria-hidden="true">↓</span></a>
      {otherCatalogs.map((catalog) => <a class="ds-btn ds-btn--ghost" href={catalog.href}>{catalog.title}</a>)}
    </CatalogHeroMeta>
    <CatalogStats
      slot="aside"
      label="Plugins by status"
      items={[
        { value: plugins.length, label: 'Plugins' },
        { value: byStatus.get('Live') ?? 0, label: 'Live', tone: 'live' },
        { value: (byStatus.get('Draft') ?? 0) + (byStatus.get('Beta') ?? 0) + (byStatus.get('Internal') ?? 0), label: 'Draft or beta', tone: 'warn' },
        { value: platformsInUse.size, label: 'Runtimes' },
      ]}
      caption={`Supported runtimes: ${[...platformsInUse].map((platform) => platformLabel(platform)).join(' · ')}.`}
    />
  </PageHero>

  <section class="ds-shell cat-catalog" id="catalog" aria-labelledby="catalog-title">
    <div class="ds-section-head cat-catalog-head">
      <div>
        <h2 class="ds-h2" id="catalog-title">All plugins</h2>
        <p>A plugin is a real runtime component, not a workflow bundle. It registers hooks, modifies outbound behavior, and is verified by what the live system actually did, not by what the config file said.</p>
      </div>
    </div>

    <div class="ds-grid ds-grid--2 cat-grid">
      {plugins.map((plugin) => (
        <CatalogCard
          href={`/plugins/${plugin.slug}/`}
          title={plugin.title}
          tagline={plugin.tagline}
          summary={plugin.summary}
          badges={[
            { label: plugin.status, tone: statusTone(plugin.status) },
            { label: plugin.category, tone: 'plain' },
            { label: plugin.difficulty, tone: 'plain' },
            ...plugin.platforms.map((platform) => ({ label: platformLabel(platform), tone: 'accent' as const })),
          ]}
          facts={[
            { label: 'Source', value: plugin.sourceLabel, href: plugin.sourceUrl, mono: true },
            { label: 'Supported platforms', value: plugin.platforms.map((p) => platformLabel(p)).join(' · '), mono: true },
          ]}
          command={plugin.installCommand}
          meta={[`${plugin.difficulty} setup`]}
          cta="View plugin"
          attrs={{ 'data-category': plugin.category }}
        />
      ))}
    </div>
  </section>

  <CatalogCrossBand current="/plugins/" title="Not a runtime change?" copy="Skills teach an agent a capability. Workflows bundle skills into repeatable operator routines." />
</SiteLayout>

<style>
  .cat-catalog { scroll-margin-top: var(--chrome-top); }
  .cat-catalog-head p { max-width: 44rem; margin-top: 10px; color: var(--muted); font-size: 15px; line-height: 1.6; }
  .cat-grid { gap: 18px; }
  @media (max-width: 760px) {
    .cat-grid { gap: 12px; }
  }
</style>
