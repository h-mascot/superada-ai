---
import NavIcon from '../components/NavIcon.astro';
import PageHero from '../components/PageHero.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const title = 'Use Cases - SuperAda';
const description = 'Plain-English examples of how Henry and the Enterprise Crew use agents for research, meetings, inboxes, shipping, and operations.';

const useCases = [
  {
    category: 'Operations',
    title: 'Heartbeat',
    summary: 'Ada posts a fleet status card every 6 hours, and underneath the card runs a control loop that keeps roughly 132 cron jobs honest in between.',
    runs: 'Card every 6 hours into the private #heartbeat channel. Underneath it, a contract validator and a fleet sweep run every 30 minutes.',
    connects: 'Hermes cron state, machine-checkable contracts for 9 core jobs (freshness SLAs, output markers, side-effect artifact freshness), a sweep across all ~132 cron jobs for unregistered fails, circuit breakers, and a waiting-gate tracker.',
    givesBack: 'A max-12-line card with readiness score, contract pass count, breaker trips, and open gates. Scheduler ok counts for nothing; only receipts do. The sweep surfaces failing jobs nobody registered, with a readiness penalty.',
    humanGate: 'Report-only by default: 3 consecutive failed receipts trip the breaker and it flags loudly, but auto-pause stays behind explicit approval from Henry. Anything destructive, credential-related, or customer-facing stops for him.',
    image: '/use-cases/heartbeat.webp'
  },
  {
    category: 'Daily briefing',
    title: 'Morning brief',
    summary: 'Ada turns calendar, inbox, task, vault, and fleet signals into a short morning brief Henry can act on.',
    runs: 'Every morning at 7am, delivered to the internal ops channel.',
    connects: 'Google Calendar, Gmail, Obsidian notes, recent sessions, Mission Control-style task surfaces, crew health checks, and Henry’s current location/timezone file.',
    givesBack: 'Three concrete actions for the day, what finished overnight, what is blocked, and anything that needs Henry rather than another agent pretending to be useful.',
    humanGate: 'The agent can read, summarize, archive low-risk inbox noise under standing rules, and draft. It cannot send as Henry, make commitments, change external calendars, or publish without approval.',
    image: '/use-cases/morning-brief.webp'
  },
  {
    category: 'Daily briefing',
    title: 'The 8pm voice debrief',
    summary: 'Every evening a scheduled job opens a voice session, hands it a fresh context pack, and interviews Henry about his day while writing notes in real time. The debrief interviews him so the notes write themselves.',
    runs: 'Daily at 8pm. If a voice session is already live, it stays out of the way.',
    connects: 'The day’s plan and task notes, yesterday’s debrief as carry-forward, a project folder with interview instructions, and the desktop voice client on the crew Mac.',
    givesBack: 'A live voice conversation that asks one question at a time, and a notes file that fills in as he speaks — seconds behind his words, so nothing is lost even if the call drops.',
    humanGate: 'The scheduler is deterministic and script-only: zero agent tokens. It can start sessions and write notes. It cannot send external messages, publish, or touch anything outside the debrief folder.',
    image: '/use-cases/recapper-voice-debrief.webp'
  },
    {
    category: 'Meetings',
    title: 'Meeting prep and follow-up',
    summary: 'Before a call, Ada builds the context Henry would otherwise hunt through manually. After the call, it turns the transcript into next steps.',
    runs: 'On demand or as part of a meeting-actions workflow.',
    connects: 'Calendar events, attendee names, company context, prior notes, CRM-style relationship memory, docs, email threads, and meeting transcripts from Fireflies or Google Meet captions when available.',
    givesBack: 'A prep note with who is joining, what happened before, likely agenda, useful questions, open risks, and after the call, owner-backed action items plus follow-up drafts.',
    humanGate: 'Prep, summaries, and draft follow-ups are safe. Sending messages, changing calendar invites, or making commercial promises requires approval unless a standing workflow already covers that exact action.',
    image: '/use-cases/meeting-prep.webp'
  },
  {
    category: 'Relationships',
    title: 'Personal CRM',
    summary: 'A daily sync keeps Henry’s relationship memory fresh without turning it into a creepy outreach cannon. We are civilized villains here.',
    runs: 'Daily at 5:45am, local-only.',
    connects: 'Gmail, Google Calendar, Slack, Fireflies, Apollo contact data, local CRM tables, embeddings, duplicate checks, and relationship-health scoring.',
    givesBack: 'Updated contacts, interaction history, relationship health, duplicate suggestions, and a searchable base for meeting prep or follow-up.',
    humanGate: 'The sync is read-only against providers and writes only to the local CRM database. It does not send messages, launch outreach, enrich contacts externally, or mutate provider records.',
    image: '/use-cases/personal-crm.webp'
  },
  {
    category: 'Inbox',
    title: 'Urgent message triage',
    summary: 'Ada watches for messages that are easy to miss but expensive to ignore, then stages the response path.',
    runs: 'As a recurring check or on demand when Henry asks for an inbox audit.',
    connects: 'Gmail, Slack or Discord mentions, WhatsApp/Beeper queues, sender history, current priorities, and thread context.',
    givesBack: 'A short list of what needs attention, why it matters, suggested next action, and draft replies when useful.',
    humanGate: 'Reading and drafting can be automatic. Sending as Henry, contacting a new person, making promises, or escalating externally needs approval.',
    image: '/use-cases/inbox-triage.webp'
  },
  {
    category: 'Product',
    title: 'Runner builds a scoped task',
    summary: 'A coding runner takes a bounded ticket, changes the repo, runs the gate, and returns proof instead of “looks good” fog machine nonsense.',
    runs: 'On approved tickets or durable project loops.',
    connects: 'GitHub or local repo state, task brief, acceptance criteria, tests, build commands, review tools, and deployment rules.',
    givesBack: 'A branch or patch, the exact diff, test/build output, blockers, and the next merge or review step.',
    humanGate: 'Local reversible edits and tests can run. Merge, production deploy, destructive migration, customer release, or expanded scope waits for Henry or the project owner.',
    image: '/use-cases/runner-build.webp'
  },
    {
    category: 'Sales',
    title: 'Account brief before a customer call',
    summary: 'Ada pulls the account story together before Henry walks into a sales or partnership conversation.',
    runs: 'On demand before a call, event, or outreach push.',
    connects: 'Company site, LinkedIn-style public signals, prior emails, meeting notes, CRM records, insurance-market context, and open asks from the team.',
    givesBack: 'A short account brief: what they do, why they might care, previous touchpoints, likely objections, useful angles, and the next best ask.',
    humanGate: 'Research and draft talking points can run alone. Sending outreach, quoting terms, making promises, or updating a customer-facing record needs approval.',
    image: '/use-cases/account-brief.webp'
  },
            {
    category: 'Fleet',
    title: 'Agent runtime repair',
    summary: 'When one crew member stalls, Ada checks the host, process, gateway, logs, and route before declaring the bot dead and buying flowers.',
    runs: 'When a heartbeat, user report, or monitor flags an agent as unhealthy.',
    connects: 'Host process lists, gateway logs, journalctl, cron state, agent workspaces, deployment receipts, and known host routing rules.',
    givesBack: 'A diagnosis, the smallest safe repair already attempted, remaining blocker, and proof that the agent is healthy or still down.',
    humanGate: 'Safe restarts and local reversible fixes can run under maintenance rules. Credential changes, production data deletion, or broad fleet config changes need approval.',
    image: '/use-cases/runtime-repair.webp'
  },
      {
    category: 'Media',
    title: 'Script-to-video proof pack',
    summary: 'Ada turns a story or workflow into a media plan with prompts, shots, narration, and verification instead of vibes in a trench coat.',
    runs: 'When a launch, article, or resource needs visual proof or social video.',
    connects: 'Script notes, brand references, generated images, TTS output, timelines, asset checks, and final-render QA.',
    givesBack: 'Storyboard, image prompts, narration script, render plan, artifact paths, and verification notes for what passed or drifted.',
    humanGate: 'Drafting, rendering tests, and local QA can run. Publishing, using real people/customer names, or final external distribution waits for approval.',
    image: '/use-cases/script-to-video.webp'
  },
  {
    category: 'Learning',
    title: 'YouTube learning tracker',
    summary: 'Ada tracks what Henry watches on YouTube every day, keeps him honest against his 10-hour learning target, and turns the best videos into insights and todos.',
    runs: 'Every night, automatically. A report lands in a private channel with the day’s numbers, the queue, and anything worth his attention.',
    connects: 'Henry’s YouTube accounts, read through an authenticated browser on his own machine, plus his learning target and the queue backlog.',
    givesBack: 'A daily scorecard of learning hours against target, a prioritized backlog of videos worth revisiting, and takeaways proposed as todos.',
    humanGate: 'Insights arrive as proposals; nothing becomes a todo until Henry approves. He sees aggregates like hours and counts, not a view-by-view log.',
    image: '/use-cases/youtube-learning.webp',
    story: '/use-cases/youtube-learning-tracker'
  },
              ];
const setupSteps = [
  'Pick one repeated job Henry already has to do.',
  'Connect the safe sources the agent is allowed to read.',
  'Define what the agent returns and where it delivers it.',
  'Write the approval boundary before the automation runs.',
  'Keep receipts, so the output can be checked instead of trusted.'
];
const slug = (text: string) => text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const areas = new Set(useCases.map((item) => item.category)).size;
---
<SiteLayout title={title} description={description}>
  <PageHero eyebrow="Use cases" title="Henry’s agent use cases" lede="These are plain examples of how Henry and the Enterprise Crew use agents in daily work. Not a prompt library. Not a raw catalog. Just the recurring jobs, what each one connects to, what comes back, and where the human approval line sits." size="lg">
    <Fragment slot="title">Henry’s agent <em>use cases</em></Fragment>
    <a class="ds-btn" href="#examples">See the examples <span aria-hidden="true">↓</span></a>
    <a class="ds-btn ds-btn--ghost" href="/resources/agent-workflow-atlas/">Workflow atlas</a>
    <Fragment slot="aside">
      <div class="ds-stats uc-stats">
        <div class="ds-stat"><b>{useCases.length}</b><span>recurring jobs mapped</span></div>
        <div class="ds-stat"><b>{areas}</b><span>areas of work</span></div>
        <div class="ds-stat"><b>{useCases.filter((item) => item.humanGate).length}/{useCases.length}</b><span>with a written approval line</span></div>
      </div>
    </Fragment>
  </PageHero>

  <div class="ds-shell">
    <section class="ds-grid ds-grid--2 uc-intro" aria-label="What the page covers">
      <article class="ds-card">
        <span class="ds-card-icon"><NavIcon name="docs" /></span>
        <h2>Readable by a normal operator</h2>
        <p>Each example explains the work in human terms. “Meeting prep” is easier to understand than “calendar-aware contextual synthesis loop,” which sounds like a SaaS landing page got trapped in a blender.</p>
      </article>
      <article class="ds-card ds-card--feature">
        <span class="ds-card-icon"><NavIcon name="shield" /></span>
        <h2>Built around approval</h2>
        <p>The useful part is not just that an agent can act. It is knowing what it can do alone, what it should draft, and where it must stop for Henry.</p>
      </article>
    </section>

    <section id="examples" class="ds-section uc-examples" aria-labelledby="examples-title">
      <div class="uc-examples-head">
        <span class="ds-eyebrow">Examples</span>
        <h2 class="ds-h2" id="examples-title">How the system gets used</h2>
      </div>
      <nav class="uc-index" aria-label="Jump to a use case" data-no-reveal>
        {useCases.map((item) => <a class="ds-chip" href={`#${slug(item.title)}`}>{item.title}</a>)}
      </nav>

      <div class="uc-list">
        {useCases.map((item, index) => (
          <article class:list={['uc-case', { 'is-flipped': index % 2 === 1 }]} id={slug(item.title)}>
            {item.image && (
              <div class="uc-figure" style={`--art: url('${item.image}')`}>
                <img src={item.image} alt={`Illustration: ${item.title}`} width="1024" height="576" loading="lazy" decoding="async" />
              </div>
            )}
            <div class="uc-copy">
              <div class="uc-topline">
                <span class="ds-card-kicker"><span>{String(index + 1).padStart(2, '0')}</span>{item.category}</span>
                <h3>{item.title}</h3>
                <p>{item.summary}</p>
              </div>
              <dl class="uc-facts">
                <div>
                  <dt>When it runs</dt>
                  <dd>{item.runs}</dd>
                </div>
                <div>
                  <dt>What it connects to</dt>
                  <dd>{item.connects}</dd>
                </div>
                <div>
                  <dt>What Henry gets back</dt>
                  <dd>{item.givesBack}</dd>
                </div>
                <div class="uc-gate">
                  <dt><NavIcon name="shield" />Where the human stays in charge</dt>
                  <dd>{item.humanGate}</dd>
                </div>
              </dl>
              {item.story && <a class="ds-card-link uc-story" href={item.story}>Read the full story <span aria-hidden="true">→</span></a>}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="ds-section ds-panel uc-setup" aria-labelledby="setup-title">
      <div class="uc-setup-head">
        <span class="ds-eyebrow">Setup pattern</span>
        <h2 class="ds-h2" id="setup-title">The recipe is boring on purpose</h2>
        <p>Good agent workflows are not magic. They are clear inputs, a narrow job, a delivery route, and a gate. The boring version works. The cinematic version sends you a 19-page report no one asked for and calls it strategy.</p>
      </div>
      <ol class="uc-steps">
        {setupSteps.map((step, index) => <li><span class="uc-step-n">{String(index + 1).padStart(2, '0')}</span><span>{step}</span></li>)}
      </ol>
    </section>

    <a class="ds-cta-band uc-more" href="/resources/agent-workflow-atlas/">
      <div>
        <span class="ds-eyebrow">Workflow atlas</span>
        <span class="ds-h2">See more</span>
        <p>The full workflow atlas, with every mapped use case and filters by agent and category.</p>
      </div>
      <span class="ds-btn" aria-hidden="true">Open the atlas <span>→</span></span>
    </a>
  </div>
</SiteLayout>

<style>
  .uc-stats { display: grid; gap: 0; padding-bottom: 8px; }
  .uc-stats .ds-stat { grid-template-columns: 120px minmax(0, 1fr); align-items: center; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--border); }
  .uc-stats .ds-stat:last-child { border-bottom: 0; }
  .uc-stats .ds-stat b { font-size: clamp(36px, 3.6vw, 52px); color: var(--accent); }

  .uc-examples-head { display: grid; gap: 14px; margin-bottom: 22px; }
  .uc-index { position: sticky; top: var(--chrome-top); z-index: 20; display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; margin: 0 calc(var(--gutter) * -1) 28px; padding: 12px var(--gutter); background: color-mix(in srgb, var(--bg) 84%, transparent); -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px); border-bottom: 1px solid color-mix(in srgb, var(--border) 60%, transparent); mask-image: linear-gradient(90deg, transparent, #000 var(--gutter), #000 calc(100% - var(--gutter)), transparent); transition: top .4s var(--ease-ios); }
  .uc-index::-webkit-scrollbar { display: none; }
  .uc-index .ds-chip { flex: none; }

  .uc-list { display: grid; gap: clamp(20px, 2.6vw, 32px); }
  .uc-case { display: grid; grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr); overflow: hidden; overflow: clip; border-radius: var(--radius-xl); border: 1px solid var(--surface-border); background: var(--surface); scroll-margin-top: calc(var(--chrome-top) + 80px); transition: border-color .3s ease, box-shadow .5s ease; }
  .uc-case.is-flipped { grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr); }
  .uc-case.is-flipped .uc-figure { order: 2; border-right: 0; border-left: 1px solid var(--border); }
  @media (hover: hover) {
    .uc-case:hover { border-color: color-mix(in srgb, var(--accent) 35%, var(--surface-border)); box-shadow: var(--lift); }
    .uc-case:hover .uc-figure img { transform: scale(1.035); }
  }
  .uc-figure { position: relative; overflow: hidden; overflow: clip; display: grid; place-items: start center; min-height: 100%; padding: clamp(16px, 2vw, 28px); border-right: 1px solid var(--border); background: #0b0a09; isolation: isolate; }
  .uc-figure::before { content: ''; position: absolute; inset: -10%; z-index: -1; background: var(--art) center / cover no-repeat; filter: blur(34px) saturate(1.3) brightness(.55); transform: scale(1.1); }
  .uc-figure img { position: sticky; top: calc(var(--chrome-top) + 96px); width: 100%; height: auto; max-height: 520px; object-fit: contain; display: block; border-radius: var(--radius-md); box-shadow: 0 24px 60px rgba(0, 0, 0, .45); transition: transform 1.1s var(--ease-out); }
  .uc-copy { display: grid; gap: 20px; align-content: start; padding: clamp(24px, 3vw, 40px); }
  .uc-topline { display: grid; gap: 12px; }
  .uc-topline .ds-card-kicker span { color: var(--faint); }
  .uc-topline h3 { font: 500 clamp(28px, 2.8vw, 40px)/1.02 var(--font-display); letter-spacing: -.045em; color: var(--text); text-wrap: balance; }
  .uc-topline p { color: var(--text-soft); font-size: 16.5px; line-height: 1.6; }
  .uc-facts { display: grid; margin: 0; }
  .uc-facts > div { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 16px; padding: 13px 0; border-top: 1px solid var(--border); }
  .uc-facts dt { display: flex; align-items: flex-start; gap: 8px; color: var(--muted); font: 750 10.5px/1.5 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; }
  .uc-facts dd { margin: 0; color: var(--text-soft); font-size: 15px; line-height: 1.6; }
  .uc-facts > .uc-gate { grid-template-columns: 1fr; gap: 8px; margin-top: 6px; padding: 16px 18px; border: 1px solid color-mix(in srgb, var(--accent) 38%, var(--border)); border-radius: var(--radius-md); background: color-mix(in srgb, var(--accent-soft) 55%, transparent); }
  .uc-gate dt { color: var(--accent); }
  .uc-gate dt :global(.nav-icon) { width: 16px; height: 16px; flex: none; margin-top: -1px; }
  .uc-gate dd { color: var(--text); }
  .uc-story { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; justify-self: start; }

  .uc-setup { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(24px, 4vw, 64px); }
  .uc-setup-head { display: grid; gap: 14px; align-content: start; }
  .uc-setup-head p { color: var(--muted); font-size: 16px; line-height: 1.65; }
  .uc-steps { list-style: none; margin: 0; padding: 0; display: grid; counter-reset: step; }
  .uc-steps li { position: relative; display: grid; grid-template-columns: 52px minmax(0, 1fr); gap: 14px; align-items: center; padding: 16px 0; border-bottom: 1px solid var(--border); color: var(--text); font-size: 16.5px; line-height: 1.5; }
  .uc-steps li:last-child { border-bottom: 0; }
  .uc-step-n { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%; border: 1px solid color-mix(in srgb, var(--accent) 40%, var(--border)); background: var(--accent-soft); color: var(--accent); font: 750 12.5px/1 var(--font-mono); }
  .uc-steps li:not(:last-child) .uc-step-n::after { content: ''; position: absolute; left: 22px; top: calc(50% + 24px); height: calc(50% - 8px); width: 1px; background: linear-gradient(var(--accent), transparent); opacity: .5; }

  .uc-more { color: var(--text); }
  .uc-more .ds-h2 { display: block; }
  .uc-more .ds-btn span { transition: transform .35s var(--ease-spring); }
  @media (hover: hover) {
    .uc-more { transition: border-color .3s ease, box-shadow .5s ease, transform .45s var(--ease-out); }
    .uc-more:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--accent) 45%, var(--surface-border)); box-shadow: var(--lift); }
    .uc-more:hover .ds-btn span { transform: translateX(4px); }
  }

  @media (max-width: 1080px) {
    .uc-facts > div { grid-template-columns: 1fr; gap: 6px; }
  }
  @media (max-width: 900px) {
    .uc-case, .uc-case.is-flipped { grid-template-columns: 1fr; }
    .uc-case.is-flipped .uc-figure { order: 0; border-left: 0; }
    .uc-figure { min-height: 0; padding: 0; border-right: 0; border-bottom: 1px solid var(--border); }
    .uc-figure { place-items: center; }
    .uc-figure img { position: static; width: auto; max-width: 100%; max-height: 380px; border-radius: 0; box-shadow: 0 0 40px rgba(0, 0, 0, .4); }
    .uc-setup { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    .uc-stats .ds-stat { grid-template-columns: 92px minmax(0, 1fr); padding: 10px 0; }
    .uc-stats .ds-stat b { font-size: 34px; }
    .uc-case { border-radius: var(--radius-lg); }
    .uc-copy { padding: 20px 18px 22px; gap: 16px; }
    .uc-topline h3 { font-size: 30px; }
    .uc-topline p { font-size: 16px; }
    .uc-index .ds-chip { min-height: 44px; }
    .uc-index { margin-bottom: 20px; }
    .uc-setup { padding: 24px 20px; border-radius: var(--radius-lg); }
    .uc-steps li { font-size: 16px; }
    .uc-case { scroll-margin-top: 80px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .uc-figure img, .uc-case, .uc-more, .uc-more .ds-btn span, .uc-index { transition: none; }
  }
</style>
