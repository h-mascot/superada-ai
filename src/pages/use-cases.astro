---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Use Cases - SuperAda';
const description = 'Plain-English examples of how Henry and the Enterprise Crew use agents for research, meetings, inboxes, shipping, and operations.';

const useCases = [
  {
    category: 'Operations',
    title: 'Heartbeat',
    summary: 'Ada checks the agent fleet every hour and sends a short status card only when something changed or needs attention.',
    runs: 'Hourly, into the private #heartbeat channel.',
    connects: 'Hermes cron state, gateway health, storage headroom, dropped-session watchdogs, error clusters, Entity docs, and recent agent receipts.',
    givesBack: 'A compact readiness score, the main blocker, safe recovery already performed, and a deep-dive link with the evidence.',
    humanGate: 'Ada can inspect, recover dropped internal threads, update receipts, and perform safe local fixes. Anything destructive, customer-facing, credential-related, or broader than the approved maintenance window stops for Henry.'
  },
  {
    category: 'Daily briefing',
    title: 'Morning brief',
    summary: 'Ada turns calendar, inbox, task, vault, and fleet signals into a short morning brief Henry can act on.',
    runs: 'Every morning at 7am, delivered to the internal ops channel.',
    connects: 'Google Calendar, Gmail, Obsidian notes, recent sessions, Mission Control-style task surfaces, crew health checks, and Henry’s current location/timezone file.',
    givesBack: 'Three concrete actions for the day, what finished overnight, what is blocked, and anything that needs Henry rather than another agent pretending to be useful.',
    humanGate: 'The agent can read, summarize, archive low-risk inbox noise under standing rules, and draft. It cannot send as Henry, make commitments, change external calendars, or publish without approval.'
  },
  {
    category: 'Daily briefing',
    title: 'The 20:00 voice debrief',
    summary: 'Every evening a scheduled job opens a voice session, hands it a fresh context pack, and interviews Henry about his day while writing notes in real time. The debrief interviews him so the notes write themselves.',
    runs: 'Daily at 20:00 UK. If a voice session is already live, it stays out of the way.',
    connects: 'The day’s plan and task notes, yesterday’s debrief as carry-forward, a project folder with interview instructions, and the desktop voice client on the crew Mac.',
    givesBack: 'A live voice conversation that asks one question at a time, and a notes file that fills in as he speaks — seconds behind his words, so nothing is lost even if the call drops.',
    humanGate: 'The scheduler is deterministic and script-only: zero agent tokens. It can start sessions and write notes. It cannot send external messages, publish, or touch anything outside the debrief folder.'
  },
  {
    category: 'Research',
    title: 'AI news watch',
    summary: 'Spock and the WeeklyClaw research jobs scan AI news, remove duplicates, and turn useful developments into briefs or draft posts.',
    runs: 'Daily and twice-daily, depending on the lane. Some runs stay silent when there is nothing worth sending.',
    connects: 'Hacker News, TechCrunch AI, The Verge AI, Ars Technica, credible X sources, Polymarket AI-market state, saved research memory, and prior draft history.',
    givesBack: 'Ranked AI items with source links, why they matter, draft social posts when useful, and a clear marker when the evidence is weak or already covered.',
    humanGate: 'Research and draft staging can run alone. Public posts, market-facing claims, customer references, or anything with shaky sourcing wait for review.'
  },
  {
    category: 'Meetings',
    title: 'Meeting prep and follow-up',
    summary: 'Before a call, Ada builds the context Henry would otherwise hunt through manually. After the call, it turns the transcript into next steps.',
    runs: 'On demand or as part of a meeting-actions workflow.',
    connects: 'Calendar events, attendee names, company context, prior notes, CRM-style relationship memory, docs, email threads, and meeting transcripts from Fireflies or Google Meet captions when available.',
    givesBack: 'A prep note with who is joining, what happened before, likely agenda, useful questions, open risks, and after the call, owner-backed action items plus follow-up drafts.',
    humanGate: 'Prep, summaries, and draft follow-ups are safe. Sending messages, changing calendar invites, or making commercial promises requires approval unless a standing workflow already covers that exact action.'
  },
  {
    category: 'Relationships',
    title: 'Personal CRM',
    summary: 'A daily sync keeps Henry’s relationship memory fresh without turning it into a creepy outreach cannon. We are civilized villains here.',
    runs: 'Daily at 5:45am, local-only.',
    connects: 'Gmail, Google Calendar, Slack, Fireflies, Apollo contact data, local CRM tables, embeddings, duplicate checks, and relationship-health scoring.',
    givesBack: 'Updated contacts, interaction history, relationship health, duplicate suggestions, and a searchable base for meeting prep or follow-up.',
    humanGate: 'The sync is read-only against providers and writes only to the local CRM database. It does not send messages, launch outreach, enrich contacts externally, or mutate provider records.'
  },
  {
    category: 'Inbox',
    title: 'Urgent message triage',
    summary: 'Ada watches for messages that are easy to miss but expensive to ignore, then stages the response path.',
    runs: 'As a recurring check or on demand when Henry asks for an inbox audit.',
    connects: 'Gmail, Slack or Discord mentions, WhatsApp/Beeper queues, sender history, current priorities, and thread context.',
    givesBack: 'A short list of what needs attention, why it matters, suggested next action, and draft replies when useful.',
    humanGate: 'Reading and drafting can be automatic. Sending as Henry, contacting a new person, making promises, or escalating externally needs approval.'
  },
  {
    category: 'Product',
    title: 'Runner builds a scoped task',
    summary: 'A coding runner takes a bounded ticket, changes the repo, runs the gate, and returns proof instead of “looks good” fog machine nonsense.',
    runs: 'On approved tickets or durable project loops.',
    connects: 'GitHub or local repo state, task brief, acceptance criteria, tests, build commands, review tools, and deployment rules.',
    givesBack: 'A branch or patch, the exact diff, test/build output, blockers, and the next merge or review step.',
    humanGate: 'Local reversible edits and tests can run. Merge, production deploy, destructive migration, customer release, or expanded scope waits for Henry or the project owner.'
  },
  {
    category: 'Publishing',
    title: 'Public-safe resource page',
    summary: 'Ada turns a private evidence pack into a page strangers can read without exposing private proof or internal mess.',
    runs: 'When a resource, use-case page, article, or public artifact needs to ship.',
    connects: 'Private receipts, source notes, repo content, screenshots, diagrams, QA scripts, build output, deployment status, and production route checks.',
    givesBack: 'A readable page, a privacy-safe version of the useful pattern, build receipts, route checks, and a clear list of anything blocked by approval or missing credentials.',
    humanGate: 'Drafting, local build, and QA can run. Public release needs privacy review and approval for sensitive claims, private evidence, customer references, or external announcements.'
  },
  {
    category: 'Sales',
    title: 'Account brief before a customer call',
    summary: 'Ada pulls the account story together before Henry walks into a sales or partnership conversation.',
    runs: 'On demand before a call, event, or outreach push.',
    connects: 'Company site, LinkedIn-style public signals, prior emails, meeting notes, CRM records, insurance-market context, and open asks from the team.',
    givesBack: 'A short account brief: what they do, why they might care, previous touchpoints, likely objections, useful angles, and the next best ask.',
    humanGate: 'Research and draft talking points can run alone. Sending outreach, quoting terms, making promises, or updating a customer-facing record needs approval.'
  },
  {
    category: 'Sales',
    title: 'Conference follow-up',
    summary: 'After an event, Ada turns messy notes, badge scans, and “remind me later” chaos into a real follow-up queue.',
    runs: 'After conferences, dinners, demos, and investor or partner events.',
    connects: 'Calendar history, attendee lists, notes, photos or scans Henry provides, email threads, contact records, and priority tags.',
    givesBack: 'A ranked follow-up list, suggested messages, owner tags, stale leads, and contacts that should be saved or merged.',
    humanGate: 'Ada can organize and draft. It cannot send first-time outreach, add people to campaigns, or commit Henry to meetings without confirmation.'
  },
  {
    category: 'Operations',
    title: 'Action tracker cleanup',
    summary: 'Ada turns scattered commitments from chats, calls, and docs into owned work instead of letting them rot in the swamp.',
    runs: 'On demand, after meetings, or during weekly reviews.',
    connects: 'Slack or Discord threads, meeting notes, task boards, docs, calendar context, and prior action-item history.',
    givesBack: 'Deduplicated actions with owners, deadlines, source links, unclear items, and a clean handoff for the person responsible.',
    humanGate: 'Creating internal draft tasks and summaries is fine. Reassigning people, changing official plans, or messaging stakeholders requires review unless Henry already approved that workflow.'
  },
  {
    category: 'Memory',
    title: 'Cross-session context recovery',
    summary: 'When a conversation gets long or an agent restarts, Ada rebuilds the thread from receipts instead of asking Henry to repeat himself like a haunted printer.',
    runs: 'After compaction, restarts, handoffs, or “what happened with this?” questions.',
    connects: 'LCM summaries, raw message excerpts, project plans, task receipts, git history, deployment logs, and memory files.',
    givesBack: 'A compact reconstruction of decisions, current state, evidence, blockers, and the next safe action.',
    humanGate: 'Reading and summarizing are safe. Editing durable memory, changing tasks, or acting on recovered context follows the same approval boundary as the original work.'
  },
  {
    category: 'Research',
    title: 'Public claim verification',
    summary: 'Spock checks whether a claim is true enough to use before it becomes content, strategy, or expensive confidence.',
    runs: 'On demand for articles, decks, market maps, investor notes, and social posts.',
    connects: 'Primary sources, company docs, public filings, credible media, archived pages, prior research notes, and source-quality rules.',
    givesBack: 'A source-backed answer, confidence level, contradictions, direct citations, and wording that does not overclaim.',
    humanGate: 'Research can run alone. Publishing, legal-sensitive statements, customer references, or strong claims from weak evidence wait for Henry.'
  },
  {
    category: 'Finance',
    title: 'Gateway cost watch',
    summary: 'Ada and Midas look for model spend, token waste, quota risk, and runaway agent loops before the bill gets funny in a bad way.',
    runs: 'Recurring checks and on-demand audits.',
    connects: 'Provider usage APIs, gateway logs, cron inventory, model routing config, token ledgers, and agent-run receipts.',
    givesBack: 'Burn-rate summaries, waste suspects, quota warnings, route recommendations, and exact evidence for anything that needs fixing.',
    humanGate: 'Read-only audit and recommendations are safe. Changing production routing, cutting off agents, or rotating paid provider credentials needs approval unless a standing incident rule applies.'
  },
  {
    category: 'Fleet',
    title: 'Agent runtime repair',
    summary: 'When one crew member stalls, Ada checks the host, process, gateway, logs, and route before declaring the bot dead and buying flowers.',
    runs: 'When a heartbeat, user report, or monitor flags an agent as unhealthy.',
    connects: 'Host process lists, gateway logs, journalctl, cron state, agent workspaces, deployment receipts, and known host routing rules.',
    givesBack: 'A diagnosis, the smallest safe repair already attempted, remaining blocker, and proof that the agent is healthy or still down.',
    humanGate: 'Safe restarts and local reversible fixes can run under maintenance rules. Credential changes, production data deletion, or broad fleet config changes need approval.'
  },
  {
    category: 'Docs',
    title: 'Evidence-backed Google Doc or deck',
    summary: 'Ada turns raw notes into a document Henry can share, with claims grounded in sources instead of “trust me bro” vapor.',
    runs: 'When Henry asks for a brief, deck, memo, investor update, or customer-facing artifact.',
    connects: 'Source docs, spreadsheets, meeting notes, transcripts, web research, prior drafts, brand rules, and Google Workspace publication tools.',
    givesBack: 'A structured doc or deck draft, cited claims, unresolved questions, and a shareable link when publication is approved.',
    humanGate: 'Drafting and internal docs are safe. Sending, sharing externally, or publishing sensitive business claims requires review.'
  },
  {
    category: 'Content',
    title: 'X/Twitter draft from research',
    summary: 'Ada turns verified research into posts that sound like Henry, not like a B2B webinar had a nervous breakdown.',
    runs: 'On demand or as part of a news/content pipeline.',
    connects: 'Source links, prior posts, Henry voice examples, publication queue, topical context, and claim-verification results.',
    givesBack: 'Draft posts, thread options, source receipts, risk notes, and alternates tuned for punch or clarity.',
    humanGate: 'Drafting and staging are safe. Posting, replying from Henry’s account, or making public claims needs approval.'
  },
  {
    category: 'Media',
    title: 'Script-to-video proof pack',
    summary: 'Ada turns a story or workflow into a media plan with prompts, shots, narration, and verification instead of vibes in a trench coat.',
    runs: 'When a launch, article, or resource needs visual proof or social video.',
    connects: 'Script notes, brand references, generated images, TTS output, timelines, asset checks, and final-render QA.',
    givesBack: 'Storyboard, image prompts, narration script, render plan, artifact paths, and verification notes for what passed or drifted.',
    humanGate: 'Drafting, rendering tests, and local QA can run. Publishing, using real people/customer names, or final external distribution waits for approval.'
  },
  {
    category: 'Hiring',
    title: 'Candidate review pack',
    summary: 'Ada gathers the evidence around a hire or contractor decision so Henry can decide faster without pretending vibes are data.',
    runs: 'When a candidate, trial hire, or compensation decision needs review.',
    connects: 'Submitted work, interview notes, trial-task receipts, GitHub or portfolio links, scorecards, compensation bands, and role requirements.',
    givesBack: 'A decision pack with strengths, risks, missing evidence, compensation framing, and a clear recommendation.',
    humanGate: 'Analysis and drafting are safe. Offers, compensation commitments, rejections, or access changes require Henry or the hiring owner.'
  },
  {
    category: 'Product',
    title: 'Bug diagnosis before fixing',
    summary: 'Ada investigates the actual failure path before touching code, because random patches are how software becomes archaeology.',
    runs: 'When Henry reports a broken feature, stale deploy, bad UI, or agent loop.',
    connects: 'Repo history, logs, browser console, network traces, tests, deployment status, and screenshots.',
    givesBack: 'Root cause, reproduction steps, smallest fix, validation output, and remaining risk.',
    humanGate: 'Local reversible code fixes and tests can run. Production deploys, destructive migrations, or scope expansion need approval.'
  },
  {
    category: 'Governance',
    title: 'Cron noise control',
    summary: 'Ada audits scheduled jobs so useful alerts survive and noisy little goblins stop yelling into Henry’s DMs.',
    runs: 'When a cron is added, repaired, or starts sending useless output.',
    connects: 'Cron registry, delivery targets, recent outputs, channel rules, error logs, and job prompts.',
    givesBack: 'Which jobs should stay, pause, merge, silence on success, or get stronger failure contracts.',
    humanGate: 'Read-only audit and safe prompt fixes are fine. Removing important jobs, changing external delivery, or disabling production monitors needs confirmation.'
  },
  {
    category: 'Knowledge',
    title: 'Skill improvement loop',
    summary: 'When an agent repeats a mistake, Ada patches the workflow itself instead of adding another sticky note to the bonfire.',
    runs: 'After repeated misses, hard recoveries, or Henry corrections that should persist.',
    connects: 'Skill files, execution receipts, user corrections, failed tool outputs, docs, and regression checks.',
    givesBack: 'A tighter reusable procedure, removed stale steps, verification rules, and a smaller chance the same nonsense happens next week.',
    humanGate: 'Editing local skills and docs is safe in scope. Publishing shared skills, changing another profile, or exposing private process requires approval.'
  },
  {
    category: 'Customer ops',
    title: 'Claims or support triage',
    summary: 'Ada turns incoming operational cases into approve, investigate, or request-info lanes with evidence attached.',
    runs: 'When a queue of claims, support requests, or customer build tasks needs first-pass sorting.',
    connects: 'Case records, policy or product rules, previous correspondence, attachments, customer context, and escalation criteria.',
    givesBack: 'A triaged list, reason for each decision, missing information, draft responses, and escalation flags.',
    humanGate: 'Classification and drafts can run. Customer-facing decisions, payments, production data changes, or policy exceptions require approval.'
  },
  {
    category: 'Personal ops',
    title: 'Contact saving and cleanup',
    summary: 'When Henry says “save this contact,” Ada treats Apple/iCloud Contacts as the source of truth and avoids inventing a second address book.',
    runs: 'On demand when Henry sends a person, number, email, or follow-up instruction.',
    connects: 'Apple/iCloud Contacts, provided details, conversation context, duplicate checks, and relationship notes when allowed.',
    givesBack: 'A saved or updated contact, duplicate warning, and the exact fields changed.',
    humanGate: 'Creating or updating the intended local contact is safe when requested. Messaging the person, enriching externally, or changing unrelated records needs approval.'
  },
  {
    category: 'Strategy',
    title: 'Plan grill',
    summary: 'Ada pressure-tests a plan before the team spends a week executing something that sounded smart in Slack.',
    runs: 'When Henry asks whether a plan, feature, business idea, or workflow makes sense.',
    connects: 'The proposal, market or customer context, constraints, prior decisions, evidence sources, and relevant operator skills.',
    givesBack: 'What is strong, what is vague, what will break, what to test first, and the smallest next move.',
    humanGate: 'Critique and planning are safe. Starting external work, assigning people, spending money, or making commitments requires confirmation.'
  }
];
const setupSteps = [
  'Pick one repeated job Henry already has to do.',
  'Connect the safe sources the agent is allowed to read.',
  'Define what the agent returns and where it delivers it.',
  'Write the approval boundary before the automation runs.',
  'Keep receipts, so the output can be checked instead of trusted.'
];
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body class="use-cases-page">
    <Header />
    <main>
      <section class="hero shell">
        <h1>Henry’s agent use cases</h1>
        <p class="lede">These are plain examples of how Henry and the Enterprise Crew use agents in daily work. Not a prompt library. Not a raw catalog. Just the recurring jobs, what each one connects to, what comes back, and where the human approval line sits.</p>
        <figure class="hero-figure">
          <img src="/use-cases/recapper-voice-debrief.webp" alt="Infographic: the 20:00 voice debrief pipeline — cron fires at 20:00 UK, context pack assembles, voice session starts, notes write in real time." width="1376" height="768" loading="eager" />
          <figcaption>The 20:00 voice debrief — a scheduled job opens the call, the notes file writes itself in real time.</figcaption>
        </figure>
      </section>

      <section class="shell intro-grid" aria-label="What the page covers">
        <article>
          <h2>Readable by a normal operator</h2>
          <p>Each example explains the work in human terms. “Meeting prep” is easier to understand than “calendar-aware contextual synthesis loop,” which sounds like a SaaS landing page got trapped in a blender.</p>
        </article>
        <article>
          <h2>Built around approval</h2>
          <p>The useful part is not just that an agent can act. It is knowing what it can do alone, what it should draft, and where it must stop for Henry.</p>
        </article>
      </section>

      <section id="examples" class="shell examples" aria-labelledby="examples-title">
        <p class="eyebrow">Examples</p>
        <h2 id="examples-title">How the system gets used</h2>
        <div class="case-list">
          {useCases.map((item) => (
            <article class="case-card">
              <div class="case-topline">
                <span>{item.category}</span>
                <h3>{item.title}</h3>
                <p>{item.summary}</p>
              </div>
              <dl>
                <div>
                  <dt>When it runs</dt>
                  <dd>{item.runs}</dd>
                </div>
                <div>
                  <dt>What it connects to</dt>
                  <dd>{item.connects}</dd>
                </div>
                <div>
                  <dt>What Henry gets back</dt>
                  <dd>{item.givesBack}</dd>
                </div>
                <div>
                  <dt>Where the human stays in charge</dt>
                  <dd>{item.humanGate}</dd>
                </div>
              </dl>
            </article>
          ))}
        </div>
      </section>

      <section class="shell setup" aria-labelledby="setup-title">
        <div>
          <p class="eyebrow">Setup pattern</p>
          <h2 id="setup-title">The recipe is boring on purpose</h2>
          <p>Good agent workflows are not magic. They are clear inputs, a narrow job, a delivery route, and a gate. The boring version works. The cinematic version sends you a 19-page report no one asked for and calls it strategy.</p>
        </div>
        <ol>
          {setupSteps.map((step) => <li>{step}</li>)}
        </ol>
      </section>

      <section class="shell more">
        <a class="more-link" href="/resources/agent-workflow-atlas/">See more<span>The full workflow atlas, with every mapped use case and filters by agent and category.</span></a>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  :global(body.use-cases-page) {
    background: radial-gradient(circle at top left, rgba(248, 96, 42, 0.16), transparent 28rem), #080706;
    color: #f7efe7;
  }

  .shell {
    width: min(1120px, calc(100vw - 32px));
    margin: 0 auto;
  }

  .hero {
    padding: 7rem 0 3.5rem;
  }

  .hero-figure {
    margin: 3rem 0 0;
    padding: 0;
  }

  .hero-figure img {
    width: 100%;
    height: auto;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    display: block;
  }

  .hero-figure figcaption {
    margin-top: 0.85rem;
    font-size: 0.85rem;
    color: #9aa3b2;
    letter-spacing: 0.01em;
  }

  .eyebrow,
  .case-topline span {
    display: inline-flex;
    width: fit-content;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.72rem;
    color: #ffb088;
    font-weight: 800;
  }

  h1,
  h2,
  h3,
  p,
  dl,
  dd,
  ol {
    margin: 0;
  }

  h1 {
    max-width: 1120px;
    margin-top: 0;
    font-size: clamp(2.1rem, 5vw, 3.4rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    h1 {
      font-size: 2rem;
      white-space: normal;
      line-height: 1.1;
    }
  }

  .lede {
    max-width: 820px;
    margin-top: 1.4rem;
    color: #d8c6b9;
    font-size: clamp(1.08rem, 2vw, 1.3rem);
    line-height: 1.55;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    padding: 0 0 3rem;
  }

  .intro-grid article,
  .case-card,
  .setup {
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.055);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.25);
  }

  .intro-grid article {
    border-radius: 28px;
    padding: 1.4rem;
  }

  .intro-grid h2,
  .examples h2,
  .setup h2 {
    font-size: clamp(1.7rem, 3vw, 3rem);
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .intro-grid p,
  .setup p {
    margin-top: 0.9rem;
    color: #d8c6b9;
    line-height: 1.65;
  }

  .examples,
  .setup {
    margin-top: 1rem;
  }

  .examples {
    padding: 2rem 0 3rem;
  }

  .examples h2 {
    margin-top: 0.5rem;
  }

  .case-list {
    display: grid;
    gap: 1rem;
    margin-top: 1.4rem;
  }

  .case-card {
    border-radius: 30px;
    overflow: hidden;
  }

  .case-topline {
    padding: 1.5rem;
    background: linear-gradient(135deg, rgba(255, 106, 42, 0.18), rgba(255, 255, 255, 0.03));
  }

  .case-topline h3 {
    margin-top: 0.5rem;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    letter-spacing: -0.045em;
  }

  .case-topline p {
    max-width: 860px;
    margin-top: 0.65rem;
    color: #e4d2c5;
    line-height: 1.55;
  }

  dl {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  dl > div {
    padding: 1.1rem;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
  }

  dl > div:last-child {
    border-right: 0;
  }

  dt {
    color: #ffb088;
    font-size: 0.76rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 850;
  }

  dd {
    margin-top: 0.6rem;
    color: #d8c6b9;
    line-height: 1.55;
    font-size: 0.95rem;
  }

  .setup {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 2rem;
    border-radius: 30px;
    padding: 1.6rem;
    margin-bottom: 4rem;
  }

  .setup h2 {
    margin-top: 0.55rem;
  }

  .setup ol {
    display: grid;
    gap: 0.75rem;
    padding-left: 1.2rem;
    color: #f7efe7;
  }

  .setup li {
    padding-left: 0.3rem;
    color: #d8c6b9;
    line-height: 1.5;
  }

  .more {
    margin-bottom: 4.5rem;
  }

  .more-link {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    column-gap: 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: linear-gradient(135deg, rgba(255, 106, 42, 0.18), rgba(255, 255, 255, 0.03));
    border-radius: 30px;
    padding: 1.5rem 1.7rem;
    text-decoration: none;
  }

  .more-link:hover {
    border-color: rgba(255, 176, 136, 0.55);
  }

  .more-link {
    color: #f7efe7;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.045em;
  }

  .more-link span {
    color: #d8c6b9;
    font-size: 0.95rem;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .intro-grid,
    dl,
    .setup {
      grid-template-columns: 1fr;
    }

