---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { milestones, timelineLink, type MilestoneSource } from '../data/milestones';
import { coverFor, getPublishedPosts } from '../lib/posts';

const sourceLabels: Record<MilestoneSource, string> = {
	post: 'Post',
	tool: 'Tool',
	launch: 'Launch',
	incident: 'Lesson',
	agent: 'Agent',
	infra: 'Infra',
	thesis: 'Thesis',
};

const posts = await getPublishedPosts();
const journey = [...milestones]
	.sort((a, b) => a.date.localeCompare(b.date))
	.map((milestone) => {
		const post = milestone.slug ? posts.find((p) => p.id === milestone.slug) : undefined;
		return { ...milestone, href: timelineLink(milestone), cover: post ? coverFor(post) : undefined };
	});

const monthOf = (date: string) => new Date(`${date}T00:00:00Z`).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const dayOf = (date: string) => new Date(`${date}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
const chapters: { month: string; items: typeof journey }[] = [];
for (const item of journey) {
	const month = monthOf(item.date);
	if (chapters.at(-1)?.month !== month) chapters.push({ month, items: [] });
	chapters.at(-1)!.items.push(item);
}
const launches = journey.filter((m) => m.source === 'launch').length;
let side = 0;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Timeline | ${SITE_TITLE}`} description="The builds and failures that changed the system: Ada, the Enterprise Crew, Entity, Citadel, Hoshi, Mycelium and the infrastructure holding them together." />
	</head>
	<body>
		<Header />
		<main class="tl-page">
			<header class="tl-hero ds-shell">
				<span class="ds-eyebrow">Timeline</span>
				<h1 class="ds-display">The 1000x journey.</h1>
				<p class="ds-lede">The builds and failures that changed the system: Ada, the Enterprise Crew, Entity, Citadel, Hoshi, Mycelium and the infrastructure holding them together.</p>
				<div class="tl-stats">
					<div><b>{journey.length}</b><span>milestones</span></div>
					<div><b>{launches}</b><span>launches</span></div>
					<div><b>{chapters.length}</b><span>months</span></div>
				</div>
				<div class="tl-actions">
					<a class="ds-btn" href="#tl-start">Start at day one <span aria-hidden="true">↓</span></a>
					<a class="ds-btn ds-btn--ghost" href="#tl-now">Jump to now</a>
				</div>
				<p class="tl-rule"><b>Milestone rule:</b> a new post is not a milestone. A product launch, major capability, infrastructure shift or expensive lesson is.</p>
			</header>

			<section class="tl ds-shell" data-tl data-no-reveal aria-label="Milestones, oldest first">
				<div class="tl-track" aria-hidden="true"><span class="tl-fill" data-tl-fill></span></div>
				{chapters.map((chapter, chapterIndex) => (
					<section class="tl-chapter" id={chapterIndex === 0 ? 'tl-start' : undefined}>
						<h2 class="tl-month"><span>{chapter.month}</span></h2>
						{chapter.items.map((item) => {
							const align = side++ % 2 === 0 ? 'left' : 'right';
							const Tag = item.href ? 'a' : 'div';
							return (
								<article class:list={['tl-item', `is-${align}`]} data-tl-item>
									<span class="tl-node" aria-hidden="true">{item.emoji}</span>
									<Tag class:list={['tl-card', { 'has-cover': item.cover }]} href={item.href}>
										{item.cover && (
											<div class="tl-cover"><Image src={item.cover} alt="" widths={[480, 800]} sizes="(max-width: 760px) 86vw, 460px" format="webp" loading="lazy" /></div>
										)}
										<div class="tl-copy">
											<div class="tl-meta"><time datetime={item.date}>{dayOf(item.date)}</time><span class={`tl-source tl-source--${item.source}`}>{sourceLabels[item.source]}</span></div>
											<h3>{item.title}</h3>
											<p>{item.description}</p>
											{item.href && <span class="tl-more">Read the story <span aria-hidden="true">→</span></span>}
										</div>
									</Tag>
								</article>
							);
						})}
					</section>
				))}
				<div class="tl-now" id="tl-now">
					<span class="tl-node tl-node--now" aria-hidden="true"><i></i></span>
					<div class="tl-now-card">
						<span class="ds-eyebrow">Now</span>
						<p class="ds-h2">The next milestone is being built.</p>
						<p>Follow it as it ships in the Ship Log, or get the signal when it lands.</p>
						<div class="tl-actions">
							<a class="ds-btn" href="/subscribe">Get the signal <span aria-hidden="true">↗</span></a>
							<a class="ds-btn ds-btn--ghost" href="/blog">Read the Ship Log</a>
						</div>
					</div>
				</div>
			</section>
		</main>
		<Footer />

		<script is:inline>
			(() => {
				const tl = document.querySelector('[data-tl]');
				const fill = tl && tl.querySelector('[data-tl-fill]');
				const items = tl ? [...tl.querySelectorAll('[data-tl-item], .tl-now')] : [];
				if (!tl || !fill) return;
				const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
				if (!reduce && 'IntersectionObserver' in window) {
					tl.classList.add('is-armed');
					const io = new IntersectionObserver((entries) => entries.forEach((entry) => {
						if (entry.isIntersecting) { entry.target.classList.add('is-in'); io.unobserve(entry.target); }
					}), { rootMargin: '0px 0px -12% 0px', threshold: 0.15 });
					items.forEach((item) => io.observe(item));
				}
				let ticking = false;
				const update = () => {
					ticking = false;
					const rect = tl.getBoundingClientRect();
					const line = innerHeight * 0.62;
					const progress = Math.min(1, Math.max(0, (line - rect.top) / rect.height));
					fill.style.transform = `scaleY(${progress.toFixed(4)})`;
					items.forEach((item) => {
						const node = item.querySelector('.tl-node');
						if (node) item.classList.toggle('is-past', node.getBoundingClientRect().top < line);
					});
				};
				addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
				addEventListener('resize', update, { passive: true });
				update();
			})();
		</script>
	</body>
</html>

<style>
	.tl-hero { --shell: 1100px; display: grid; justify-items: center; gap: 22px; text-align: center; padding-top: clamp(48px, 8vw, 120px); padding-bottom: clamp(40px, 6vw, 80px); }
	.tl-hero .ds-lede { margin-inline: auto; }
	.tl-stats { display: flex; gap: clamp(20px, 5vw, 56px); margin-top: 8px; }
	.tl-stats div { display: grid; gap: 4px; }
	.tl-stats b { font: 500 clamp(40px, 5vw, 64px)/1 var(--font-display); letter-spacing: -.05em; color: var(--text); }
	.tl-stats span { color: var(--muted); font: 700 11px/1 var(--font-mono); letter-spacing: .16em; text-transform: uppercase; }
	.tl-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
	.tl-rule { max-width: 34rem; color: var(--faint); font-size: 13.5px; line-height: 1.6; }
	.tl-rule b { color: var(--muted); font-weight: 650; }

	.tl { --shell: 1100px; --spine: 50%; position: relative; overflow-x: clip; padding-top: 20px; padding-bottom: 40px; }
	.tl-track { position: absolute; top: 0; bottom: 90px; left: var(--spine); width: 2px; transform: translateX(-50%); border-radius: 2px; background: color-mix(in srgb, var(--border-strong) 70%, transparent); }
	.tl-fill { position: absolute; inset: 0; transform-origin: top; transform: scaleY(0); border-radius: inherit; background: linear-gradient(180deg, var(--accent-3), var(--accent), var(--accent-2)); box-shadow: 0 0 18px var(--glow), 0 0 4px var(--accent); }

	.tl-chapter { position: relative; display: grid; gap: 28px; padding-bottom: 36px; scroll-margin-top: calc(var(--chrome-top) + 20px); }
	.tl-month { position: relative; z-index: 2; display: flex; justify-content: center; margin: 18px 0 4px; }
	.tl-month span { padding: 9px 16px; border-radius: 999px; border: 1px solid var(--border-strong); background: var(--bg); color: var(--text); font: 750 11.5px/1 var(--font-mono); letter-spacing: .16em; text-transform: uppercase; box-shadow: 0 0 0 6px var(--bg); }

	.tl-item { position: relative; display: grid; grid-template-columns: 1fr 1fr; }
	.tl-node { position: absolute; z-index: 3; left: var(--spine); top: 22px; width: 46px; height: 46px; display: grid; place-items: center; transform: translateX(-50%) scale(.82); border-radius: 50%; border: 1px solid var(--border-strong); background: var(--panel); font-size: 20px; filter: grayscale(.8); opacity: .7; transition: transform .6s var(--ease-spring), filter .5s ease, opacity .5s ease, border-color .5s ease, box-shadow .5s ease; }
	.tl-item.is-past .tl-node, .tl-now.is-past .tl-node { transform: translateX(-50%) scale(1); filter: none; opacity: 1; border-color: var(--accent); box-shadow: 0 0 0 6px var(--bg), 0 0 30px var(--glow); }

	.tl-card { position: relative; display: block; overflow: hidden; border-radius: var(--radius-lg); border: 1px solid var(--surface-border); background: var(--surface); color: var(--text); transition: transform .5s var(--ease-out), border-color .25s ease, box-shadow .5s ease, opacity .8s var(--ease-out), translate .9s var(--ease-out); }
	.tl-item.is-left .tl-card { grid-column: 1; margin-right: 52px; }
	.tl-item.is-right .tl-card { grid-column: 2; margin-left: 52px; }
	.tl-item.is-left .tl-card::after, .tl-item.is-right .tl-card::after { content: ''; position: absolute; top: 44px; width: 18px; height: 1px; background: var(--border-strong); }
	.tl-cover { aspect-ratio: 16 / 8; overflow: hidden; border-bottom: 1px solid var(--border); }
	.tl-cover img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.1s var(--ease-out); }
	.tl-copy { display: grid; gap: 10px; padding: 22px 24px 24px; }
	.tl-meta { display: flex; align-items: center; gap: 10px; }
	.tl-meta time { color: var(--accent); font: 750 12px/1 var(--font-mono); letter-spacing: .06em; }
	.tl-source { padding: 5px 9px; border-radius: 999px; border: 1px solid var(--border); color: var(--muted); font: 750 10px/1 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; }
	.tl-source--launch { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 40%, var(--border)); }
	.tl-source--incident { color: #f78d72; border-color: color-mix(in srgb, #f78d72 40%, var(--border)); }
	.tl-copy h3 { font: 500 clamp(22px, 2.2vw, 28px)/1.1 var(--font-display); letter-spacing: -.035em; text-wrap: balance; }
	.tl-copy p { color: var(--muted); font-size: 15px; line-height: 1.6; }
	.tl-more { color: var(--accent); font-size: 12px; font-weight: 850; letter-spacing: .1em; text-transform: uppercase; }
	@media (hover: hover) {
		a.tl-card:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--accent) 45%, var(--surface-border)); box-shadow: var(--lift); }
		a.tl-card:hover .tl-cover img { transform: scale(1.05); }
	}

	.tl.is-armed .tl-item:not(.is-in) .tl-card { opacity: 0; }
	.tl.is-armed .tl-item.is-left:not(.is-in) .tl-card { translate: -48px 0; }
	.tl.is-armed .tl-item.is-right:not(.is-in) .tl-card { translate: 48px 0; }
	.tl.is-armed .tl-now:not(.is-in) .tl-now-card { opacity: 0; translate: 0 30px; }

	.tl-now { position: relative; display: grid; justify-items: center; padding-top: 70px; }
	.tl-now .tl-node { top: 0; }
	.tl-node--now i { width: 14px; height: 14px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 20px var(--accent); animation: tl-pulse 2.2s ease-in-out infinite; }
	@keyframes tl-pulse { 50% { transform: scale(1.5); opacity: .6; } }
	.tl-now-card { display: grid; justify-items: center; gap: 14px; max-width: 560px; padding: 34px; text-align: center; border-radius: var(--radius-xl); border: 1px solid var(--surface-border); background: radial-gradient(circle at 50% 0%, color-mix(in srgb, var(--accent) 20%, transparent), transparent 55%), var(--surface); transition: opacity .8s var(--ease-out), translate .9s var(--ease-out); }
	.tl-now-card p:not(.ds-h2) { color: var(--muted); }

	@media (max-width: 760px) {
		.tl { --spine: 22px; }
		.tl-hero { justify-items: start; text-align: left; padding-top: 28px; }
		.tl-hero .ds-display { font-size: clamp(50px, 15vw, 72px); }
		.tl-hero .ds-lede { margin-inline: 0; }
		.tl-actions { justify-content: flex-start; }
		.tl-stats { gap: 28px; }
		.tl-track { left: calc(var(--gutter) + var(--spine)); }
		.tl-node { left: calc(var(--spine)); width: 38px; height: 38px; font-size: 17px; top: 18px; }
		.tl-month { justify-content: flex-start; padding-left: 0; }
		.tl-month span { margin-left: 0; }
		.tl-item { grid-template-columns: 1fr; }
		.tl-item.is-left .tl-card, .tl-item.is-right .tl-card { grid-column: 1; margin: 0 0 0 56px; }
		.tl-item .tl-card::after { display: none; }
		.tl.is-armed .tl-item.is-left:not(.is-in) .tl-card, .tl.is-armed .tl-item.is-right:not(.is-in) .tl-card { translate: 28px 0; }
		.tl-copy { padding: 18px 18px 20px; }
		.tl-now { justify-items: start; padding-top: 60px; }
		.tl-now .tl-node { left: var(--spine); }
		.tl-now-card { margin-left: 56px; padding: 24px 20px; justify-items: start; text-align: left; }
		.tl-now-card .tl-actions { flex-direction: column; width: 100%; }
		.tl-now-card .ds-btn { width: 100%; }
	}
	@media (prefers-reduced-motion: reduce) {
		.tl-card, .tl-node, .tl-now-card { transition: none; }
		.tl-node--now i { animation: none; }
	}
</style>
