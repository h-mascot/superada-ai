---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import { milestones, timelineLink } from '../data/milestones';

const sourceLabels = {
	post: 'Post',
	tool: 'Tool',
	launch: 'Launch',
	incident: 'Lesson',
	agent: 'Agent',
	infra: 'Infra',
	thesis: 'Thesis',
};

function formatDate(dateStr: string) {
	const d = new Date(dateStr + 'T00:00:00');
	return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Timeline | ${SITE_TITLE}`} />
		<style is:global>
			.timeline-intro {
				max-width: 40rem;
				color: var(--muted);
				font-size: 1rem;
				margin: 0 0 1rem;
				line-height: 1.7;
			}
			.timeline-note {
				max-width: 42rem;
				border: 1px solid var(--border);
				border-radius: 14px;
				background: rgba(232, 220, 200, 0.035);
				padding: 1rem 1.1rem;
				color: var(--muted);
				font-size: 0.9rem;
				line-height: 1.65;
				margin: 0 0 3rem;
			}
			.timeline-note strong {
				color: var(--text);
				font-weight: 500;
			}
			.timeline-container {
				position: relative;
				padding-left: 3rem;
			}
			.timeline-container::before {
				content: '';
				position: absolute;
				left: 0.75rem;
				top: 0;
				bottom: 0;
				width: 2px;
				background: linear-gradient(to bottom, var(--accent), var(--border) 90%);
			}
			.timeline-item {
				position: relative;
				padding-bottom: 2.5rem;
			}
			.timeline-item:last-child {
				padding-bottom: 0;
			}
			.timeline-dot {
				position: absolute;
				left: -2.65rem;
				top: 0.25rem;
				width: 2rem;
				height: 2rem;
				background: var(--bg);
				border: 2px solid var(--accent);
				border-radius: 50%;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 0.875rem;
				z-index: 1;
			}
			.timeline-item:first-child .timeline-dot {
				border-color: var(--text);
				box-shadow: 0 0 12px rgba(200, 117, 51, 0.4);
			}
			.timeline-meta {
				display: flex;
				align-items: center;
				gap: 0.65rem;
				margin-bottom: 0.35rem;
				flex-wrap: wrap;
			}
			.timeline-date {
				font-family: monospace;
				font-size: 0.8125rem;
				color: var(--accent);
				letter-spacing: 0.02em;
			}
			.timeline-source {
				font-family: monospace;
				font-size: 0.68rem;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: var(--muted);
				border: 1px solid var(--border);
				border-radius: 999px;
				padding: 0.15rem 0.45rem;
				background: rgba(232, 220, 200, 0.025);
			}
			.timeline-title {
				font-family: Georgia, 'Times New Roman', serif;
				font-size: 1.25rem;
				font-weight: 400;
				color: var(--text);
				margin: 0 0 0.35rem;
				line-height: 1.35;
			}
			.timeline-title a {
				color: inherit;
				text-decoration: none;
				border-bottom: 1px solid transparent;
				transition: border-color 0.2s;
			}
			.timeline-title a:hover {
				border-color: var(--accent);
			}
			.timeline-desc {
				color: var(--muted);
				font-size: 0.9rem;
				line-height: 1.65;
				margin: 0;
				max-width: 38rem;
			}
			.timeline-read-more {
				display: inline-block;
				margin-top: 0.5rem;
				font-size: 0.8rem;
				color: var(--accent);
				text-decoration: none;
				opacity: 0.72;
				transition: opacity 0.2s;
			}
			.timeline-read-more:hover {
				opacity: 1;
			}
			.timeline-item:first-child .timeline-title {
				color: var(--accent);
			}
			@media (max-width: 640px) {
				.timeline-container {
					padding-left: 2.5rem;
				}
				.timeline-dot {
					left: -2.15rem;
					width: 1.5rem;
					height: 1.5rem;
					font-size: 0.75rem;
				}
			}
		</style>
	</head>
	<body style="background:var(--bg); color:var(--text); min-height:100vh;">
		<Header />
		<main style="max-width:840px; margin:0 auto; padding:3rem 1.5rem;">

			<h1 style="font-family:Georgia,serif; font-size:2rem; font-weight:400; margin:0 0 0.5rem;">Timeline</h1>
			<p class="timeline-intro">From one agent to a full crew to an operating system for agent work. The moments below are not a blog archive; they are the scars, launches, tools, agents, and theses that changed what SuperAda is.</p>
			<p class="timeline-note"><strong>Going forward:</strong> new entries are added when the system materially levels up - shipped internal tools, launch moments, incidents/lessons, new agent or infrastructure milestones, or public theses that become core to the brand.</p>

			<div class="timeline-container">
				{milestones.map((m) => {
					const href = timelineLink(m);
					return (
						<div class="timeline-item">
							<div class="timeline-dot">{m.emoji}</div>
							<div class="timeline-meta">
								<div class="timeline-date">{formatDate(m.date)}</div>
								<div class="timeline-source">{sourceLabels[m.source]}</div>
							</div>
							<h3 class="timeline-title">
								{href ? <a href={href}>{m.title}</a> : m.title}
							</h3>
							<p class="timeline-desc">{m.description}</p>
							{href && <a href={href} class="timeline-read-more">Read the full story →</a>}
						</div>
					);
				})}
			</div>

		</main>
		<Footer />
	</body>
</html>
