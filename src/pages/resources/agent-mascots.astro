        color: var(--accent-2);
      }

      .meta-block {
        display: grid;
        gap: 0.18rem;
        margin-bottom: 0.85rem;
        font-size: 0.88rem;
      }

      .tag-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
        margin-bottom: 0.9rem;
      }

      .tag-row span {
        padding: 0.28rem 0.55rem;
        border-radius: 999px;
        border: 1px solid var(--line);
        color: var(--text);
        background: rgba(255, 255, 255, 0.035);
        font-size: 0.78rem;
      }

      .stat-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.55rem;
        margin: 0;
      }

      .stat-grid div {
        padding-top: 0.7rem;
        border-top: 1px solid var(--line);
      }

      .stat-grid dt {
        margin-bottom: 0.25rem;
        color: var(--muted);
      }

      .stat-grid dd {
        margin: 0;
        font-size: 0.88rem;
      }

      @media (max-width: 1180px) {
        .atlas-frame {
          grid-template-columns: 1fr;
        }

        .resource-sidebar {
          position: static;
          min-height: 0;
        }

        .resource-nav,
        .mascot-grid,
        .resource-card-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 900px) {
        .stat-strip,
        .resource-card-grid,
        .mascot-grid,
        .search-row {
          grid-template-columns: 1fr;
        }

        .mascot-card:first-child {
          grid-column: auto;
          grid-template-columns: 1fr;
        }

        .section-heading,
        .atlas-topbar {
          flex-direction: column;
          align-items: start;
        }
      }

      @media (max-width: 640px) {
        .atlas-shell {
          padding-left: 0.75rem;
          padding-right: 0.75rem;
        }

        .atlas-content,
        .resource-sidebar {
          border-radius: 22px;
        }

        .atlas-hero {
          padding: 1.35rem;
        }

        .atlas-hero h1 {
          font-size: 2.65rem;
        }

        .resource-nav,
        .stat-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
