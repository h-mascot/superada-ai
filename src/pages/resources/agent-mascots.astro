---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';

type Mascot = {
  name: string;
  kind: 'Fox' | 'Cat' | 'Hound';
  role: string;
  creator: string;
  classDate: string;
  bio: string;
  tags: string[];
  accent: string;
  panel: string;
  collar: string;
  stats: {
    label: string;
    value: string;
  }[];
};

const mascots: Mascot[] = [
  {
    name: 'Sparky',
    kind: 'Fox',
    role: 'Animated Scout',
    creator: 'Enterprise Crew',
    classDate: 'May 4, 2026',
    bio: 'Fast-moving mascot concept for launches, changelogs, and anything that needs a little velocity.',
    tags: ['#Active', '#Launch', '#Mascot'],
    accent: '#E7B16B',
    panel: '#B7AB98',
    collar: '#C87533',
    stats: [
      { label: 'Temperament', value: 'Curious' },
      { label: 'Habitat', value: 'Launch bay' },
      { label: 'Loop', value: 'Announce -> Scout -> Return' },
    ],
  },
  {
    name: 'Nova',
    kind: 'Cat',
    role: 'Data Watch',
    creator: 'Enterprise Crew',
    classDate: 'May 4, 2026',
    bio: 'Blue-hour analyst pet for dashboards, eval pages, and benchmark surfaces that need a resident observer.',
    tags: ['#Data', '#Signals', '#Companion'],
    accent: '#9DB5EF',
    panel: '#7A7092',
    collar: '#E8DCC8',
    stats: [
      { label: 'Temperament', value: 'Alert' },
      { label: 'Habitat', value: 'Ops wall' },
      { label: 'Loop', value: 'Watch -> Flag -> Persist' },
    ],
  },
  {
    name: 'Garh',
    kind: 'Hound',
    role: 'Utility Escort',
    creator: 'Enterprise Crew',
    classDate: 'May 4, 2026',
    bio: 'Dependable helper for install guides, onboarding flows, and pages that need calm, grounded utility energy.',
    tags: ['#Utility', '#Docs', '#Stable'],
    accent: '#876D62',
    panel: '#B6A48A',
    collar: '#C87533',
    stats: [
      { label: 'Temperament', value: 'Steady' },
      { label: 'Habitat', value: 'Tool room' },
      { label: 'Loop', value: 'Guide -> Carry -> Confirm' },
    ],
  },
  {
    name: 'Pala',
    kind: 'Hound',
    role: 'Bridge Runner',
    creator: 'Enterprise Crew',
    classDate: 'May 4, 2026',
    bio: 'A lighter-footed hound variant designed for workflow bridges and inter-app handoff pages.',
    tags: ['#Bridge', '#Workflow', '#Courier'],
    accent: '#AA6B4B',
    panel: '#7E7390',
    collar: '#F0C67F',
    stats: [
      { label: 'Temperament', value: 'Loyal' },
      { label: 'Habitat', value: 'Bridge deck' },
      { label: 'Loop', value: 'Carry -> Relay -> Sync' },
    ],
  },
  {
    name: 'Shola',
    kind: 'Fox',
    role: 'Research Ember',
    creator: 'Enterprise Crew',
    classDate: 'May 4, 2026',
    bio: 'A warmer, more editorial fox aimed at essays, field notes, and long-form research presentation.',
    tags: ['#Research', '#Editorial', '#Warm'],
    accent: '#E7C17D',
    panel: '#C38A4F',
    collar: '#F6E2B8',
    stats: [
      { label: 'Temperament', value: 'Restless' },
      { label: 'Habitat', value: 'Archive deck' },
      { label: 'Loop', value: 'Read -> Distill -> Emit' },
    ],
  },
  {
    name: 'Patra',
    kind: 'Cat',
    role: 'Perimeter Watch',
    creator: 'Enterprise Crew',
    classDate: 'May 4, 2026',
    bio: 'Guard-cat concept for safety rails, review states, and pages that need a visible sense of oversight.',
    tags: ['#Guard', '#Safety', '#Review'],
    accent: '#A6A1A5',
    panel: '#C5B9A4',
    collar: '#C87533',
    stats: [
      { label: 'Temperament', value: 'Watchful' },
      { label: 'Habitat', value: 'Review gate' },
      { label: 'Loop', value: 'Observe -> Halt -> Explain' },
    ],
  },
];

const buildNotes = [
  'Warm dark palette tuned for the existing SuperAda site',
  'Petdex-style gallery structure without breaking the current Astro shell',
  'Roster-first layout so the mascot cards have room to breathe',
];

function pixelArt(kind: Mascot['kind'], primary: string, panel: string, collar: string) {
  const artwork = {
    Fox: `
      <rect x="11" y="16" width="10" height="6" fill="${primary}" />
      <rect x="20" y="17" width="5" height="4" fill="${primary}" />
      <rect x="7" y="18" width="5" height="3" fill="${primary}" />
      <rect x="14" y="10" width="7" height="7" fill="${primary}" />
      <rect x="13" y="8" width="2" height="3" fill="${primary}" />
      <rect x="20" y="8" width="2" height="3" fill="${primary}" />
      <rect x="19" y="13" width="4" height="2" fill="#F4E5CB" />
      <rect x="13" y="21" width="2" height="5" fill="${primary}" />
      <rect x="18" y="21" width="2" height="5" fill="${primary}" />
      <rect x="9" y="16" width="2" height="2" fill="#F4E5CB" />
      <rect x="15" y="17" width="5" height="1" fill="${collar}" />
      <rect x="17" y="18" width="1" height="1" fill="${collar}" />
      <rect x="16" y="12" width="1" height="1" fill="#21170F" />
      <rect x="20" y="12" width="1" height="1" fill="#21170F" />
    `,
    Cat: `
      <rect x="11" y="16" width="10" height="6" fill="${primary}" />
      <rect x="20" y="14" width="4" height="4" fill="${primary}" />
      <rect x="7" y="12" width="2" height="7" fill="${primary}" />
      <rect x="13" y="9" width="8" height="7" fill="${primary}" />
      <rect x="13" y="7" width="2" height="3" fill="${primary}" />
      <rect x="20" y="7" width="2" height="3" fill="${primary}" />
      <rect x="15" y="21" width="2" height="5" fill="${primary}" />
      <rect x="19" y="21" width="2" height="5" fill="${primary}" />
      <rect x="15" y="17" width="5" height="1" fill="${collar}" />
      <rect x="17" y="18" width="1" height="1" fill="${collar}" />
      <rect x="16" y="12" width="1" height="1" fill="#21170F" />
      <rect x="20" y="12" width="1" height="1" fill="#21170F" />
      <rect x="17" y="14" width="3" height="1" fill="#F1E2CF" />
    `,
    Hound: `
      <rect x="10" y="16" width="11" height="6" fill="${primary}" />
      <rect x="20" y="16" width="5" height="4" fill="${primary}" />
      <rect x="14" y="10" width="7" height="7" fill="${primary}" />
      <rect x="21" y="11" width="2" height="5" fill="${primary}" />
      <rect x="8" y="15" width="3" height="2" fill="${primary}" />
      <rect x="13" y="21" width="2" height="5" fill="${primary}" />
      <rect x="18" y="21" width="2" height="5" fill="${primary}" />
      <rect x="15" y="17" width="5" height="1" fill="${collar}" />
      <rect x="17" y="18" width="1" height="1" fill="${collar}" />
      <rect x="16" y="12" width="1" height="1" fill="#21170F" />
      <rect x="19" y="12" width="1" height="1" fill="#21170F" />
      <rect x="18" y="14" width="4" height="1" fill="#EEDFCC" />
    `,
  };

  const svg = `
    <svg xmlns="http://www.w3.org/2000/svg" width="320" height="220" viewBox="0 0 32 28" shape-rendering="crispEdges">
      <rect width="32" height="28" fill="${panel}" />
      ${artwork[kind]}
    </svg>
  `;

  return `data:image/svg+xml;charset=utf-8,${encodeURIComponent(svg)}`;
}

const resourceCounts = {
  mascots: mascots.length + 8,
  weeklyClaw: 12,
  changelog: 19,
  crons: 3,
  benchmarks: 8,
  workflowPacks: 12,
  crewGuides: 10,
  tools: 22,
  shipNotes: 9,
};

const resourceNav = [
  { label: 'Overview', href: '/resources', count: null },
  { label: 'Agent Mascots (Pets)', href: '/resources/agent-mascots', count: resourceCounts.mascots, active: true },
  { label: 'OpenClaw Weekly Claw', href: '/weekly-claw', count: resourceCounts.weeklyClaw },
  { label: 'Changelog', href: '/openclaw-changelog', count: resourceCounts.changelog },
  { label: 'Crons', href: '#crons', count: resourceCounts.crons },
  { label: 'Benchmarks', href: '/benchmarks', count: resourceCounts.benchmarks },
  { label: 'Workflow Packs', href: '/workflows', count: resourceCounts.workflowPacks },
  { label: 'Crew Guides', href: '#crew-guides', count: resourceCounts.crewGuides },
  { label: 'Tools', href: '#tools', count: resourceCounts.tools },
  { label: 'Ship Notes', href: '#ship-notes', count: resourceCounts.shipNotes },
];

const atlasStats = [
  { label: 'Tools', value: resourceCounts.tools, copy: 'Reusable tools, templates, and utilities to build, test, and ship.', href: '#tools', cta: 'Browse tools' },
  { label: 'Latest updates', value: resourceCounts.changelog, copy: 'New builds, logs, and resource changes from the bridge.', href: '/openclaw-changelog', cta: "See what's new" },
  { label: 'Popular bundles', value: '6', copy: 'Most saved bundles by the crew.', href: '#workflow-packs', cta: 'View popular' },
];

const resourceTabs = [
  'Agent Mascots (Pets)',
  'OpenClaw Weekly Claw',
  'Changelog',
  'Crons',
  'Benchmarks',
  'Workflow Packs',
  'Crew Guides',
  'Tools',
  'Ship Notes',
];

const resourceCards = [
  { title: 'Agent Mascots (Pets)', meta: `${resourceCounts.mascots} items`, status: 'Updated', anchor: 'mascot-roster', copy: 'Pets that represent our agents. Includes cards, rigs, crafts, and animations.' },
  { title: 'OpenClaw Weekly Claw', meta: `${resourceCounts.weeklyClaw} issues`, status: 'New', anchor: 'weekly-claw', copy: 'Weekly digest for OpenClaw progress, field notes, experiments, and shipped changes.' },
  { title: 'Changelog', meta: `${resourceCounts.changelog} updates`, status: 'Updated', anchor: 'changelog', copy: 'Product changes, fixes, release notes, and operator-facing deltas.' },
  { title: 'Crons', meta: `${resourceCounts.crons} workflows`, status: 'Live', anchor: 'crons', copy: 'Scheduled jobs, reminders, heartbeat checks, and recurring operator automations.' },
  { title: 'Benchmarks', meta: `${resourceCounts.benchmarks} suites`, status: 'Updated', anchor: 'benchmarks', copy: 'Evaluation suites and results across reasoning, memory, and tooling.' },
  { title: 'Workflow Packs', meta: `${resourceCounts.workflowPacks} packs`, status: 'New', anchor: 'workflow-packs', copy: 'Reusable bundles for real operator work. Deploy, adapt, ship.' },
  { title: 'Crew Guides', meta: `${resourceCounts.crewGuides} guides`, status: 'Updated', anchor: 'crew-guides', copy: 'How-tos, playbooks, and reference material for working with the Enterprise Crew.' },
  { title: 'Tools', meta: `${resourceCounts.tools} tools`, status: 'Updated', anchor: 'tools', copy: 'Templates, prompts, models, utilities, and tooling for faster builds.' },
  { title: 'Ship Notes', meta: `${resourceCounts.shipNotes} notes`, status: 'Updated', anchor: 'ship-notes', copy: 'Mission updates, decisions, and important notes from the bridge.' },
];

---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Agent Mascots (Pets) - SuperAda Resources"
      description="gallery for mascots/pets for coding agents like codex etc that, the Enterprise Crew builds and shares."
      image="/favicon.png"
    />
  </head>
  <body class="mascots-body" data-theme="ember">
    <main class="atlas-shell">
      <div class="atlas-frame">
        <aside class="resource-sidebar" aria-label="Resources navigation">
          <a class="sidebar-brand" href="/resources" aria-label="SuperAda resources">
            <img src="/superada-icon.png" alt="" width="34" height="34" />
            <span>SuperAda</span>
          </a>

          <div class="sidebar-label">Resources</div>
          <nav class="resource-nav">
            {resourceNav.map((item) => (
              <a href={item.href} class:list={[{ 'is-active': item.active }]}>
                <span>{item.label}</span>
                {item.count && <strong>{item.count}</strong>}
              </a>
            ))}
          </nav>

          <div class="submit-card">
            <div class="submit-icon">＋</div>
            <h2>Suggest a resource</h2>
            <p>Share something valuable with the crew.</p>
            <a href="mailto:hello@superada.ai">Submit resource =&gt;</a>
          </div>
        </aside>

        <section class="atlas-content">
          <div class="atlas-topbar" aria-label="Resource sections">
            <nav class="top-menu">
              <a href="/crew">Crew</a>
              <a href="/resources" class="is-current">Resources</a>
              <a href="/blog">Ship Log</a>
              <a href="/journey">Timeline</a>
            </nav>
            <div class="theme-switcher" aria-label="Color scheme">
              <button type="button" class="is-active" data-set-theme="ember">Dark</button>
              <button type="button" data-set-theme="light">Light</button>
              <button type="button" data-set-theme="midnight">Midnight</button>
            </div>
          </div>

          <section class="atlas-hero" aria-labelledby="resource-atlas-title">
            <div>
              <div class="breadcrumb">Resources / Discovery</div>
              <h1 id="resource-atlas-title">Resource Atlas</h1>
              <p>Everything the Enterprise Crew has built, tested, and learned. Explore guides, mascots, benchmarks, workflows, tools, and ship notes - curated for building better AI systems.</p>
            </div>
          </section>

          <section class="stat-strip" aria-label="Resource highlights">
            {atlasStats.map((stat) => (
              <article class="stat-card">
                <div class="stat-label">{stat.label}</div>
                <strong>{stat.value}</strong>
                <p>{stat.copy}</p>
                <a href={stat.href}>{stat.cta} &gt;</a>
              </article>
            ))}
          </section>

          <section class="discovery-panel" aria-label="Resource discovery">
            <div class="search-row">
              <label class="search-box">
                <span>⌕</span>
                <input type="search" placeholder="Search resources, guides, mascots, workflows, tools..." />
              </label>
              <select aria-label="Sort resources">
                <option>Relevance</option>
                <option>Newest</option>
                <option>Most used</option>
              </select>
              <button type="button" class="filter-button">Filters</button>
            </div>

            <div class="tab-row" aria-label="Resource categories">
              {resourceTabs.map((tab, index) => (
                <a href={index === 0 ? '#mascot-roster' : '#resource-cards'} class:list={[{ 'is-active': index === 0 }]}>{tab}</a>
              ))}
            </div>

            <div class="resource-card-grid" id="resource-cards">
              {resourceCards.map((card) => (
                <article class="resource-card" id={card.anchor}>
                  <div class="card-topline">
                    <span>{card.meta}</span>
                    <strong>{card.status}</strong>
                  </div>
                  <h2>{card.title}</h2>
                  <p>{card.copy}</p>
                </article>
              ))}
            </div>
          </section>

          <section class="mascot-section" id="mascot-roster">
            <div class="section-heading">
              <div>
                <div class="section-kicker">Agent Mascots (Pets)</div>
                <h2>Enterprise Crew mascot roster</h2>
              </div>
              <p>Pixel-style pets for coding agents, docs, changelogs, crons, and launch surfaces.</p>
            </div>

            <div class="mascot-grid">
              {mascots.map((mascot) => (
                <article class="mascot-card">
                  <div class="preview-frame" style={`background:${mascot.panel};`}>
                    <img
                      src={pixelArt(mascot.kind, mascot.accent, mascot.panel, mascot.collar)}
                      alt={`${mascot.name} ${mascot.kind.toLowerCase()} mascot preview`}
                      loading="lazy"
                    />
                  </div>
                  <div class="card-copy">
                    <div class="meta-line">{mascot.role}</div>
                    <h3>{mascot.name}</h3>
                    <p>{mascot.bio}</p>
                    <div class="meta-block">
                      <span>Creator: {mascot.creator}</span>
                      <span>Class / date: {mascot.classDate}</span>
                    </div>
                    <div class="tag-row">
                      {mascot.tags.map((tag) => <span>{tag}</span>)}
                    </div>
                    <dl class="stat-grid">
                      {mascot.stats.map((stat) => (
                        <div>
                          <dt>{stat.label}</dt>
                          <dd>{stat.value}</dd>
                        </div>
                      ))}
                    </dl>
                  </div>
                </article>
              ))}
            </div>
          </section>
        </section>
      </div>
    </main>
    <Footer />

    <script is:inline>
      const body = document.body;
      const buttons = document.querySelectorAll('[data-set-theme]');
      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          body.dataset.theme = button.dataset.setTheme;
          buttons.forEach((item) => item.classList.toggle('is-active', item === button));
        });
      });
    </script>

    <style>
      :root {
        --bg: #0d0b09;
        --surface: #14100d;
        --surface-2: #1b1510;
        --surface-3: #211a14;
        --line: rgba(232, 220, 200, 0.12);
        --line-strong: rgba(232, 220, 200, 0.2);
        --text: #eadfce;
        --muted: #938673;
        --accent: #c87533;
        --accent-2: #f0c67f;
        --glow: rgba(200, 117, 51, 0.18);
      }

      .mascots-body[data-theme="light"] {
        --bg: #fcfbf8;
        --surface: #f6f0e8;
        --surface-2: #fffaf3;
        --surface-3: #efe4d5;
        --line: rgba(52, 42, 32, 0.14);
        --line-strong: rgba(52, 42, 32, 0.24);
        --text: #231a12;
        --muted: #756754;
        --accent: #a4602f;
        --accent-2: #7b4a25;
        --glow: rgba(196, 135, 76, 0.16);
      }

      .mascots-body[data-theme="midnight"] {
        --bg: #00061a;
        --surface: #050d25;
        --surface-2: #071634;
        --surface-3: #0b1f43;
        --line: rgba(191, 216, 255, 0.15);
        --line-strong: rgba(191, 216, 255, 0.28);
        --text: #edf4ff;
        --muted: #8fa4c4;
        --accent: #62a8ff;
        --accent-2: #f0c67f;
        --glow: rgba(55, 116, 226, 0.22);
      }

      .mascots-body {
        margin: 0;
        min-height: 100vh;
        background:
          radial-gradient(circle at 74% 0%, var(--glow), transparent 30rem),
          radial-gradient(circle at 0% 18%, rgba(255, 255, 255, 0.045), transparent 20rem),
          var(--bg);
        color: var(--text);
      }

      .atlas-shell {
        max-width: 1480px;
        margin: 0 auto;
        padding: 0 1rem 4rem;
      }

      .atlas-frame {
        display: grid;
        grid-template-columns: 280px minmax(0, 1fr);
        gap: 1rem;
        align-items: start;
      }

      .resource-sidebar,
      .atlas-content,
      .stat-card,
      .discovery-panel,
      .resource-card,
      .mascot-card,
      .submit-card {
        border: 1px solid var(--line);
        background: linear-gradient(180deg, color-mix(in srgb, var(--surface-2) 58%, transparent), color-mix(in srgb, var(--surface) 94%, transparent)), var(--surface);
        box-shadow: 0 24px 70px rgba(0, 0, 0, 0.24);
      }

      .resource-sidebar {
        position: sticky;
        top: 1rem;
        min-height: 100vh;
        border-radius: 0 0 28px 28px;
        padding: 1.1rem;
      }

      .sidebar-brand {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1.35rem;
        color: var(--text);
        text-decoration: none;
        font-family: Georgia, serif;
        font-size: 1.24rem;
      }

      .sidebar-brand img {
        border-radius: 0.7rem;
        box-shadow: 0 0 0 1px var(--line-strong);
      }

      .sidebar-label,
      .breadcrumb,
      .stat-label,
      .section-kicker,
      .meta-line,
      .stat-grid dt,
      .card-topline {
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-size: 0.72rem;
      }

      .sidebar-label,
      .breadcrumb,
      .stat-label,
      .section-kicker {
        color: var(--accent);
      }

      .resource-nav {
        display: grid;
        gap: 0.35rem;
        margin-top: 0.8rem;
      }

      .resource-nav a {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.78rem 0.85rem;
        border-radius: 14px;
        color: var(--muted);
        text-decoration: none;
        border: 1px solid transparent;
      }

      .resource-nav a:hover,
      .resource-nav a.is-active {
        color: var(--text);
        border-color: var(--line-strong);
        background: rgba(255, 255, 255, 0.045);
      }

      .resource-nav strong {
        min-width: 1.8rem;
        text-align: center;
        padding: 0.15rem 0.4rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.055);
        color: var(--text);
        font-size: 0.72rem;
      }

      .submit-card {
        margin-top: 1.2rem;
        border-radius: 22px;
        padding: 1rem;
        background: linear-gradient(145deg, var(--surface-2), var(--surface));
      }

      .submit-icon {
        width: 2.2rem;
        height: 2.2rem;
        display: grid;
        place-items: center;
        border-radius: 0.8rem;
        background: rgba(255, 255, 255, 0.06);
        color: var(--accent-2);
      }

      .submit-card h2 {
        margin: 0.8rem 0 0.35rem;
        font-size: 1rem;
      }

      .submit-card p,
      .resource-card p,
      .stat-card p,
      .section-heading p,
      .card-copy p,
      .meta-block {
        color: var(--muted);
      }

      .submit-card p {
        margin: 0 0 0.8rem;
        line-height: 1.55;
        font-size: 0.9rem;
      }

      .submit-card a,
      .stat-card a {
        color: var(--accent-2);
        text-decoration: none;
        font-size: 0.9rem;
      }

      .atlas-content {
        min-width: 0;
        border-radius: 30px;
        padding: 1rem;
        background: color-mix(in srgb, var(--surface) 94%, transparent);
      }

      .atlas-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin: -1rem -1rem 1rem;
        padding: 0.85rem 1rem;
        border-bottom: 1px solid var(--line);
      }

      .top-menu,
      .theme-switcher,
      .tab-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
      }

      .top-menu a {
        position: relative;
        color: var(--muted);
        text-decoration: none;
        padding: 0.35rem 0;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.13em;
      }

      .top-menu a.is-current,
      .top-menu a:hover {
        color: var(--text);
      }

      .top-menu a.is-current::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        bottom: -0.86rem;
        height: 1px;
        background: var(--accent);
      }

