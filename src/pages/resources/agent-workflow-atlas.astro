    <Footer />
    <script>
      const search = document.getElementById('atlas-search');
      const category = document.getElementById('category-filter');
      const agent = document.getElementById('agent-filter');
      const proof = document.getElementById('proof-filter');
      const risk = document.getElementById('risk-filter');
      const sort = document.getElementById('sort-control');
      const grid = document.getElementById('workflow-grid');
      const cards = Array.from(document.querySelectorAll('#workflow-grid .case-card'));
      const count = document.getElementById('catalog-count');
      const empty = document.getElementById('empty-state');
      cards.forEach((card, index) => { card.dataset.index = String(index); });
      function sortCards() {
        if (!grid) return;
        const mode = sort?.value || 'original';
        const proofRank = { Verified: 0, Inferred: 1 };
        const sorted = [...cards].sort((a, b) => {
          if (mode === 'title') return (a.querySelector('h3')?.textContent || '').localeCompare(b.querySelector('h3')?.textContent || '');
          if (mode === 'category') return (a.dataset.category || '').localeCompare(b.dataset.category || '') || Number(a.dataset.index) - Number(b.dataset.index);
          if (mode === 'agent') return ((a.dataset.agents || '').split('|')[0] || '').localeCompare(((b.dataset.agents || '').split('|')[0] || '')) || Number(a.dataset.index) - Number(b.dataset.index);
          if (mode === 'proof') return (proofRank[a.dataset.proof] ?? 9) - (proofRank[b.dataset.proof] ?? 9) || Number(a.dataset.index) - Number(b.dataset.index);
          if (mode === 'risk') return (a.dataset.risk || '').localeCompare(b.dataset.risk || '') || Number(a.dataset.index) - Number(b.dataset.index);
          return Number(a.dataset.index) - Number(b.dataset.index);
        });
        sorted.forEach((card) => grid.appendChild(card));
      }
      function applyFilters() {
        const q = (search?.value || '').trim().toLowerCase();
        const selectedCategory = category?.value || '';
        const selectedAgent = agent?.value || '';
        const selectedProof = proof?.value || '';
        const selectedRisk = risk?.value || '';
        let visible = 0;
        cards.forEach((card) => {
          const haystack = card.dataset.search || '';
          const agents = card.dataset.agents || '';
          const show = (!q || haystack.includes(q)) && (!selectedCategory || card.dataset.category === selectedCategory) && (!selectedAgent || agents.split('|').includes(selectedAgent)) && (!selectedProof || card.dataset.proof === selectedProof) && (!selectedRisk || card.dataset.risk === selectedRisk);
          card.hidden = !show;
          if (show) visible += 1;
        });
        if (count) count.textContent = `${visible} workflow${visible === 1 ? '' : 's'} shown`;
        if (empty) empty.hidden = visible !== 0;
      }
      [search, category, agent, proof, risk].forEach((el) => { el?.addEventListener('input', applyFilters); el?.addEventListener('change', applyFilters); });
      sort?.addEventListener('change', () => { sortCards(); applyFilters(); });
      sortCards();
      applyFilters();
    </script>
  </body>
