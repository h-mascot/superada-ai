const categoryCopy = {
  'Executive command center': { runs: 'Daily, weekly, or when Henry asks for the operating picture.', givesBack: 'A short command view: priority, owner, blocker, next action, and the receipt behind each item.' },
  'Research and evidence': { runs: 'On demand for claims, market questions, articles, decks, and decisions that need proof.', givesBack: 'A source-backed answer, contradictions, confidence level, citations, and clean wording that does not overclaim.' },
  'Communication and inboxes': { runs: 'Continuously, on a schedule, or when a thread/inbox needs triage.', givesBack: 'A ranked queue, suggested replies, context, why each item matters, and the exact action that still needs approval.' },
  'Sales, partnerships, and revenue': { runs: 'Before calls, after events, during pipeline review, or when an account needs movement.', givesBack: 'A concise commercial brief: account context, useful angle, next ask, risk, and follow-up draft.' },
  'Content and distribution': { runs: 'When research, a launch, or a strong opinion needs to become a publishable artifact.', givesBack: 'Drafts, source receipts, channel fit, claim risk, and a route to publish only after review.' },
  'Software and product delivery': { runs: 'When a scoped task, bug, or product change needs to move from brief to verified patch.', givesBack: 'A diff or branch, test output, build receipts, review notes, blockers, and the next merge/deploy step.' },
  'Fleet and infrastructure operations': { runs: 'When a heartbeat, alert, deploy, route, or user report says the system is unhealthy.', givesBack: 'A diagnosis, smallest safe repair attempted, before/after evidence, and remaining risk.' },
  'Knowledge and memory': { runs: 'After decisions, compactions, handoffs, restarts, or “what happened with this?” questions.', givesBack: 'Recovered context, decisions, current state, provenance, stale facts, and the next safe move.' },
  'Finance and business intelligence': { runs: 'During recurring spend checks, provider reviews, pricing work, or decision-pack requests.', givesBack: 'Burn rate, waste suspects, quota risk, value framing, and recommended action with evidence.' },
  'Creative and media production': { runs: 'When a story, launch, article, or workflow needs a visual, audio, or video artifact.', givesBack: 'Storyboard, prompts, assets, render plan, QA notes, and publish-ready files after approval.' },
  'Personal and lifestyle operations': { runs: 'On demand or on a private schedule for contacts, calendar, travel, family, and household admin.', givesBack: 'A clean private action, saved record, duplicate warning, reminder, or draft without leaking private context.' },
  'Governance, QA, and safety': { runs: 'Before publication, deploy, agent action, skill change, or any claim that needs a gate.', givesBack: 'A pass/fail decision, missing proof, test receipt, approval requirement, and rollback note.' }
};

const categoryTitles = {
  'Executive command center': ['Daily command brief', 'Meeting-to-task sweep', 'Priority reset', 'Decision log cleanup', 'Owner and blocker audit', 'Weekly operating review', 'Commitment tracker', 'Escalation watch', 'Executive handoff pack'],
  'Research and evidence': ['Public claim verification', 'Market question dossier', 'Source-backed article research', 'Competitor evidence scan', 'Policy or filing review', 'Technical proof pack', 'Contradiction check', 'Research memory update', 'Last-30-days scan'],
  'Communication and inboxes': ['Urgent message triage', 'Executive email draft', 'WhatsApp follow-up queue', 'Slack mention audit', 'Discord thread cleanup', 'Cross-channel reply pack', 'New-contact approval gate', 'Missed-message review', 'External-send receipt'],
  'Sales, partnerships, and revenue': ['Account brief before a call', 'Conference follow-up', 'Partner research pack', 'Pipeline next-action review', 'Warm intro prep', 'Commercial objection map', 'CRM hygiene pass', 'Investor or sponsor brief', 'Renewal risk scan'],
  'Content and distribution': ['AI news watch', 'X draft from research', 'Article from evidence pack', 'Launch announcement pack', 'WeeklyClaw draft queue', 'Clip-to-post triage', 'Newsletter source sweep', 'Public-safe resource rewrite'],
  'Software and product delivery': ['Runner builds a scoped task', 'Bug diagnosis before fixing', 'Regression test harness', 'Release changelog draft', 'PR review with receipts', 'Deployment canary check', 'Spec-to-issue breakdown', 'Prototype proof pass'],
  'Fleet and infrastructure operations': ['Heartbeat', 'Agent runtime repair', 'Gateway cost watch', 'Cron noise control', 'Host health sweep', 'Route and deploy audit', 'Storage pressure check', 'Watchdog recovery'],
  'Knowledge and memory': ['Cross-session context recovery', 'Skill improvement loop', 'Decision memory capture', 'Obsidian note cleanup', 'Project context pack', 'Shared memory publication', 'Stale instruction audit', 'Transcript-to-actions recovery'],
  'Finance and business intelligence': ['Provider spend review', 'Token waste audit', 'Quota risk watch', 'Budget decision pack', 'Cloud cost attribution', 'Revenue signal brief', 'Pricing research pack', 'Runaway-loop cost stop'],
  'Creative and media production': ['Script-to-video proof pack', 'Infographic from source notes', 'Thumbnail concept pass', 'Voiceover render QA', 'Image prompt and verification', 'Deck visual polish', 'Short-form video storyboard', 'Asset continuity check'],
  'Personal and lifestyle operations': ['Contact saving and cleanup', 'Calendar conflict check', 'Travel admin brief', 'Family schedule reminder', 'Private document checklist', 'Personal CRM sync', 'Appointment prep', 'Household task follow-up'],
  'Governance, QA, and safety': ['Publication readiness gate', 'Security posture check', 'Privacy scrub before publish', 'Evidence convergence review', 'Approval-boundary audit', 'Production deploy safety check', 'Skill supply-chain review', 'Final QA receipt']
};

const seenByCategory = {};
const atlasCases = atlas.rows.map((row) => {
  const count = (seenByCategory[row.category] || 0);
  seenByCategory[row.category] = count + 1;
  const titles = categoryTitles[row.category] || [];
  const title = titles[count] || `${row.category} loop ${count + 1}`;
  const copy = categoryCopy[row.category] || { runs: 'On demand or on a schedule.', givesBack: 'A clear output, evidence, and the next safe action.' };
  return { ...row, title, summary: `${row.agents.join(' + ')} turns ${row.inputs} into a reusable ${row.category.toLowerCase()} workflow with a visible approval boundary.`, runs: copy.runs, connects: row.inputs, givesBack: copy.givesBack, humanGate: row.approval };
});

const stats = [
  { label: 'Workflows', value: atlas.summary.total },
  { label: 'Categories', value: atlas.categories.length },
  { label: 'Agents', value: atlas.agents.length },
  { label: 'Verified', value: atlas.summary.by_evidence.verified },
  { label: 'Inferred', value: atlas.summary.by_evidence.inferred },
];
