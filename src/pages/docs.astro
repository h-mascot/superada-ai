---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Docs - SuperAda" description="SuperAda documentation hub for humans and agents: developer API docs, OpenAPI, llms.txt, sitemap, benchmarks, resources, and contact links." />
	</head>
	<body>
		<Header />
		<main class="docs-shell" aria-labelledby="docs-title">
			<section class="docs-hero">
				<div class="kicker">Documentation hub</div>
				<h1 id="docs-title">SuperAda docs for humans and agents.</h1>
				<p class="lede">A stable discovery page for agents, crawlers, and developers looking for SuperAda API documentation, machine-readable metadata, public datasets, and support routes.</p>
			</section>

			<section class="docs-grid" aria-label="Primary documentation links">
				<a class="docs-card" href="/developers/">
					<span>Developer docs</span>
					<h2>Public API guide</h2>
					<p>Authentication notes, canonical <code>/api/v1/...</code> endpoints, example requests, error format, rate limits, and versioning/deprecation policy.</p>
				</a>

				<a class="docs-card" href="/openapi.json">
					<span>OpenAPI</span>
					<h2>Machine-readable API spec</h2>
					<p>OpenAPI 3.1 specification for public SuperAda API endpoints, response headers, structured errors, and version metadata.</p>
				</a>

				<a class="docs-card" href="/llms.txt">
					<span>llms.txt</span>
					<h2>Agent orientation file</h2>
					<p>Plain-text guidance for language models and agents: what the site is, which links matter, and how to find public data.</p>
				</a>

				<a class="docs-card" href="/resources/">
					<span>Resources</span>
					<h2>Resource atlas</h2>
					<p>Human-readable guides, tools, studies, benchmarks, and workflow references built by the SuperAda crew.</p>
				</a>

				<a class="docs-card" href="/sitemap-index.xml">
					<span>Sitemap</span>
					<h2>Crawl map</h2>
					<p>Search-engine and crawler-friendly sitemap index for public SuperAda pages.</p>
				</a>

				<a class="docs-card" href="/contact/">
					<span>Contact</span>
					<h2>Support and corrections</h2>
					<p>Where to report API documentation issues, public-data problems, or inaccurate site information.</p>
				</a>
			</section>

			<section class="docs-panel" aria-labelledby="quickstart-title">
				<h2 id="quickstart-title">Agent quickstart</h2>
				<ol>
					<li>Read <a href="/llms.txt">/llms.txt</a> for site orientation.</li>
					<li>Use <a href="/developers/">/developers/</a> for human-readable API guidance.</li>
					<li>Use <a href="/openapi.json">/openapi.json</a> for endpoint schemas and response headers.</li>
					<li>Prefer canonical versioned API routes under <code>/api/v1/...</code>.</li>
					<li>Respect <code>RateLimit-*</code>, <code>Retry-After</code>, <code>API-Version</code>, <code>Deprecation</code>, and future <code>Sunset</code> headers.</li>
				</ol>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.docs-shell { width: min(100%, 1120px); margin: 0 auto; padding: clamp(54px, 7vw, 96px) 32px 90px; }
	.docs-hero { margin-bottom: 28px; }
	.docs-hero h1 { max-width: 900px; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(48px, 6vw, 80px); font-weight: 500; letter-spacing: -.055em; }
	.docs-hero .lede { max-width: 820px; color: var(--muted); line-height: 1.72; }
	.docs-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin-top: 30px; }
	.docs-card, .docs-panel { border: 1px solid var(--border); border-radius: 26px; background: linear-gradient(145deg, var(--panel), color-mix(in srgb, var(--panel-soft) 68%, transparent)); box-shadow: 0 16px 48px color-mix(in srgb, var(--glow) 16%, transparent); }
	.docs-card { display: block; min-height: 210px; padding: 24px; text-decoration: none; color: inherit; }
	.docs-card span { display: inline-flex; margin-bottom: 12px; color: var(--accent); font-size: 12px; font-weight: 900; letter-spacing: .16em; text-transform: uppercase; }
	.docs-card h2, .docs-panel h2 { font-size: 26px; margin-bottom: 12px; }
	.docs-card p, .docs-panel li { color: var(--muted); line-height: 1.72; }
	.docs-panel { margin-top: 16px; padding: 30px; }
	.docs-panel ol { margin: 0; padding-left: 22px; }
	code { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', monospace; font-size: .9em; color: var(--text); background: var(--bg); border: 1px solid var(--border); border-radius: 7px; padding: 1px 5px; }
	@media (max-width: 860px) { .docs-grid { grid-template-columns: 1fr; } }
</style>
