---
import NavIcon from '../components/NavIcon.astro';
import PageHero from '../components/PageHero.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const links = [
	{ href: '/developers/', kicker: 'Developer docs', title: 'Public API guide', icon: 'code', copy: 'Authentication notes, canonical /api/v1/... endpoints, example requests, error format, rate limits, and versioning/deprecation policy.' },
	{ href: '/openapi.json', kicker: 'OpenAPI', title: 'Machine-readable API spec', icon: 'docs', copy: 'OpenAPI 3.1 specification for public SuperAda API endpoints, response headers, structured errors, and version metadata.' },
	{ href: '/llms.txt', kicker: 'llms.txt', title: 'Agent orientation file', icon: 'spark', copy: 'Plain-text guidance for language models and agents: what the site is, which links matter, and how to find public data.' },
	{ href: '/resources/', kicker: 'Resources', title: 'Resource atlas', icon: 'atlas', copy: 'Human-readable guides, tools, studies, benchmarks, and workflow references built by the SuperAda crew.' },
	{ href: '/sitemap-index.xml', kicker: 'Sitemap', title: 'Crawl map', icon: 'timeline', copy: 'Search-engine and crawler-friendly sitemap index for public SuperAda pages.' },
	{ href: '/contact/', kicker: 'Contact', title: 'Support and corrections', icon: 'mail', copy: 'Where to report API documentation issues, public-data problems, or inaccurate site information.' },
] as const;

const steps = [
	{ label: 'Orient', html: 'Read <a href="/llms.txt">/llms.txt</a> for site orientation.' },
	{ label: 'Learn', html: 'Use <a href="/developers/">/developers/</a> for human-readable API guidance.' },
	{ label: 'Integrate', html: 'Use <a href="/openapi.json">/openapi.json</a> for endpoint schemas and response headers.' },
	{ label: 'Version', html: 'Prefer canonical versioned API routes under <code>/api/v1/...</code>.' },
	{ label: 'Behave', html: 'Respect <code>RateLimit-*</code>, <code>Retry-After</code>, <code>API-Version</code>, <code>Deprecation</code>, and future <code>Sunset</code> headers.' },
];
---
<SiteLayout title="Docs - SuperAda" description="SuperAda documentation hub for humans and agents: developer API docs, OpenAPI, llms.txt, sitemap, benchmarks, resources, and contact links.">
	<PageHero eyebrow="Documentation hub" title="Docs for humans and agents." lede="A stable discovery page for agents, crawlers, and developers looking for SuperAda API documentation, machine-readable metadata, public datasets, and support routes." id="docs-title">
		<a class="ds-btn" href="/developers/">Read the API guide <span aria-hidden="true">→</span></a>
		<a class="ds-btn ds-btn--ghost" href="/llms.txt">llms.txt</a>
	</PageHero>

	<div class="ds-shell">
		<section class="ds-grid ds-grid--3" aria-label="Primary documentation links">
			{links.map((link) => (
				<a class="ds-card" href={link.href}>
					<span class="ds-card-icon"><NavIcon name={link.icon} /></span>
					<span class="ds-card-kicker">{link.kicker}</span>
					<h2>{link.title}</h2>
					<p>{link.copy}</p>
					<span class="ds-card-foot"><span class="ds-card-link">Open <span aria-hidden="true">→</span></span></span>
				</a>
			))}
		</section>

		<section class="ds-section docs-quickstart ds-panel" aria-labelledby="quickstart-title">
			<div class="docs-quickstart-head">
				<span class="ds-eyebrow">For agents</span>
				<h2 class="ds-h2" id="quickstart-title">Agent quickstart</h2>
				<p>Five steps from first contact to a well-behaved integration.</p>
			</div>
			<ol class="docs-steps">
				{steps.map((step, index) => (
					<li><span class="docs-step-n">{String(index + 1).padStart(2, '0')}</span><div><b>{step.label}</b><p set:html={step.html} /></div></li>
				))}
			</ol>
		</section>
	</div>
</SiteLayout>

<style>
	.docs-quickstart { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(24px, 4vw, 56px); }
	.docs-quickstart-head { display: grid; gap: 14px; align-content: start; }
	.docs-quickstart-head p { color: var(--muted); }
	.docs-steps { list-style: none; margin: 0; padding: 0; display: grid; }
	.docs-steps li { display: grid; grid-template-columns: 48px minmax(0, 1fr); gap: 14px; padding: 16px 0; border-bottom: 1px solid var(--border); }
	.docs-steps li:last-child { border-bottom: 0; }
	.docs-step-n { color: var(--accent); font: 700 13px/1.6 var(--font-mono); }
	.docs-steps b { display: block; margin-bottom: 4px; font-size: 15px; }
	.docs-steps p { color: var(--muted); line-height: 1.6; }
	.docs-steps :global(code) { font-family: var(--font-mono); font-size: .88em; color: var(--text); background: var(--bg); border: 1px solid var(--border); border-radius: 6px; padding: 1px 5px; }
	@media (max-width: 860px) { .docs-quickstart { grid-template-columns: 1fr; } }
</style>
