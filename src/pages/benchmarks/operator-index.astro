---
import PageHero from '../../components/PageHero.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import registry from '../../data/benchmark-registry.json';

const siteTitle = 'OperatorIndex — SuperAda';
const description = 'OperatorIndex is our public benchmark for agent judgment under real constraints: routing, recovery, config safety, delegation, and proof.';

const suiteLeaders = [
	{ rank: 1, name: 'Claude Opus 4.6', alias: 'opus', score: 95.3, note: 'Best raw operator judgment across recovery, config safety, and delegation proof.' },
	{ rank: 2, name: 'GLM-5-Turbo', alias: 'glm5t', score: 95.0, note: 'Near-Opus quality with absurd cost efficiency. Cleanest all-round challenger.' },
	{ rank: 3, name: 'MiniMax M2.7', alias: 'minimax', score: 90.8, note: 'Powerful but lost trust with a config.patch rule violation.' },
];

const messagingLeaders = [
	{ rank: 1, label: '12-way tie at 100/100', models: 'Gemini Pro, Gemini Flash, Gemini 3.1, GLM-4.7, GLM-5, Hunter, MiniMax, Open, Opus 4.6, Opus 4.5, Sonnet 4.6, Sonnet 4.5' },
	{ rank: 2, label: '95/100 band', models: 'Grok Fast, Healer, Kimi Code, Nemo' },
	{ rank: 3, label: 'Local models exposed', models: 'qwen-local 70/100, llama-local 40/100' },
];

const benchmarkCards = [
	{
		kicker: 'Canon 01',
		title: 'Cron Reliability',
		date: '2026-03-13',
		scoreline: 'Hunter 94 · Healer 90 · Open 87 · Nemo 87',
		href: '/benchmarks/2026-03-19/cron-reliability-v1.png',
		blurb: 'The first useful run. Good signal, too soft. Rewarded neat structured output more than operator judgment.',
	},
	{
		kicker: 'Canon 02',
		title: 'Messaging Tool Planning v2',
		date: '2026-03-14',
		scoreline: '22 models · 18 completed · 4 harness/provider failures',
		href: '/benchmarks/2026-03-19/messaging-v2-full.png',
		blurb: 'Full-roster routing benchmark built from real work: Slack vs Telegram vs direct API path, plus reminder scheduling.',
	},
	{
		kicker: 'Canon 03',
		title: 'Operator Suite v2',
		date: '2026-03-18',
		scoreline: 'Opus 95.3 · GLM-5-Turbo 95.0 · MiniMax 90.8',
		href: '/benchmarks/2026-03-19/operator-suite-v2-march18.png',
		blurb: 'Five tracks, fifteen tasks, weighted toward routing, recovery, config safety, delegation, and proof.',
	},
];

const updateNotes = [
	'We benchmark operator leverage, not pretty JSON.',
	'We classify failures as model, provider, harness, context, policy, schema, or delegation failures.',
	'Every serious run should produce a pack: tasks, rubric, raw results, scored results, and visuals.',
	'Each major model update should append a new scored run here instead of resetting the board like nothing happened.',
];

const tracks = ['Routing', 'Failure recovery', 'Config safety', 'Delegation proof', 'Update-on-run leaderboard'];

const costValue = (cost: string) => {
	const match = cost.match(/\$([\d.]+)/);
	return match ? Number(match[1]) : '';
};
const sourceBadge = (family: string) =>
	/operator suite/i.test(family) ? 'ds-badge--live' : /messaging/i.test(family) ? 'ds-badge--warn' : /local|ollama|omlx|prism/i.test(family) ? 'ds-badge--accent' : 'ds-badge--muted';
const tone = (score: number) => (score >= 85 ? 'high' : score >= 60 ? 'mid' : 'low');
const board = registry.leaderboard;
const updated = registry.updatedAt.slice(0, 10);
---
<SiteLayout title={siteTitle} description={description} mainClass="oi-page">
	<PageHero eyebrow="Public Benchmark" title="OperatorIndex" lede="A benchmark for AI agents under real constraints: when to route, when to wait, when to recover, when to ask permission, and when not to bluff." size="xl" id="oi-title">
		<a class="ds-btn" href="#leaderboard">Operator Suite v2 <span aria-hidden="true">↓</span></a>
		<a class="ds-btn ds-btn--ghost" href="#board">Full board</a>
		<div slot="aside" class="oi-podium ds-panel" data-no-reveal>
			<div class="oi-podium-head">
				<span class="ds-card-kicker">Operator Suite v2</span>
				<span class="ds-badge ds-badge--live">Verified 2026-03-18</span>
			</div>
			<ol class="oi-podium-list">
				{suiteLeaders.map((item) => (
					<li class={`is-rank-${item.rank}`}>
						<span class="oi-medal">{item.rank}</span>
						<span class="oi-podium-name">{item.name}</span>
						<span class="oi-podium-bar" style={`--w:${item.score}%`} aria-hidden="true"><i></i></span>
						<b>{item.score.toFixed(1)}</b>
					</li>
				))}
			</ol>
			<div class="oi-podium-foot ds-meta"><span>5 tracks</span><span>15 tasks</span><span>22-model roster</span></div>
		</div>
	</PageHero>

	<div class="ds-shell">
		<ul class="oi-tracks" aria-label="What OperatorIndex measures">
			{tracks.map((track) => <li class="ds-chip">{track}</li>)}
		</ul>

		<section class="ds-section oi-headline" aria-labelledby="headline-title">
			<div class="oi-headline-main">
				<span class="ds-eyebrow">Current headline</span>
				<h2 class="oi-headline-quote" id="headline-title">GLM is the annoying value monster, Opus is still the king, MiniMax is brilliant but can’t be left alone with config.</h2>
				<p>That is the current state of play from our recent benchmark canon. Messaging tests created a crowded top tier. Operator Suite v2 forced the real separation: judgment, recovery chains, and rule compliance.</p>
			</div>
			<aside class="ds-card ds-card--feature oi-rule">
				<span class="ds-card-kicker">Benchmark rule</span>
				<p>Benchmark <strong>operator leverage</strong>, not answer cosmetics.</p>
			</aside>
		</section>

		<section class="ds-section" id="leaderboard" aria-labelledby="leaderboard-title">
			<div class="ds-section-head">
				<div class="oi-head"><span class="ds-eyebrow">Leaderboard</span><h2 class="ds-h2" id="leaderboard-title">Operator Suite v2</h2></div>
				<span class="oi-head-meta">Latest verified run: 2026-03-18</span>
			</div>
			<div class="ds-grid ds-grid--3 ds-rail-sm oi-leaders">
				{suiteLeaders.map((item) => (
					<article class={`ds-card oi-leader is-rank-${item.rank}`}>
						<div class="oi-leader-top">
							<span class="oi-leader-rank">#{item.rank}</span>
							<span class="oi-leader-score">{item.score}</span>
						</div>
						<span class="oi-leader-bar" style={`--w:${item.score}%`} aria-hidden="true"><i></i></span>
						<h3>{item.name}</h3>
						<p>{item.note}</p>
					</article>
				))}
			</div>
			<a class="oi-figure" href="/benchmarks/2026-03-19/operator-suite-v2-march18.png">
				<img src="/benchmarks/2026-03-19/operator-suite-v2-march18.png" alt="Operator Suite v2 March 18 leaderboard" width="1200" height="800" loading="lazy" decoding="async" />
				<span class="oi-figure-cap">Operator Suite v2 · March 18 leaderboard <span aria-hidden="true">↗</span></span>
			</a>
		</section>

		<section class="ds-section oi-messaging" aria-labelledby="messaging-title">
			<div class="oi-messaging-copy">
				<span class="ds-eyebrow">Messaging Tool Planning v2</span>
				<h2 class="ds-h2" id="messaging-title">A crowded top tier, then the cliff.</h2>
				<ol class="oi-bands">
					{messagingLeaders.map((row) => (
						<li>
							<span class="oi-band-n">Band {row.rank}</span>
							<div>
								<b>{row.label}</b>
								<p>{row.models}</p>
							</div>
						</li>
					))}
				</ol>
			</div>
			<a class="oi-figure oi-figure--tall" href="/benchmarks/2026-03-19/messaging-v2-full.png">
				<img src="/benchmarks/2026-03-19/messaging-v2-full.png" alt="Messaging tool planning v2 full leaderboard" width="2084" height="1481" loading="lazy" decoding="async" />
				<span class="oi-figure-cap">Full messaging leaderboard <span aria-hidden="true">↗</span></span>
			</a>
		</section>

		<section class="ds-section" id="board" aria-labelledby="board-title">
			<div class="ds-section-head">
				<div class="oi-head"><span class="ds-eyebrow">Benchmark registry</span><h2 class="ds-h2" id="board-title">The full operator board</h2></div>
				<span class="oi-head-meta">Updated {updated} · {board.length} models</span>
			</div>
			<div class="oi-board-tools" role="group" aria-label="Sort the board">
				<span>Sort by</span>
				<button type="button" class="ds-chip" data-oi-sort="rank" aria-pressed="true">Rank</button>
				<button type="button" class="ds-chip" data-oi-sort="score" aria-pressed="false">Operator score</button>
				<button type="button" class="ds-chip" data-oi-sort="cost" aria-pressed="false">Cost</button>
				<button type="button" class="ds-chip" data-oi-sort="model" aria-pressed="false">Name</button>
			</div>
			<div class="oi-table-wrap" data-no-reveal>
				<table class="oi-table" data-oi-board>
					<thead>
						<tr>
							<th scope="col" class="oi-col-rank">#</th>
							<th scope="col">Model</th>
							<th scope="col" class="oi-col-score">Operator</th>
							<th scope="col">Messaging</th>
							<th scope="col">External canon</th>
							<th scope="col">Cost</th>
							<th scope="col">Verdict</th>
						</tr>
					</thead>
					<tbody>
						{board.map((row) => (
							<tr class={`is-${tone(row.operator)}`} data-rank={row.rank} data-score={row.operator} data-cost={costValue(row.cost)} data-model={row.model.toLowerCase()}>
								<td class="oi-col-rank"><span class:list={['oi-rank', { 'is-top': row.rank <= 3 }]}>{row.rank}</span></td>
								<th scope="row">
									<a class="oi-model" href={row.detailHref} {...(row.detailHref.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
										<b>{row.model}</b>
										<span class={`ds-badge ${sourceBadge(row.family)}`}>{row.family}</span>
									</a>
								</th>
								<td class="oi-col-score"><span class="oi-score"><b>{row.operator}</b><span class="oi-bar" style={`--w:${row.operator}%`} aria-hidden="true"><i></i></span></span></td>
								<td>{row.messaging}</td>
								<td class="oi-dim">{row.external}</td>
								<td class="oi-cost">{row.cost}</td>
								<td class="oi-dim oi-verdict">{row.verdict} <a href={row.detailHref} {...(row.detailHref.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{row.detailLabel} <span aria-hidden="true">→</span></a></td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
			<p class="oi-board-note">Scores mix full Operator Suite runs, messaging-only runs and local quick packs. The source badge on each row says which.</p>
		</section>

		<section class="ds-section" aria-labelledby="canon-title">
			<div class="ds-section-head">
				<div class="oi-head"><span class="ds-eyebrow">Benchmark canon</span><h2 class="ds-h2" id="canon-title">How we got here</h2></div>
			</div>
			<ol class="ds-grid ds-grid--3 ds-rail-sm oi-canon">
				{benchmarkCards.map((card, i) => (
					<li>
						<a class="ds-card oi-canon-card" href={card.href}>
							<span class="ds-card-kicker">{card.kicker}<span class="oi-canon-step" aria-hidden="true">{i < benchmarkCards.length - 1 ? '→' : '●'}</span></span>
							<h3>{card.title}</h3>
							<div class="ds-meta"><time datetime={card.date}>{card.date}</time><span>{card.scoreline}</span></div>
							<p>{card.blurb}</p>
							<span class="ds-card-foot"><span class="ds-card-link">Open artifact →</span></span>
						</a>
					</li>
				))}
			</ol>
		</section>

		<section class="ds-section oi-protocol ds-panel" aria-labelledby="protocol-title">
			<div class="oi-head">
				<span class="ds-eyebrow">Update protocol</span>
				<h2 class="ds-h2" id="protocol-title">Every new model run updates the board.</h2>
			</div>
			<ol class="oi-notes">
				{updateNotes.map((note, i) => <li><span>{String(i + 1).padStart(2, '0')}</span><p>{note}</p></li>)}
			</ol>
		</section>

		<section class="ds-cta-band" aria-labelledby="story-title">
			<div>
				<span class="ds-eyebrow">Read the full story</span>
				<h2 class="ds-h2" id="story-title">Benchmarks That Actually Matter</h2>
				<p>The article that explains how the first soft benchmark turned into a proper operator benchmark system.</p>
			</div>
			<a class="ds-btn" href="/blog/benchmarks-that-actually-matter/">Read article →</a>
		</section>
	</div>

	<script is:inline>
		(() => {
			const table = document.querySelector('[data-oi-board]');
			const buttons = [...document.querySelectorAll('[data-oi-sort]')];
			if (!table || !buttons.length) return;
			const body = table.tBodies[0];
			const rows = [...body.rows];
			const compare = {
				rank: (a, b) => Number(a.dataset.rank) - Number(b.dataset.rank),
				score: (a, b) => Number(b.dataset.score) - Number(a.dataset.score) || Number(a.dataset.rank) - Number(b.dataset.rank),
				cost: (a, b) => {
					const x = a.dataset.cost === '' ? Infinity : Number(a.dataset.cost);
					const y = b.dataset.cost === '' ? Infinity : Number(b.dataset.cost);
					return x - y || Number(a.dataset.rank) - Number(b.dataset.rank);
				},
				model: (a, b) => a.dataset.model.localeCompare(b.dataset.model),
			};
			buttons.forEach((button) => button.addEventListener('click', () => {
				const key = button.dataset.oiSort;
				buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
				rows.sort(compare[key]).forEach((row) => body.appendChild(row));
			}));
		})();
	</script>
</SiteLayout>

<style>
	.oi-podium { display: grid; gap: 20px; padding: clamp(22px, 2.4vw, 30px); border-radius: var(--radius-lg); }
	.oi-podium-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
	.oi-podium-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
	.oi-podium-list li { display: grid; grid-template-columns: 34px minmax(0, 1fr) auto; grid-template-rows: auto auto; gap: 8px 12px; align-items: center; }
	.oi-medal { grid-row: 1 / 3; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--border-strong); color: var(--muted); font: 800 13px/1 var(--font-mono); }
	.is-rank-1 .oi-medal { color: #140c04; background: var(--accent); border-color: var(--accent); box-shadow: 0 0 20px var(--glow); }
	.is-rank-2 .oi-medal { color: var(--text); border-color: color-mix(in srgb, var(--accent) 50%, var(--border)); }
	.oi-podium-name { grid-column: 2; grid-row: 1; font-weight: 650; font-size: 15px; }
	.oi-podium-list b { grid-column: 3; grid-row: 1; font: 500 26px/1 var(--font-display); letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
	.oi-podium-bar { grid-column: 2 / 4; grid-row: 2; position: relative; height: 6px; border-radius: 999px; background: color-mix(in srgb, var(--border) 70%, transparent); overflow: hidden; }
	.oi-podium-bar i { position: absolute; inset: 0 auto 0 0; width: var(--w); transform-origin: left; border-radius: inherit; background: linear-gradient(90deg, var(--accent-3), var(--accent)); animation: oi-grow 1.1s var(--ease-out) .2s backwards; }
	@keyframes oi-grow { from { transform: scaleX(0); } }
	.oi-podium-foot { padding-top: 14px; border-top: 1px solid var(--border); }

	.oi-tracks { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
	.oi-tracks .ds-chip { cursor: default; color: var(--text-soft); }

	.oi-head { display: grid; gap: 12px; }
	.oi-head-meta { color: var(--muted); font: 650 12px/1.3 var(--font-mono); text-align: right; }

	.oi-headline { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(260px, .7fr); gap: clamp(24px, 4vw, 64px); align-items: center; }
	.oi-headline-main { display: grid; gap: 18px; }
	.oi-headline-quote { font: 500 clamp(28px, 3.4vw, 48px)/1.08 var(--font-display); letter-spacing: -.035em; color: var(--text); text-wrap: balance; }
	.oi-headline-main p { max-width: 44rem; color: var(--muted); font-size: 16.5px; line-height: 1.7; }
	.oi-rule p { color: var(--text) !important; font: 500 clamp(22px, 2.2vw, 30px)/1.25 var(--font-display) !important; letter-spacing: -.02em; }
	.oi-rule strong { color: var(--accent); font-weight: 500; }

	.oi-leader { gap: 14px; }
	.oi-leader-top { display: flex; align-items: baseline; justify-content: space-between; }
	.oi-leader-rank { color: var(--accent); font: 800 12px/1 var(--font-mono); letter-spacing: .12em; }
	.oi-leader-score { font: 500 clamp(48px, 5vw, 68px)/.9 var(--font-display); letter-spacing: -.05em; font-variant-numeric: tabular-nums; }
	.is-rank-1 .oi-leader-score { color: var(--accent); text-shadow: 0 0 30px var(--glow); }
	.oi-leader-bar { position: relative; height: 6px; border-radius: 999px; background: color-mix(in srgb, var(--border) 70%, transparent); overflow: hidden; }
	.oi-leader-bar i { position: absolute; inset: 0 auto 0 0; width: var(--w); border-radius: inherit; background: linear-gradient(90deg, var(--accent-3), var(--accent)); }
	.oi-leader.is-rank-1 { background: radial-gradient(circle at 100% 0%, color-mix(in srgb, var(--accent) 18%, transparent), transparent 55%), var(--surface); border-color: color-mix(in srgb, var(--accent) 35%, var(--surface-border)); }

	.oi-figure { position: relative; display: block; margin-top: 16px; overflow: hidden; border-radius: var(--radius-lg); border: 1px solid var(--surface-border); background: var(--panel-soft); }
	.oi-figure img { display: block; width: 100%; height: auto; transition: transform 1.1s var(--ease-out); }
	.oi-figure-cap { position: absolute; left: 14px; bottom: 14px; display: inline-flex; gap: 8px; align-items: center; min-height: 36px; padding: 0 14px; border-radius: 999px; background: rgba(8, 6, 4, .72); color: #fff4e3; font-size: 12px; font-weight: 750; -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
	.oi-figure:hover img { transform: scale(1.02); }

	.oi-messaging { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 56px); align-items: stretch; }
	.oi-messaging-copy { display: grid; gap: 18px; align-content: start; }
	.oi-bands { list-style: none; margin: 8px 0 0; padding: 0; display: grid; border-top: 1px solid var(--border); }
	.oi-bands li { display: grid; grid-template-columns: 76px minmax(0, 1fr); gap: 16px; padding: 18px 0; border-bottom: 1px solid var(--border); }
	.oi-band-n { padding-top: 3px; color: var(--accent); font: 800 10.5px/1.3 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; }
	.oi-bands b { display: block; margin-bottom: 4px; font: 500 21px/1.2 var(--font-display); letter-spacing: -.02em; }
	.oi-bands p { color: var(--muted); font-size: 14.5px; line-height: 1.6; }
	.oi-figure--tall { margin-top: 0; }
	.oi-figure--tall img { height: 100%; object-fit: cover; object-position: top; }

	.oi-board-tools { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; overflow-x: auto; scrollbar-width: none; }
	.oi-board-tools::-webkit-scrollbar { display: none; }
	.oi-board-tools > span { margin-right: 4px; color: var(--faint); font: 800 10.5px/1 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; white-space: nowrap; }
	.oi-table-wrap { overflow-x: auto; border-radius: var(--radius-lg); border: 1px solid var(--surface-border); background: var(--surface); -webkit-overflow-scrolling: touch; }
	.oi-table { width: 100%; min-width: 1060px; border-collapse: collapse; text-align: left; }
	.oi-table th, .oi-table td { padding: 16px 16px; border-bottom: 1px solid var(--border); vertical-align: middle; }
	.oi-table tbody tr:last-child > * { border-bottom: 0; }
	.oi-table thead th { color: var(--muted); font: 800 10.5px/1 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; background: color-mix(in srgb, var(--panel-soft) 60%, transparent); white-space: nowrap; }
	.oi-table tbody tr { transition: background-color .2s ease; }
	.oi-table tbody tr:hover { background: color-mix(in srgb, var(--panel-soft) 55%, transparent); }
	.oi-table td { color: var(--text-soft); font-size: 13.5px; line-height: 1.5; }
	.oi-col-rank { width: 56px; }
	.oi-rank { display: inline-grid; place-items: center; width: 32px; height: 32px; border-radius: 10px; border: 1px solid var(--border); color: var(--muted); font: 800 12px/1 var(--font-mono); }
	.oi-rank.is-top { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); background: var(--accent-soft); }
	.oi-table tbody th { min-width: 200px; }
	.oi-model { display: grid; gap: 7px; justify-items: start; align-content: center; min-height: 44px; color: var(--text); }
	.oi-model b { font-weight: 650; font-size: 15px; transition: color .2s ease; }
	.oi-model:hover b { color: var(--accent); }
	.oi-model .ds-badge { white-space: normal; text-align: left; line-height: 1.2; padding-block: 4px; }
	.oi-col-score { width: 150px; }
	.oi-score { display: grid; gap: 7px; }
	.oi-score b { color: var(--tone); font: 700 15px/1 var(--font-mono); font-variant-numeric: tabular-nums; }
	.oi-table tr.is-high { --tone: var(--success); }
	.oi-table tr.is-mid { --tone: var(--accent); }
	.oi-table tr.is-low { --tone: #f78d72; }
	.oi-bar { position: relative; display: block; height: 6px; border-radius: 999px; background: color-mix(in srgb, var(--border) 70%, transparent); overflow: hidden; }
	.oi-bar i { position: absolute; inset: 0 auto 0 0; width: var(--w); border-radius: inherit; background: var(--tone); }
	.oi-dim { color: var(--muted) !important; }
	.oi-cost { font-family: var(--font-mono); font-size: 12.5px !important; white-space: nowrap; }
	.oi-verdict { min-width: 240px; }
