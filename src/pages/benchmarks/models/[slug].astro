---
import fs from 'node:fs';
import path from 'node:path';
import BenchCompare from '../../../components/benchmarks/BenchCompare.astro';
import type { CompareRow } from '../../../components/benchmarks/types';
import ScoreRing from '../../../components/benchmarks/ScoreRing.astro';
import PageHero from '../../../components/PageHero.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import registry from '../../../data/benchmark-registry.json';

export async function getStaticPaths() {
	return registry.models.map((model) => ({
		params: { slug: model.slug },
		props: { model },
	}));
}

const { model } = Astro.props;

type ArtifactLink = { label: string; href?: string; internal?: boolean };

function resolveArtifactPath(artifactPath: string): ArtifactLink {
	if (artifactPath.startsWith('http://') || artifactPath.startsWith('https://')) {
		return { label: artifactPath, href: artifactPath };
	}

	if (artifactPath.startsWith('/home/') || artifactPath.startsWith('memory/')) {
		return { label: artifactPath, internal: true };
	}

	let publicPath = artifactPath;
	if (artifactPath.startsWith('output/benchmarks/')) {
		publicPath = artifactPath.replace(/^output\/benchmarks\//, '/benchmarks/reports/');
	} else if (!artifactPath.startsWith('/')) {
		publicPath = `/${artifactPath}`;
	}

	const diskPath = path.join(process.cwd(), 'public', publicPath.replace(/^\//, ''));
	if (fs.existsSync(diskPath)) {
		return { label: artifactPath, href: publicPath };
	}

	return { label: artifactPath, internal: true };
}

const artifactLinks = model.detail.reportPaths.map(resolveArtifactPath);

const ranked = [...registry.models].sort((a, b) => b.score - a.score);
const rankOf = (score: number) => ranked.findIndex((item) => item.score === score) + 1;
const rank = rankOf(model.score);
const compareRows: CompareRow[] = ranked.map((item) => ({
	rank: rankOf(item.score),
	label: item.model,
	score: item.score,
	display: String(item.score),
	href: `/benchmarks/models/${item.slug}/`,
	meta: item.family,
	current: item.slug === model.slug,
}));
const sameSource = registry.models.filter((item) => item.family === model.family && item.slug !== model.slug);
const board = registry.leaderboard.find((row) => row.slug === model.slug);
const scorecard = board
	? [
			{ label: 'Operator board', value: `#${board.rank}`, note: `${board.operator}/100 operator score` },
			{ label: 'Messaging', value: board.messaging, note: 'Messaging Tool Planning v2' },
			{ label: 'External canon', value: board.external, note: 'Public benchmark references' },
			{ label: 'Cost', value: board.cost, note: board.verdict },
		]
	: [];
const latency = typeof model.avgSeconds === 'number' ? `${model.avgSeconds}s` : null;
const report = model.reportData;
const maxTask = report ? report.tasks[0].maxScore : 0;
const taskTone = (score: number) => (score >= 20 ? 'high' : score >= 10 ? 'mid' : 'low');
---
<SiteLayout title={`${model.model} — Benchmarks — SuperAda`} description={model.summary} mainClass="bm-page">
	<div class="ds-shell bm-back"><a href="/benchmarks" class="back-link">← Back to Benchmarks</a></div>

	<PageHero eyebrow="Model Detail" title={model.model} lede={model.detail.headline} size="lg" id="model-title">
		<a class="ds-btn" href="#compare">How it compares <span aria-hidden="true">↓</span></a>
		<a class="ds-btn ds-btn--ghost" href="#artifacts">Source artifacts</a>
		<div slot="aside" class="bm-score ds-panel" data-no-reveal>
			<ScoreRing value={model.score} label="Benchmark score" unit="/100" size={180} />
			<div class="bm-score-side">
				<span class="ds-badge ds-badge--accent">{model.positioning}</span>
				<dl class="ds-kv">
					<div><dt>Rank</dt><dd>#{rank} of {ranked.length}</dd></div>
					<div><dt>Source</dt><dd>{model.family}</dd></div>
					<div><dt>Run date</dt><dd><time datetime={model.date}>{model.date}</time></dd></div>
					{latency && <div><dt>Avg latency</dt><dd>{latency}</dd></div>}
				</dl>
			</div>
		</div>
	</PageHero>

	<div class="ds-shell">
		<section class="bm-metrics" aria-label="Headline metrics">
			{model.detail.metrics.map((metric, i) => (
				<div class="ds-card bm-metric">
					<span class="ds-card-kicker">{String(i + 1).padStart(2, '0')} · {metric.label}</span>
					<b>{metric.value}</b>
				</div>
			))}
		</section>

		{scorecard.length > 0 && (
			<section class="ds-section" aria-labelledby="scorecard-title">
				<div class="ds-section-head"><div class="bm-head"><span class="ds-eyebrow">Per-suite breakdown</span><h2 class="ds-h2" id="scorecard-title">Scorecard</h2></div></div>
				<div class="ds-grid bm-suites" style="--min: 230px">
					{scorecard.map((item) => (
						<div class="ds-card bm-suite">
							<span class="ds-card-kicker">{item.label}</span>
							<b>{item.value}</b>
							<p>{item.note}</p>
						</div>
					))}
				</div>
			</section>
		)}

		<section class="ds-section ds-grid ds-grid--2 bm-sw" aria-label="Strengths and weaknesses">
			<div class="ds-card bm-list bm-list--good">
				<span class="ds-card-kicker">Strengths</span>
				<ul>{model.strengths.map((item) => <li>{item}</li>)}</ul>
			</div>
			<div class="ds-card bm-list bm-list--bad">
				<span class="ds-card-kicker">Weaknesses</span>
				<ul>{model.weaknesses.map((item) => <li>{item}</li>)}</ul>
			</div>
		</section>

		<section class="ds-section bm-read ds-panel" aria-labelledby="read-title">
			<span class="ds-eyebrow" id="read-title">Operator read</span>
			<p>{model.summary}</p>
		</section>

		{report && (
			<>
				<section class="ds-section" aria-labelledby="tasks-title">
					<div class="ds-section-head"><div class="bm-head"><span class="ds-eyebrow">Task breakdown</span><h2 class="ds-h2" id="tasks-title">How each task scored</h2></div></div>
					<div class="bm-table-wrap">
						<table class="bm-table">
							<thead><tr><th scope="col">Task</th><th scope="col">Score</th><th scope="col">Time</th><th scope="col">What happened</th></tr></thead>
							<tbody>
								{report.tasks.map((t) => (
									<tr class={`is-${taskTone(t.score)}`}>
										<th scope="row">{t.name}</th>
										<td><span class="bm-cell-score"><b>{t.score}/{t.maxScore}</b><span class="bm-bar" style={`--w:${(t.score / t.maxScore) * 100}%`}><i></i></span></span></td>
										<td class="bm-num">{t.seconds}s</td>
										<td>{t.notes}</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
				</section>

				<section class="ds-section ds-grid ds-grid--2" aria-label="Best and worst output">
					<figure class="ds-card bm-quote bm-quote--best">
						<div class="bm-quote-head"><span class="ds-badge ds-badge--live">Best output</span><b>{report.bestOutput.score}/{maxTask}</b></div>
						<span class="ds-card-kicker">{report.bestOutput.task}</span>
						<blockquote>{report.bestOutput.text}</blockquote>
					</figure>
					<figure class="ds-card bm-quote bm-quote--worst">
						<div class="bm-quote-head"><span class="ds-badge ds-badge--warn">Worst output</span><b>{report.worstOutput.score}/{maxTask}</b></div>
						<span class="ds-card-kicker">{report.worstOutput.task}</span>
						<blockquote>{report.worstOutput.text}</blockquote>
					</figure>
				</section>

				<section class="ds-section ds-grid ds-grid--2" aria-label="Bottom line and limitations">
					<div class="ds-card">
						<span class="ds-card-kicker">Bottom line</span>
						<p class="bm-bottom">{report.bottomLine}</p>
					</div>
					<div class="ds-card">
						<span class="ds-card-kicker">MFSF</span>
						<div class="bm-tags">{report.mfsf.map((tag) => <span>{tag}</span>)}</div>
						<ul class="bm-limits">{report.limitations.map((l) => <li>{l}</li>)}</ul>
					</div>
				</section>
			</>
		)}

		<section class="ds-section bm-compare" id="compare" aria-labelledby="compare-title">
			<div class="ds-section-head">
				<div class="bm-head"><span class="ds-eyebrow">Comparison</span><h2 class="ds-h2" id="compare-title">Where {model.model} lands</h2></div>
				<a href="/benchmarks/operator-index">OperatorIndex <span aria-hidden="true">→</span></a>
			</div>
			<div class="bm-compare-grid">
				<div class="ds-panel bm-compare-panel">
					<BenchCompare rows={compareRows} label="Every tracked model report by benchmark score" />
				</div>
				<aside class="bm-compare-note">
					<p class="bm-compare-rank"><b>#{rank}</b><span>of {ranked.length} tracked model reports</span></p>
					<p>Scores come from different packs, so compare models that share a source first.{sameSource.length > 0 && ` ${model.family} also covers:`}</p>
					{sameSource.length > 0 && (
						<ul>{sameSource.map((item) => <li><a href={`/benchmarks/models/${item.slug}/`}>{item.model}</a><span>{item.score}</span></li>)}</ul>
					)}
				</aside>
			</div>
		</section>

		<section class="ds-section bm-artifacts ds-panel" id="artifacts" aria-labelledby="artifacts-title">
			<div class="bm-head">
				<span class="ds-eyebrow">Source artifacts</span>
				<p id="artifacts-title">Raw machine-readable files for anyone who wants to dig deeper or run their own analysis.</p>
			</div>
			<ul class="bm-artifact-list">
				{artifactLinks.map((artifact, i) => (
					<li>
						{artifact.href ? (
							<a href={artifact.href} target={artifact.href.startsWith('http') ? '_blank' : '_self'} rel={artifact.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
								<span class="ds-badge ds-badge--live">Public</span>
								<span class="bm-artifact-label">{i === 0 && !model.reportData ? 'Open readable benchmark report' : artifact.label}</span>
								<span aria-hidden="true">↗</span>
							</a>
						) : (
							<span class="bm-artifact-internal">
								<span class="ds-badge ds-badge--muted">internal artifact</span>
								<span class="bm-artifact-label">{artifact.label}</span>
							</span>
						)}
					</li>
				))}
			</ul>
		</section>
	</div>
</SiteLayout>

<style>
	:global(.bm-page .page-hero.has-aside) { align-items: center; }
	.bm-back { padding-top: clamp(20px, 3vw, 36px); margin-bottom: calc(clamp(44px, 7vw, 108px) * -1 + 12px); }
	.back-link { display: inline-flex; align-items: center; min-height: 44px; color: var(--muted); font-size: 13px; font-weight: 700; transition: color .2s ease; }
	.back-link:hover { color: var(--accent); }

	.bm-score { display: grid; justify-items: center; gap: 22px; padding: clamp(22px, 2.4vw, 30px); border-radius: var(--radius-lg); }
	.bm-score-side { display: grid; gap: 14px; justify-items: center; width: 100%; min-width: 0; }
	.bm-score-side .ds-badge { max-width: 100%; overflow: hidden; text-overflow: ellipsis; }
	.bm-score-side .ds-kv { width: 100%; }
	.bm-score-side .ds-kv > div { padding: 9px 0; }
	.bm-score-side .ds-kv dd { overflow-wrap: anywhere; }

	.bm-head { display: grid; gap: 12px; }
	.ds-section-head > a { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; }
	.bm-metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 16px; }
	.bm-metric b, .bm-suite b { font: 500 clamp(26px, 2.6vw, 36px)/1.05 var(--font-display); letter-spacing: -.035em; color: var(--text); overflow-wrap: anywhere; }
	.bm-suite b { font-size: clamp(22px, 2vw, 28px); }
	.bm-suite p { font-size: 14px; }

	.bm-list ul { list-style: none; padding: 0; gap: 12px; }
	.bm-list li { position: relative; padding-left: 30px; color: var(--text-soft); }
	.bm-list li::before { position: absolute; left: 0; top: 2px; width: 20px; height: 20px; display: grid; place-items: center; border-radius: 50%; font: 800 12px/1 var(--font-mono); }
	.bm-list--good .ds-card-kicker { color: var(--success); }
	.bm-list--good li::before { content: '+'; color: var(--success); background: color-mix(in srgb, var(--success) 14%, transparent); }
	.bm-list--bad .ds-card-kicker { color: #f78d72; }
	.bm-list--bad li::before { content: '−'; color: #f78d72; background: color-mix(in srgb, #f78d72 14%, transparent); }

	.bm-read { display: grid; gap: 18px; background: radial-gradient(circle at 0% 0%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 50%), var(--surface); }
	.bm-read p { max-width: 52rem; color: var(--text); font: 500 clamp(22px, 2.4vw, 32px)/1.3 var(--font-display); letter-spacing: -.02em; text-wrap: pretty; }

	.bm-table-wrap { overflow-x: auto; border-radius: var(--radius-lg); border: 1px solid var(--surface-border); background: var(--surface); -webkit-overflow-scrolling: touch; }
	.bm-table { width: 100%; min-width: 680px; border-collapse: collapse; text-align: left; }
	.bm-table th, .bm-table td { padding: 16px 18px; border-bottom: 1px solid var(--border); vertical-align: top; }
	.bm-table tbody tr:last-child > * { border-bottom: 0; }
	.bm-table thead th { color: var(--muted); font: 800 10.5px/1 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; background: color-mix(in srgb, var(--panel-soft) 60%, transparent); }
	.bm-table tbody th { color: var(--text); font-weight: 650; font-size: 14.5px; white-space: nowrap; }
	.bm-table td { color: var(--muted); font-size: 14px; line-height: 1.6; }
	.bm-num { font-family: var(--font-mono); font-variant-numeric: tabular-nums; white-space: nowrap; }
	.bm-cell-score { display: grid; gap: 8px; min-width: 110px; }
	.bm-cell-score b { font: 700 14px/1 var(--font-mono); color: var(--tone); }
	.bm-table tr.is-high { --tone: var(--success); }
	.bm-table tr.is-mid { --tone: #e8b04a; }
	.bm-table tr.is-low { --tone: #f78d72; }
	.bm-bar { position: relative; display: block; height: 6px; border-radius: 999px; background: color-mix(in srgb, var(--border) 70%, transparent); overflow: hidden; }
	.bm-bar i { position: absolute; inset: 0 auto 0 0; width: var(--w); border-radius: inherit; background: var(--tone); }

	.bm-quote { margin: 0; }
	.bm-quote-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
	.bm-quote-head b { font: 700 14px/1 var(--font-mono); }
	.bm-quote--best .bm-quote-head b { color: var(--success); }
	.bm-quote--worst .bm-quote-head b { color: #e8b04a; }
	.bm-quote .ds-card-kicker { color: var(--muted); }
	.bm-quote blockquote { margin: 0; padding-left: 16px; border-left: 2px solid var(--border-strong); color: var(--text-soft); font: italic 400 17px/1.6 var(--font-display); }
	.bm-quote--best blockquote { border-left-color: var(--success); }
	.bm-quote--worst blockquote { border-left-color: #e8b04a; }
	.bm-bottom { color: var(--text-soft) !important; font-size: 16px !important; }
	.bm-limits { list-style: none; padding: 0 !important; gap: 10px !important; }
	.bm-limits li { position: relative; padding-left: 18px; }
	.bm-limits li::before { content: ''; position: absolute; left: 0; top: .78em; width: 8px; height: 1px; background: var(--accent); }
	.bm-tags { display: flex; flex-wrap: wrap; gap: 8px; }
	.bm-tags span { padding: 5px 10px; border-radius: 8px; border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent); background: var(--accent-soft); color: var(--accent); font: 750 12px/1 var(--font-mono); }

	.bm-compare-grid { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(240px, .7fr); gap: clamp(20px, 3vw, 40px); align-items: start; }
	.bm-compare-panel { padding: clamp(10px, 1.4vw, 18px); border-radius: var(--radius-lg); }
	.bm-compare-note { position: sticky; top: calc(var(--chrome-top) + 24px); display: grid; gap: 16px; color: var(--muted); font-size: 14.5px; line-height: 1.6; }
	.bm-compare-rank { display: grid; gap: 6px; }
	.bm-compare-rank b { font: 500 clamp(64px, 7vw, 104px)/.9 var(--font-display); letter-spacing: -.06em; color: var(--text); }
	.bm-compare-rank span { font: 750 10.5px/1.3 var(--font-mono); letter-spacing: .16em; text-transform: uppercase; }
	.bm-compare-note ul { list-style: none; margin: 0; padding: 0; display: grid; border-top: 1px solid var(--border); }
	.bm-compare-note li { display: flex; justify-content: space-between; gap: 12px; border-bottom: 1px solid var(--border); }
	.bm-compare-note li a { display: flex; align-items: center; min-height: 44px; color: var(--text); font-weight: 600; }
	.bm-compare-note li a:hover { color: var(--accent); }
	.bm-compare-note li span { align-self: center; font: 650 13px/1 var(--font-mono); color: var(--text-soft); }

	.bm-artifacts { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.5fr); gap: clamp(20px, 3vw, 48px); }
	.bm-artifacts .bm-head p { color: var(--muted); line-height: 1.65; }
	.bm-artifact-list { list-style: none; margin: 0; padding: 0; display: grid; }
	.bm-artifact-list li { border-bottom: 1px solid var(--border); }
	.bm-artifact-list li:last-child { border-bottom: 0; }
	.bm-artifact-list a, .bm-artifact-internal { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 14px; align-items: center; min-height: 56px; padding: 10px 0; }
	.bm-artifact-internal { grid-template-columns: auto minmax(0, 1fr); }
	.bm-artifact-list a { color: var(--text); transition: color .2s ease; }
	.bm-artifact-list a > span:last-child { color: var(--accent); }
	.bm-artifact-list a:hover { color: var(--accent); }
	.bm-artifact-label { font: 600 13px/1.5 var(--font-mono); overflow-wrap: anywhere; }
	.bm-artifact-internal .bm-artifact-label { color: var(--muted); }

	@media (max-width: 980px) {
		.bm-back { margin-bottom: -40px; }
		.bm-compare-grid, .bm-artifacts { grid-template-columns: 1fr; }
		.bm-compare-note { position: static; order: -1; }
	}
	@media (max-width: 760px) {
		.bm-back { padding-top: 10px; margin-bottom: -26px; }
		.bm-score { padding: 22px 20px; }
		.bm-compare-rank b { font-size: 64px; }
		.bm-artifact-list a, .bm-artifact-internal { grid-template-columns: minmax(0, 1fr) auto; gap: 8px 12px; }
		.bm-artifact-list .ds-badge { grid-column: 1 / -1; justify-self: start; }
		.bm-artifact-internal { grid-template-columns: minmax(0, 1fr); }
	}
</style>
