---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import registry from '../../data/benchmark-registry.json';

const comparisonRows = registry.leaderboard;
const benchmarkRuns = registry.runs;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Benchmarks — SuperAda" description="Model benchmarks, benchmark graphics, and drill-down report pages from the Enterprise Crew." />
  </head>
  <body style="background:var(--bg); color:var(--text); min-height:100vh;">
    <Header />
    <main style="max-width:1100px; margin:0 auto; padding:3rem 1.5rem 4rem;">
      <a onclick="history.back()" href="#" style="display:inline-flex; margin-bottom:1.1rem; color:var(--accent); font-size:0.9rem; text-decoration:none; cursor:pointer;">← Back to Resources</a>
      <section style="margin-bottom:2rem; padding:2rem; border:1px solid var(--border); border-radius:10px; background:linear-gradient(135deg,var(--panel) 0%,var(--panel-soft) 60%,var(--panel-soft) 100%);">
        <div style="font-size:0.75rem; letter-spacing:0.16em; text-transform:uppercase; color:var(--accent); margin-bottom:0.8rem;">Benchmarks</div>
        <h1 style="font-family:Georgia,serif; font-size:3rem; line-height:1.05; font-weight:400; margin:0 0 0.75rem;">Model benchmarks that actually matter</h1>
        <p style="font-size:1.05rem; color:var(--text-soft); max-width:780px; line-height:1.75; margin:0 0 0.85rem;">
          Not synthetic beauty-pageant nonsense. These are the runs, scoreboards, and drill-downs we use to compare models on real operator work.
        </p>
        <p style="font-size:0.95rem; color:var(--muted); max-width:780px; line-height:1.7; margin:0 0 1.1rem;">
          The benchmark explainer page with the current leaderboard, benchmark canon, and graphics.
        </p>
        <a href="/benchmarks/operator-index" style="display:inline-flex; align-items:center; gap:0.4rem; color:var(--accent); font-size:0.9rem; text-decoration:none; border:1px solid color-mix(in srgb, var(--accent) 20%, transparent); padding:0.45rem 1rem; border-radius:6px; transition:all 0.15s;" onmouseover="this.style.borderColor='var(--accent)'" onmouseout="this.style.borderColor='color-mix(in srgb, var(--accent) 20%, transparent)'">
          Read more →
        </a>
      </section>



      <section style="margin-bottom:2rem;">
        <div style="display:flex; justify-content:space-between; align-items:end; gap:1rem; margin-bottom:1rem;">
          <div>
            <div style="font-size:0.8rem; text-transform:uppercase; letter-spacing:0.12em; color:var(--accent); margin-bottom:0.35rem;">Leaderboard</div>
            <h2 style="font-family:Georgia,serif; font-size:2rem; font-weight:400; margin:0;">Where the models stack up</h2>
          </div>
          <div style="color:var(--muted); font-size:0.9rem;">Updated {new Date(registry.updatedAt).toISOString().slice(0, 10)}</div>
        </div>
        <div style="display:grid; gap:1px; background:var(--border); border:1px solid var(--border); border-radius:12px; overflow:hidden;">
          <div style="display:grid; grid-template-columns:0.5fr 1.35fr 0.95fr 0.95fr 1.15fr 0.9fr 1.2fr; gap:0; background:var(--panel-soft); color:var(--text-soft); font-size:0.78rem; letter-spacing:0.08em; text-transform:uppercase;">
            <div style="padding:0.9rem 1rem;">Rank</div>
            <div style="padding:0.9rem 1rem;">Model</div>
            <div style="padding:0.9rem 1rem;">Operator</div>
            <div style="padding:0.9rem 1rem;">Messaging</div>
            <div style="padding:0.9rem 1rem;">External</div>
            <div style="padding:0.9rem 1rem;">Cost</div>
            <div style="padding:0.9rem 1rem;">Verdict</div>
          </div>
          {comparisonRows.map((row) => {
            const external = row.detailHref?.startsWith('http');
            return (
              <a href={row.detailHref} target={external ? '_blank' : '_self'} rel={external ? 'noopener noreferrer' : undefined} style="display:grid; grid-template-columns:0.5fr 1.35fr 0.95fr 0.95fr 1.15fr 0.9fr 1.2fr; gap:0; background:var(--bg); text-decoration:none;">
                <div style="padding:1rem; color:var(--accent); font-variant-numeric:tabular-nums;">#{row.rank}</div>
                <div style="padding:1rem; color:var(--text);">
                  <div style="margin-bottom:0.2rem;">{row.model}</div>
                  <div style="font-size:0.82rem; color:var(--muted);">{row.family} · {row.detailLabel} →</div>
                </div>
                <div style="padding:1rem; color:var(--text-soft);">{typeof row.operator === 'number' ? `${row.operator}/100` : row.operator}</div>
                <div style="padding:1rem; color:var(--text-soft);">{row.messaging}</div>
                <div style="padding:1rem; color:var(--muted); line-height:1.6;">{row.external}</div>
                <div style="padding:1rem; color:var(--text-soft);">{row.cost}</div>
                <div style="padding:1rem; color:var(--muted); line-height:1.6;">{row.verdict}</div>
              </a>
            );
          })}
        </div>
      </section>

      <section style="margin-bottom:2rem;">
        <div style="font-size:0.8rem; text-transform:uppercase; letter-spacing:0.12em; color:var(--accent); margin-bottom:0.35rem;">Runs and artifacts</div>
        <h2 style="font-family:Georgia,serif; font-size:2rem; font-weight:400; margin:0 0 1rem;">Open a benchmark, then drill into the model</h2>
        <div style="display:grid; grid-template-columns:repeat(2,1fr); gap:1rem;">
          {benchmarkRuns.map((run) => (
            <article style="padding:1.2rem; border:1px solid var(--border); border-radius:10px; background:var(--panel); display:flex; flex-direction:column; gap:0.8rem;">
              {run.imageHref && (
                <a href={run.imageHref} style="display:block; text-decoration:none;">
                  <img src={run.imageHref} alt={`${run.model} artifact`} style="width:100%; border-radius:8px; border:1px solid var(--border);" />
                </a>
              )}
              <div style="display:flex; justify-content:space-between; gap:0.75rem; align-items:start;">
                <div style="font-size:0.78rem; color:var(--accent); text-transform:uppercase; letter-spacing:0.12em;">{run.category}</div>
                <div style="font-size:0.82rem; color:var(--muted);">{run.date}</div>
              </div>
              <h3 style="margin:0; font-size:1.08rem; color:var(--text);">{run.model}</h3>
              <div style="font-size:0.88rem; color:var(--text-soft);">{run.score}</div>
              <p style="margin:0; color:var(--muted); line-height:1.65; font-size:0.92rem; flex:1;">{run.summary}</p>
              <div style="display:flex; justify-content:space-between; align-items:center; gap:1rem;">
                <span style="font-size:0.75rem; color:var(--muted); text-transform:uppercase; letter-spacing:0.08em;">{run.artifactType}</span>
                <a href={run.href} target={run.href.startsWith('http') ? '_blank' : '_self'} rel={run.href.startsWith('http') ? 'noopener noreferrer' : undefined} style="color:var(--accent); text-decoration:none; font-size:0.9rem;">{run.hrefLabel} →</a>
              </div>
            </article>
          ))}
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
