---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import PageHero from '../../../components/PageHero.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';

export function getStaticPaths() {
	const allSlides = import.meta.glob('/public/weekly-claw/week*/slide-*.jpg', { eager: false });
	const weeks = new Set<string>();
	for (const path of Object.keys(allSlides)) {
		const match = path.match(/\/public\/weekly-claw\/(week\d+[a-z]?)\/slide-(\d+)\.jpg$/);
		if (match) weeks.add(match[1]);
	}
	return Array.from(weeks).map((week) => ({ params: { week } }));
}

const week = Astro.params.week!;
const weekNumber = week.replace('week', '#');
const htmlDeckPath = `/weekly-claw/${week}/deck.html`;
const hasHtmlDeck = existsSync(join(process.cwd(), 'public', 'weekly-claw', week, 'deck.html'));
const slides = Object.keys(import.meta.glob('/public/weekly-claw/week*/slide-*.jpg', { eager: false }))
	.filter((path) => path.includes(`/public/weekly-claw/${week}/`))
	.map((path) => path.replace('/public', ''))
	.sort((a, b) => {
		const na = parseInt(a.match(/slide-(\d+)/)?.[1] || '0');
		const nb = parseInt(b.match(/slide-(\d+)/)?.[1] || '0');
		return na - nb;
	});
const title = `The Weekly Claw ${weekNumber} Changelog`;
---
<SiteLayout title={title} description="Weekly OpenClaw changelog and developer experience deck" mainClass="wc-page">
	<div class="ds-shell wc-back" id="back"><a href="/weekly-claw">← All editions</a></div>

	<PageHero eyebrow={`The Weekly Claw · Edition ${weekNumber}`} title={title} lede="Weekly OpenClaw changelog and developer experience deck: what shipped, what broke, and what it means for the crew." size="md" id="page-title">
		{hasHtmlDeck ? (
			<>
				<button type="button" class="ds-btn" data-deck-fullscreen>Play fullscreen <span aria-hidden="true">⤢</span></button>
				<a class="ds-btn ds-btn--ghost" href={htmlDeckPath}>Open deck <span aria-hidden="true">↗</span></a>
			</>
		) : (
			<a class="ds-btn" href="#slide-1">Start the deck <span aria-hidden="true">↓</span></a>
		)}
		<a class="ds-btn ds-btn--ghost" href={`/weekly-claw/${week}`}>Edition page</a>
	</PageHero>

	<div class="ds-shell wc-body">
		{hasHtmlDeck ? (
			<section class="wc-stage-wrap" aria-label={`${title} deck`} data-no-reveal>
				<div class="wc-stage" data-deck-stage>
					<iframe id="html-deck" src={htmlDeckPath} title={title} allowfullscreen></iframe>
				</div>
				<div class="wc-stage-bar">
					<span class="ds-meta"><span>Interactive deck</span><span>{slides.length} slides</span></span>
					<span class="wc-hint"><kbd>←</kbd><kbd>→</kbd> Click the deck, then use the arrow keys</span>
				</div>
			</section>
		) : (
			<ol class="wc-slides" aria-label={`${title} slides`} data-no-reveal>
				{slides.map((slide, i) => (
					<li class="slide" id={`slide-${i + 1}`}>
						<img src={slide} alt={`The Weekly Claw ${weekNumber}`} width="2752" height="1536" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
						<span class="wc-slide-n">{String(i + 1).padStart(2, '0')} / {String(slides.length).padStart(2, '0')}</span>
					</li>
				))}
			</ol>
		)}
	</div>

	<script is:inline>
		(() => {
			const button = document.querySelector('[data-deck-fullscreen]');
			const stage = document.querySelector('[data-deck-stage]');
			if (!button || !stage) return;
			const frame = stage.querySelector('iframe');
			const canFullscreen = !!(stage.requestFullscreen || stage.webkitRequestFullscreen);
			button.addEventListener('click', () => {
				if (!canFullscreen) { location.href = frame.src; return; }
				const request = stage.requestFullscreen || stage.webkitRequestFullscreen;
				Promise.resolve(request.call(stage)).then(() => frame.focus()).catch(() => { location.href = frame.src; });
			});
		})();
	</script>
</SiteLayout>

<style>
	.wc-back { padding-top: clamp(20px, 3vw, 36px); margin-bottom: calc(clamp(44px, 7vw, 108px) * -1 + 12px); }
	.wc-back a { display: inline-flex; align-items: center; min-height: 44px; color: var(--muted); font-size: 13px; font-weight: 700; transition: color .2s ease; }
	.wc-back a:hover { color: var(--accent); }
	[data-deck-fullscreen] { font-family: inherit; cursor: pointer; }

	.wc-body { --shell: 1400px; }
	.wc-stage-wrap { display: grid; gap: 14px; }
	.wc-stage { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-radius: var(--radius-xl); border: 1px solid var(--surface-border); background: #050810; box-shadow: var(--lift), 0 40px 120px rgba(0, 0, 0, .35); isolation: isolate; }
	.wc-stage::after { content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none; box-shadow: inset 0 0 0 1px color-mix(in srgb, white 6%, transparent); }
	.wc-stage:fullscreen { border-radius: 0; border: 0; aspect-ratio: auto; }
	#html-deck { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; background: #050810; }
	.wc-stage-bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 0 6px; }
	.wc-hint { display: inline-flex; align-items: center; gap: 6px; color: var(--faint); font-size: 12.5px; }
	.wc-hint kbd { display: inline-grid; place-items: center; min-width: 24px; height: 24px; border-radius: 7px; border: 1px solid var(--border); background: var(--panel); color: var(--muted); font: 650 11px/1 var(--font-mono); }

	.wc-slides { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(16px, 2.4vw, 32px); }
	.slide { position: relative; overflow: hidden; border-radius: var(--radius-lg); border: 1px solid var(--surface-border); background: #050505; box-shadow: var(--lift); scroll-margin-top: calc(var(--chrome-top) + 20px); }
	.slide img { display: block; width: 100%; height: auto; }
	.wc-slide-n { position: absolute; right: 14px; bottom: 14px; padding: 6px 10px; border-radius: 999px; background: rgba(5, 5, 5, .65); color: #f0f4ff; font: 700 11px/1 var(--font-mono); letter-spacing: .08em; -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); }

	@media (max-width: 980px) { .wc-back { margin-bottom: -40px; } }
	@media (max-width: 760px) {
		.wc-back { padding-top: 10px; margin-bottom: -26px; }
		.wc-stage { border-radius: var(--radius-md); margin-inline: calc(var(--gutter) * -0.5); }
		.wc-hint { display: none; }
		.slide { border-radius: var(--radius-md); }
		.wc-slide-n { right: 10px; bottom: 10px; }
	}
</style>
