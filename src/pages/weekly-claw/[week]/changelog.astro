---
import BaseHead from '../../../components/BaseHead.astro';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

export function getStaticPaths() {
  const allSlides = import.meta.glob('/public/weekly-claw/week*/slide-*.jpg', { eager: false });
  const weeks = new Set<string>();
  for (const path of Object.keys(allSlides)) {
    const match = path.match(/\/public\/weekly-claw\/(week\d+[a-z]?)\/slide-(\d+)\.jpg$/);
    if (match) weeks.add(match[1]);
  }
  return Array.from(weeks).map((week) => ({ params: { week } }));
}

const week = Astro.params.week!;
const weekNumber = week.replace('week', '#');
const htmlDeckPath = `/weekly-claw/${week}/deck.html`;
const hasHtmlDeck = existsSync(join(process.cwd(), 'public', 'weekly-claw', week, 'deck.html'));
const slides = Object.keys(import.meta.glob('/public/weekly-claw/week*/slide-*.jpg', { eager: false }))
  .filter((path) => path.includes(`/public/weekly-claw/${week}/`))
  .map((path) => path.replace('/public', ''))
  .sort((a, b) => {
    const na = parseInt(a.match(/slide-(\d+)/)?.[1] || '0');
    const nb = parseInt(b.match(/slide-(\d+)/)?.[1] || '0');
    return na - nb;
  });
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`The Weekly Claw ${weekNumber} Changelog`} description="Weekly OpenClaw changelog and developer experience deck" />
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { width: 100%; height: 100%; overflow: hidden; background: #050505; color: #fff; }
      body { font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
      #html-deck { position: fixed; inset: 0; width: 100vw; height: 100vh; border: 0; background: #050505; z-index: 1; }
      #page-title { position: fixed; top: 20px; left: 50%; transform: translateX(-50%); color: #333; font-size: 12px; font-weight: 400; letter-spacing: 0.05em; text-transform: uppercase; z-index: 100; user-select: none; }
      #back { position: fixed; top: 20px; left: 28px; z-index: 100; }
      #back a { font-size: 11px; color: #444; text-decoration: none; letter-spacing: 0.05em; text-transform: uppercase; transition: all 0.2s; border: 1px solid #222; border-radius: 4px; padding: 4px 10px; }
      #back a:hover { color: #F65454; border-color: #F65454; }
      .slide { position: absolute; inset: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background:#050505; }
      .slide img { width: 100%; height: 100%; object-fit: contain; }
    </style>
  </head>
  <body>
    <h1 id="page-title">The Weekly Claw {weekNumber} Changelog</h1>
    <div id="back"><a href="/weekly-claw">← All editions</a></div>
    {hasHtmlDeck ? (
      <iframe id="html-deck" src={htmlDeckPath} title={`The Weekly Claw ${weekNumber} Changelog`} allowfullscreen></iframe>
    ) : (
      slides.map((slide) => (<div class="slide"><img src={slide} alt={`The Weekly Claw ${weekNumber}`} /></div>))
    )}
  </body>
</html>
