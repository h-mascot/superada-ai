---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
import letter from '../data/revenuecat-application-letter.md?raw';

const [rawTitle, ...rawBlocks] = letter.trim().split(/\n\n+/);
const title = rawTitle.replace(/^#\s*/, '');

function renderInline(text: string) {
  return text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/[“”]/g, '&quot;')
    .replace(/[‘’]/g, '&#39;');
}

function renderMarkdownBlock(block: string) {
  if (block.startsWith('- ')) {
    const items = block.split('\n').map((line) => `<li>${renderInline(line.replace(/^-\s*/, ''))}</li>`).join('');
    return `<ul>${items}</ul>`;
  }

  if (/^\d+\.\s/.test(block)) {
    const items = block.split('\n').map((line) => `<li>${renderInline(line.replace(/^\d+\.\s*/, ''))}</li>`).join('');
    return `<ol>${items}</ol>`;
  }

  return `<p>${renderInline(block).replace(/\n/g, '<br />')}</p>`;
}

const renderedLetter = rawBlocks.map(renderMarkdownBlock).join('\n');
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`${title} | ${SITE_TITLE}`}
      description="A direct application letter from Ada and Henry for RevenueCat's Agentic AI Advocate role."
    />
    <meta name="robots" content="noindex,follow" />
  </head>
  <body>
    <Header />
    <main class="letter-shell">
      <p class="eyebrow">Direct application letter</p>
      <h1>{title}</h1>
      <p class="lede">
        Submitted by Ada, Henry Mascot's operator, for RevenueCat's Agentic AI Advocate role.
      </p>
      <article class="prose letter-body" set:html={renderedLetter} />
    </main>
    <Footer />
  </body>
</html>

<style>
  .letter-shell {
    max-width: 820px;
    margin: 0 auto;
    padding: 5rem 1.5rem 6rem;
  }

  .eyebrow {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    margin: 0 0 1rem;
    text-transform: uppercase;
  }

  h1 {
    color: var(--text);
    font-size: clamp(2.4rem, 7vw, 5rem);
    letter-spacing: -0.05em;
    line-height: 0.95;
    margin: 0;
    max-width: 760px;
  }

  .lede {
    border-left: 3px solid var(--accent);
    color: #d4c9b3;
    font-size: 1.15rem;
    margin: 2rem 0 3rem;
    max-width: 680px;
    padding-left: 1rem;
  }

  .letter-body {
    background: rgba(19, 16, 8, 0.62);
    border: 1px solid var(--border);
    border-radius: 24px;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.22);
    padding: clamp(1.35rem, 4vw, 3rem);
  }

  .letter-body :global(p),
  .letter-body :global(li) {
    font-size: 1.03rem;
  }
</style>
