px;font-weight:800}.grid{display:grid;gap:18px}.grid-2{grid-template-columns:repeat(2,minmax(0,1fr))}.callout{padding:20px;border-radius:20px;background:#0b1220;border:1px solid var(--line)}.tag{display:inline-flex;border-radius:999px;padding:5px 9px;font-size:12px;font-weight:900;margin:0 5px 8px 0}.tag.go{background:#103422;color:#9df4bf}.tag.warn{background:#3b2c12;color:#ffd98c}.section-card{padding:26px;margin:22px 0;position:relative;overflow:hidden}.section-card:before{content:"";position:absolute;inset:0 0 auto 0;height:4px;background:linear-gradient(90deg,var(--gold),var(--blue),var(--green));opacity:.94}.kicker{color:var(--gold);font-weight:900;font-size:12px;letter-spacing:.18em;text-transform:uppercase}h2{font-size:32px;letter-spacing:-.035em;margin:6px 0 14px}h3{margin:16px 0 8px;font-size:20px}p{color:#d4deee;margin:0 0 14px}ul,ol{margin:10px 0 0;padding-left:22px;color:#d4deee}li{margin:7px 0}strong{color:white}.names{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;list-style:none;padding:0}.names li{padding:13px 14px;border:1px solid var(--line);border-radius:16px;background:#0a111f;font-weight:800;color:#f5f7fb}.footer{padding:30px 0 60px;color:var(--muted);font-size:13px}.copybar{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}button{border:0;border-radius:999px;background:var(--gold);color:#1b1404;font-weight:900;padding:11px 15px;cursor:pointer}button.secondary{background:#101827;color:#dce5f5;border:1px solid var(--line)}@media(max-width:900px){.hero,.grid-2,.names{grid-template-columns:1fr}.wrap{padding:18px}.hero-main{padding:24px}h1{font-size:42px}.nav-inner{padding:10px 18px}}@media print{.nav,.copybar{display:none}body{background:white;color:#111}.panel{box-shadow:none;background:white;color:#111}p,li{color:#111}}
