#!/usr/bin/env sh
set -eu
TARGET_DIR="${1:-${AGENT_SKILLS_DIR:-./skills}}/runner"
mkdir -p "$TARGET_DIR"
base="https://superada.ai/skills/runner"
# Fetch all files via a tarball approach is not available; fetch SKILL.md and key artifacts
curl -fsSL "$base/SKILL.md" -o "$TARGET_DIR/SKILL.md"
# Fetch scripts
mkdir -p "$TARGET_DIR/scripts"
curl -fsSL "$base/scripts/redacted-secret-scan.sh" -o "$TARGET_DIR/scripts/redacted-secret-scan.sh"
curl -fsSL "$base/scripts/validate_execution_pack.py" -o "$TARGET_DIR/scripts/validate_execution_pack.py"
chmod +x "$TARGET_DIR/scripts/"*.sh 2>/dev/null || true
# Fetch templates
mkdir -p "$TARGET_DIR/templates"
for tmpl in \
  cursor-bounded-queue-prompt \
  cursor-driver-cron-prompt \
  cursor-single-issue-prompt \
  entity-fs-link-instructions \
  linear-cleanup-manifest \
  linear-id-to-source-id \
  plan \
  preflight-checklist \
  project-gate.example \
  run-state.example; do
  ext="md"; [ "$tmpl" = "linear-id-to-source-id" ] && ext="json"; [ "$tmpl" = "project-gate.example" ] && ext="json"; [ "$tmpl" = "run-state.example" ] && ext="json"
  curl -fsSL "$base/templates/$tmpl.$ext" -o "$TARGET_DIR/templates/$tmpl.$ext"
done
# Fetch references index
mkdir -p "$TARGET_DIR/references"
curl -fsSL "$base/references/INDEX.md" -o "$TARGET_DIR/references/INDEX.md"
printf 'Installed runner to %s\n' "$TARGET_DIR"
printf 'Note: runner has 60+ reference files. Full reference set available at %s/skills/runner/references/\n' "${SUPERADA_BASE_URL:-https://superada.ai}"
