#!/usr/bin/env sh
set -eu
TARGET_DIR="${1:-${AGENT_SKILLS_DIR:-./skills}}/ogillvy"
mkdir -p "$TARGET_DIR"
base="https://superada.ai/skills/ogillvy"
for path in \
  "SKILL.md"
  "README.md"; do
  mkdir -p "$TARGET_DIR/$(dirname "$path")"
  curl -fsSL "$base/$path" -o "$TARGET_DIR/$path"
done
printf 'Installed ogillvy to %s\n' "$TARGET_DIR"
