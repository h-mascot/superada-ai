#!/bin/sh
set -eu
PET_ID="picard"
BASE_URL="https://superada.ai/pets/picard"
DEST="${CODEX_PETS_DIR:-$HOME/.codex/pets}/$PET_ID"
mkdir -p "$DEST"
curl -fsSL "$BASE_URL/pet.json" -o "$DEST/pet.json"
curl -fsSL "$BASE_URL/spritesheet.webp" -o "$DEST/spritesheet.webp"
curl -fsSL "$BASE_URL/pet-image.png" -o "$DEST/pet-image.png"
echo "Installed SuperAda Picard pet to $DEST"
echo "Open Codex Settings > Appearance > Pets, then select Picard."
