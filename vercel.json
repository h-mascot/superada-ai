{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://analytics.henrymascot.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://analytics.henrymascot.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/software-factory",
      "destination": "/resources/software-factory/",
      "permanent": true
    },
    {
      "source": "/software-factory/:path*",
      "destination": "/resources/software-factory/:path*",
      "permanent": true
    },
    {
      "source": "/decks/magnifica-humanitas",
      "destination": "/resources/interesting/magnifica-humanitas/",
      "permanent": true
    },
    {
      "source": "/decks/magnifica-humanitas/:path*",
      "destination": "/resources/interesting/magnifica-humanitas/:path*",
      "permanent": true
    },
    {
      "source": "/decks/spacex-s1",
      "destination": "/resources/interesting/spacex-s1/",
      "permanent": true
    },
    {
      "source": "/decks/spacex-s1/:path*",
      "destination": "/resources/interesting/spacex-s1/:path*",
      "permanent": true
    }
  ]
}
